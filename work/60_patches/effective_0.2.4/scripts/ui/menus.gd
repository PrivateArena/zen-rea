func show_tower_camp(at_floor: int, gift: String, done: Callable) -> void :
	if auto_pick:
		done.call()
		return
	_mode = "tower_camp"
	world.hold_world()
	_grace = INPUT_GRACE
	var col: = _screen(tr("Zona de descanso  ·  Piso %d") % at_floor, "")
	_npc_cutin("tnm_lucile03")
	var hel_camp: bool = world.tower != null and world.tower.hel != null
	var lines: Array = [tr(str((GameData.HEL_CAMP_LINES if hel_camp else GameData.TOWER_CAMP_LINES).pick_random()))]
	if hel_camp:
		pass
	elif gift == "legend":
		lines.append(tr("¡Toma! Te hice sitio: un hueco más para legendarias en tu equipo inicial."))
	elif gift == "power":
		lines.append(tr("¡Toma! Con esto la torre te pesará menos: +%d%% de daño y vida aquí dentro.") % roundi(GameData.TOWER_POWER * 100.0))
	elif GameData.TOWER_REWARDS.has(at_floor):
		lines.append(tr("Este regalo ya te lo di. ¡El siguiente te espera más arriba!"))
	_cutin_say(lines, tr("Lucile"))
	col.custom_minimum_size.x = 380
	if gift == "" and GameData.TOWER_REWARDS.has(at_floor) and not hel_camp:
		var claimed: = UiKit.label(tr("✓ Regalo ya reclamado"), 16, UiKit.MUTED, true)
		claimed.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER
		col.add_child(claimed)
	if gift != "":

		var card: = PanelContainer.new()
		var cb: = UiKit.panel_box(Color(1.0, 0.97, 0.88), Color(0.95, 0.65, 0.2), 10, 2)
		cb.set_content_margin_all(12)
		card.add_theme_stylebox_override("panel", cb)
		col.add_child(card)
		var cc: = VBoxContainer.new()
		cc.add_theme_constant_override("separation", 2)
		card.add_child(cc)
		var head: = UiKit.label(tr("Regalo de Lucile"), 13, Color(0.75, 0.4, 0.1), true)
		head.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER
		cc.add_child(head)
		var big: = UiKit.label(tr("+1 hueco de legendaria") if gift == "legend" else tr("+%d%% de daño y vida en la torre") % roundi(GameData.TOWER_POWER * 100.0), 
			22, Color(0.85, 0.45, 0.1), true)
		big.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER
		cc.add_child(big)
		var sub: = UiKit.label(tr("En el equipo inicial de todas tus clases (Almacén Kafra)") if gift == "legend" else tr("Para siempre, en cada subida"), 
			11, UiKit.MUTED)
		sub.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER
		cc.add_child(sub)
		var pop: = card.create_tween().set_pause_mode(Tween.TWEEN_PAUSE_PROCESS)
		card.pivot_offset = Vector2(180, 40)
		card.scale = Vector2.ONE * 0.6
		pop.tween_property(card, "scale", Vector2.ONE, 0.3).set_trans(Tween.TRANS_BACK).set_ease(Tween.EASE_OUT)
		world.play_sound("drop_yellow", 0.0, -4.0)
	else:
		var calm: = UiKit.label(tr("Recupera el aliento: cuando quieras, el portal te lleva arriba."), 13, UiKit.MUTED)
		calm.autowrap_mode = TextServer.AUTOWRAP_WORD_SMART
		calm.custom_minimum_size.x = 360
		calm.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER
		col.add_child(calm)

	var go: = UiKit.button(tr("¡Seguimos subiendo!"), true)
	go.pressed.connect( func():
		if _grace > 0.0:
			return
		_resume()
		done.call())
	col.add_child(go)
	go.grab_focus.call_deferred()


func show_tower_blessing(ids: Array, done: Callable) -> void :
	if auto_pick:
		done.call(str(ids.pick_random()))
		return
	_mode = "tower_bless"
	world.hold_world()
	_grace = INPUT_GRACE
	var col: = _screen(tr("Bendición de Lucile"), tr("Elige una."))
	_npc_cutin("tnm_lucile03")
	_cutin_say(tr("¡Toma, para lo que queda de subida!"), tr("Lucile"))
	_bounce_in(col.get_parent().get_parent())
	var row: = HBoxContainer.new()
	row.alignment = BoxContainer.ALIGNMENT_CENTER
	row.add_theme_constant_override("separation", 10)
	col.add_child(row)
	var first: Button
	for id in ids:
		var d: Dictionary = GameData.TOWER_BLESSINGS[id]
		var b: = Button.new()
		b.custom_minimum_size = Vector2(170, 150)
		b.add_theme_stylebox_override("normal", UiKit.panel_box(Color(0.97, 0.95, 1.0), Color(0.62, 0.5, 0.95), 8, 2))
		b.add_theme_stylebox_override("hover", UiKit.panel_box(Color(0.92, 0.88, 1.0), Color(0.45, 0.3, 0.95), 8, 3))
		b.add_theme_stylebox_override("focus", UiKit.panel_box(Color(0.92, 0.88, 1.0), Color(0.45, 0.3, 0.95), 8, 3))
		b.add_theme_stylebox_override("pressed", UiKit.panel_box(Color(0.88, 0.82, 1.0), Color(0.45, 0.3, 0.95), 8, 3))
		var inner: = VBoxContainer.new()
		inner.alignment = BoxContainer.ALIGNMENT_CENTER
		inner.add_theme_constant_override("separation", 6)
		inner.mouse_filter = Control.MOUSE_FILTER_IGNORE
		inner.set_anchors_and_offsets_preset(Control.PRESET_FULL_RECT)
		b.add_child(inner)
		var icon: = UiKit.skill_icon(str(d.icon))
		if icon != null:
			var center: = CenterContainer.new()
			center.mouse_filter = Control.MOUSE_FILTER_IGNORE
			center.add_child(UiKit.icon_rect(icon, 40))
			inner.add_child(center)
		var n: = UiKit.label(tr(str(d.name)), 15, Color(0.35, 0.2, 0.7), true)
		n.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER
		inner.add_child(n)
		var t: = UiKit.label(tr(str(d.desc)), 12, UiKit.TEXT)
		t.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER
		t.autowrap_mode = TextServer.AUTOWRAP_WORD_SMART
		t.custom_minimum_size.x = 150
		inner.add_child(t)
		var key: = str(id)
		b.pressed.connect( func():
			if _grace > 0.0:
				return
			ui_click()
			_resume()
			done.call(key))
		row.add_child(b)
		if first == null:
			first = b
	var taken: Array = world.tower.blessings if world.tower != null else []
	if not taken.is_empty():
		var names: Array[String] = []
		for id in taken:
			names.append(tr(str(GameData.TOWER_BLESSINGS[id].name)))
		var l: = UiKit.label(tr("Ya llevas: %s") % ", ".join(names), 11, UiKit.MUTED)
		l.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER
		l.autowrap_mode = TextServer.AUTOWRAP_WORD_SMART
		l.custom_minimum_size.x = 540
		col.add_child(l)
	if first != null:
		first.grab_focus.call_deferred()




