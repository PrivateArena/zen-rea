const CHEF_GOLD: = Color(0.86, 0.6, 0.2)
const CHEF_INK: = Color(0.33, 0.24, 0.12)
const CHEF_TILE: = 58.0
func show_chef(message: = "") -> void :
	_mode = "chef"
	var col: = _screen(tr("Klaws  ·  Cocina de Prontera"), "")
	_npc_cutin("npc_chef")
	_cutin_say(message if message != "" else tr("¡Gracias a ti tengo cocina otra vez! Elige tus platos y te los preparo para cada aventura. Las recetas nuevas las encontrarás ayudando a la gente de los mapas."), 
		tr("Klaws"))
	col.add_theme_constant_override("separation", 8)
	var level: = Save.cook_level()
	var table: = Save.dishes()
	var known: = GameData.RECIPES.keys().filter( func(r): return Save.recipe_known(r))
	if _chef_sel == "" or not GameData.RECIPES.has(_chef_sel):
		_chef_sel = str(table[0]) if not table.is_empty() else (str(known[0]) if not known.is_empty() else str(GameData.RECIPES.keys()[0]))

	col.add_child(_chef_heading(tr("Tu mesa"), tr("va contigo en cada partida")))
	var places: = HBoxContainer.new()
	places.add_theme_constant_override("separation", 8)
	col.add_child(places)
	for i in GameData.CHEF_MAX_LEVEL:
		places.add_child(_chef_place(str(table[i]) if i < table.size() else "", i < level, i + 1))


	col.add_child(_sets_bar("dishes", tr("Sets de platos"), func() -> Variant: return Save.dishes().duplicate(), 
		func(v: Variant) -> String: return _load_dish_set(v), 
		func(msg: String, _good: bool): show_chef(msg)))
	col.add_child(_chef_rule())

	col.add_child(_chef_heading(tr("Recetas"), "%d / %d" % [known.size(), GameData.RECIPES.size()]))
	var book: = VBoxContainer.new()
	book.add_theme_constant_override("separation", 10)
	col.add_child(book)
	_chef_list = book
	var grid: = GridContainer.new()
	grid.columns = 6
	grid.add_theme_constant_override("h_separation", 8)
	grid.add_theme_constant_override("v_separation", 8)
	grid.size_flags_horizontal = Control.SIZE_SHRINK_CENTER
	book.add_child(grid)
	for id in GameData.RECIPES:
		grid.add_child(_chef_tile(str(id), table))
	_chef_detail = VBoxContainer.new()
	_chef_detail.custom_minimum_size = Vector2(6 * CHEF_TILE + 5 * 8, 104)
	book.add_child(_chef_detail)
	_chef_show(_chef_sel)
	col.add_child(_chef_rule())

	var foot: = HBoxContainer.new()
	foot.add_theme_constant_override("separation", 8)
	col.add_child(foot)
	var info: = VBoxContainer.new()
	info.add_theme_constant_override("separation", 0)
	info.size_flags_horizontal = Control.SIZE_EXPAND_FILL
	info.alignment = BoxContainer.ALIGNMENT_CENTER
	foot.add_child(info)
	info.add_child(UiKit.label(tr("Cocina nivel %d / %d") % [level, GameData.CHEF_MAX_LEVEL], 13, CHEF_INK, true))
	var cost: = Save.cook_next_cost()
	if cost > 0:
		info.add_child(UiKit.label(tr("Nivel %d: %d platos a la vez  ·  %s z") % [level + 1, level + 1, RoBasicWindow._thousands(cost)], 11, 
			UiKit.MUTED if Save.zeny() >= cost else Color(0.7, 0.25, 0.2)))
		var up: = UiKit.button(tr("Mejorar"))
		up.disabled = Save.zeny() < cost
		up.tooltip_text = tr("Tienes %s z") % RoBasicWindow._thousands(Save.zeny())
		up.custom_minimum_size = Vector2(96, 34)
		up.size_flags_vertical = Control.SIZE_SHRINK_CENTER
		up.pressed.connect( func():
			if Save.cook_upgrade():
				world.play_sound("job_levelup", 0.0, -4.0)
				show_chef(tr("¡Cocina ampliada! Ahora te preparo %d platos para cada aventura.") % Save.cook_level()))
		foot.add_child(up)
	else:
		info.add_child(UiKit.label(tr("Al máximo: %d platos a la vez") % level, 11, UiKit.MUTED))
	var close: = UiKit.button(tr("Cerrar"))
	close.custom_minimum_size = Vector2(96, 34)
	close.size_flags_vertical = Control.SIZE_SHRINK_CENTER
	close.pressed.connect(_back_to_hub)
	foot.add_child(close)
	close.grab_focus.call_deferred()



