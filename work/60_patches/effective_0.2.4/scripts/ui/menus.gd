func _npc_cutin(sprite_id: String) -> bool:
	var path: = "res://assets/ro/ui/skin/illust/%s.png" % sprite_id
	if not _has_cutin(sprite_id):
		return false
	var art: = TextureRect.new()
	art.texture = load(path)
	art.expand_mode = TextureRect.EXPAND_IGNORE_SIZE
	art.stretch_mode = TextureRect.STRETCH_KEEP_ASPECT
	art.mouse_filter = Control.MOUSE_FILTER_IGNORE
	var vp: = get_viewport().get_visible_rect().size
	var h: = minf(vp.y * 0.78, float(art.texture.get_height()) * 1.25)
	art.set_meta("size", Vector2(h * art.texture.get_width() / float(art.texture.get_height()), h))
	art.set_anchors_preset(Control.PRESET_BOTTOM_LEFT)
	_root.add_child(art)


	if _ro_window_root != null and is_instance_valid(_ro_window_root) and _ro_window_root.get_parent() == _root:
		_root.move_child(art, _ro_window_root.get_index())
	elif _root.get_child_count() > 1:
		_root.move_child(art, 1)
	_cutin_art = art
	_cutin_bubble = null
	art.modulate.a = 0.0
	_fit_cutin.call_deferred()

	_queue_fit()
	var tw: = art.create_tween().set_pause_mode(Tween.TWEEN_PAUSE_PROCESS)
	tw.tween_property(art, "modulate:a", 1.0, 0.25)
	return true









const RO_CUTIN_MAX_W: = 0.5
const RO_CUTIN_SHRINK: = 0.82
const RO_CUTIN_EDGE: = 8.0


const RO_CUTIN_RIGHT: = 0.5


const RO_SAY_TAIL: = 16.0
const RO_SAY_MAX_W: = 330.0

const RO_SAY_GAP: = 14.0
const RO_SAY_TOP: = 34.0
var _cutin_bubble: SayBubble
var _cutin_art: TextureRect



func _queue_fit() -> void :
	if is_inside_tree() and not get_tree().process_frame.is_connected(_fit_cutin):
		get_tree().process_frame.connect(_fit_cutin, CONNECT_ONE_SHOT)


func _fit_cutin() -> void :
	if _cutin_art == null or not is_instance_valid(_cutin_art) or not _cutin_art.is_inside_tree():
		return
	var view: = get_viewport().get_visible_rect().size
	var ro: = _ro_window_root != null and is_instance_valid(_ro_window_root) and _ro_window_root.get_parent() == _root
	var center: Control = null
	var win: = Vector2.ZERO
	if ro:
		win = _ro_window_root.get_combined_minimum_size() * _ro_window_root.scale
	else:

		for c in _root.get_children():
			if c is CenterContainer and c.get_child_count() > 0:
				center = c


				win = (c.get_child(0) as Control).get_combined_minimum_size() * c.scale.x
		if center == null:
			return
	var full: Vector2 = _cutin_art.get_meta("size")
	var gap: = 16.0


	var paint: = _cutin_paint(_cutin_art.texture)
	var w: = minf(full.x, view.x * RO_CUTIN_MAX_W)
	var over: = win.x + gap + w * paint.y + RO_CUTIN_EDGE * 2.0 - view.x
	if over > 0.0:
		w = maxf(w * RO_CUTIN_SHRINK, w - over / maxf(0.1, paint.y))
	var h: = full.y * w / full.x
	_cutin_art.visible = true
	var left: = floorf((view.x - (win.x + gap + w * paint.y)) * 0.5)
	var art_left: = left + win.x + gap - w * paint.x
	if left > RO_CUTIN_EDGE:
		var lean: = floorf((left - RO_CUTIN_EDGE) * RO_CUTIN_RIGHT)
		left += lean
		art_left += lean
	if left < RO_CUTIN_EDGE:


		left = maxf(RO_CUTIN_EDGE, floorf(minf((view.x - win.x) * 0.5, view.x - w - win.x * 0.6)))
		art_left = view.x - RO_CUTIN_EDGE - w * (paint.x + paint.y)


	var top: = floorf(clampf((view.y - win.y) * 0.5, 8.0, maxf(8.0, view.y - win.y - 8.0)))
	if ro:
		_ro_window_root.position = Vector2(left, top)
		_ro_placed_top = top
	else:
		var dx: = left - floorf((view.x - win.x) * 0.5)


		var dy: = 0.0 if center.scale.x < 0.999 else top - floorf((view.y - win.y) * 0.5)
		center.offset_left = dx
		center.offset_right = dx
		center.offset_top = dy
		center.offset_bottom = dy
	_cutin_art.offset_left = art_left
	_cutin_art.offset_right = art_left + w
	_cutin_art.offset_top = - h
	_cutin_art.offset_bottom = 0.0
	if _cutin_bubble != null and is_instance_valid(_cutin_bubble):

		var head: = _cutin_head(_cutin_art.texture)
		var tip: = Vector2(art_left + head.x * w, view.y - h + head.y * h + 4.0)
		var bw: = minf(_cutin_bubble.want_w, minf(RO_SAY_MAX_W, w * 0.95))
		_cutin_bubble.custom_minimum_size.x = bw


		var inner: = bw - 32.0
		if not is_equal_approx(_cutin_bubble.text.custom_minimum_size.x, inner):
			_cutin_bubble.text.custom_minimum_size.x = inner
			_cutin_bubble.text.size.x = inner
		_cutin_bubble.reset_size()
		var bh: = _cutin_bubble.get_combined_minimum_size().y



		var room: = tip.y - RO_SAY_TAIL - bh - RO_SAY_TOP
		if room < 0.0 and head.y < 0.95:
			var h2: = maxf(h * 0.55, (view.y - RO_SAY_TOP - RO_SAY_TAIL - bh - 4.0) / (1.0 - head.y))
			if h2 < h:
				var w2: = w * h2 / h
				var right: = art_left + w * (paint.x + paint.y)
				art_left = right - w2 * (paint.x + paint.y)
				w = w2
				h = h2
				_cutin_art.offset_left = art_left
				_cutin_art.offset_right = art_left + w
				_cutin_art.offset_top = - h
				tip = Vector2(art_left + head.x * w, view.y - h + head.y * h + 4.0)


		var bx: = clampf(tip.x - bw * 0.5, maxf(art_left, left + win.x + RO_SAY_GAP), view.x - RO_CUTIN_EDGE - bw)
		var by: = maxf(RO_SAY_TOP, tip.y - RO_SAY_TAIL - bh)
		_cutin_bubble.position = Vector2(floorf(bx), floorf(by))
		_cutin_bubble.tip = tip - _cutin_bubble.position
		_cutin_bubble.queue_redraw()




var _cutin_paints: = {}
func _cutin_paint(tex: Texture2D) -> Vector2:
	var key: = tex.resource_path
	if _cutin_paints.has(key):
		return _cutin_paints[key]
	var out: = Vector2(0.0, 1.0)
	var img: = RoAssets.tex_image(tex)
	if img != null:
		if img.is_compressed():
			img.decompress()
		var used: = img.get_used_rect()
		if used.size.x > 0:
			out = Vector2(float(used.position.x) / img.get_width(), float(used.size.x) / img.get_width())
	_cutin_paints[key] = out
	return out




var _cutin_heads: = {}


const CUTIN_HEADS: = {"npc_valkyrie": Vector2(0.49, 0.27)}
func _cutin_head(tex: Texture2D) -> Vector2:
	var key: = tex.resource_path
	if _cutin_heads.has(key):
		return _cutin_heads[key]
	var own: String = key.get_file().get_basename()
	if CUTIN_HEADS.has(own):
		_cutin_heads[key] = CUTIN_HEADS[own]
		return CUTIN_HEADS[own]
	var out: = Vector2(0.5, 0.0)
	var img: = RoAssets.tex_image(tex)
	if img != null:
		if img.is_compressed():
			img.decompress()
		var iw: = img.get_width()
		var ih: = img.get_height()
		for y in range(0, ih, 2):
			var lo: = -1
			var hi: = -1
			for x in range(0, iw, 2):
				if img.get_pixel(x, y).a > 0.5:
					if lo < 0:
						lo = x
					hi = x
			if lo >= 0 and hi - lo >= 6:
				out = Vector2((lo + hi) * 0.5 / iw, float(y) / ih)
				break
	_cutin_heads[key] = out
	return out




class SayBubble extends PanelContainer:
	signal line_shown(i: int)
	signal finished
	const FILL: = Color(1.0, 0.975, 0.9)
	const EDGE: = Color(0.6, 0.44, 0.2)
	var tip: = Vector2.ZERO
	var want_w: = 0.0
	var lines: Array = []
	var at: = 0
	var who: Label
	var text: Label
	var more: Label
	var _type: Tween
	var _next: SceneTreeTimer

	func _init() -> void :
		var bb: = StyleBoxFlat.new()
		bb.bg_color = FILL
		bb.border_color = EDGE
		bb.set_border_width_all(2)
		bb.set_corner_radius_all(14)
		bb.content_margin_left = 16
		bb.content_margin_right = 16
		bb.content_margin_top = 9
		bb.content_margin_bottom = 11
		bb.shadow_color = Color(0, 0, 0, 0.28)
		bb.shadow_size = 6
		bb.shadow_offset = Vector2(0, 2)
		add_theme_stylebox_override("panel", bb)
		mouse_filter = Control.MOUSE_FILTER_STOP

	func _draw() -> void :

		var inner: = StyleBoxFlat.new()
		inner.draw_center = false
		inner.border_color = Color(EDGE, 0.35)
		inner.set_border_width_all(1)
		inner.set_corner_radius_all(10)
		draw_style_box(inner, Rect2(Vector2(4, 4), size - Vector2(8, 8)))

		var bx: = clampf(tip.x, 26.0, size.x - 26.0)
		var a: = Vector2(bx - 10.0, size.y - 2.0)
		var b: = Vector2(bx + 6.0, size.y - 2.0)
		var t: = Vector2(clampf(tip.x, bx - 40.0, bx + 40.0), maxf(tip.y, size.y + 6.0))
		draw_colored_polygon(PackedVector2Array([a, b, t]), FILL)
		draw_line(a, t, EDGE, 2.0, true)
		draw_line(b, t, EDGE, 2.0, true)


	func show_line(i: int) -> void :
		at = i

		text.text = str(lines[i]).strip_edges().trim_prefix("«").trim_suffix("»")
		more.visible = i < lines.size() - 1
		text.visible_ratio = 0.0
		if _type != null:
			_type.kill()
		_type = create_tween().set_pause_mode(Tween.TWEEN_PAUSE_PROCESS)
		_type.tween_property(text, "visible_ratio", 1.0, clampf(text.text.length() * 0.018, 0.25, 1.6))
		line_shown.emit(i)
		if more.visible:

			var wait: = 2.5 + text.text.length() * 0.05
			_next = get_tree().create_timer(wait, true)
			var me: = i
			_next.timeout.connect( func():
				if is_instance_valid(self) and at == me:
					show_line(me + 1))

	func _gui_input(e: InputEvent) -> void :
		if e is InputEventMouseButton and e.pressed and e.button_index == MOUSE_BUTTON_LEFT:
			accept_event()
			if text.visible_ratio < 1.0:
				_type.kill()
				text.visible_ratio = 1.0
			elif at < lines.size() - 1:
				show_line(at + 1)
			else:
				finished.emit()




func _cutin_say(said: Variant, npc_name: = "") -> void :
	if _cutin_art == null or not is_instance_valid(_cutin_art):
		return
	var lines: Array = said if said is Array else [said]
	var bubble: = SayBubble.new()
	bubble.lines = lines
	var col: = VBoxContainer.new()
	col.add_theme_constant_override("separation", 2)
	col.mouse_filter = Control.MOUSE_FILTER_IGNORE
	bubble.add_child(col)
	bubble.who = _ro_text(npc_name, 11, Color(0.58, 0.36, 0.08), true)
	bubble.who.visible = npc_name != ""
	col.add_child(bubble.who)
	bubble.text = _ro_text("", 12, Color(0.22, 0.16, 0.32))
	bubble.text.autowrap_mode = TextServer.AUTOWRAP_WORD_SMART
	col.add_child(bubble.text)
	bubble.more = _ro_text("▼", 9, Color(0.6, 0.44, 0.2))
	bubble.more.horizontal_alignment = HORIZONTAL_ALIGNMENT_RIGHT
	col.add_child(bubble.more)
	var blink: = bubble.more.create_tween().set_loops().set_pause_mode(Tween.TWEEN_PAUSE_PROCESS)
	blink.tween_property(bubble.more, "modulate:a", 0.2, 0.45)
	blink.tween_property(bubble.more, "modulate:a", 1.0, 0.45)

	var font: Font = bubble.text.get_theme_font("font")
	for l in lines:
		bubble.want_w = maxf(bubble.want_w, font.get_string_size(str(l), HORIZONTAL_ALIGNMENT_LEFT, -1, 12).x + 36.0)
	bubble.want_w = maxf(bubble.want_w, 150.0)
	_root.add_child(bubble)
	_cutin_bubble = bubble
	bubble.minimum_size_changed.connect(_queue_fit)
	bubble.show_line(0)
	bubble.modulate.a = 0.0
	var tw: = bubble.create_tween().set_pause_mode(Tween.TWEEN_PAUSE_PROCESS)
	tw.tween_interval(0.2)
	tw.tween_property(bubble, "modulate:a", 1.0, 0.3)
	_fit_cutin.call_deferred()





