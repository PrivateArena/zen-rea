	return _item_icon(str(u.get("icon", id)))


func _item_icon(id: String) -> Texture2D:

	if id.begins_with("soul@"):
		var soul_tex: Texture2D = load("res://scripts/core/soul_icon.gd").texture(id.substr(5))
		if soul_tex != null:
			return soul_tex
	var path: = "res://assets/ro/ui/skin/item_icons/%s.png" % id
	if ResourceLoader.exists(path):
		return load(path) as Texture2D

	return RoAssets.placeholder(Color(0.75, 0.72, 0.6), 24, false)




