func _wheel_rain(view: Vector2, col: Color, count: int) -> void :
	for i in count:
		var bit: = ColorRect.new()
		bit.mouse_filter = Control.MOUSE_FILTER_IGNORE
		bit.size = Vector2(randf_range(4.0, 9.0), randf_range(8.0, 15.0))
		bit.color = col.lightened(randf() * 0.35)
		bit.position = Vector2(view.x * 0.5 + randf_range(-300.0, 300.0), -20.0)
		bit.rotation = randf() * TAU
		_root.add_child(bit)
		var tw: = bit.create_tween().set_pause_mode(Tween.TWEEN_PAUSE_PROCESS).set_parallel()
		var time: = randf_range(0.9, 1.8)
		tw.tween_property(bit, "position:y", view.y + 20.0, time).set_delay(randf() * 0.4).set_ease(Tween.EASE_IN).set_trans(Tween.TRANS_QUAD)
		tw.tween_property(bit, "rotation", bit.rotation + randf_range(-6.0, 6.0), time + 0.4)
		tw.chain().tween_callback(bit.queue_free)




func _tower_build_row(b: Dictionary, i: int, start: Array, pick: = Callable()) -> Control:
