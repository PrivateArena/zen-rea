func _festival_submit(res: Dictionary, place: Label) -> void :
	var p: = world.player
	if p == null:
		return
	var party: = bool(res.get("party", false))
	var look: Dictionary = (p.appearance as Dictionary).duplicate() if p.appearance is Dictionary else {}
	look["build"] = "%s  ·  Nv %d" % [p.job_name(), p.level]
	if party:
		var names: Array = []
		for h in world.heroes:
			names.append("%s (%s)" % [_hero_name(h), h.job_name()])
		look["members"] = ", ".join(names).left(300)
	var on_done: = func(data: Dictionary):
		if not is_instance_valid(place):
			return
		if data.is_empty():
			place.text = tr("No se pudo enviar al ranking (sin conexión o récords apagados).")
		elif bool(data.get("improved", false)):
			place.text = tr("¡Nuevo récord!  ·  Puesto #%d de %d este mes") % [int(data.get("rank", 0)), int(data.get("total", 0))]
		else:
			place.text = tr("Tu récord del mes: %s  ·  Puesto #%d") % [tr_n("%d Emperium", "%d Emperiums", int(data.get("best_checks", 0))) % int(data.get("best_checks", 0)), int(data.get("rank", 0))]
	world.board.submitted.connect(on_done, CONNECT_ONE_SHOT)
	world.board.submit_festival(p.class_id, int(res.get("score", 0)), int(res.get("checks", 0)), look, party, float(res.get("dmg", 0.0)))




func _hero_name(h: Player) -> String:
	if h == world.player:
		return Save.char_name(h.class_id)
	for id in world.net.peers:
		if world.net.peers[id].get("hero") == h:
			return str(world.net.peers[id].get("name", h.job_name()))
	return h.job_name()




