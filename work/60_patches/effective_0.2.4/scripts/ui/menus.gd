	off.text = "✕"
	off.flat = true
	off.focus_mode = Control.FOCUS_NONE
	off.tooltip_text = tr("Quitar de la mesa")
	off.add_theme_color_override("font_color", Color(UiKit.MUTED, 0.7))
	off.add_theme_color_override("font_hover_color", Color(0.75, 0.25, 0.2))
	off.add_theme_font_size_override("font_size", 13)
	off.size_flags_vertical = Control.SIZE_SHRINK_CENTER
