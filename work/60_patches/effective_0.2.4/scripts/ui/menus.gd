func _socket_cell(slot_key: String, index: int, it: Dictionary) -> Control:
	var p: = world.player
	var eq: = p.equipment
	var filled: bool = index < it.cards.size()
	var cid: String = it.cards[index] if filled else ""
	var cell: = PanelContainer.new()
	cell.custom_minimum_size = Vector2(62, 84)
	var st: = StyleBoxFlat.new()
	st.bg_color = Color(0.92, 0.94, 1.0) if filled else Color(0.97, 0.97, 0.99)
	st.border_color = Color(0.4, 0.5, 0.85) if filled else Color(0.72, 0.74, 0.82)
	st.set_border_width_all(2)
	st.set_corner_radius_all(5)
	st.set_content_margin_all(3)
	cell.add_theme_stylebox_override("panel", st)
	cell.mouse_filter = Control.MOUSE_FILTER_STOP
	var fixed: = filled and index < int(it.get("eternal_n", 0))
	if fixed:

		st.border_color = GameData.ETERNAL_COLOR
		st.bg_color = Color(1.0, 0.96, 0.84)
		var eart: = _card_art(cid, Vector2(54, 76))
		cell.add_child(eart)
		UiKit.eternal_shine(eart)
		cell.mouse_entered.connect( func(): _show_card_hover(cid, 1, 0, cell))
		cell.mouse_exited.connect(_hide_item_hover)
		return cell
	if filled:
		var art: = _card_art(cid, Vector2(54, 76))
		cell.add_child(art)
		cell.mouse_entered.connect( func(): _show_card_hover(cid, 1, 0, cell))
		cell.mouse_exited.connect(_hide_item_hover)
		cell.gui_input.connect( func(ev: InputEvent):
			if ev is InputEventMouseButton and ev.pressed and ev.button_index == MOUSE_BUTTON_RIGHT:
				_hide_item_hover()
				eq.unsocket(slot_key, index)
				p.recompute()
				world.play_sound("ui_click", 0.0, -4.0)
				show_equipment(slot_key, tr("%s vuelve a la bolsa de cartas.") % tr(GameData.CARDS[cid].name)))
	else:

		var wings: bool = Equipment.item_def(it).get("wings", false)
		var plus: = _ro_text(tr("solo MVP") if wings else tr("vacío"), 9, Color(0.75, 0.55, 0.2) if wings else Color(0.42, 0.44, 0.52), true)
		plus.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER
		plus.vertical_alignment = VERTICAL_ALIGNMENT_CENTER
		cell.add_child(plus)
	var kind: = Equipment.card_kind(it)
	cell.set_drag_forwarding(
		func(_at: Vector2) -> Variant:
			if not filled:
				return null
			_hide_item_hover()
			cell.set_drag_preview(_drag_preview_card(cid))
			return {"type": "socket", "slot": slot_key, "index": index, "card": cid}, 
		func(_at: Vector2, data: Variant) -> bool:
			return data is Dictionary and data.get("type", "") == "bagcard" and Equipment.card_fits(it, str(data.card)), 
		func(_at: Vector2, data: Variant) -> void :
			var card: String = data.card
			if filled:
				eq.swap_card(card, slot_key, index)
			else:
				eq.socket(card, slot_key)
			p.recompute()
			world.play_sound("equip_item", 0.0, -3.0)
			show_equipment(slot_key, tr("%s insertada.") % tr(GameData.CARDS[card].name)))
	return cell


func _drag_preview_card(id: String) -> Control:
	var r: = _card_art(id, Vector2(44, 60))
	r.size = Vector2(44, 60)
	r.modulate.a = 0.85
	return r




func _item_drop_target(ctrl: Control, slot_key: String, worn: Variant = null) -> void :
	ctrl.set_drag_forwarding(

		func(_at: Vector2) -> Variant:
			if slot_key == "" or worn == null:
				return null
			_hide_item_hover()
			var pv: = UiKit.icon_rect(_item_icon(Equipment.item_def(worn).icon), 32)
			pv.size = Vector2(32, 32)
			pv.modulate.a = 0.85
			ctrl.set_drag_preview(pv)
			return {"type": "equipped", "slot": slot_key}, 
		func(_at: Vector2, data: Variant) -> bool:
			if not data is Dictionary:
				return false

			if data.get("type", "") == "equipped":
				return slot_key.begins_with("acc") and str(data.slot).begins_with("acc") and str(data.slot) != slot_key
			return data.get("type", "") == "item", 
		func(_at: Vector2, data: Variant) -> void :
			if data.get("type", "") == "equipped":
				world.player.equipment.swap_slots(str(data.slot), slot_key)
				world.player.recompute()
				world.play_sound("equip_item", 0.0, -4.0)
				show_equipment(slot_key)
				return
			var key: = slot_key
			var it: Dictionary = world.player.equipment.bag[int(data.index)]
			var left_hand: = key == "shield" and world.player.equipment.offhand_fits(it)
			if key != "" and not left_hand and Equipment.item_type(it) != ("acc" if key.begins_with("acc") else key):
				key = ""
			_inv_equip(int(data.index), key))



func _unequip_drop_target(ctrl: Control) -> void :
	ctrl.set_drag_forwarding(
		func(_at: Vector2) -> Variant: return null, 
		func(_at: Vector2, data: Variant) -> bool:
			return data is Dictionary and data.get("type", "") == "equipped", 
		func(_at: Vector2, data: Variant) -> void :
			_unequip(str(data.slot)))



func _unequip(slot_key: String) -> void :
	var eq: = world.player.equipment
	if slot_key == "weapon":
		show_equipment(slot_key, tr("El arma no se quita: arrastra otra encima para cambiarla."), false)
		return
	if eq.bag.size() >= eq.bag_max:
		show_equipment(slot_key, tr("El inventario está lleno."), false)
		return
	var it = eq.slots.get(slot_key)
	if it == null or not eq.unequip(slot_key):
		return
	_hide_item_hover()
	world.player.recompute()
	world.play_sound("equip_item", 0.0, -6.0)
	show_equipment(slot_key, tr("%s al inventario.") % Equipment.item_name(it))



func _bag_drop_target(ctrl: Control) -> void :
