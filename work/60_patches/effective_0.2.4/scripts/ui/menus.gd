func _album_pill(text: String, on: bool, callback: Callable, gold: = false, font_size: = 11) -> Button:
	var b: = Button.new()
	b.text = text
	b.focus_mode = Control.FOCUS_ALL
	b.mouse_default_cursor_shape = Control.CURSOR_POINTING_HAND
	var fill: = Color(0.86, 0.6, 0.12) if gold else Color(0.3, 0.42, 0.78)
	for st in ["normal", "hover", "pressed", "disabled"]:
		var box: = StyleBoxFlat.new()
		var bg: = fill if on else Color.WHITE
		if st == "hover":
			bg = fill.lightened(0.15) if on else Color(0.9, 0.93, 1.0)
		elif st == "pressed":
			bg = fill.darkened(0.1) if on else Color(0.84, 0.88, 0.98)
		elif st == "disabled":
			bg = Color(0.93, 0.94, 0.96)
		box.bg_color = bg
		box.border_color = fill.darkened(0.2) if on else Color(0.66, 0.72, 0.88)
		box.set_border_width_all(1)
		box.set_corner_radius_all(10)
		box.content_margin_left = 10
		box.content_margin_right = 10
		box.content_margin_top = 2
		box.content_margin_bottom = 3
		b.add_theme_stylebox_override(st, box)
	var focus: = StyleBoxFlat.new()
	focus.draw_center = false
	focus.border_color = Color(0.2, 0.3, 0.65)
	focus.set_border_width_all(1)
	focus.set_corner_radius_all(10)
	b.add_theme_stylebox_override("focus", focus)
	b.add_theme_font_override("font", UiKit.FONT_TITLE if on else UiKit.FONT_BODY)
	b.add_theme_font_size_override("font_size", font_size)
	var ink: = Color.WHITE if on else Color(0.15, 0.2, 0.45)
	for c in ["font_color", "font_hover_color", "font_pressed_color", "font_focus_color"]:
		b.add_theme_color_override(c, ink)
	b.add_theme_color_override("font_disabled_color", Color(0.42, 0.44, 0.5))
	b.pressed.connect(callback)
	return b



func _album_select(items: Array, selected: int, callback: Callable) -> OptionButton:
	var pick: = OptionButton.new()
