func _prep_pick_ids(cid: String) -> Array:
	var all: = []
	for sec in RunPrefs.sections(cid):
		for key in sec[1]:
			all.append(str(key).get_slice(":", 1))

	var bans: = {}
	for key in Player.saved_bans(cid):
		bans[str(key).get_slice(":", 1)] = true
	all = all.filter( func(id): return not bans.has(id))
	var saved: Array = _class_setting("pick_order", cid, [])
	var first: = saved.filter( func(id): return all.has(id))
	return first + all.filter( func(id): return not first.has(id))





static func _pick_order_merge(old: Array, shown: Array) -> Array:
	var out: = shown.duplicate()
	for i in old.size():
		var id = old[i]
		if out.has(id):
			continue
		var at: = 0
		for j in range(i - 1, -1, -1):
			var k: = out.find(old[j])
			if k >= 0:
				at = k + 1
				break
		out.insert(at, id)
	return out













const PICK_LIMITS: = [0, 1, 5, 10, 20, 30, 40, 50, 75, 100, 150, 200, 300]

const PICK_BAN_W: = 56.0


func _pick_limit_names() -> Array:
	return PICK_LIMITS.map( func(n: int): return tr("Hasta Nv %d") % n if n > 0 else tr("Sin tope"))







func _refill_pick_order(list, fill: Array) -> void :
	if is_instance_valid(list):
		(fill[0] as Callable).call()







func _pick_limit_select(current: int, on_set: Callable) -> Control:
	if bool(Save.setting("pick_limit_typed", false)):
		return _pick_limit_field(current, on_set)
	var opts: = PICK_LIMITS.duplicate()
	if current > 0 and not opts.has(current):
		opts.append(current)
		opts.sort()
	var names: = opts.map( func(n: int): return tr("Hasta Nv %d") % n if n > 0 else tr("Sin tope"))
	var pick: = _album_select(names, maxi(0, opts.find(current)), func(_i: int): pass)
	pick.add_user_signal("level_set")
	pick.item_selected.connect( func(i: int):
		on_set.call(int(opts[i]))
		pick.emit_signal("level_set"))
	return pick




func _pick_limit_field(current: int, on_set: Callable) -> LineEdit:
	var e: = LineEdit.new()
	e.add_user_signal("level_set")
	e.placeholder_text = tr("Sin tope")
	e.text = str(current) if current > 0 else ""
	e.max_length = 3
	e.alignment = HORIZONTAL_ALIGNMENT_CENTER
	e.virtual_keyboard_type = LineEdit.KEYBOARD_TYPE_NUMBER
	e.select_all_on_focus = true
	e.add_theme_font_override("font", UiKit.FONT_BODY)
	e.add_theme_font_size_override("font_size", 12)
	e.add_theme_color_override("font_color", Color(0.15, 0.2, 0.45))
	e.add_theme_color_override("caret_color", Color(0.15, 0.2, 0.45))
	e.add_theme_color_override("font_placeholder_color", Color(0.15, 0.2, 0.45, 0.45))
	for st in ["normal", "focus", "read_only"]:
		var sb: = StyleBoxFlat.new()
		sb.bg_color = Color.WHITE
		sb.border_color = Color(0.3, 0.42, 0.78) if st == "focus" else Color(0.66, 0.72, 0.88)
		sb.set_border_width_all(2 if st == "focus" else 1)
		sb.set_corner_radius_all(10)
		sb.content_margin_left = 8
		sb.content_margin_right = 8
		e.add_theme_stylebox_override(st, sb)
	var last: = [e.text]
	e.text_changed.connect( func(t: String):
		var d: = ""
		for ch in t:
			if ch >= "0" and ch <= "9":
				d += ch
		if d != t:
			var at: = e.caret_column
			e.text = d
			e.caret_column = mini(at, d.length()))
	var apply: = func():
		var t: = e.text.strip_edges()
		if t == last[0]:
			return
		var n: = clampi(int(t), 0, 999) if t != "" else 0
		e.text = str(n) if n > 0 else ""
		last[0] = e.text
		on_set.call(n)
		e.emit_signal("level_set")
	e.text_submitted.connect( func(_t: String):
		apply.call()
		e.release_focus())
	e.focus_exited.connect(apply)
	return e




func _set_pick_limit(ids: Array, lim: int, cid: String) -> void :
	var all: Dictionary = (Save.setting("pick_limits", {}) as Dictionary).duplicate(true)
	var mine: Dictionary = (all.get(cid, {}) as Dictionary).duplicate() if all.get(cid) is Dictionary else {}
	for id in ids:
		if lim <= 0:
			mine.erase(id)
		else:
			mine[id] = lim
	all[cid] = mine
	Save.set_setting("pick_limits", all)



