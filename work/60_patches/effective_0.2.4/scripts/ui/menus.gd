func _job_portrait(body: String, weapon: String, title: String, look: Dictionary = {}, headgear: = "", extras: Array = [], 
		min_h: = 206.0, walking: = false, turning: = false) -> Control:
	var col: = VBoxContainer.new()
	col.add_theme_constant_override("separation", 14 if title != "" else 0)
	var ro: = RoAssets.styled_character(body, weapon, "", [], headgear, look, "", extras)
	var stage: = Control.new()
	stage.custom_minimum_size = Vector2(140, min_h)
	stage.size_flags_horizontal = Control.SIZE_SHRINK_CENTER
	col.add_child(stage)
	var glow: = UiKit.glow(Color(0.5, 0.6, 0.95, 0.35), 140)
	stage.add_child(glow)
	stage.resized.connect( func(): glow.position.x = (stage.size.x - 140.0) * 0.5)
	if ro != null:
		var frame: = ro.get_frame(RoVisual.PC_READY * RoSprite.DIRS, 0)
		var tex: = UiKit.icon_rect(frame, 0)
		if walking:

			var walk: = RoVisual.PC_WALK * RoSprite.DIRS
			tex.texture = ro.get_frame(walk, 0)


			var step: = [0, 0]
			var timer: = Timer.new()
			timer.wait_time = maxf(0.05, ro.frame_delay(walk))
			timer.autostart = true
			timer.timeout.connect( func():
				step[0] = (step[0] + 1) % maxi(1, ro.frame_count(walk) * (2 if turning else 1))
				if turning and step[0] == 0:
					step[1] = (step[1] + 1) % RoSprite.DIRS
				if is_instance_valid(tex):
					tex.texture = ro.get_frame(walk + step[1], step[0] %maxi(1, ro.frame_count(walk))))
			tex.add_child(timer)
		tex.custom_minimum_size = Vector2(ro.canvas_size) * 2.0
		tex.size = tex.custom_minimum_size
		tex.position = Vector2(70, 172) - Vector2(ro.origin) * 2.0



		var used: = ro.compose_image(RoVisual.PC_READY * RoSprite.DIRS, 0).get_used_rect() if frame != null else Rect2i()



		if walking and used.has_area():
			var walk_a: = RoVisual.PC_WALK * RoSprite.DIRS
			for f in ro.frame_count(walk_a):
				var im: = ro.compose_image(walk_a, f)
				if im != null and im.get_used_rect().has_area():
					used = used.merge(im.get_used_rect())
		if used.has_area():
			var top: = tex.position.y + used.position.y * 2.0
			var bottom: = tex.position.y + used.end.y * 2.0
			var shift: = maxf(0.0, - top)
			tex.position.y += shift
			stage.custom_minimum_size.y = maxf(min_h, bottom + shift + 6.0)



			var body_used: = used
			if true:
				var bare: = RoAssets.styled_character(body, "", "", [], "", look, "", [])
				var bf: = bare.compose_image(RoVisual.PC_READY * RoSprite.DIRS, 0) if bare != null else null
				if bf != null and bf.get_used_rect().has_area():
					body_used = bf.get_used_rect()

					body_used.position += ro.origin - bare.origin
			var mid: = (body_used.position.x + body_used.size.x * 0.5) * 2.0
			var reach: = maxf(mid - used.position.x * 2.0, used.end.x * 2.0 - mid)
			var wide: = maxf(140.0, reach * 2.0 + 16.0)
			stage.custom_minimum_size.x = wide
			tex.position.x = roundf(wide * 0.5 - mid)
		stage.add_child(tex)
	if title != "":
		var l: = UiKit.label(title, 18, UiKit.TEXT, true)
		l.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER
		col.add_child(l)
	return col




