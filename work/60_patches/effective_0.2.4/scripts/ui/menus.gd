	left.custom_minimum_size.x = 262
	cols.add_child(left)
	left.add_child(_ro_text(tr("Almacén Kafra  %d / %d") % [store.size(), Save.storage_cap()], 12, Color(0.12, 0.25, 0.75), true))
	left.add_child(_store_tabs( func(): show_socket()))
	var grid: = GridContainer.new()
	grid.columns = 6
	grid.add_theme_constant_override("h_separation", 3)
	grid.add_theme_constant_override("v_separation", 3)
	left.add_child(_store_scroll(grid, 6))
	for s_it in _store_shown():
		var uid: = str(s_it.uid)
		var cell: = Button.new()
		cell.custom_minimum_size = Vector2(40, 40)
		cell.focus_mode = Control.FOCUS_NONE
		var sel: = uid == _socket_uid
		var box: = _cell_box(Equipment.item_color(s_it), sel, 3 if sel else 1)
		for sn in ["normal", "hover", "pressed"]:
			cell.add_theme_stylebox_override(sn, box)
		var center: = CenterContainer.new()
		center.set_anchors_and_offsets_preset(Control.PRESET_FULL_RECT)
		center.mouse_filter = Control.MOUSE_FILTER_IGNORE
		cell.add_child(center)
		var icon: = UiKit.icon_rect(_item_icon(Equipment.item_def(s_it).icon), 30)

		if Equipment.socket_room(s_it) <= 0:
			icon.modulate = Color(1, 1, 1, 0.4)
		center.add_child(icon)
		if Equipment.sockets(s_it) > 0:
			var tag: = _ro_text("[%d]" % Equipment.sockets(s_it), 9, Color.WHITE, true)
			tag.add_theme_color_override("font_outline_color", Color.BLACK)
			tag.add_theme_constant_override("outline_size", 3)
			tag.mouse_filter = Control.MOUSE_FILTER_IGNORE
			cell.add_child(tag)
		_owner_star(cell, uid)
		_set_hover(cell, _item_hover(s_it, _owner_feet(uid)))
		cell.pressed.connect( func():
			_socket_uid = uid
			_eternal_sel = -1
			show_socket())
		grid.add_child(cell)
	for i in maxi(0, 18 - store.size()):
		var empty: = Panel.new()
		empty.custom_minimum_size = Vector2(40, 40)
		empty.add_theme_stylebox_override("panel", _cell_box(Color(0.84, 0.86, 0.92), false, 1))
		empty.modulate.a = 0.7
		grid.add_child(empty)

	var right: = VBoxContainer.new()
	right.add_theme_constant_override("separation", 6)
	right.custom_minimum_size = Vector2(400, 250)
	cols.add_child(right)
	if it.is_empty():
		right.add_child(_socket_empty(store.is_empty()))
	else:
		var top: = HBoxContainer.new()
		top.add_theme_constant_override("separation", 12)
		right.add_child(top)
		top.add_child(_anvil_slot(_item_icon(Equipment.item_def(it).icon), Equipment.item_color(it)))
		var info: = VBoxContainer.new()
		info.add_theme_constant_override("separation", 4)
		info.size_flags_vertical = Control.SIZE_SHRINK_CENTER
		top.add_child(info)
		info.add_child(_ro_text(Equipment.item_name(it), 14, Equipment.item_color(it), true))
		info.add_child(_owner_line(str(it.uid)))
		var have: = Equipment.sockets(it)
		var room: = Equipment.socket_room(it)
		info.add_child(_ro_text(tr("Huecos para cartas: %d") % have, 11, Color(0.15, 0.3, 0.6), true))
		info.add_child(_socket_pips(have, room > 0))
		var rule: = tr("Legendaria: hasta %d huecos.") % GameData.SOCKET_MAX_LEGENDARY if Equipment.is_legendary(it)\
		else tr("Hasta %d hueco extra por objeto.") % GameData.SOCKET_MAX_EXTRA
		info.add_child(_ro_text(rule, 10, Color(0.28, 0.3, 0.4)))
		right.add_child(_eternal_bench(it))
		if room <= 0:
			var done: = _ro_text(tr("Este objeto ya no admite más huecos."), 12, Color(0.6, 0.45, 0.1), true)
			done.custom_minimum_size.x = 380
			right.add_child(done)
		else:
			var price: = Equipment.socket_price(it)
			var zeny: = int(price[0])
			var mat: = str(price[1])
			var need: = int(price[2])
			var got: = Save.material(mat) if need > 0 else 0
			var chance: = Equipment.socket_chance(it)
			var crow: = HBoxContainer.new()
			crow.add_theme_constant_override("separation", 14)
			right.add_child(crow)
			crow.add_child(_ro_text("[%d]  →  [%d]" % [have, have + 1], 16, Color(0.12, 0.25, 0.75), true))
			crow.add_child(_ro_text(tr("%d%% de éxito") % roundi(chance * 100.0), 16, 
				Color(0.15, 0.55, 0.2) if chance >= 0.5 else (Color(0.75, 0.5, 0.05) if chance >= 0.25 else Color(0.75, 0.2, 0.15)), true))
			crow.add_child(_ro_text(tr("Costo: %s z") % RoBasicWindow._thousands(zeny), 12, 
				Color(0.6, 0.15, 0.15) if Save.zeny() < zeny else Color.BLACK, true))
			if need > 0:
				var md: Dictionary = GameData.MATERIALS[mat]
				var mrow: = HBoxContainer.new()
				mrow.add_theme_constant_override("separation", 6)
				right.add_child(mrow)
				var mic: = UiKit.icon_rect(_item_icon(str(md.icon)), 24)
				mic.size_flags_vertical = Control.SIZE_SHRINK_CENTER
				mrow.add_child(mic)
				var ml: = _ro_text(tr("%s  x%d  (tienes %d)") % [tr(str(md.name)), need, got], 11, 
					Color.BLACK if got >= need else Color(0.7, 0.15, 0.15), true)
				ml.size_flags_vertical = Control.SIZE_SHRINK_CENTER
				mrow.add_child(ml)
				if got < need:
					var hint: = _ro_text(tr("Los Enriched los sueltan a veces los jefes y los MVP."), 10, Color(0.28, 0.3, 0.4))
					hint.autowrap_mode = TextServer.AUTOWRAP_WORD_SMART
					hint.custom_minimum_size.x = 380
					right.add_child(hint)
			var note: = _ro_text(tr("Si falla se pierde el pago, pero el objeto no se rompe. El hueco se queda para siempre; las cartas se ponen en cada partida."), 10, Color(0.15, 0.5, 0.2))
			note.autowrap_mode = TextServer.AUTOWRAP_WORD_SMART
			note.custom_minimum_size.x = 380
			right.add_child(note)
			var go: = _ro_button(tr("Abrir hueco"), _do_socket, (need <= 0 or got >= need) and Save.zeny() >= zeny)
			go.custom_minimum_size = Vector2(160, 30)
			right.add_child(go)



	var spring: = Control.new()
	spring.size_flags_vertical = Control.SIZE_EXPAND_FILL
	right.add_child(spring)
	var outs: = HBoxContainer.new()
	outs.alignment = BoxContainer.ALIGNMENT_END
	outs.add_theme_constant_override("separation", 6)
	right.add_child(outs)
	var here: = _eternal_out_cost([it] if not it.is_empty() else [])
	if int(here[1]) >= 2:
		var b1: = _ro_button(tr("Quitar sus %d cartas  ·  %s z") % [int(here[1]), RoBasicWindow._thousands(int(here[2]))], func():
			_confirm_eternal_out([it]), Save.zeny() >= int(here[2]))
		b1.add_theme_font_size_override("font_size", 10)
		b1.tooltip_text = tr("Quita todas las Cartas Eternas de esta pieza: vuelven libres a tu colección.")
		outs.add_child(b1)
	var listed: = _eternal_out_cost(_store_shown())
	if int(listed[0]) >= 2:
		var b2: = _ro_button(tr("Quitar todas las de la lista (%d)  ·  %s z") % [int(listed[1]), RoBasicWindow._thousands(int(listed[2]))], func():
			_confirm_eternal_out(_store_shown()), Save.zeny() >= int(listed[2]))
		b2.add_theme_font_size_override("font_size", 10)
		b2.tooltip_text = tr("Quita las Cartas Eternas de todas las piezas que muestra la lista de la izquierda (usa los filtros para elegir cuáles). Vuelven libres a tu colección.")
		outs.add_child(b2)

	var bar: = PanelContainer.new()
	var bar_box: = StyleBoxFlat.new()
	bar_box.bg_color = Color(0.94, 0.95, 0.99)
	bar_box.border_color = Color(0.72, 0.76, 0.88)
	bar_box.set_border_width_all(1)
	bar_box.set_corner_radius_all(5)
	bar_box.set_content_margin_all(6)
	bar.add_theme_stylebox_override("panel", bar_box)
	body.add_child(bar)
	var shop: = HBoxContainer.new()
	shop.add_theme_constant_override("separation", 6)
