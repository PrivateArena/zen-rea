static func _pct2(x: float) -> String:
	return str(snappedf(x * 100.0, 0.001)).replace(".", ",") if TranslationServer.get_locale().begins_with("es")\
	else str(snappedf(x * 100.0, 0.001))




func _hel_gift(f: int, prize: Dictionary, got: bool) -> Control:
	var col: = Color(0.62, 0.1, 0.2)
	var p: = PanelContainer.new()
	p.custom_minimum_size = Vector2(52, 0)
	var pb: = UiKit.panel_box(col.lerp(Color.WHITE, 0.85) if got else Color(0.97, 0.95, 0.96), col if got else Color(0.82, 0.78, 0.8), 6, 2 if got else 1)
	pb.set_content_margin_all(3)
	p.add_theme_stylebox_override("panel", pb)
	var v: = VBoxContainer.new()
	v.add_theme_constant_override("separation", 0)
	p.add_child(v)
	var head: = UiKit.label(("✓" if got else "") + str(f), 11, col if got else UiKit.MUTED, true)
	head.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER
	v.add_child(head)
	var row: = VBoxContainer.new()
	row.alignment = BoxContainer.ALIGNMENT_CENTER
	row.add_theme_constant_override("separation", 0)
	v.add_child(row)
	var icon: = ""
	var text: = ""
	var tip: = ""
	if prize.has("title"):
		icon = "hel_tear"
		text = tr("Título")
		tip = tr("El título «%s» y %d Lágrimas de Hel") % [tr(str(GameData.TITLES[str(prize.title)].name)), int(prize.get("tears", 0))]
	elif prize.has("cosmetic"):
		icon = "santa_hat"
		text = "x1"
		tip = tr("Un cosmético que no tengas (si ya los tienes todos, %d Lágrimas de Hel)") % GameData.HEL_TOWER_COSMETIC_TEARS
	elif prize.has("tears"):
		icon = "hel_tear"
		text = "x%d" % int(prize.tears)
		tip = tr("Lágrima de Hel: en Altair, una línea Legendaria semi perfecta pasa a perfecta")
	elif prize.has("coins"):
		icon = "poring_coin"
		text = "x%d" % int(prize.coins)
		tip = tr("%d Poring Coins") % int(prize.coins)
	elif prize.has("crumbs"):
		icon = "star_crumb"
		text = "x%d" % int(prize.crumbs)
		tip = tr("%d Star Crumbs") % int(prize.crumbs)
	var ic: = UiKit.icon_rect(_item_icon(icon), 22)
	ic.mouse_filter = Control.MOUSE_FILTER_PASS
	ic.size_flags_horizontal = Control.SIZE_SHRINK_CENTER
	if not got:
		ic.modulate = Color(1, 1, 1, 0.6)
	row.add_child(ic)
	var tl: = UiKit.label(text, 11, UiKit.TEXT if got else UiKit.MUTED, true)
	tl.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER
	row.add_child(tl)
	p.tooltip_text = (tr("Piso %d") % f) + "\n" + tip
	return p




func _hel_oaths() -> void :
	var win = (load("res://scripts/ui/oath_window.gd") as GDScript).new()
	win.world = world
	win.tower = true
	win.closed.connect( func():
		if _mode == "tower":
			show_tower())
	_root.add_child(win)




func _tower_banner(top: int) -> Control:
	var frame: = PanelContainer.new()
