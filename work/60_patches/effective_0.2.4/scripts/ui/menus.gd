func show_closet(class_id: String, tab: = "ropa") -> void :
	_closet_cid = class_id
	if _mode == "town":
		_mode = "wardrobe"

	_npc_scroll.erase("wardrobe")
	match tab:
		"auras":
			_show_auras(class_id)
		"name":
