	var purples: = Save.storage().filter(Equipment.can_trait)
	var bare: = purples.filter( func(it): return Equipment.trait_of(it).is_empty()).size()
	var sub: = tr("Pide una pieza con ranuras") if purples.is_empty() else (tr("Piezas: %d en tu almacén, %d sin rasgo") % [purples.size(), bare] if bare > 0 else tr("Piezas: %d en tu almacén") % purples.size())
