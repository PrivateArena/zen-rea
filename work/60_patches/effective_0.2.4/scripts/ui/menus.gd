	picks.add_theme_constant_override("separation", 18)
	col.add_child(picks)
	var checks: = [[tr("Elegir al azar"), "endless_auto_pick"], [tr("Acumular mejoras"), "hold_levels"]]

	if not world.is_coop():
		checks.append([tr("Acumular cofres"), "hold_chests"])
	for c in checks:
		var cb: = CheckBox.new()
		cb.text = str(c[0])
		cb.focus_mode = Control.FOCUS_NONE
		cb.add_theme_font_override("font", UiKit.FONT_BODY)
		cb.add_theme_font_size_override("font_size", 13)
		for st in ["font_color", "font_hover_color", "font_pressed_color", "font_hover_pressed_color"]:
			cb.add_theme_color_override(st, UiKit.TEXT)
		var key: String = c[1]
		cb.button_pressed = bool(Save.setting(key, false))
		cb.toggled.connect( func(on: bool): Save.set_setting(key, on))
		if key != "endless_auto_pick":
			picks.add_child(cb)
			continue


		var random_row: = HBoxContainer.new()
		random_row.add_theme_constant_override("separation", 2)
		random_row.add_child(cb)
		var gear: = TextureButton.new()
		gear.texture_normal = load("res://assets/brand/gear.png")
		gear.ignore_texture_size = true
		gear.stretch_mode = TextureButton.STRETCH_KEEP_ASPECT_CENTERED
		gear.custom_minimum_size = Vector2(17, 17)
		gear.size_flags_vertical = Control.SIZE_SHRINK_CENTER
		gear.focus_mode = Control.FOCUS_NONE
		gear.tooltip_text = tr("Prioridad de mejoras")
		gear.pressed.connect(show_pick_order)
		gear.mouse_entered.connect( func(): gear.modulate = Color(0.7, 0.8, 1.0))
		gear.mouse_exited.connect( func(): gear.modulate = Color.WHITE)
		random_row.add_child(gear)

		random_row.add_child(RunPrefs.pause_button(self))
		picks.add_child(random_row)
	var resume: = UiKit.button(tr("Continuar"), true)
	resume.pressed.connect(_resume)
	col.add_child(resume)


	var row_a: = _pause_row(col)
	var controls: = UiKit.button(tr("Controles"))
	controls.pressed.connect( func(): show_options("controls"))
	row_a.add_child(controls)
	var evo: = UiKit.button(tr("Habilidades"))
	evo.pressed.connect(show_compendium)
	row_a.add_child(evo)
	var guide: = UiKit.button(tr("Guía"))
	guide.tooltip_text = tr("Qué significa cada cosa: tipos de daño, atributos, crítico, defensa, estados...")
	guide.pressed.connect( func(): show_guide(show_pause))
	row_a.add_child(guide)
	var options: = UiKit.button(tr("Opciones  (O)"))
	options.pressed.connect(show_options)
	row_a.add_child(options)
	var row_b: = _pause_row(col)
	var news: = UiKit.button(tr("Novedades"))
	news.pressed.connect( func(): show_patch_notes(show_pause))
	row_b.add_child(news)
	_notes_badge(news)
	var report: = UiKit.button(tr("Reportar  (F8)"))
	report.tooltip_text = tr("Cuéntanos un bug o una idea: se envía con lo que pasaba en la partida.")
	report.pressed.connect( func(): show_feedback(_pause_shot))
	row_b.add_child(report)
	if world.endless and leader:


		var hel: bool = world.tower != null and world.tower.hel != null
		var finish: = UiKit.button(tr("Terminar la Torre de Hel") if hel else (tr("Terminar la subida") if world.tower != null else tr("Terminar (victoria)")))
		if hel:



			finish.tooltip_text = tr("La Torre de Hel no tiene puntos de control: la próxima vez empiezas en el piso 1. Tu piso más alto queda en el ranking; la build no vuelve.")
		elif world.tower != null:
			finish.tooltip_text = tr("Tus pisos quedan guardados; la build no vuelve (se gastó al entrar a la torre).")
		finish.pressed.connect( func():
			if hel and not finish.has_meta("hel_sure"):
				finish.set_meta("hel_sure", true)
				finish.text = tr("¿Seguro? Vuelves al piso 1")
				finish.add_theme_color_override("font_color", Color(0.85, 0.25, 0.2))
				ui_click()
				return
			if not _party_sure(finish):
				return
			get_tree().paused = false
			world._end_run(true))
		row_b.add_child(finish)
	var quit: = UiKit.button(tr("Volver a Prontera") if world.training else (tr("Abandonar partida") if leader else tr("Salir de la partida")))
	if not leader:
		quit.tooltip_text = tr("Te vas sin perder nada: guardas lo ganado y tu héroe sigue con el bot.")
	quit.pressed.connect( func():


		if world.endless and leader and not world.training and not quit.has_meta("leave_sure"):
			quit.set_meta("leave_sure", true)
			quit.text = tr("¿Seguro? Pierdes la victoria")
			quit.tooltip_text = tr("Abandonar no cuenta como victoria: usa «Terminar (victoria)» para quedarte con el informe y el objeto. Pulsa otra vez para abandonar igual.")
			quit.add_theme_color_override("font_color", Color(0.85, 0.25, 0.2))
			ui_click()
			return
		if world.net.is_host() and not _party_sure(quit):
			return
		get_tree().paused = false
		if world.training:
			close()
			world.leave_training()
			return
		if world.net.is_client():

			world.abandon_run()
			close()
			return
		world.abandon_run()
		show_class_select())
	row_b.add_child(quit)
	for row: HBoxContainer in [row_a, row_b]:
		for b: Control in row.get_children():
			b.size_flags_horizontal = Control.SIZE_EXPAND_FILL
	resume.grab_focus.call_deferred()




func _party_sure(b: Button) -> bool:
	if not world.net.is_host() or world.net._run_peers().is_empty() or b.has_meta("sure"):
		return true
	b.set_meta("sure", true)
	b.text = tr("¿Seguro? Termina para toda la party")
	b.add_theme_color_override("font_color", Color(0.85, 0.25, 0.2))
	ui_click()
	return false


