static var _grey_shader: Shader





func _title_row(id: String, now: String, touch: bool, refill: Callable) -> Control:
	var t: Node = world.titles
	var d: Dictionary = GameData.TITLES[id]
	var got: bool = t.has(id)
	var col: Color = d.color
	var b: = Button.new()
	b.focus_mode = Control.FOCUS_ALL if got else Control.FOCUS_NONE
	b.disabled = not got
	b.custom_minimum_size.y = 60 if touch else 52
	var st: = StyleBoxFlat.new()
	st.bg_color = Color(0.97, 0.97, 1.0) if got else Color(0.93, 0.93, 0.95)
	st.border_color = col.darkened(0.2) if id == now else Color(0.82, 0.84, 0.9)
	st.set_border_width_all(2 if id == now else 1)
	st.set_corner_radius_all(6)
	if id == now:
		st.bg_color = Color.WHITE.lerp(col, 0.08)
	var hover: = st.duplicate() as StyleBoxFlat
	hover.bg_color = Color.WHITE
	hover.border_color = col.darkened(0.2)
	b.add_theme_stylebox_override("normal", st)
	b.add_theme_stylebox_override("disabled", st)
	b.add_theme_stylebox_override("hover", hover if got else st)
	b.add_theme_stylebox_override("pressed", hover)
	b.add_theme_stylebox_override("focus", hover)
	var h: = HBoxContainer.new()
	h.set_anchors_and_offsets_preset(Control.PRESET_FULL_RECT)
	h.offset_left = 8
	h.offset_right = -8
	h.add_theme_constant_override("separation", 10)
	h.mouse_filter = Control.MOUSE_FILTER_IGNORE
	b.add_child(h)

	var badge: = HBoxContainer.new()
	badge.custom_minimum_size.x = 200
	badge.add_theme_constant_override("separation", 4)
	badge.mouse_filter = Control.MOUSE_FILTER_IGNORE
	badge.size_flags_vertical = Control.SIZE_SHRINK_CENTER
	h.add_child(badge)
	if not got:
		badge.add_child(_title_lock())

	var secret: bool = bool(d.get("hidden", false)) and not got
	var c: Control = t.chip(id, 11) if not secret else _ro_text("???", 13, Color(0.28, 0.3, 0.4), true)
	c.size_flags_vertical = Control.SIZE_SHRINK_CENTER
	if not got and not secret:
		if _grey_shader == null:
			_grey_shader = Shader.new()
			_grey_shader.code = "shader_type canvas_item;\nvoid fragment() {\n\tvec4 c = COLOR;\n\tfloat g = dot(c.rgb, vec3(0.3, 0.59, 0.11));\n\tCOLOR = vec4(vec3(0.08 + g * 0.92), c.a * 0.9);\n}"
		var mat: = ShaderMaterial.new()
		mat.shader = _grey_shader
		c.material = mat
	badge.add_child(c)
	var desc: = _ro_text(tr("Título secreto: descúbrelo jugando.") if secret else tr(str(d.desc)), 11 if touch else 10, 
		Color(0.25, 0.27, 0.38) if got else Color(0.48, 0.5, 0.56))
	desc.autowrap_mode = TextServer.AUTOWRAP_WORD_SMART
	desc.size_flags_horizontal = Control.SIZE_EXPAND_FILL
	desc.size_flags_vertical = Control.SIZE_SHRINK_CENTER
