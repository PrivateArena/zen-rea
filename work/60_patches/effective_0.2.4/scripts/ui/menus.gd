func _place_item_card(card, from, tries: = 0, checks: = 3) -> void :
	if not is_instance_valid(card) or not is_instance_valid(from):
		return
	var panel: = card as Control
	var anchor: = from as Control
	var view: = get_viewport().get_visible_rect().size
	var sz: = panel.size
	if sz.y > view.y - 8.0:
		if tries < 3 and sz.x * 1.35 <= view.x * 0.9:
			for l in panel.find_children("*", "Label", true, false):
				var lab: = l as Label
				if lab.autowrap_mode != TextServer.AUTOWRAP_OFF and lab.custom_minimum_size.x > 0.0:
					lab.custom_minimum_size.x = roundf(lab.custom_minimum_size.x * 1.35)
			panel.reset_size()
			panel.modulate.a = 0.0
			await get_tree().process_frame
			_place_item_card(card, from, tries + 1, checks)
			return
		panel.scale = Vector2.ONE * ((view.y - 8.0) / sz.y)
	panel.modulate.a = 1.0
	var shown: = sz * panel.scale
	var r: = anchor.get_global_rect()
	var at: = Vector2(r.end.x + 6, r.position.y)
	if at.x + shown.x > view.x - 4:
		at.x = r.position.x - shown.x - 6
	at.x = maxf(4.0, at.x)
	at.y = maxf(4.0, minf(at.y, view.y - shown.y - 4))
	panel.global_position = at


	if checks > 0:
		await get_tree().process_frame
		_place_item_card(card, from, tries, checks - 1)




