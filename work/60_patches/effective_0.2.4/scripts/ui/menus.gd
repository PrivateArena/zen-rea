func _ore_chance(base: float, kind: String) -> float:
	match kind:
		"enriched":
			return minf(1.0, base + (1.0 - base) * GameData.ENRICHED_BONUS)
		"hd":
			return minf(1.0, base + (1.0 - base) * GameData.HD_BONUS)
	return base







func _auto_refine_mat(it: Dictionary) -> Array:
	var kind_for: = "weapon" if Equipment.item_type(it) == "weapon" else "armor"
	var rich: = int(it.get("refine", 0)) >= GameData.REFINE_RICH_FROM
	var order: Array = []
	for k in ["normal", "enriched", "hd"]:
		if rich and k == "normal":
			continue
		for m in GameData.MATERIALS:
			if str(GameData.MATERIALS[m]["for"]) == kind_for and str(GameData.MATERIALS[m].kind) == k:
				order.append(m)
	if order.is_empty():
		return ["", ""]
	var base: = Equipment.refine_chance(it)
	var ideal: = order.size() - 1
	for i in order.size():
		if _ore_chance(base, str(GameData.MATERIALS[order[i]].kind)) > GameData.REFINE_AUTO_MIN:
			ideal = i
			break
	for i in range(ideal, order.size()):
		if Save.material(order[i]) > 0:
			return [order[i], order[ideal]]
	for i in range(ideal - 1, -1, -1):
		if Save.material(order[i]) > 0:
			return [order[i], order[ideal]]
	return ["", order[ideal]]



func _refine_guarded(it: Dictionary) -> bool:
	return bool(Save.setting("refine_protect", false)) and int(it.get("refine", 0)) >= Equipment.refine_safe(it) and not _never_breaks(it)




static func _never_breaks(it: Dictionary) -> bool:
	return bool(Equipment.item_def(it).get("fixed", false))



func _refine_fee(it: Dictionary) -> int:
	var fee: = float(GameData.REFINE_FEE[Equipment._rate_key(it)]) * Equipment.fee_mult(it) * GameData.REFINE_FEE_MULT
	fee *= pow(GameData.REFINE_FEE_GROWTH, int(it.get("refine", 0)))
	if _refine_guarded(it):
		fee *= GameData.REFINE_PROTECT_MULT
	return int(fee)


func _do_refine() -> void :
	var it: = Save.storage_item(_refine_uid)

	if not it.is_empty() and bool(Save.setting("refine_auto", false)):
		_refine_mat = str(_auto_refine_mat(it)[0])
	if it.is_empty() or _refine_mat == "":
		return
	if int(it.get("refine", 0)) >= GameData.REFINE_RICH_FROM and str(GameData.MATERIALS[_refine_mat].kind) == "normal":
		return
	_refine_confirm = ""
	var guarded: = _refine_guarded(it)
	var fee: = _refine_fee(it)
	if not Save.spend(fee) or not Save.use_material(_refine_mat):
		return
	var lvl: = int(it.get("refine", 0))
	var base: = Equipment.refine_chance(it)
	var mkind: = str(GameData.MATERIALS[_refine_mat].kind)
	var chance: = _ore_chance(base, mkind)
	var ok: = randf() < chance
	var item_label: = Equipment.item_name(it)
	world.play_sound("refine_hammer", 0.0, -4.0)
	var msg: = ""
	var broke: = false
	if ok:
		it["refine"] = lvl + 1
		Save.stat_max("storage_refine", lvl + 1)
		msg = tr("¡Éxito! %s") % Equipment.item_name(it)


		if lvl + 1 >= GameData.MAX_REFINE and not Equipment.is_locked(it):
			it["lock"] = true
			msg += "  " + tr("Se bloqueó solo: no se venderá por error.")

		if lvl + 1 >= GameData.MAX_REFINE and world != null:
			world.channel.feat("refine", str(it.id), lvl + 1)
	elif guarded or _never_breaks(it):
		it["refine"] = maxi(0, lvl - 1)
		msg = tr("Falló... %s bajó a +%d.") % [tr(str(Equipment.item_def(it).name)), int(it.refine)]
	else:
		broke = true
		Save.bump("broken")
		msg = tr("¡%s se rompió!") % item_label
		Save.remove_from_storage(_refine_uid)
		_refine_uid = ""
	Save.mark_dirty()
	Save.flush()
	get_tree().create_timer(0.45, true).timeout.connect( func():
		world.play_sound(("refine_ok" if RoAssets.sound("refine_ok") != null else "levelup") if ok
			else ("refine_fail" if RoAssets.sound("refine_fail") != null else "cold_hit1"), 0.0, -2.0))
	show_refiner(msg, ok, Equipment.item_def({"id": str(it.id)}).icon if broke else "")
	_refine_anim(ok, broke)
	world.net.town_event("refine", ok)





