func _class_owns(cid: String, id: String) -> bool:
	var d: Dictionary = GameData.CLASSES[cid]
	var all: Array = d.get("skills", []) + d.get("passives", [])
	for path in GameData.job_paths(cid):
		for job in [path, path.get("trans", {})]:
			all += (job as Dictionary).get("skills", []) + (job as Dictionary).get("passives", [])
	return all.has(id)





func _prep_columns(row: HBoxContainer, grid: GridContainer) -> void :
	var cards: Array = grid.get_children()
	var cols: = HBoxContainer.new()
	cols.add_theme_constant_override("separation", 8)
	row.add_child(cols)
	var sides: Array[VBoxContainer] = []
	var heights: = [0.0, 0.0]
	for i in 2:
		var v: = VBoxContainer.new()
		v.add_theme_constant_override("separation", 6)
		cols.add_child(v)
		sides.append(v)
	for c: Control in cards:
		grid.remove_child(c)
		var k: = 0 if heights[0] <= heights[1] else 1
		sides[k].add_child(c)
		heights[k] += c.get_combined_minimum_size().y + 6.0
	grid.queue_free()
	for v in sides:
		if v.get_child_count() > 0:
			(v.get_child(v.get_child_count() - 1) as Control).size_flags_vertical = Control.SIZE_EXPAND_FILL




func _prep_swap_to_big(row: Node, big: String, small: String) -> void :
	var a: Control = null
	var b: Control = null
	for c in row.find_children("*", "PanelContainer", true, false):
		if str(c.get_meta("prep_box", "")) == big:
			a = c
		elif str(c.get_meta("prep_box", "")) == small:
			b = c
	if a == null or b == null:
		return
	var pa: = a.get_parent()
	var pb: = b.get_parent()
	if pa == pb:
		return
	var ia: = a.get_index()
	var ib: = b.get_index()
	var fa: = a.size_flags_vertical
	a.size_flags_vertical = b.size_flags_vertical
	b.size_flags_vertical = fa
	pa.remove_child(a)
	pb.remove_child(b)
	pa.add_child(b)
	pa.move_child(b, ia)
	pb.add_child(a)
	pb.move_child(a, ib)



