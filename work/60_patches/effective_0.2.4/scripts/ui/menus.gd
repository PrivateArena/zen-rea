var _fest_class: = ""




func _festival_records(fr: Dictionary) -> void :
	var body: VBoxContainer = fr.body
	for c in body.get_children():
		c.queue_free()
	var months: = [tr("enero"), tr("febrero"), tr("marzo"), tr("abril"), tr("mayo"), tr("junio"), tr("julio"), 
		tr("agosto"), tr("septiembre"), tr("octubre"), tr("noviembre"), tr("diciembre")]
	var now: = Time.get_datetime_dict_from_system(true)
	(fr.sub as Label).text = ("%s %d" % [months[int(now.month) - 1], int(now.year)]).capitalize()
	var party: = _fest_tab == "party"
	var kind: = HBoxContainer.new()
	kind.add_theme_constant_override("separation", 4)
	body.add_child(kind)
	for k in [["solo", tr("Solo")], ["party", tr("En grupo")]]:
		var b: = UiKit.button(str(k[1]), _fest_tab == str(k[0]))
		b.focus_mode = Control.FOCUS_NONE
		b.size_flags_horizontal = Control.SIZE_EXPAND_FILL
		var tab: String = k[0]
		b.pressed.connect( func():
			if _fest_tab != tab:
				_fest_tab = tab
				ui_click()
				_festival_records(fr))
		kind.add_child(b)


	if _fest_class == "" and world != null and world.town != null and is_instance_valid(world.town) and GameData.CLASSES.has(str(world.town.class_id)):
		_fest_class = str(world.town.class_id)
	if _fest_class != "all" and not GameData.CLASSES.has(_fest_class):
		_fest_class = "all"
	var keys: = ["all"] + GameData.CLASSES.keys()
	var sw: = HBoxContainer.new()
	sw.add_theme_constant_override("separation", 4)
	body.add_child(sw)
	var step: = func(d: int):
		_fest_class = str(keys[posmod(keys.find(_fest_class) + d, keys.size())])
		ui_click()
		_festival_records(fr)
	sw.add_child(_fest_arrow("‹", func(): step.call(-1)))
	var mid: = PanelContainer.new()
	var mb: = StyleBoxFlat.new()
	mb.bg_color = Color(0.94, 0.95, 1.0)
	mb.border_color = Color(0.7, 0.75, 0.9)
	mb.set_border_width_all(1)
	mb.set_corner_radius_all(6)
	mb.content_margin_top = 2
	mb.content_margin_bottom = 2
	mid.add_theme_stylebox_override("panel", mb)
	mid.size_flags_horizontal = Control.SIZE_EXPAND_FILL
	sw.add_child(mid)
	var cl: = UiKit.label(tr("General") if _fest_class == "all" else tr(str(GameData.CLASSES[_fest_class].name)), 13, UiKit.TEXT, true)
	cl.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER
	mid.add_child(cl)
	sw.add_child(_fest_arrow("›", func(): step.call(1)))
	var mine_box: = VBoxContainer.new()
	body.add_child(mine_box)
	var scroll: = ScrollContainer.new()
	scroll.horizontal_scroll_mode = ScrollContainer.SCROLL_MODE_DISABLED
	scroll.size_flags_vertical = Control.SIZE_EXPAND_FILL
	body.add_child(scroll)
	var list: = VBoxContainer.new()
	list.add_theme_constant_override("separation", 4)
	list.size_flags_horizontal = Control.SIZE_EXPAND_FILL
	scroll.add_child(list)
	var foot: = VBoxContainer.new()
	foot.add_theme_constant_override("separation", 3)
	body.add_child(foot)
	var cid: = _fest_class
	var stage: = Leaderboard.FESTIVAL_PARTY_STAGE if party else Leaderboard.FESTIVAL_STAGE
	var key: = cid + "|" + stage
	var show: = func(d: Dictionary):
		if not is_instance_valid(list):
			return

		for box in [list, mine_box, foot]:
			for c in box.get_children():
				c.queue_free()
		if d.is_empty():
			list.add_child(_fest_note("⚠", tr("Sin conexión: los récords no se pueden ver ahora.")))
			return
		mine_box.add_child(_fest_standing(d))
		var top: Array = d.get("top", [])
		if top.is_empty():
			list.add_child(_fest_note("★", tr("Nadie todavía este mes. ¡Sé el primero!")))
		for r in top:
			list.add_child(_fest_row(r, party, cid == "all"))
		var me = d.get("me")
		if me is Dictionary and not top.any( func(r): return bool(r.get("me", false))):
			foot.add_child(UiKit.label(tr("Tu mejor marca"), 10, UiKit.MUTED, true))
			var mine: = (me as Dictionary).duplicate()
			mine["name"] = Save.char_name(str(mine.get("class", cid)) if cid == "all" else cid)
			mine["tag"] = Leaderboard.tag()
			mine["me"] = true
			foot.add_child(_fest_row(mine, party, cid == "all"))
		var n: = UiKit.label(tr_n("%d jugador", "%d jugadores", int(d.get("total", 0))) % int(d.get("total", 0)), 10, UiKit.MUTED)
		n.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER
		foot.add_child(n)
		if is_instance_valid(fr.note):
			(fr.note as Label).text = tr_n("Se reinicia en %d día", "Se reinicia en %d días", int(d.get("days_left", 0))) % int(d.get("days_left", 0))
	var c0: = world.board.cached(cid, stage)
	if not c0.is_empty():
		show.call(c0)
	else:
		list.add_child(_fest_note("↻", tr("Cargando récords...")))
	world.board.board_ready.connect( func(k: String, d: Dictionary):
		if k == key:
			show.call(d), CONNECT_ONE_SHOT)
	world.board.fetch(cid, stage)


