		list.add_child(none)
	for s_it in uniques:
		var uid: = str(s_it.uid)
		var row: = Button.new()
		row.focus_mode = Control.FOCUS_NONE
		row.custom_minimum_size = Vector2(286, 30)
		row.add_theme_stylebox_override("normal", _cell_box(Equipment.item_color(s_it), uid == _soul_pick, 2 if uid == _soul_pick else 1))
		row.add_theme_stylebox_override("hover", _cell_box(Equipment.item_color(s_it), true, 2))
		row.add_theme_stylebox_override("pressed", _cell_box(Equipment.item_color(s_it), true, 2))
		var h: = HBoxContainer.new()
		h.add_theme_constant_override("separation", 6)
		h.mouse_filter = Control.MOUSE_FILTER_IGNORE
		h.position = Vector2(4, 3)
		row.add_child(h)
		var ic: = UiKit.icon_rect(_item_icon(Equipment.item_def(s_it).icon), 24)
		ic.mouse_filter = Control.MOUSE_FILTER_IGNORE
		h.add_child(ic)
		var nl: = _ro_text(Equipment.item_name(s_it), 11, Equipment.item_color(s_it).darkened(0.3), true)
		nl.mouse_filter = Control.MOUSE_FILTER_IGNORE
		h.add_child(nl)
		row.mouse_entered.connect( func(): _show_item_hover(s_it, row, true))
		row.mouse_exited.connect(_hide_item_hover)
		row.pressed.connect( func():
			_soul_pick = uid
			_soul_armed = ""
			ui_click()
			show_souls())
		list.add_child(row)

	var right: = VBoxContainer.new()
	right.add_theme_constant_override("separation", 4)
	right.custom_minimum_size.x = 380
	cols.add_child(right)
	var it: = Save.storage_item(_soul_pick)
	if not it.is_empty():
		var sid: = Souls.soul_id(str(it.id))
		var soul: = {"id": sid, "slots": 0, "extra_slots": 0, "refine": 0, "cards": []}
		var head: = HBoxContainer.new()
		head.add_theme_constant_override("separation", 8)
		right.add_child(head)
		head.add_child(UiKit.icon_rect(_item_icon(Equipment.item_def(it).icon), 32))
		var names: = VBoxContainer.new()
		names.add_theme_constant_override("separation", 0)
		head.add_child(names)
		names.add_child(_ro_text(Equipment.item_name(it), 12, Equipment.item_color(it).darkened(0.3), true))
		names.add_child(_ro_text("→  " + Equipment.item_name(soul), 13, GameData.SOUL_COLOR.darkened(0.35), true))
		for line in [tr("El alma va en su propio hueco del equipo, junto a las alas, y no ocupa un hueco del equipo inicial."), 
				tr("El hueco de alma de cada clase se abre al renacerla (las que no renacen lo tienen desde el principio)."), 
				tr("Da solo el efecto de la única, no los atributos de la pieza. Un solo efecto de única a la vez: la pieza o el alma."), 
				tr("Es para siempre: el alma no vuelve a ser pieza.")]:
			var l: = _ro_text("·  " + line, 11, Color(0.25, 0.27, 0.36))
			l.autowrap_mode = TextServer.AUTOWRAP_WORD_SMART
			l.custom_minimum_size.x = 370
			right.add_child(l)
		right.add_child(_ro_text(tr("Te devuelvo"), 12, Color(0.12, 0.25, 0.75), true))
		var back: = Souls.refund(it)
		var got: = []
		if int(back.zeny) > 0:
			got.append("%s z" % RoBasicWindow._thousands(int(back.zeny)))
		for m in back.mats:
			got.append("%s x%d" % [tr(str(GameData.MATERIALS[m].name)), int(back.mats[m])])
		if int(back.crumbs) > 0:
			got.append("%s x%d" % [tr(str(GameData.MATERIALS.star_crumb.name)), int(back.crumbs)])
		for c in back.eternal:
			got.append(tr("%s (Carta Eterna, libre otra vez)") % tr(str(GameData.CARDS[str(c)].name)) if GameData.CARDS.has(str(c)) else "")
		for c in back.cards:
			got.append(tr("%s (al álbum)") % tr(str(GameData.CARDS[str(c)].name)))
		got = got.filter( func(g): return str(g) != "")
		var gl: = _ro_text(", ".join(got) if not got.is_empty() else tr("Nada: la pieza está como cayó."), 11, Color(0.2, 0.24, 0.36))
		gl.autowrap_mode = TextServer.AUTOWRAP_WORD_SMART
		gl.custom_minimum_size.x = 370
		right.add_child(gl)
		if Potential.tier(it) > 0:
			var pw: = _ro_text(tr("Su Potencial estelar (%s) devuelve %d Star Crumbs fijos, no los que gastaste en él.") % [Potential.tier_name(Potential.tier(it)), int(back.crumbs)], 
				11, Color(0.75, 0.35, 0.1), true)
			pw.autowrap_mode = TextServer.AUTOWRAP_WORD_SMART
			pw.custom_minimum_size.x = 370
			right.add_child(pw)
		var owner: = Save.loadout_owner(str(it.uid))
		if owner != "":
			var ow: = _ro_text(tr("Está en el equipo inicial de %s: el alma toma su lugar ahí.") % tr(str(GameData.CLASSES[owner].name)), 11, Color(0.27, 0.29, 0.37))
			ow.autowrap_mode = TextServer.AUTOWRAP_WORD_SMART
			ow.custom_minimum_size.x = 370
			right.add_child(ow)
		var armed: = _soul_armed == _soul_pick
		var go: = _ro_button(tr("¿Seguro? Clic otra vez") if armed else tr("Convertir en alma"), func():
			if _soul_armed != _soul_pick:
				_soul_armed = _soul_pick
				ui_click()
				show_souls()
				return
			_soul_armed = ""
			var was: = Equipment.item_name(it)
			var r: = Souls.turn(_soul_pick)
			if not bool(r.get("ok", false)):
				show_souls(tr("No se pudo convertir."), false)
				return
			world.play_sound("refine_ok" if RoAssets.sound("refine_ok") != null else "levelup", 0.0, -2.0)
			_soul_pick = ""
			show_souls(tr("%s es ahora %s. Póntela en el hueco de alma del equipo inicial.") % [was, Equipment.item_name(r.soul)], true))
		right.add_child(go)

	var owned: = Save.storage().filter( func(s): return Equipment.is_soul(s))
	if not owned.is_empty():
		var ol: = _ro_text(tr("Tus almas: %s") % ", ".join(owned.map( func(s): return Equipment.item_name(s))), 11, GameData.SOUL_COLOR.darkened(0.35))
		ol.autowrap_mode = TextServer.AUTOWRAP_WORD_SMART
		ol.custom_minimum_size.x = 690
		body.add_child(ol)
	var footer: = HBoxContainer.new()
	footer.alignment = BoxContainer.ALIGNMENT_END
	body.add_child(footer)
	footer.add_child(_ro_button(tr("Volver"), show_altair_talk))
	footer.add_child(_ro_button(tr("Cerrar"), _back_to_hub))
