var _equip_page: = "equip"


var _equip_hid_hud: = false





func _equip_hud_tick() -> void :
	if world == null or world.hud == null:
		return
	var want: = _mode == "equipment" and world.running and not world.is_coop()
	if want and world.hud.visible:
		world.hud.hide()
		_equip_hid_hud = true
	elif not want and _equip_hid_hud:
		_equip_hid_hud = false

		if world.running and _mode != "equipment":
			world.hud.show()









func _equip_touch_pages(body: VBoxContainer, cols: HBoxContainer, pages: Array, details: Array, extra: Array, selected: String, bag_sel: int) -> void :
	if bag_sel >= 0:
		_equip_page = "bag"
	var bag_col: Control = pages[0]
	var left: Control = pages[1]
	var right: Control = pages[2]
	var side: = VBoxContainer.new()
	side.add_theme_constant_override("separation", 4)
	side.custom_minimum_size.x = 460
	cols.add_child(side)
	for n: Control in details:
		n.reparent(side, false)
		if n is ScrollContainer:
			n.custom_minimum_size.y = 140


	var grid_at: = -1
	for i in right.get_child_count():
		if right.get_child(i) is GridContainer:
			grid_at = i
			break
	var opts: = VBoxContainer.new()
	opts.add_theme_constant_override("separation", 2)
	if grid_at >= 0:
		for n in right.get_children().slice(grid_at + 2):
			if not n in extra:
				n.reparent(opts, false)
	side.add_child(opts)
	opts.visible = _equip_page == "bag"

	(extra[0] as Control).visible = false
	var refine: Control = extra[1]
	refine.reparent(side, false)

	var det: Control = details[1]
	refine.visible = _equip_page == "equip" and det.visible
	det.visibility_changed.connect( func():
		if is_instance_valid(refine):
			refine.visible = _equip_page == "equip" and det.visible)

	for sc in bag_col.find_children("*", "ScrollContainer", true, false):
		sc.custom_minimum_size.y = minf(sc.custom_minimum_size.y, 280.0)
	bag_col.visible = _equip_page == "cards"
	left.visible = _equip_page == "equip"
	right.visible = _equip_page == "bag"

	for n in cols.get_children():
		if n is VSeparator:
			cols.move_child(n, cols.get_child_count() - 2)
			break
	cols.custom_minimum_size.y = 310

	var tabs: = HBoxContainer.new()
	tabs.add_theme_constant_override("separation", 6)
	tabs.alignment = BoxContainer.ALIGNMENT_CENTER
	body.add_child(tabs)
	body.move_child(tabs, 0)
	for pg in [["equip", tr("Equipo")], ["bag", tr("Inventario")], ["cards", tr("Cartas")]]:
		var id: String = pg[0]
		var on: = id == _equip_page
		var b: = Button.new()
		b.text = str(pg[1])
		b.focus_mode = Control.FOCUS_NONE
		b.custom_minimum_size = Vector2(120, 30)
		b.add_theme_font_override("font", UiKit.FONT_BODY)
		b.add_theme_font_size_override("font_size", 13)
		for st in ["normal", "hover", "pressed"]:
			var sb: = StyleBoxFlat.new()
			sb.bg_color = Color(0.3, 0.45, 0.85) if on else Color(0.96, 0.97, 1.0)
			sb.border_color = Color(0.25, 0.38, 0.75) if on else Color(0.7, 0.75, 0.9)
			sb.set_border_width_all(1)
			sb.set_corner_radius_all(12)
			sb.content_margin_left = 12
			sb.content_margin_right = 12
			b.add_theme_stylebox_override(st, sb)
		for c in ["font_color", "font_hover_color", "font_pressed_color", "font_focus_color"]:
			b.add_theme_color_override(c, Color.WHITE if on else Color(0.22, 0.3, 0.52))
		b.pressed.connect( func():
			if id == _equip_page:
				return
			_equip_page = id
			ui_click()
			show_equipment(selected))
		tabs.add_child(b)
	if _ro_window_root != null and is_instance_valid(_ro_window_root):
		_ro_window_root.set_meta("touch_grow", true)



