	var it = eq.slots.get(selected)
	if it == null:
		col.add_child(_ro_text(tr("Elige un objeto equipado para refinarlo."), 11, Color(0.28, 0.3, 0.4)))
	elif Equipment.item_type(it) == "acc" and not Equipment.item_def(it).has("refine"):
		col.add_child(_ro_text(tr("Solo los accesorios únicos se pueden refinar."), 11, Color(0.28, 0.3, 0.4)))
	elif not Equipment.refinable(it):
		col.add_child(_ro_text(tr("Refino máximo (+%d).") % int(it.refine), 11, Color(0.28, 0.3, 0.4)))
	else:
		var ore: = Equipment.ore_for(it)
		var have: = int(eq.ores[ore])
		var chance: = Equipment.refine_chance(it)
		var row: = HBoxContainer.new()
		row.add_theme_constant_override("separation", 10)
		col.add_child(row)
		var icon: = UiKit.icon_rect(_item_icon(Equipment.item_def(it).icon), 32)
		icon.size_flags_vertical = Control.SIZE_SHRINK_CENTER
		row.add_child(icon)
		var info: = VBoxContainer.new()
		info.add_theme_constant_override("separation", 2)
		info.size_flags_horizontal = Control.SIZE_EXPAND_FILL
		row.add_child(info)
		info.add_child(_ro_text(tr("%s  →  +%d") % [Equipment.item_name(it), int(it.refine) + 1], 12, Equipment.item_color(it), true))
		var gain: = _ro_text(_mods_text(Equipment.refine_gain(it)), 11, Color(0.12, 0.45, 0.2))
		gain.autowrap_mode = TextServer.AUTOWRAP_WORD_SMART
		gain.custom_minimum_size.x = 180
		info.add_child(gain)
		var gauge_row: = HBoxContainer.new()
		gauge_row.add_theme_constant_override("separation", 6)
		info.add_child(gauge_row)
		var gauge: = UiStyles.ro_gauge("blue", 90)
		gauge.max_value = 1.0
		gauge.step = 0.0
		gauge.value = chance
		gauge.size_flags_vertical = Control.SIZE_SHRINK_CENTER
		gauge_row.add_child(gauge)
		var risk: = Color(0.12, 0.5, 0.2) if chance >= 0.9 else (Color(0.7, 0.5, 0.05) if chance >= 0.5 else Color(0.75, 0.15, 0.15))
		gauge_row.add_child(_ro_text(tr("%d%% de éxito") % roundi(chance * 100.0), 11, risk, true))
		if chance < 1.0 and int(it.refine) > 0:
			info.add_child(_ro_text(tr("Si falla, pierde un nivel"), 10, Color(0.6, 0.3, 0.3)))
		var btn: = _ro_button(tr("Refinar  (1 %s)") % tr(GameData.ORES[ore].name), func(): _refine(selected), have > 0)
		btn.custom_minimum_size = Vector2(0, 30)
		btn.add_theme_font_size_override("font_size", 12)
		btn.size_flags_vertical = Control.SIZE_SHRINK_CENTER
		if have <= 0:
			btn.tooltip_text = tr("Necesitas %s: lo sueltan los monstruos y los cofres.") % tr(GameData.ORES[ore].name)
		row.add_child(btn)

	var others: = ready.filter( func(k: String) -> bool: return k != selected)
	if not others.is_empty():
		var flow: = HFlowContainer.new()
		flow.add_theme_constant_override("h_separation", 4)
		flow.add_theme_constant_override("v_separation", 4)
		col.add_child(flow)
		var lead: = _ro_text(tr("También puedes refinar:"), 11, Color(0.55, 0.38, 0.05), true)
		lead.size_flags_vertical = Control.SIZE_SHRINK_CENTER
		flow.add_child(lead)
		for k in others:
			var o: Dictionary = eq.slots[k]
			flow.add_child(_ro_button("%s +%d" % [Equipment.item_name(o), int(o.refine)], func(): show_equipment(k)))
	return panel


func _refine(slot_key: String) -> void :
	var res: = world.refine(slot_key)
	if res.is_empty():
		return
	var it: Dictionary = world.player.equipment.slots[slot_key]
	if res.ok:
		show_equipment(slot_key, tr("¡Refinado con éxito!  %s") % Equipment.item_name(it), true)
	else:
		show_equipment(slot_key, tr("El refinamiento falló...  %s") % Equipment.item_name(it), false)
	_refine_fx(bool(res.ok))





func _refine_fx(ok: bool) -> void :
	if _equip_portrait == null or not is_instance_valid(_equip_portrait):
		return
	var holder: = SubViewportContainer.new()
	holder.stretch = true
	holder.mouse_filter = Control.MOUSE_FILTER_IGNORE
	holder.size = Vector2(160, 160)

	holder.position = Vector2(60, -12)



	var mat: = ShaderMaterial.new()
	mat.shader = _luma_alpha_shader()
	holder.material = mat
	var halo: = UiKit.glow(Color(0.02, 0.03, 0.08, 0.55), 170)
	halo.position = holder.position + Vector2(-5, 0)
	_equip_portrait.get_parent().add_child(halo)
	_equip_portrait.get_parent().move_child(halo, _equip_portrait.get_index())
	_equip_portrait.get_parent().add_child(holder)
	var vp: = SubViewport.new()
	vp.transparent_bg = false
	vp.own_world_3d = true
	var env: = WorldEnvironment.new()
	env.environment = Environment.new()
	env.environment.background_mode = Environment.BG_COLOR
	env.environment.background_color = Color.BLACK
	vp.add_child(env)
	vp.size = Vector2i(160, 160)
	vp.process_mode = Node.PROCESS_MODE_ALWAYS
	holder.add_child(vp)
	var cam: = Camera3D.new()
	cam.projection = Camera3D.PROJECTION_ORTHOGONAL
	cam.size = 6.5
	cam.position = Vector3(0, 2.2, 10)
	vp.add_child(cam)
	var root3d: = Node3D.new()
	root3d.process_mode = Node.PROCESS_MODE_ALWAYS
	vp.add_child(root3d)
	var tw: = holder.create_tween().set_pause_mode(Tween.TWEEN_PAUSE_PROCESS)
	tw.tween_interval(0.45)
	tw.tween_callback( func():
		var fx: = RoEffect.spawn(root3d, "bs_refinesuccess" if ok else "bs_refinefailed", Vector3.ZERO, 1.0)
		if fx != null:
			fx.process_mode = Node.PROCESS_MODE_ALWAYS)
	tw.tween_interval(3.0)
	tw.tween_callback(holder.queue_free)
	tw.tween_callback(halo.queue_free)





func _refine_anim(ok: bool, broke: bool) -> void :
	var slot: = _refine_slot
	var icon: = _equip_portrait
	if slot == null or not is_instance_valid(slot) or icon == null or not is_instance_valid(icon):
		return
	var tw: = slot.create_tween().set_pause_mode(Tween.TWEEN_PAUSE_PROCESS)

	for i in 3:
		tw.tween_property(icon, "position:y", 23.0, 0.06)
		tw.tween_property(icon, "position:y", 19.0, 0.09)
	tw.tween_callback( func():
		if not is_instance_valid(slot):
			return
		_refine_light(slot, ok)
		var fx: = slot.create_tween().set_pause_mode(Tween.TWEEN_PAUSE_PROCESS)
		if ok:
			_refine_frame.border_color = Color(1.0, 0.82, 0.3)
			fx.tween_property(icon, "scale", Vector2.ONE * 1.3, 0.14).set_trans(Tween.TRANS_BACK).set_ease(Tween.EASE_OUT)
			fx.parallel().tween_property(icon, "modulate", Color(1.6, 1.45, 1.0), 0.14)
			fx.tween_property(icon, "scale", Vector2.ONE, 0.25)
			fx.parallel().tween_property(icon, "modulate", Color.WHITE, 0.35)
		elif broke:
			_refine_frame.border_color = Color(0.85, 0.1, 0.1)
			world.shake(0.3)
			for i in 4:
				fx.tween_property(icon, "position:x", 15.0 if i % 2 == 0 else 23.0, 0.04)
			fx.tween_property(icon, "modulate", Color(1.0, 0.3, 0.25), 0.1)
			fx.tween_property(icon, "scale", Vector2(1.15, 0.2), 0.35).set_ease(Tween.EASE_IN)
			fx.parallel().tween_property(icon, "modulate:a", 0.0, 0.35)
		else:
			_refine_frame.border_color = Color(0.85, 0.3, 0.2)
			for i in 4:
				fx.tween_property(icon, "position:x", 15.0 if i % 2 == 0 else 23.0, 0.05)
			fx.tween_property(icon, "position:x", 19.0, 0.05)
			fx.parallel().tween_property(icon, "modulate", Color(1.0, 0.6, 0.55), 0.1)
			fx.tween_property(icon, "modulate", Color.WHITE, 0.4))



