func _fit_end_scroll(scroll: ScrollContainer, cols: Control, col: Control) -> void :
	if not is_instance_valid(scroll):
		return
	var need: = cols.get_combined_minimum_size()
	scroll.custom_minimum_size = Vector2(need.x, need.y)
	await get_tree().process_frame
	if not is_instance_valid(scroll):
		return
	var view: = get_viewport().get_visible_rect().size.y

	var total: = col.get_combined_minimum_size().y + 66.0
	var over: = total - (view - 8.0)
	if over > 0.0:
		scroll.custom_minimum_size.y = maxf(150.0, need.y - over)



