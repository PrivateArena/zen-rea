				cb.focus_mode = Control.FOCUS_NONE
				var cs: = StyleBoxFlat.new()
				cs.bg_color = Color(1.0, 0.96, 0.84)
				cs.border_color = GameData.ETERNAL_COLOR
				cs.set_border_width_all(1)
				cs.set_corner_radius_all(4)
				var ch: = cs.duplicate() as StyleBoxFlat
				ch.border_color = Color(1.0, 0.65, 0.1)
				ch.set_border_width_all(2)
				for k in ["normal", "pressed", "focus"]:
					cb.add_theme_stylebox_override(k, cs)
				cb.add_theme_stylebox_override("hover", ch)
				var art: = _card_art(c, Vector2(42, 58))
				art.position = Vector2(3, 3)
				art.size = Vector2(42, 58)
				art.mouse_filter = Control.MOUSE_FILTER_IGNORE
				cb.add_child(art)
				UiKit.eternal_shine(art)
				var n: = _ro_text("x%d" % free, 10, Color(0.15, 0.4, 0.15) if free > 0 else Color(0.6, 0.3, 0.3), true)
				n.position = Vector2(4, 61)
				n.size = Vector2(40, 14)
				n.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER
				cb.add_child(n)
				if free <= 0:
					cb.disabled = true
					cb.modulate = Color(1, 1, 1, 0.45)
				_set_hover(cb, _card_hover(c, [tr("Libres: %d") % free]))
				cb.pressed.connect( func():
					if Save.set_eternal(uid, c):
						_eternal_sel = -1
						Save.set_setting("socket_hint_done", true)
						world.play_sound("refine_ok", 0.0, -2.0)
						world.play_sound("coin2", 0.0, -6.0)
						world.net.town_event("card", true)
						_eternal_find = ""
						show_socket(tr("«%s engarzada. Brilla bonito, ¿eh?»") % tr(str(GameData.CARDS[c].name)), true)
						_eternal_flash())
				cb.set_meta("find", _fold("%s %s" % [tr(str(GameData.CARDS[c].name)), tr(str(GameData.CARDS[c].get("desc", "")))]))
				pick.add_child(cb)
			if find != null:
				var apply: = func(text: String):
					_eternal_find = text
					var needle: = _fold(text.strip_edges())
					for b in pick.get_children():
						b.visible = needle == "" or str(b.get_meta("find", "")).contains(needle)
				find.text_changed.connect(apply)
				apply.call(_eternal_find)
	return box




