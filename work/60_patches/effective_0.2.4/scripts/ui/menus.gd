func _record_place(place: Label, d: Dictionary) -> void :
	if not is_instance_valid(place):
		return
	if d.is_empty():
		place.text = tr("Sin conexión: tu récord no se pudo enviar.")
		return
	var who: = "%s  ·  %s" % [tr(str(world.stage.name)), world.player.job_name() if world.player != null else ""]
	var rank: = int(d.get("rank", 0))
	var medal: String = "★ " if rank >= 1 and rank <= 3 else ""
	if bool(d.get("improved", false)):
		place.text = medal + tr("¡Nuevo récord! Puesto %d de %d del mes en %s") % [rank, int(d.get("total", rank)), who]
		place.add_theme_color_override("font_color", Color(0.78, 0.5, 0.0))
		place.pivot_offset = place.size * 0.5
		place.scale = Vector2(1.25, 1.25)
		place.create_tween().tween_property(place, "scale", Vector2.ONE, 0.4).set_trans(Tween.TRANS_BACK).set_ease(Tween.EASE_OUT)
		if world != null:
			world.play_sound("refine_ok", 0.0, -6.0)
	else:
		place.text = medal + tr("Tu récord del mes sigue en pie: puesto %d de %d en %s") % [rank, int(d.get("total", rank)), who]
		place.add_theme_color_override("font_color", Color(0.3, 0.4, 0.7))




func _end_rewards(result: Dictionary, best: Dictionary) -> PanelContainer:
	var panel: = PanelContainer.new()
	panel.add_theme_stylebox_override("panel", UiKit.panel_box())
	panel.custom_minimum_size.x = 300
	var col: = VBoxContainer.new()
	col.add_theme_constant_override("separation", 5)
	panel.add_child(col)
	var head: = UiKit.label(tr("Recompensas"), 16, UiKit.TEXT, true)
	head.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER
	col.add_child(head)
	var grid: = GridContainer.new()
	grid.columns = 2
	grid.add_theme_constant_override("h_separation", 14)
	grid.add_theme_constant_override("v_separation", 2)
	col.add_child(grid)
	var add: = func(caption: String, value: String, color: Color):
		var c: = UiKit.label(caption, 12, UiKit.MUTED)
		c.size_flags_horizontal = Control.SIZE_EXPAND_FILL
		grid.add_child(c)
		var v: = UiKit.label(value, 12, color, true)
		v.horizontal_alignment = HORIZONTAL_ALIGNMENT_RIGHT
		grid.add_child(v)
	var zf: Dictionary = result.get("zeny_from", {})
	if int(zf.get("daily", 0)) > 0:
		var daily: = UiKit.label(tr("¡Primera partida del día!  +%s z  (+%d%%)") % [RoBasicWindow._thousands(int(zf.daily)), 
			roundi(GameData.DAILY_FIRST_BONUS * 100.0)], 13, Color(0.75, 0.48, 0.0), true)
		daily.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER
		col.add_child(daily)
		col.move_child(daily, 1)
	var names: = {"loot": tr("Botín de monstruos"), "steal": tr("Robos"), "chest": tr("Cofres pequeños"), 
		"sold": tr("Ventas en la partida"), "end": tr("Venta al terminar")}
	for k in ["loot", "steal", "chest", "sold", "end"]:
		if int(zf.get(k, 0)) > 0:
			add.call(names[k], "+%s z" % RoBasicWindow._thousands(int(zf[k])), Color(0.6, 0.45, 0.1))
	if int(zf.get("spent", 0)) > 0:
		add.call(tr("Gastado en Mammonite"), "-%s z" % RoBasicWindow._thousands(int(zf.spent)), Color(0.7, 0.2, 0.2))

	var left_n: = int(result.get("sold", 0)) + int(result.get("sold_cards", 0))
	if left_n > 0:
		var tips: Array[String] = []
		if int(result.get("sold", 0)) > 0:
			tips.append("%s: %d  ·  %s z" % [tr("Objetos sobrantes vendidos"), int(result.sold), RoBasicWindow._thousands(int(result.sold_zeny))])
		if int(result.get("sold_cards", 0)) > 0:
			tips.append("%s: %d  ·  %s z" % [tr("Cartas sobrantes vendidas"), int(result.sold_cards), RoBasicWindow._thousands(int(result.cards_zeny))])
		add.call(tr("Sobrantes vendidos"), "%d  ·  %s z" % [left_n, RoBasicWindow._thousands(int(result.get("sold_zeny", 0)) + int(result.get("cards_zeny", 0)))], UiKit.TEXT)
		for k in 2:
			var cell: = grid.get_child(grid.get_child_count() - 2 + k) as Control
			cell.tooltip_text = "\n".join(tips)
			cell.mouse_filter = Control.MOUSE_FILTER_PASS
	if best.has("class_level"):
		add.call(tr("EXP de clase"), "+%d" % int(best.class_xp), UiKit.TEXT)

	var mats: Dictionary = result.get("materials", {})
	if not mats.is_empty():
		var mrow: = HFlowContainer.new()
		mrow.add_theme_constant_override("h_separation", 10)
		mrow.add_theme_constant_override("v_separation", 2)
		for m in mats:
			var cell: = HBoxContainer.new()
			cell.add_theme_constant_override("separation", 2)
			cell.tooltip_text = tr(GameData.MATERIALS[m].name)
			cell.mouse_filter = Control.MOUSE_FILTER_PASS
			var ic: = UiKit.icon_rect(_item_icon(str(GameData.MATERIALS[m].get("icon", m))), 22)
			cell.add_child(ic)
