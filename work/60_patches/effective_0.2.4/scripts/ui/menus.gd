func _wing_step(i: int, r: int) -> Control:
	var gold: = GameData.REBIRTH_LV_GOLD
	var on: = i < r
	var nxt: = i == r
	var box: = PanelContainer.new()
	var sb: = StyleBoxFlat.new()
	sb.bg_color = Color(1.0, 0.95, 0.78) if on else (Color(0.97, 0.94, 1.0) if nxt else Color(0, 0, 0, 0))
	sb.border_color = GameData.WINGS_COLOR if nxt else (Color(gold, 0.55) if on else Color(0.8, 0.82, 0.88, 0.6))
	sb.set_border_width_all(2 if nxt else 1)
	sb.set_corner_radius_all(8)
	sb.content_margin_left = 6
	sb.content_margin_right = 10
	sb.content_margin_top = 2
	sb.content_margin_bottom = 2
	box.add_theme_stylebox_override("panel", sb)
	box.custom_minimum_size.x = 400
	var line: = HBoxContainer.new()
	line.add_theme_constant_override("separation", 8)
	box.add_child(line)
	var seal: = Control.new()
	seal.custom_minimum_size = Vector2(24, 24)
	seal.size_flags_vertical = Control.SIZE_SHRINK_CENTER
	seal.draw.connect( func():
		var c: = Vector2(12, 12)
		seal.draw_circle(c, 11.5, gold.darkened(0.25) if on else (GameData.WINGS_COLOR if nxt else Color(0.72, 0.74, 0.82)))
		seal.draw_circle(c, 9.5, gold.lightened(0.2) if on else (Color(0.97, 0.94, 1.0) if nxt else Color(0.93, 0.94, 0.97)))
		var font: = seal.get_theme_default_font()
		var txt: = "%d" % (i + 1)
		var fs: = 11 if i < 9 else 9
		var w: = font.get_string_size(txt, HORIZONTAL_ALIGNMENT_LEFT, -1, fs).x
		seal.draw_string(font, c + Vector2( - w * 0.5, 4), txt, HORIZONTAL_ALIGNMENT_LEFT, -1, fs, 
			Color(0.32, 0.2, 0.04) if on else (GameData.WINGS_COLOR.darkened(0.4) if nxt else Color(0.42, 0.44, 0.52))))
	line.add_child(seal)
	var text: = UiKit.label(tr(GameData.WING_LEVELS[i]), 13, Color(0.38, 0.25, 0.04) if on else (UiKit.TEXT if nxt else UiKit.MUTED), on or nxt)
	text.size_flags_horizontal = Control.SIZE_EXPAND_FILL
	text.size_flags_vertical = Control.SIZE_SHRINK_CENTER
	text.autowrap_mode = TextServer.AUTOWRAP_WORD_SMART
	line.add_child(text)
	if nxt:
		var t: = UiKit.tag(tr("Siguiente"), GameData.WINGS_COLOR, 10)
		t.size_flags_vertical = Control.SIZE_SHRINK_CENTER
		line.add_child(t)
	return box




