func _card_stage(card_id: String) -> String:
	for sid in GameData.STAGES:
		var st: Dictionary = GameData.STAGES[sid]
		var mobs: Array = []
		for sp in st.spawns:
			mobs.append(sp.mob)
		for ev in st.events:
			mobs.append(ev.mob)
		for m in mobs:
			if GameData.MONSTERS.has(m) and str(GameData.MONSTERS[m].get("card", "")) == card_id:
				return sid
	return ""




func _card_where(card_id: String) -> String:
	var sid: = _card_stage(card_id)
	if sid != "":
		return tr(GameData.STAGES[sid].name)
	var mob: = ""
	for m in GameData.MONSTERS:
		if str(GameData.MONSTERS[m].get("card", "")) == card_id:
			mob = m
			break
	for q in GameData.QUESTS:
		if str(GameData.QUESTS[q].get("reward", {}).get("card", "")) == card_id:
			return tr("Quest de %s") % tr(str(GameData.STAGES[q].name)) if GameData.STAGES.has(q) else tr("Quest")
	if mob == "":
		return "-"
	if mob == "satan_morroc":
		return tr("Satan Morroc")
	for r in GameData.KARMA_ROUTES:
		if str(GameData.KARMA_ROUTES[r].mvp) == mob:
			return tr(str(GameData.KARMA_ROUTES[r].name))
	if GameData.KARMA_DEMONS.has(mob):
		return tr("Demonios de Niflheim")
	for raid in GameData.RAIDS:
		for ab in GameData.RAIDS[raid].get("abilities", []):
			var mobs = ab.get("mob", ab.get("egg", ""))
			if (mobs is Array and (mobs as Array).has(mob)) or str(mobs) == mob or str(ab.get("hatch", "")) == mob:
				return tr("Pelea contra %s") % tr(str(GameData.MONSTERS[raid].name)) if GameData.MONSTERS.has(raid) else tr("MVP")
	return "-"



