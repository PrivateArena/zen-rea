	input.size_flags_vertical = Control.SIZE_SHRINK_CENTER
	row.add_child(input)

	var flow: = HBoxContainer.new()
	flow.add_theme_constant_override("separation", -2)
	flow.size_flags_vertical = Control.SIZE_SHRINK_CENTER
	row.add_child(flow)
	for k in 3:
		var chev: = _ro_text("›", 20, ink if can > 0 else Color(0.7, 0.72, 0.78), true)
		flow.add_child(chev)
		if can > 0:
			chev.modulate.a = 0.25
			var tw: = chev.create_tween().set_loops().set_pause_mode(Tween.TWEEN_PAUSE_PROCESS)
			tw.tween_interval(0.18 * k)
			tw.tween_property(chev, "modulate:a", 1.0, 0.25)
			tw.tween_property(chev, "modulate:a", 0.25, 0.45)
			tw.tween_interval(0.36 - 0.18 * k)
	var crucible: = _transmute_crucible(to, ink, can > 0)
	row.add_child(crucible)
	var out: = int(r.get("out", 1))
	var name: = _ro_text((("x%d  " % out) if out > 1 else "") + tr(str(GameData.MATERIALS[to].name)), 12, ink.darkened(0.3), true)
	name.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER
	col.add_child(name)
	var stock: = _ro_text(tr("Tienes %d  ·  alcanza para %d") % [have, can], 10, Color(0.35, 0.38, 0.45))
