var _closet_warm: = ""




func warm_closet(class_id: String) -> void :
	if _closet_warm == class_id:
		return
	_closet_warm = class_id
	var look: = Save.look(class_id)
	var body: = str(GameData.shown_job(class_id, look).body)
	var ids: Array = GameData.COSMETICS.keys()
	var t0: = Time.get_ticks_usec()
	for id in ids:
		if world == null or world.town == null or not is_instance_valid(world.town) or _closet_warm != class_id:
			return
		_cosmetic_picture(str(id), body, look)

		if Time.get_ticks_usec() - t0 > 3000:
			await get_tree().process_frame
			t0 = Time.get_ticks_usec()




