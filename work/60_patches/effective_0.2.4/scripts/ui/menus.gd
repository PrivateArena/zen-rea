func _cosmetic_cell(id: String, class_id: String, body_key: String, look: Dictionary, worn: Dictionary, refill: Callable) -> Control:
	var d: Dictionary = GameData.COSMETICS[id]
	var owned: = Save.has_cosmetic(id)
	var on: = str(worn.get(str(d.slot), "")) == id
	var rar: Dictionary = GameData.COSMETIC_RARITY.get(str(d.rarity), GameData.COSMETIC_RARITY.common)
	var b: = Button.new()
	b.focus_mode = Control.FOCUS_NONE
	b.custom_minimum_size = Vector2(86, 96)
	var box: = StyleBoxFlat.new()
	box.bg_color = Color(1.0, 0.97, 0.86) if on else (Color(0.97, 0.98, 1.0) if owned else Color(0.88, 0.89, 0.92))
	box.border_color = Color(0.95, 0.7, 0.2) if on else Color(rar.color, 0.9 if owned else 0.35)
	box.set_border_width_all(2 if on else 1)
	box.set_corner_radius_all(5)
	for st in ["normal", "hover", "pressed", "disabled"]:
		b.add_theme_stylebox_override(st, box)
	var col: = VBoxContainer.new()
	col.set_anchors_preset(Control.PRESET_FULL_RECT)
	col.mouse_filter = Control.MOUSE_FILTER_IGNORE
	col.add_theme_constant_override("separation", 0)
	b.add_child(col)
	var pic: = TextureRect.new()
	pic.custom_minimum_size = Vector2(80, 56)
	pic.expand_mode = TextureRect.EXPAND_IGNORE_SIZE
	pic.mouse_filter = Control.MOUSE_FILTER_IGNORE
	pic.texture = _cosmetic_picture(id, body_key, look)


	var fits: = pic.texture == null or (pic.texture.get_width() <= 80 and pic.texture.get_height() <= 56)
	pic.stretch_mode = TextureRect.STRETCH_KEEP_CENTERED if fits else TextureRect.STRETCH_KEEP_ASPECT_CENTERED
	pic.texture_filter = CanvasItem.TEXTURE_FILTER_NEAREST if fits else CanvasItem.TEXTURE_FILTER_LINEAR
	pic.modulate = Color.WHITE if owned else Color(0.1, 0.12, 0.18, 0.55)
	col.add_child(pic)
	var name_l: = _ro_text(tr(str(d.name)) if owned else "???", 9, Color(0.15, 0.17, 0.3) if owned else Color(0.28, 0.3, 0.4), true)
	name_l.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER
	name_l.custom_minimum_size.x = 82
	col.add_child(name_l)
	UiKit.fit_dots(name_l)
