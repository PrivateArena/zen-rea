	var it: = Save.storage_item(uid)
	if it.is_empty():
		return
	var why: = _loadout_block(class_id, it, key)
	if why != "":
		show_loadout(class_id, why, false)
		return
	Save.set_loadout_slot(class_id, key, uid)
	world.play_sound("equip_item", 0.0, -2.0)

	if key == "weapon" and _hands_full(Save.loadout(class_id)) and Save.loadout(class_id).has("shield"):
		var huuma: = _huuma_in(Save.loadout(class_id))
