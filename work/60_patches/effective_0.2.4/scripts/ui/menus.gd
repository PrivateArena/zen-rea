func _fill_legend_souls() -> void :
	if _ls_list == null or not is_instance_valid(_ls_list):
		return
	for c in _ls_list.get_children():
		c.queue_free()
	var needle: = _fold(_ls_query.strip_edges())
	var shown: = 0
	for sid in Souls.legend_shop(_ls_class):
		var d: Dictionary = GameData.ITEMS[sid]
		var src: Dictionary = GameData.ITEMS.get(str(d.soul_of), {})
		if _ls_slot != "" and str(src.get("slot", "")) != _ls_slot:
			continue
		var soul: = {"id": sid, "slots": 0, "extra_slots": 0, "refine": 0, "cards": []}
		var desc: = Equipment.desc_of(soul)
		if needle != "" and not _fold("%s %s %s" % [tr(str(d.name)), tr(str(src.get("name", ""))), desc]).contains(needle):
			continue
		shown += 1
		var row: = PanelContainer.new()
		row.add_theme_stylebox_override("panel", _cell_box(GameData.SOUL_COLOR, false, 1))
		row.mouse_filter = Control.MOUSE_FILTER_STOP
		var h: = HBoxContainer.new()
		h.add_theme_constant_override("separation", 8)
		row.add_child(h)
		h.add_child(UiKit.icon_rect(_item_icon(str(d.icon)), 30))
		var col: = VBoxContainer.new()
		col.add_theme_constant_override("separation", 0)
		col.size_flags_horizontal = Control.SIZE_EXPAND_FILL
		h.add_child(col)
		var owned: = Save.storage().filter( func(s): return str(s.id) == sid).size()
		col.add_child(_ro_text(tr(str(d.name)) + ("   ·   " + tr("tienes %d") % owned if owned > 0 else ""), 11, GameData.SOUL_COLOR.darkened(0.35), true))
		var dl: = _ro_text("%s  ·  %s" % [_slot_name(str(src.get("slot", "acc")) if str(src.get("slot", "")) != "acc" else "acc1"), desc], 10, Color(0.3, 0.32, 0.4))
		dl.autowrap_mode = TextServer.AUTOWRAP_WORD_SMART
		dl.custom_minimum_size.x = 540
		col.add_child(dl)
		var on_buy: = func():
			var why: = Souls.buy(sid)
			if why == "":
				world.play_sound("refine_ok" if RoAssets.sound("refine_ok") != null else "levelup", 0.0, -2.0)
				show_legend_souls(tr("%s está en tu almacén. Póntela en el hueco de alma del equipo inicial.") % tr(str(d.name)), true)
			elif why == "coins":
				show_legend_souls(tr("Te faltan Monedas legendarias: se ganan vendiendo legendarias y únicas."), false)
			elif why == "full":
				show_legend_souls(tr("Tu almacén está lleno."), false)
		var buy: = _ro_button(tr("Comprar  (%d)") % GameData.LEGEND_SOUL_PRICE, on_buy, Save.material("legend_coin") >= GameData.LEGEND_SOUL_PRICE)
		buy.size_flags_vertical = Control.SIZE_SHRINK_CENTER
		h.add_child(buy)
		row.mouse_entered.connect( func(): _show_item_hover(soul, row, true))
		row.mouse_exited.connect(_hide_item_hover)
		_ls_list.add_child(row)
	if shown == 0:
		_ls_list.add_child(_ro_text(tr("Nada con ese filtro."), 11, Color(0.28, 0.3, 0.4)))




