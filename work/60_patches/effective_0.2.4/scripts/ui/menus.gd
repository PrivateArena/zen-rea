	var body: VBoxContainer = w.body
	body.add_theme_constant_override("separation", 6)
	_closet_tabs(body, "effects", w)
	var width: = 700.0
	var note: = _ro_text(tr("Algunos títulos dan un efecto solo por tenerlos: no hace falta llevarlos puestos."), 11, Color(0.28, 0.3, 0.4))
	note.autowrap_mode = TextServer.AUTOWRAP_WORD_SMART
	note.custom_minimum_size.x = width
	body.add_child(note)
	var scroll: = ScrollContainer.new()
	scroll.horizontal_scroll_mode = ScrollContainer.SCROLL_MODE_DISABLED
	scroll.custom_minimum_size = Vector2(width, 360)
	body.add_child(scroll)
	var list: = VBoxContainer.new()
	list.size_flags_horizontal = Control.SIZE_EXPAND_FILL
	list.add_theme_constant_override("separation", 6)
	scroll.add_child(list)
	var fx_text: = func(fx: Dictionary) -> String:
		var parts: Array[String] = []
		for k in fx:
			if k == "drop_find":
				parts.append(tr("+%s%% de probabilidad de drop") % str(roundi(float(fx[k]) * 100.0)))
		return ", ".join(parts)
	var ids: Array = GameData.TITLES.keys().filter( func(id): return GameData.TITLES[id].has("effects"))
	var mine: Array = ids.filter( func(id): return t.has(id))
	list.add_child(_ro_text(tr("Activos"), 12, Color(0.12, 0.25, 0.75), true))
	if mine.is_empty():
		list.add_child(_ro_text(tr("Ninguno por ahora."), 11, Color(0.28, 0.3, 0.4)))

	var others: Array = ids.filter( func(id): return not t.has(id))
	for id in mine + others:
		var d: Dictionary = GameData.TITLES[id]
		var got: bool = t.has(id)
		if not got and id == others[0]:
			list.add_child(_ro_text(tr("Por conseguir"), 12, Color(0.12, 0.25, 0.75), true))
		var row: = HBoxContainer.new()
		row.add_theme_constant_override("separation", 10)
		row.modulate = Color.WHITE if got else Color(1, 1, 1, 0.55)
		row.add_child(t.chip(str(id), 12))
		var col: = VBoxContainer.new()
		col.add_theme_constant_override("separation", 1)
		col.size_flags_horizontal = Control.SIZE_EXPAND_FILL
		row.add_child(col)
		col.add_child(_ro_text(fx_text.call(d.effects), 12, Color(0.1, 0.45, 0.2) if got else Color(0.3, 0.32, 0.4), true))
		var how: = _ro_text(tr(str(d.desc)) + ("  " + tr("(hasta el próximo lunes)") if got and d.get("temp", false) else ""), 10, Color(0.28, 0.3, 0.4))
		how.autowrap_mode = TextServer.AUTOWRAP_WORD_SMART
		col.add_child(how)
		list.add_child(row)

	list.add_child(_ro_text(tr("Torre de Hel · ranking semanal (en solitario)"), 12, Color(0.12, 0.25, 0.75), true))
	var board: = VBoxContainer.new()
	board.add_theme_constant_override("separation", 2)
	list.add_child(board)
	board.add_child(_ro_text(tr("Cargando..."), 11, Color(0.28, 0.3, 0.4)))
	if world.board != null:
		world.board._call("hel_week_board", {}, func(ok: bool, d):
			if not is_instance_valid(board):
				return
			for c in board.get_children():
				c.queue_free()
			if not ok or not d is Dictionary:
				board.add_child(_ro_text(tr("Sin conexión"), 11, Color(0.6, 0.2, 0.2)))
				return
			var left: = int(d.get("ends", 0)) - int(Time.get_unix_time_from_system())
			board.add_child(_ro_text(tr("Termina en %d d %d h. Los 3 primeros ganan «%s» toda la semana siguiente.") % [left / 86400, (left % 86400) / 3600, tr(str(GameData.TITLES.hel_week.name))], 10, Color(0.28, 0.3, 0.4)))
			var rank: = 0
			for r in d.get("now", []):
				rank += 1
				var line: = HBoxContainer.new()
				line.add_theme_constant_override("separation", 8)
				var top3: = rank <= 3
				var rk: = _ro_text("%d." % rank, 12, Color(0.75, 0.35, 0.05) if top3 else Color(0.3, 0.32, 0.4), true)
				rk.custom_minimum_size.x = 26
				line.add_child(rk)
				var nm: = _ro_text("%s %s" % [str(r.get("name", "")), str(r.get("tag", ""))], 12, Color(0.15, 0.17, 0.3), top3)
				nm.custom_minimum_size.x = 260
				line.add_child(nm)
				var cid: = str(r.get("class", ""))
				var cl: = _ro_text(tr(str(GameData.CLASSES[cid].name)) if GameData.CLASSES.has(cid) else cid, 11, Color(0.3, 0.32, 0.4))
				cl.custom_minimum_size.x = 140
				line.add_child(cl)
				line.add_child(_ro_text(tr("Piso %d") % int(r.get("floor", 0)) + ("  ·  " + tr("Juramento %d") % int(r.get("oath", 0)) if int(r.get("oath", 0)) > 0 else ""), 12, Color(0.15, 0.17, 0.3), true))
				board.add_child(line)
			if rank == 0:
				board.add_child(_ro_text(tr("Nadie subió la Torre de Hel esta semana todavía."), 11, Color(0.28, 0.3, 0.4)))
			var last: Array = d.get("last", [])
			if not last.is_empty():
				board.add_child(_ro_text(tr("Campeones de la semana pasada: %s") % ", ".join(PackedStringArray(last.map( func(r): return "%s %s" % [str(r.get("name", "")), str(r.get("tag", ""))]))), 10, Color(0.45, 0.2, 0.6))))
	var row2: = HBoxContainer.new()
	row2.alignment = BoxContainer.ALIGNMENT_END
	row2.size_flags_vertical = Control.SIZE_EXPAND | Control.SIZE_SHRINK_END
	body.add_child(row2)
	var close_b: = _ro_button(tr("Cerrar"), func(): _closet_close(w))
	row2.add_child(close_b)
	if touch_ui():
		close_b.custom_minimum_size = Vector2(130, 46)
	_float_show(w, null if touch_ui() else close_b)





func _show_outfits(class_id: String) -> void :
	var w: = _float_window(tr("Armario"), Callable(), 0.75)
	var body: VBoxContainer = w.body
	body.add_theme_constant_override("separation", 6)
	_closet_tabs(body, "outfits", w)
	var note: = _ro_text(tr("Los trajes de cuerpo completo salen en la Máquina Gacha. Se ven en Prontera, al elegir personaje y ante los demás; en la partida vuelves a la ropa de tu clase."), 11, Color(0.28, 0.3, 0.4))
	note.autowrap_mode = TextServer.AUTOWRAP_WORD_SMART
	note.custom_minimum_size.x = 560
	body.add_child(note)
	var look: Dictionary = Save.look(class_id)
	var current: = str(look.get("show", ""))
	var grid: = GridContainer.new()
	grid.columns = 5
	grid.add_theme_constant_override("h_separation", 8)
	grid.add_theme_constant_override("v_separation", 8)
	body.add_child(grid)
	var first: Dictionary = GameData.job_looks(class_id)[0]
	var ids: Array = [""]
	for id in GameData.COSMETICS:
		if str(GameData.COSMETICS[id].slot) == "body" and GameData.COSMETICS[id].get("gacha", true) != false:
			ids.append(str(id))
	for id in ids:
		var owned: bool = id == "" or Save.has_cosmetic(str(id))
		var worn: bool = (id == "" and not current.begins_with("outfit_")) or (id != "" and current == id)
		var card: = PanelContainer.new()
		card.custom_minimum_size = Vector2(132, 168)
		var sb: = StyleBoxFlat.new()
		sb.set_corner_radius_all(10)
		sb.set_content_margin_all(6)
		sb.bg_color = Color(1.0, 0.97, 0.88) if worn else (Color(1, 1, 1) if owned else Color(0.9, 0.91, 0.94))
		sb.border_color = Color(0.93, 0.7, 0.2) if worn else (Color(0.74, 0.79, 0.9) if owned else Color(0.82, 0.83, 0.87))
		sb.set_border_width_all(3 if worn else 1)
		if worn:
			sb.shadow_color = Color(0.95, 0.7, 0.2, 0.35)
			sb.shadow_size = 6
		card.add_theme_stylebox_override("panel", sb)
		var col: = VBoxContainer.new()
		col.alignment = BoxContainer.ALIGNMENT_CENTER
		col.add_theme_constant_override("separation", 2)
		col.mouse_filter = Control.MOUSE_FILTER_IGNORE
		card.add_child(col)

		var stage: = Control.new()
		stage.custom_minimum_size = Vector2(120, 112)
		stage.mouse_filter = Control.MOUSE_FILTER_IGNORE
		col.add_child(stage)
		var floor_sb: = StyleBoxFlat.new()
		floor_sb.bg_color = Color(0.25, 0.3, 0.5, 0.14 if owned else 0.08)
		floor_sb.set_corner_radius_all(30)
		var floor_p: = Panel.new()
		floor_p.add_theme_stylebox_override("panel", floor_sb)
		floor_p.position = Vector2(32, 82)
		floor_p.size = Vector2(56, 12)
		floor_p.mouse_filter = Control.MOUSE_FILTER_IGNORE
		stage.add_child(floor_p)
		var shown_body: = str(first.body) if id == "" else str(GameData.COSMETICS[id].view)
		var ro: = RoAssets.styled_character(shown_body, "" if id != "" else str(first.weapon), "", [], "", look)
		var tex: Texture2D = ro.get_frame(0, 0) if ro != null else null
		if tex != null:
			var pic: = TextureRect.new()
			pic.texture = tex
			pic.stretch_mode = TextureRect.STRETCH_KEEP_ASPECT_CENTERED
			pic.expand_mode = TextureRect.EXPAND_IGNORE_SIZE
			pic.position = Vector2(0, -6)
			pic.size = Vector2(120, 112)
			pic.texture_filter = CanvasItem.TEXTURE_FILTER_NEAREST
			pic.mouse_filter = Control.MOUSE_FILTER_IGNORE
			if not owned:
				pic.modulate = Color(0.2, 0.22, 0.32, 0.55)
			stage.add_child(pic)
		var name: = tr("Ropa de la clase") if id == "" else (tr(str(GameData.COSMETICS[id].name)) if owned else "???")
		var l: = _ro_text(name, 11, Color(0.55, 0.33, 0.0) if worn else (UiKit.TEXT if owned else UiKit.MUTED), true)
		l.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER
		l.autowrap_mode = TextServer.AUTOWRAP_WORD_SMART
		l.custom_minimum_size.x = 118
		l.mouse_filter = Control.MOUSE_FILTER_IGNORE
		col.add_child(l)
		var tag: = _ro_text(tr("Puesto") if worn else (tr("Máquina Gacha") if not owned else ""), 9, 
			Color(0.75, 0.45, 0.0) if worn else UiKit.MUTED, worn)
		tag.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER
		tag.mouse_filter = Control.MOUSE_FILTER_IGNORE
		col.add_child(tag)
		if not owned:
			card.tooltip_text = tr("Sale en la Máquina Gacha de Prontera.")
		var pick: String = str(id)
		if owned and not worn:
			card.mouse_default_cursor_shape = Control.CURSOR_POINTING_HAND
			card.mouse_entered.connect( func():
				sb.border_color = Color(0.4, 0.55, 0.95)
				sb.set_border_width_all(2))
			card.mouse_exited.connect( func():
				sb.border_color = Color(0.74, 0.79, 0.9)
				sb.set_border_width_all(1))
			card.gui_input.connect( func(ev: InputEvent):
				if not (ev is InputEventMouseButton and ev.pressed and ev.button_index == MOUSE_BUTTON_LEFT):
					return
				ui_click()
				var lk: Dictionary = Save.look(class_id).duplicate()


				var was: = str(lk.get("show", ""))
				if pick != "" and not was.begins_with("outfit_"):
					lk["show_prev"] = was
				lk["show"] = pick if pick != "" else str(lk.get("show_prev", ""))
				Save.set_look(class_id, lk)
				if world.town != null and is_instance_valid(world.town):
					world.town.refresh_hero()
				w.shut.call()
				_show_outfits(class_id))
		grid.add_child(card)
	var bottom: = HBoxContainer.new()
	bottom.alignment = BoxContainer.ALIGNMENT_END
	body.add_child(bottom)
	var close_b: = _ro_button(tr("Cerrar"), func(): _closet_close(w))
	bottom.add_child(close_b)
	_float_show(w, null if touch_ui() else close_b)




func _closet_tabs(body: VBoxContainer, current: String, w: Dictionary) -> void :
	var bar: = HBoxContainer.new()
	bar.add_theme_constant_override("separation", 4)
	body.add_child(bar)
	var view: = get_viewport().get_visible_rect().size
	body.custom_minimum_size = Vector2(maxf(240.0, view.x - 28.0), 0.0) if touch_ui() else CLOSET_SIZE
	for t in CLOSET_TABS:
		var id: = str(t[0])
		var b: = _ro_button(tr(str(t[1])), func():
			if id == current:
				return
			ui_click()
			w.shut.call()
			show_closet(_closet_cid, id))
		b.custom_minimum_size = Vector2(maxf(54.0, (view.x - 52.0) / float(CLOSET_TABS.size())), 40 if touch_ui() else 30) if touch_ui() else Vector2(110, 30)
		if id == current:
			b.disabled = true
		bar.add_child(b)



func _closet_close(w: Dictionary) -> void :
	if _mode == "wardrobe":
		_wardrobe_leave()
	else:
		w.shut.call()





