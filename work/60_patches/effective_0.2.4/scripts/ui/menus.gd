func show_coop() -> void :
	var net: NetSync = world.net
	if net.mode == "":
		if world.channel.quick != "":
			_coop_quick()
		else:
			_coop_menu()
		return
	_mode = "coop"
	var col: = _screen(tr("Grupo cooperativo"), tr("Hasta 4 jugadores · el líder elige el mapa y la dificultad con su progreso"))
	_npc_cutin("npc_party")
	_cutin_say(tr("¡Qué buen grupo! En cuanto el líder elija el mapa, salimos."), tr("Lydia"))
	var status: = UiKit.label("", 13, UiKit.MUTED)
	status.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER
	var members: = VBoxContainer.new()
	members.add_theme_constant_override("separation", 4)
	var buttons: = HBoxContainer.new()
	buttons.alignment = BoxContainer.ALIGNMENT_CENTER
	buttons.add_theme_constant_override("separation", 10)
	var back: = UiKit.button(tr("Volver"))
	back.custom_minimum_size.x = 120
	back.pressed.connect(_back_to_hub)
	col.add_theme_constant_override("separation", 10)
	var eos = net.eos()
	var code: String = eos.code if eos != null and str(eos.code) != "" else ""
	if net.is_host():
		if code != "":
			col.add_child(_coop_ticket(code))
		else:
			var ips: = Array(IP.get_local_addresses()).filter( func(a): return str(a).count(".") == 3 and not str(a).begins_with("127."))

			ips.sort_custom( func(a, b): return not str(a).begins_with("169.254") and str(b).begins_with("169.254"))
			col.add_child(_coop_ticket(", ".join(ips.slice(0, 2)), tr("Sala abierta en la red local")))
	else:
		var wait: = UiKit.label(tr("En la sala %s · esperando que el líder empiece") % code if code != "" else tr("Conectado · esperando que el líder empiece"), 15, 
			UiKit.GOLD, true)
		wait.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER
		col.add_child(wait)
	col.add_child(members)
	col.add_child(_coop_online_option())
	col.add_child(status)
	var shown: = [""]
	var refresh: = func():
		if net.mode == "":
			show_coop()
			return

		var incoming: int = world.channel.quick_incoming() if net.is_host() else 0
		var key: = var_to_str(net.roster.map( func(m): return [m.id, m["class"], m.name])) + str(incoming)
		if key != shown[0]:
			shown[0] = key
			for c in members.get_children():
				c.queue_free()
			members.add_child(_coop_slots(net.roster, net.my_id(), incoming))
		if net.is_host():
			var waiting: = net.peers.size() - net.ready_peers().size()
			status.text = tr("Jugadores: %d / 4") % maxi(1, net.roster.size()) + ("  ·  " + tr("conectando %d...") % waiting if waiting > 0 else "")
		else:
			status.text = tr("Jugadores: %d / 4") % net.roster.size() if not net.roster.is_empty() else tr("Conectando con el líder...")
	refresh.call()
	var tick: = Timer.new()
	tick.wait_time = 0.5
	tick.autostart = true
	tick.timeout.connect( func():
		if _mode == "coop":
			refresh.call())
	col.add_child(tick)
	var hint: = UiKit.label(tr("Todos pueden cambiar de clase y equiparse en la ciudad; el líder elige el mapa en el portal.")
		if net.is_host() else tr("Puedes cambiar de clase y equiparte mientras tanto; el líder elige el mapa."), 12, UiKit.MUTED)
	hint.autowrap_mode = TextServer.AUTOWRAP_WORD_SMART
	hint.custom_minimum_size.x = 420
	hint.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER
	col.add_child(hint)




	var my_cid: String = world.town.class_id if world.town != null else _run_class
	if GameData.CLASSES.has(my_cid):
		var prefs: = UiKit.button(tr("Destierros y favoritas"))
		prefs.pressed.connect( func():
			ui_click()
			RunPrefs.open(self, my_cid, false, func(): net.update_class(my_cid)))
		buttons.add_child(prefs)



		var prio: = UiKit.button(tr("Prioridad de mejoras"))
		prio.tooltip_text = tr("Qué sube primero «Elegir al azar» con esta clase, y hasta qué nivel.")
		prio.pressed.connect( func():
			ui_click()
			show_pick_order(my_cid))
		buttons.add_child(prio)
	var leave: = UiKit.button(tr("Cerrar sala") if net.is_host() else tr("Salir de la sala"))
	leave.pressed.connect( func():
		net.leave()
		show_coop())
	buttons.add_child(leave)
	buttons.add_child(back)
	col.add_child(buttons)





func _coop_menu(message: = "") -> void :
	_mode = "coop"
	var ch: TownChannel = world.channel
	var body: = _ro_screen(tr("Grupos"), 340)


	if world.net.eos() == null and OS.has_feature("web"):
		body.add_child(_npc_header("npc_party", tr("Lydia"), tr("En el navegador aún no puedo juntar aventureros: el juego en grupo llega pronto a esta versión. ¡En PC y Android ya te espero!"), 320))
		var only: = HBoxContainer.new()
		only.alignment = BoxContainer.ALIGNMENT_END
		body.add_child(only)
		var shut: = _ro_button(tr("Cerrar"), _back_to_hub)
		only.add_child(shut)
		shut.grab_focus.call_deferred()
		return
	body.add_child(_npc_header("npc_party", tr("Lydia"), message if message != "" else tr("¡Hola! Juntar aventureros es lo mío. ¿Armamos un grupo?"), 320))
	body.add_child(_ro_text(tr("Grupo cooperativo"), 12, Color(0.12, 0.25, 0.75), true))
	var create: = _menu_option(_item_icon("sign_chat"), tr("Crear sala"), tr("Serás el líder: eliges el mapa y la dificultad"), _coop_create)
	body.add_child(create)
	body.add_child(_menu_option(_item_icon("memorize"), tr("Unirse con un código"), tr("Escribe el código que te pasó tu amigo"), _coop_join))
	body.add_child(_menu_option(_item_icon("telescope"), tr("Buscar party rápido"), tr("Hasta 4 jugadores; el más avanzado será el líder"), 
		func():
			if await ch.quick_start_async():
				_coop_quick()
			else:
				_coop_menu(ch.error)))
	body.add_child(_ro_text(tr("Prontera online"), 12, Color(0.12, 0.25, 0.75), true))
	body.add_child(_coop_online_option())
	if ch.is_in():
		body.add_child(_menu_option(_item_icon("boots"), tr("Salir del canal"), tr("Prontera sin otros jugadores hasta que vuelvas a entrar"), func():
			await ch.leave_async(true)
			_coop_menu()))
