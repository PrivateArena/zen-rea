	tag.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER
	tag.custom_minimum_size.x = 82
	col.add_child(tag)
	_set_hover(b, {"title": tr(str(d.name)) if owned else "???", "tag": "%s  ·  %s" % [tr(str(GameData.COSMETIC_SLOT_NAMES[d.slot])), tr(str(rar.name))], 
		"color": rar.color, "desc": (tr("Haz clic para quitártelo.") if on else tr("Haz clic para ponértelo.")) if owned
			else tr("Aún no lo tienes.")})
	if owned:
		b.pressed.connect( func():
			Save.wear_cosmetic(class_id, str(d.slot), "" if on else id)
			ui_click()
			refill.call())
	return b




