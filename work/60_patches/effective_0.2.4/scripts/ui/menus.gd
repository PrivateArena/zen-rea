		_album_note = []
	var sets_box: = _sets_bar("cards", tr("Sets de cartas"), 
		func() -> Variant: return Save.equipped_cards(), 
		func(v: Variant) -> String: return _load_card_set(v), 
		func(msg: String, good: bool):
			_album_note = [msg, good]
			show_album())
	sets_box.size_flags_horizontal = Control.SIZE_EXPAND_FILL
	for i in slots:
