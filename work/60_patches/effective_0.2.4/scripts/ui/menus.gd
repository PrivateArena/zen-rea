func _eternal_fits(it: Dictionary) -> Array:
	return GameData.CARDS.keys().filter( func(c): return Save.eternal_free(c) > 0 and Equipment.card_fits(it, str(c)))




func _no_eternal_help(it: Dictionary) -> Control:
	var kind: = Equipment.item_type(it)
