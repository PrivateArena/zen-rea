func _fest_standing(d: Dictionary) -> Control:
	var me = d.get("me")
	var total: = int(d.get("total", 0))
	var box: = PanelContainer.new()
	var sb: = StyleBoxFlat.new()
	sb.bg_color = Color(1.0, 0.95, 0.78)
	sb.border_color = Color(0.88, 0.62, 0.12)
	sb.set_border_width_all(1)
	sb.set_corner_radius_all(6)
	sb.content_margin_left = 8
	sb.content_margin_right = 8
	sb.content_margin_top = 3
	sb.content_margin_bottom = 3
	box.add_theme_stylebox_override("panel", sb)
	var text: = ""
	if not (me is Dictionary):
		text = tr("Aún no estás en este ranking: juega el festival para entrar.")
	else:
		var rank: = int(me.get("rank", 0))
		if rank <= 1:
			text = tr("Tú: #1 de %d  ·  ¡vas primero!") % total
		else:
			text = tr("Tú: #%d de %d") % [rank, total]

			for r in d.get("top", []):
				if int(r.get("rank", 0)) == rank - 1:
					var more: = int(r.get("mvps", 0)) - int(me.get("mvps", 0))
					if more > 0:
						text += "  ·  " + tr_n("te falta %d Emperium para el #%d", "te faltan %d Emperiums para el #%d", more) % [more, rank - 1]
					else:
						text += "  ·  " + tr("te faltan %s de daño para el #%d") % [RoBasicWindow._thousands(int(r.get("score", 0)) - int(me.get("score", 0)) + 1), rank - 1]
					break
	var l: = UiKit.label(text, 12, Color(0.5, 0.3, 0.0), true)
	l.autowrap_mode = TextServer.AUTOWRAP_WORD_SMART
	box.add_child(l)
	return box


