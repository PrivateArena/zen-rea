func _cancel_start() -> void :
	if _mode != "start_skill" or not _start_cancel.is_valid():
		return
	var out: = _start_cancel
	_start_cancel = Callable()
	close()
	get_tree().paused = false
	out.call()


func _pick_start(index: int) -> void :
	if _mode != "start_skill" or _grace > 0.0 or index >= _choices.size():
		return
	_mode = "start_skill_pick"
	var id: String = _choices[index]
	world.play_sound(str(GameData.SKILLS[id].get("sound", "")), 0.0, -2.0)
	world.play_sound("drop_green", 0.0, -8.0)
	for i in _cards.size():
		var c: Control = _cards[i]
		if not is_instance_valid(c):
			continue
		var tw: = c.create_tween().set_pause_mode(Tween.TWEEN_PAUSE_PROCESS).set_parallel()
		if i == index:


			tw.tween_property(c, "modulate", Color(1.8, 1.65, 1.25), 0.07)
			tw.tween_property(c, "position:y", c.position.y - 10.0, 0.08).set_ease(Tween.EASE_OUT)
			tw.chain().tween_property(c, "modulate", Color.WHITE, 0.14)
			tw.parallel().tween_property(c, "position:y", c.position.y, 0.14).set_trans(Tween.TRANS_BOUNCE).set_ease(Tween.EASE_OUT)
		else:
			tw.tween_property(c, "modulate:a", 0.15, 0.15)
	var done: = create_tween().set_pause_mode(Tween.TWEEN_PAUSE_PROCESS)
	done.tween_interval(0.26)
	done.tween_callback( func():
		if _mode != "start_skill_pick":
			return
		close()
		get_tree().paused = false
		if _start_done.is_valid():
			_start_done.call(id))



func _reroll() -> void :
	if _mode != "level_up" or _grace > 0.0 or world.player.rerolls <= 0:
		return
	world.player.rerolls -= 1
	world.play_sound("ui_click", 0.0, -2.0)
	world.play_sound("drop_blue", 0.0, -8.0)
	if world.net.is_client():

		world.net.send_reroll()
		return
	world.player.offer = world.player.build_choices()
	show_level_up(world.player.offer)




func _arm_banish(on: bool) -> void :
	if _mode != "level_up":
		return
	_banish_armed = on
	world.play_sound("ui_click", 0.0, -4.0)
	for c in _cards:
