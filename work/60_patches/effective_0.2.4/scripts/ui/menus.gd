static func _loadout_fits(class_id: String, it: Dictionary, key: String) -> bool:
	var kind: = Equipment.item_type(it)
	if kind == ("acc" if key.begins_with("acc") else key):
		return true
	return key == "shield" and kind == "weapon" and _loadout_left_ok(class_id, it)




func _loadout_swap(class_id: String, from: String, to: String) -> void :
	var lo: = Save.loadout(class_id)
	var a: = str(lo.get(from, ""))
	var b: = str(lo.get(to, ""))
	if a == "":
		return
	Save.set_loadout_slot(class_id, to, a)


	Save.set_loadout_slot(class_id, from, b if b != "" and _loadout_fits(class_id, Save.storage_item(b), from) else "")
	if _hands_full(Save.loadout(class_id)) and Save.loadout(class_id).has("shield"):
		Save.set_loadout_slot(class_id, "shield", "")
	world.play_sound("equip_item", 0.0, -2.0)
	show_loadout(class_id)



