	take.size_flags_vertical = Control.SIZE_SHRINK_CENTER
	row.add_child(take)
	return panel






func show_training_setup(what: String) -> void :
	if world == null or not world.training or world.festival_mode or world.player == null:
		return
	var cid: String = world.player.class_id
	var before: = var_to_str(Player.profile_of(cid))
	get_tree().paused = true
	_hub_return = func():
		_resume()
		if world == null or not world.training or world.player == null:
			return
		var now: = Player.profile_of(cid)




		if what in ["album", "pacts", "dishes"]:
			var p: Player = world.player
			match what:
				"album":
					p.album_cards.clear()
					for id in now.get("cards", []):
						if GameData.CARDS.has(str(id)):
							p.album_cards.append(str(id))
				"pacts":
					p.pacts = (now.get("pacts", []) as Array).filter( func(id): return GameData.PACTS.has(str(id))).slice(0, GameData.MAX_PACTS)
				"dishes":
					p.dishes = (now.get("dishes", []) as Array).filter( func(d): return GameData.RECIPES.has(str(d)))
			p.recompute()
			world.hud.bind(world)
		elif var_to_str(now) != before:
			world.hud.announce(tr("Cambios guardados"), Color(0.6, 0.9, 0.6), tr("Pulsa «Reiniciar todo» para probarlos"))
	match what:
		"pacts":
			show_pacts(cid)
		"dishes":
			show_chef()
		"album":
			show_album()
		_:
			show_loadout(cid)


func _armory_take(id: String) -> void :
	var p: Player = world.player
	var d: Dictionary = GameData.ITEMS[id]
	var it: = Equipment.make(id, 0 if d.get("legendary", false) or d.get("unique", false) else 3)


	it["lent"] = true
	var res: = p.equipment.receive(it, true)
	p.recompute()
	world.hud.bind(world)
	world.play_sound("equip_item", 0.0, -4.0)
	var where: = tr("equipado") if str(res.get("result", "")) == "equipped" else tr("a la bolsa")
	_arm_msg.text = tr("%s: %s") % [Equipment.item_name(it), where]





func _armory_take_own(stored: Dictionary) -> void :
	var p: Player = world.player



	var it: Dictionary = Equipment.from_storage(stored)
	p.equipment.bag_max = maxi(p.equipment.bag_max, p.equipment.bag.size() + GameData.TRAINING_BAG_SPARE)
	var res: = p.equipment.receive(it, true)
	p.recompute()
	world.hud.bind(world)
	world.play_sound("equip_item", 0.0, -4.0)
	var where: = tr("equipado") if str(res.get("result", "")) == "equipped" else tr("a la bolsa")
	_arm_msg.text = tr("%s: %s") % [Equipment.item_name(it), where]

	_armory_fill()
	if _arm_own_tab != null and is_instance_valid(_arm_own_tab):
		_arm_own_tab.text = _armory_own_label()


func _armory_own_label() -> String:
	return tr("Tu almacén (%d)") % World.training_own_items(world.player, bool(_arm.all)).size()


