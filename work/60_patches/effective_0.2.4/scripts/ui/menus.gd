func _store_filter(grid: Control) -> void :
	var needle: = _fold(_store_query.strip_edges())
	for c in grid.get_children():
		if not c.has_meta("store_it"):

			if c.has_meta("store_gap"):
				c.visible = needle == ""
			continue
		var it: Dictionary = c.get_meta("store_it")
		if needle == "":
			c.visible = true
		elif it.is_empty():
			c.visible = false
		else:
			c.visible = _fold(_store_text(it)).contains(needle)



func _store_text(it: Dictionary) -> String:
	var d: = Equipment.item_def(it)
	var parts: = [Equipment.item_name(it), str(d.get("name", "")), tr(GameData.SLOT_NAMES.get("acc1" if str(d.get("slot", "")) == "acc" else str(d.get("slot", "")), "")), 
		tr(str(d.get("desc", ""))), _mods_text(Equipment.item_mods(it))]
	for sid in GameData.SETS:
		if GameData.set_pieces(sid).has(str(it.get("id", ""))):
			parts.append(tr(str(GameData.SETS[sid].name)))
			parts.append(str(GameData.SETS[sid].get("build", "")))
	for c in it.get("eternal", []):
		if GameData.CARDS.has(str(c)):
			parts.append(tr(str(GameData.CARDS[str(c)].name)))
	if Equipment.is_unique(it):
		parts.append(tr("Único"))
	elif Equipment.is_legendary(it):
		parts.append(tr("Legendario"))
	return " ".join(parts)




