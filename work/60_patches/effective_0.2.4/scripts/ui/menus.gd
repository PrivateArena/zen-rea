	var water: = RoAssets.sprite(["karma_cursed" if dark else "karma_holy"])
	if water != null:
		var w: = UiKit.icon_rect(water.get_frame(0, 0), 34)
		w.position = Vector2(3, 3)
		art.add_child(w)
	var names: = VBoxContainer.new()
	names.add_theme_constant_override("separation", -2)
	names.size_flags_vertical = Control.SIZE_SHRINK_CENTER
	names.mouse_filter = Control.MOUSE_FILTER_IGNORE
	top.add_child(names)
	names.add_child(_ro_text(tr("Hel") if dark else tr("Valhalla"), 15, ink, true))
	names.add_child(_ro_text(way, 10, Color(ink, 0.75)))
	var body: = MarginContainer.new()
	body.add_theme_constant_override("margin_left", 8)
	body.add_theme_constant_override("margin_right", 8)
	body.add_theme_constant_override("margin_top", 6)
	body.add_theme_constant_override("margin_bottom", 8)
	body.size_flags_vertical = Control.SIZE_EXPAND_FILL
	body.mouse_filter = Control.MOUSE_FILTER_PASS
	col.add_child(body)
	var list: = VBoxContainer.new()
	list.add_theme_constant_override("separation", 4)
	list.mouse_filter = Control.MOUSE_FILTER_PASS
	body.add_child(list)
	list.add_child(_ro_text(tr("Ganas").to_upper(), 9, Color(0.2, 0.5, 0.26), true))
	for g in gains:
		list.add_child(_karma_line(g, ink))
	list.add_child(_ro_text(tr("A cambio").to_upper(), 9, Color(0.6, 0.32, 0.26), true))
	for c in costs:
		list.add_child(_karma_line(c, ink))
	var gap: = Control.new()
	gap.custom_minimum_size.y = 4
	gap.size_flags_vertical = Control.SIZE_EXPAND_FILL
	gap.mouse_filter = Control.MOUSE_FILTER_IGNORE
	list.add_child(gap)
