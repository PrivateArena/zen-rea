func _friend_row(f: Dictionary, h: float, back: Callable) -> Control:
	var fr = world.friends
	var touch: = touch_ui()
	var state: = str(f.state)
	var online: = bool(f.get("online", false))
	var card: = PanelContainer.new()
	var cb: = UiKit.panel_box(Color(0.97, 1.0, 0.97) if online else Color(0.97, 0.975, 0.99), 
		Color(0.55, 0.8, 0.6) if online else Color(0.8, 0.83, 0.9), 8, 1)
	cb.content_margin_left = 8
	cb.content_margin_right = 8
	cb.content_margin_top = 4
	cb.content_margin_bottom = 4
	cb.shadow_size = 0
	card.add_theme_stylebox_override("panel", cb)
	card.custom_minimum_size.y = h
	var row: = HBoxContainer.new()
	row.add_theme_constant_override("separation", 8)
	card.add_child(row)

	var dot: = Panel.new()
	dot.custom_minimum_size = Vector2(10, 10)
	dot.size_flags_vertical = Control.SIZE_SHRINK_CENTER
	var db: = StyleBoxFlat.new()
	db.bg_color = Color(0.25, 0.75, 0.35) if online else Color(0.72, 0.74, 0.8)
	db.set_corner_radius_all(5)
	dot.add_theme_stylebox_override("panel", db)
	row.add_child(dot)
	var ic: = UiKit.icon_rect(_friend_job_icon(str(f.get("class", "")), str(f.get("job", ""))), 24)
	ic.texture_filter = RoAssets.ui_filter()
	ic.size_flags_vertical = Control.SIZE_SHRINK_CENTER
	row.add_child(ic)
	var col: = VBoxContainer.new()
	col.add_theme_constant_override("separation", 0)
	col.size_flags_horizontal = Control.SIZE_EXPAND_FILL
	col.size_flags_vertical = Control.SIZE_SHRINK_CENTER
	row.add_child(col)
	var line: = HBoxContainer.new()
	line.add_theme_constant_override("separation", 4)
	col.add_child(line)
	line.add_child(_ro_text(str(f.get("name", "?")), 12, Color(0.12, 0.16, 0.32), true))
	line.add_child(_ro_text(str(f.get("tag", "")), 10, Color(0.3, 0.32, 0.42)))
	var sub: = ""
	match state:
		"friend":
			sub = fr.where_text(f)
		"incoming":
			sub = tr("Quiere ser tu amigo")
		_:
			sub = tr("Solicitud enviada, esperando respuesta")
	col.add_child(_ro_text(sub, 10, Color(0.2, 0.55, 0.28) if online else Color(0.42, 0.44, 0.52)))
	var bh: = 32 if touch else 22
	var id: = int(f.id)
	var mk: = func(text: String, primary: bool, cb2: Callable) -> Button:
		var b: = _ro_button(text, cb2)
		b.custom_minimum_size = Vector2(0, bh)
		b.size_flags_vertical = Control.SIZE_SHRINK_CENTER
		if primary:
			_select_style(b)
		row.add_child(b)
		return b
	if state == "friend":

		var ch: TownChannel = world.channel
		var n: = int(f.get("channel", 0))
		if online and n > 0 and world.town != null and ch != null and not (ch.is_in() and ch.number == n):
			mk.call(tr("Ir a su canal"), true, func():
				_friends_note(tr("Entrando al canal %d...") % n, true)
				show_friends(back)
				var ok: bool = await ch.join_async(n)
				_friends_note(tr("Estás en el canal %d.") % n if ok else tr("No se pudo entrar al canal %d (¿lleno?).") % n, ok)
				if _mode == "friends":
					show_friends(back))
		elif online and n > 0 and ch != null and ch.is_in() and ch.number == n and world.town != null:
			var here: = _ro_text(tr("En tu canal"), 10, Color(0.2, 0.55, 0.28), true)
			here.size_flags_vertical = Control.SIZE_SHRINK_CENTER
			row.add_child(here)

		var rm: Button = mk.call("✕", false, func(): pass)
		rm.custom_minimum_size.x = bh
		rm.tooltip_text = tr("Quitar de amigos")
		rm.pressed.connect( func():
			if not rm.has_meta("sure"):
				rm.set_meta("sure", true)
				rm.text = tr("¿Quitar?")
				return
			fr.remove(id, func(_ok):
				_friends_note(tr("%s ya no está en tu lista.") % str(f.name), true)
				if _mode == "friends":
					show_friends(back)))
	elif state == "incoming":
		mk.call(tr("Aceptar"), true, func():
			fr.answer(id, true, func(_ok):
				_friends_note(tr("¡%s ya es tu amigo!") % str(f.name), true)
				if _mode == "friends":
					show_friends(back)))
		mk.call(tr("Rechazar"), false, func():
			fr.answer(id, false, func(_ok):
				if _mode == "friends":
					show_friends(back)))
	else:
		mk.call(tr("Cancelar"), false, func():
			fr.remove(id, func(_ok):
				if _mode == "friends":
					show_friends(back)))
	return card



func _friend_job_icon(cls: String, job: String) -> Texture2D:
	var jn: = str(GameData.CLASSES[cls].name) if GameData.CLASSES.has(cls) else "Novice"
	if GameData.CLASSES.has(cls) and job != "":
		for j in GameData.job_paths(cls):
			if str(j.get("id", "")) == job:
				jn = str(j.name)
			elif j.has("trans") and str(j.trans.get("id", "")) == job:
				jn = str(j.trans.name)
	var path: = "res://assets/ro/ui/skin/job_icons/%d.png" % int(GameData.JOB_ICON_IDS.get(jn, GameData.JOB_ICON_IDS.get(
		str(GameData.CLASSES.get(cls, {}).get("name", "")), 0)))
	return load(path) as Texture2D if ResourceLoader.exists(path) else null




func _friend_from_town(mid: int) -> void :
	var ch: = world.channel
	var m: Dictionary = ch.members.get(mid, {})
	var who: = str(m.get("name", "")).strip_edges()
	var tag: = str(m.get("ft", "")).trim_prefix("#")
	if who == "" or tag.length() != 4:
		return
	world.friends.ask_name(who, tag, func(status: String, shown: String):
		var notes: = {"sent": tr("Solicitud de amistad enviada a %s.") % shown, "accepted": tr("¡%s ya es tu amigo!") % shown, 
			"already": tr("%s ya está en tu lista de amigos.") % shown, "full": tr("Tu lista de amigos está llena (50)."), 
			"self": tr("Ese eres tú."), "offline": tr("Sin conexión: inténtalo de nuevo.")}
		ch.log_line("sys", str(notes.get(status, tr("No se pudo agregar a %s: aún no aparece en el servidor (inténtalo en unos minutos).") % shown))))


func _class_title(class_id: String) -> String:
	if Save.is_reborn(class_id) and GameData.HIGH_NAMES.has(class_id):
		return tr(GameData.HIGH_NAMES[class_id])
	return tr(GameData.CLASSES[class_id].name)


func _buy_sage(id: String) -> void :
	var lv: = Save.upgrade_level(id)
	if lv >= int(GameData.SAGE_UPGRADES[id].max):
		return
	if Save.spend(GameData.sage_cost(id, lv)):
		Save.set_upgrade_level(id, lv + 1)
		if world != null:
			world.play_sound("get_coin", 0.0, -3.0)
	show_sage()


func _buy_upgrade(id: String) -> void :
	var lv: = Save.upgrade_level(id)
	if lv >= int(GameData.UPGRADES[id].max):
