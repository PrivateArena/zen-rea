		func(_at: Vector2, data: Variant) -> bool:
			return data is Dictionary and data.get("type", "") == "socket", 
		func(_at: Vector2, data: Variant) -> void :
			var p: = world.player
			p.equipment.unsocket(str(data.slot), int(data.index))
			p.recompute()
			world.play_sound("ui_click", 0.0, -4.0)
			show_equipment(str(data.slot), tr("%s vuelve a la bolsa de cartas.") % tr(GameData.CARDS[data.card].name)))




func _build_card_side(p: Player, body: VBoxContainer) -> void :
	var bag: Array = p.equipment.card_bag
	body.add_child(_ro_text(tr("Bolsa de cartas  %d") % bag.size(), 11, Color(0.12, 0.25, 0.75), true))
	var scroll: = ScrollContainer.new()
	scroll.horizontal_scroll_mode = ScrollContainer.SCROLL_MODE_DISABLED
	scroll.custom_minimum_size = Vector2(3 * 40 + 8 + 12, 440 - mini(2, ceili(p.album_cards.size() / 3.0)) * 60 - (24 if not p.album_cards.is_empty() else 0))
	body.add_child(scroll)
	var list: = VBoxContainer.new()
	list.add_theme_constant_override("separation", 3)
	list.size_flags_horizontal = Control.SIZE_EXPAND_FILL
	list.size_flags_vertical = Control.SIZE_EXPAND_FILL
	list.mouse_filter = Control.MOUSE_FILTER_STOP
	scroll.add_child(list)

	_bag_drop_target(scroll)
	_bag_drop_target(list)
	if bag.is_empty():
		var none: = _ro_text(tr("Vacía. Las cartas sin hueco libre esperan aquí; arrastra aquí una carta del objeto para quitarla."), 10, Color(0.28, 0.3, 0.4))
		none.autowrap_mode = TextServer.AUTOWRAP_WORD_SMART
		none.custom_minimum_size.x = 128
		list.add_child(none)
	var counts: = {}
	for c in bag:
		counts[c] = int(counts.get(c, 0)) + 1
	var names: = {"weapon": tr("Arma"), "armor": tr("Armadura"), "shield": tr("Escudo"), "head": tr("Cabeza"), 
		"garment": tr("Prenda"), "shoes": tr("Calzado"), "acc": tr("Accesorio")}
	for kind in ["weapon", "armor", "shield", "head", "garment", "shoes", "acc"]:
		var ids: Array = counts.keys().filter( func(c): return str(GameData.CARDS[c].get("type", "")) == kind)
		if ids.is_empty():
			continue
		list.add_child(_ro_text(names[kind], 9, Color(0.28, 0.3, 0.4), true))
		var grid: = GridContainer.new()
		grid.columns = 3
		grid.add_theme_constant_override("h_separation", 4)
		grid.add_theme_constant_override("v_separation", 4)
		list.add_child(grid)
		for id in ids:
			grid.add_child(_bag_card_cell(p, id, int(counts[id])))
	_album_side(p, body)


