	paper.add_child(body)
	var head: = UiKit.label(tr("SE BUSCA"), 30, ink, true)
	head.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER
	body.add_child(head)
	var ask: = UiKit.label(tr("¿Lo has visto?"), 13, Color(0.5, 0.34, 0.18))
	ask.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER
	body.add_child(ask)

	var frame: = PanelContainer.new()
	var fb: = StyleBoxFlat.new()
	fb.bg_color = Color(0.86, 0.78, 0.62)
	fb.border_color = Color(0.45, 0.32, 0.18)
	fb.set_border_width_all(2)
	fb.set_content_margin_all(3)
	frame.add_theme_stylebox_override("panel", fb)
	frame.size_flags_horizontal = Control.SIZE_SHRINK_CENTER
	body.add_child(frame)
	var pic: = TextureRect.new()
	pic.custom_minimum_size = Vector2(200, 200)
	pic.expand_mode = TextureRect.EXPAND_IGNORE_SIZE
	pic.stretch_mode = TextureRect.STRETCH_KEEP_ASPECT_COVERED
	pic.clip_contents = true
	var illust: = "res://assets/ro/ui/skin/illust/%s.png" % str(n.sprite)
	if n.has("npc_look"):
		var look: = QuestRun.npc_sprite_of(n)
		pic.texture = look.get_frame(0, 0) if look != null else null
