func _fuse_row(id: String) -> Control:
	var cost: = GameData.fuse_cost(id)
	var have: = Save.card_copies(id)
	if have >= cost:
		var b: = _album_pill(tr("¡Fundir!"), true, func(): _start_fusion(id), true, 10)
		b.size_flags_horizontal = Control.SIZE_SHRINK_CENTER
		b.tooltip_text = tr("Funde %d copias en una Carta Eterna.") % cost
		return b

	var box: = HBoxContainer.new()
	box.add_theme_constant_override("separation", 4)
	box.alignment = BoxContainer.ALIGNMENT_CENTER



	var bar: = ColorRect.new()
	bar.color = Color(0.25, 0.22, 0.3, 0.35)
	bar.custom_minimum_size = Vector2(50, 5)
	bar.size_flags_vertical = Control.SIZE_SHRINK_CENTER
	bar.mouse_filter = Control.MOUSE_FILTER_IGNORE
	var part: = clampf(float(have) / maxf(1.0, float(cost)), 0.0, 1.0)
	if part > 0.0:
		var fill: = ColorRect.new()
		fill.color = GameData.ETERNAL_COLOR
		fill.mouse_filter = Control.MOUSE_FILTER_IGNORE
		fill.position = Vector2.ZERO
		fill.size = Vector2(maxf(1.0, roundf(50.0 * part)), 5)
		bar.add_child(fill)
	box.add_child(bar)
	var lbl: = _ro_text("%d / %d" % [have, cost], 9, Color(0.5, 0.42, 0.25), true)
	lbl.size_flags_vertical = Control.SIZE_SHRINK_CENTER
	box.add_child(lbl)
	box.tooltip_text = tr("Con %d copias la fundes en una Carta Eterna (%s).") % [cost, 
		{"normal": tr("carta normal"), "boss": tr("carta de jefe"), "mvp": tr("carta de MVP")}[GameData.card_tier(id)]]
	box.mouse_filter = Control.MOUSE_FILTER_PASS
	return box



func _start_fusion(id: String) -> void :
	var cost: = GameData.fuse_cost(id)
	if not Save.fuse_card(id):
		return
	if _options != null and is_instance_valid(_options):
		close_options()
	var fx: = CardFusion.new(world, id, cost, func():
		if _mode == "album":
			show_album())
	_root.add_child(fx)
	Achievements.check()




func _fuse_all() -> void :
	var fused: Array = []
	for id in GameData.CARDS:
		var times: = 0
		while Save.fuse_card(id):
			times += 1
		if times > 0:
			fused.append([id, times])
	if fused.is_empty():
		return
	if _options != null and is_instance_valid(_options):
		close_options()
	var fx: = CardFusionAll.new(world, fused, func():
		if _mode == "album":
			show_album())
	_root.add_child(fx)
	Achievements.check()







