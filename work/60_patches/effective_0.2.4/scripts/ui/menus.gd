var _after_reveal: Callable


func show_card_reveal(id: String, then: = Callable()) -> void :
	_after_reveal = then
	var card: Dictionary = GameData.CARDS[id]
	_mode = "chest"
	world.hold_world()
	_grace = INPUT_GRACE + 0.6
	var col: = _screen(tr("¡Nueva carta!"), tr("Se guarda para siempre en el álbum"))
	_bounce_in(col.get_parent().get_parent())
	var stage: = CenterContainer.new()
	stage.custom_minimum_size = Vector2(0, 300)
	col.add_child(stage)
	var holder: = Control.new()
	holder.custom_minimum_size = Vector2(210, 280)
	stage.add_child(holder)
	var rays: = UiKit.rays(Color(1.0, 0.85, 0.35, 0.85), 420)
	rays.position = Vector2(105, 140) - Vector2(210, 210)
	holder.add_child(rays)
	rays.create_tween().set_pause_mode(Tween.TWEEN_PAUSE_PROCESS).set_loops().tween_property(rays, "rotation", TAU, 8.0).as_relative()
	var art: = UiKit.icon_rect(RoAssets.card_art(id), 0)
	art.texture_filter = CanvasItem.TEXTURE_FILTER_LINEAR
	art.size = Vector2(210, 280)
	art.pivot_offset = art.size * 0.5
	art.scale = Vector2(0.02, 1.1)
	holder.add_child(art)
	var flip: = art.create_tween().set_pause_mode(Tween.TWEEN_PAUSE_PROCESS)
	flip.tween_interval(0.15)
	flip.tween_property(art, "scale", Vector2(1.08, 1.08), 0.35).set_trans(Tween.TRANS_BACK).set_ease(Tween.EASE_OUT)
	flip.tween_property(art, "scale", Vector2.ONE, 0.15)
	var title: = UiKit.label(tr(card.name), 24, UiKit.TEXT, true)
	title.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER
	col.add_child(title)
	var slot: = str(card.get("type", ""))
	if GameData.SLOT_NAMES.has(slot):
		var where: = _lvl_chip(tr("Se inserta en: %s") % tr(GameData.SLOT_NAMES[slot]), UiKit.GOLD, false, 12)
		where.size_flags_horizontal = Control.SIZE_SHRINK_CENTER
		col.add_child(where)
	var texts: = _inset_texts(col, GameData.LEGENDARY_COLOR, 10)
	var desc: = UiKit.label(tr(card.desc), 16, UiKit.TEXT)
	desc.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER
	desc.autowrap_mode = TextServer.AUTOWRAP_WORD_SMART
	desc.custom_minimum_size.x = 420
	texts.add_child(desc)
	var ok: = UiKit.button(tr("Continuar  (Enter)"), true)
	ok.pressed.connect( func():
		if _grace <= 0.0:
			if _after_reveal.is_valid():
				var next: = _after_reveal
				_after_reveal = Callable()
				next.call()
			else:
				_close_chest())
	col.add_child(ok)
	ok.grab_focus.call_deferred()
	if world != null:
		world.play_sound("drop_purple", 0.0, 0.0)
		world.play_sound("levelup", 0.0, -6.0)
		world.hud.flash(Color(1.0, 0.9, 0.5), 0.3)




func show_card_choice(id: String) -> void :
	var p: = world.player
	var eq: = p.equipment
	_mode = "card_choice"
	world.hold_world()
	_grace = INPUT_GRACE
	var card: Dictionary = GameData.CARDS[id]
	var col: = _screen(tr("Sin ranura libre"), tr("Tu equipo ya tiene sus ranuras llenas: elige qué hacer con la carta nueva."))
	_bounce_in(col.get_parent().get_parent())

	var head: = PanelContainer.new()
	var hb: = UiKit.panel_box(Color.WHITE.lerp(GameData.LEGENDARY_COLOR, 0.06), GameData.LEGENDARY_COLOR.lerp(Color.WHITE, 0.3), 12, 2)
	hb.set_content_margin_all(12)
	hb.shadow_color = Color(GameData.LEGENDARY_COLOR, 0.25)
	hb.shadow_size = 5
	hb.shadow_offset = Vector2(0, 2)
	head.add_theme_stylebox_override("panel", hb)
	head.size_flags_horizontal = Control.SIZE_SHRINK_CENTER
	col.add_child(head)
	var top: = HBoxContainer.new()
	top.alignment = BoxContainer.ALIGNMENT_CENTER
	top.add_theme_constant_override("separation", 14)
	head.add_child(top)
	top.add_child(_card_art(id, Vector2(96, 128)))
	var info: = VBoxContainer.new()
	info.size_flags_vertical = Control.SIZE_SHRINK_CENTER
	top.add_child(info)
	var new_tag: = _lvl_chip(tr("NUEVA"), GameData.LEGENDARY_COLOR, true)
	new_tag.size_flags_horizontal = Control.SIZE_SHRINK_BEGIN
	info.add_child(new_tag)
	info.add_child(UiKit.label(tr(card.name), 20, UiKit.TEXT, true))
	var d: = UiKit.label(tr(card.desc), 14, UiKit.MUTED)
	d.autowrap_mode = TextServer.AUTOWRAP_WORD_SMART
	d.custom_minimum_size.x = 300
	info.add_child(d)
	col.add_child(UiKit.label(tr("Reemplazar (la carta que sale vuelve a la bolsa):"), 14, UiKit.GOLD, true))
	var first: Button = null
	for k in eq.fitting_slots(id):
		var it: Dictionary = eq.slots[k]
		var row: = HBoxContainer.new()
		row.add_theme_constant_override("separation", 10)
		col.add_child(row)
		var item_l: = UiKit.label(Equipment.item_name(it), 14, Equipment.item_color(it), true)
		item_l.custom_minimum_size.x = 150
		item_l.size_flags_vertical = Control.SIZE_SHRINK_CENTER
		row.add_child(item_l)

		for i in range(int(it.get("eternal_n", 0)), it.cards.size()):
			var old: String = it.cards[i]
			var b: = UiKit.button("")
			b.custom_minimum_size = Vector2(250, 64)

			_rarity_frame(b, 0, false)
			var inner: = HBoxContainer.new()
			inner.set_anchors_and_offsets_preset(Control.PRESET_FULL_RECT)
			inner.offset_left = 6
			inner.add_theme_constant_override("separation", 8)
			inner.mouse_filter = Control.MOUSE_FILTER_IGNORE
			b.add_child(inner)
			var art: = _card_art(old, Vector2(42, 56))
			art.size_flags_vertical = Control.SIZE_SHRINK_CENTER
			inner.add_child(art)
			var txt: = VBoxContainer.new()
			txt.size_flags_vertical = Control.SIZE_SHRINK_CENTER
			txt.mouse_filter = Control.MOUSE_FILTER_IGNORE
			inner.add_child(txt)
			txt.add_child(UiKit.label(tr("Cambiar %s") % tr(GameData.CARDS[old].name), 13, UiKit.TEXT, true))
			var od: = UiKit.label(tr(GameData.CARDS[old].desc), 11, UiKit.MUTED)
			od.custom_minimum_size.x = 180
			od.autowrap_mode = TextServer.AUTOWRAP_WORD_SMART
			txt.add_child(od)
			b.pressed.connect( func():
				if _grace > 0.0:
					return
				eq.swap_card(id, k, i)
				p.recompute()
				world.play_sound("equip_item", 0.0, -2.0)
				world.hud.announce(tr("%s insertada") % tr(card.name), Color(1, 1, 0.3), tr("%s vuelve a la bolsa de cartas") % tr(GameData.CARDS[old].name))
				_close_chest())
			row.add_child(b)
			if first == null:
				first = b
	var actions: = HBoxContainer.new()
	actions.alignment = BoxContainer.ALIGNMENT_CENTER
	actions.add_theme_constant_override("separation", 12)
	col.add_child(actions)
	var keep: = UiKit.button(tr("Guardar en la bolsa"), true)
	keep.pressed.connect( func():
		if _grace <= 0.0:
			world.card_memory[id] = "keep"
			world.hud.announce(tr(card.name), Color(1, 1, 0.3), tr("Guardada en la bolsa de cartas: cámbiala cuando quieras con Q"))
			_close_chest())
	actions.add_child(keep)
	var sell: = UiKit.button(tr("Vender  (+%d z)") % GameData.CARD_SELL_ZENY)
	sell.pressed.connect( func():
		if _grace > 0.0:
			return
		world.card_memory[id] = "sell"
		var z: = p.sell_card(id)
		world.add_zeny(z, "sold")
		world.play_sound("get_coin", 0.0, -4.0)
		_close_chest())
	actions.add_child(sell)
	var memo: = UiKit.label(tr("Las próximas copias de esta carta en la partida se guardan o venden igual, sin parar el juego."), 11, UiKit.MUTED)
	memo.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER
	col.add_child(memo)
	keep.grab_focus.call_deferred()


func _card_art(id: String, size: Vector2) -> TextureRect:
	var r: = TextureRect.new()
	r.texture = RoAssets.card_art(id)
	r.expand_mode = TextureRect.EXPAND_IGNORE_SIZE
	r.stretch_mode = TextureRect.STRETCH_KEEP_ASPECT_CENTERED
	r.texture_filter = CanvasItem.TEXTURE_FILTER_LINEAR
	r.custom_minimum_size = size
	r.mouse_filter = Control.MOUSE_FILTER_IGNORE
	return r


func _close_chest() -> void :
	get_tree().paused = false
	close()



const TAMING_SPIN: = 0
const TAMING_OK: = 2
const TAMING_FAIL: = 3
const TAMING_SPIN_TIME: = 2.2




func show_onboarding(from_pause: = false) -> void :
	_mode = "onboarding"
	world.hold_world()
	_grace = INPUT_GRACE
	var col: = _screen(tr("¡Bienvenido a Midgard!"), tr("Sobrevive a las oleadas, sube de nivel y derrota al MVP del mapa."))
	_bounce_in(col.get_parent().get_parent())
	var rows: Array = [
		[["W", "A", "S", "D"], tr("Moverte"), false], 
		[[tr("Clic")], tr("Caminar hasta el punto marcado (WASD lo cancela)"), false], 
		[["Q"], tr("Equipo e inventario: equipar, refinar e insertar cartas"), true], 
		[["1", "2", "3"], tr("Elegir mejora al subir de nivel"), false], 
		[[tr("Rueda")], tr("Acercar o alejar la cámara"), false], 
		[["Tab"], tr("Abrir las mejoras de nivel guardadas"), false], 
		[["Esc"], tr("Pausa"), false], 
	]

	if bool(Save.setting("camera_turn", true)):
		rows.insert(3, [[tr("Clic der.")], tr("Arrastra para girar la cámara (doble clic: vista normal)"), false])
	if world != null and world.player != null and world.player.can_switch_ammo():
		rows.insert(3, [["C / V"], tr("Cambiar de munición"), false])
	if world != null and world.player != null and Uniques.cannon(world.player) != "":
		rows.insert(3, [["R"], tr("Disparar la Excalibur o el Juperos Railgun"), false])
	rows.insert(3, [["F"], tr("Activar o desactivar habilidades (insignia F)"), false])
	var grid: = GridContainer.new()
	grid.columns = 2
	grid.add_theme_constant_override("h_separation", 16)
	grid.add_theme_constant_override("v_separation", 10)
	var center: = CenterContainer.new()
	center.add_child(grid)
	col.add_child(center)
	for r in rows:
		var keys: = HBoxContainer.new()
		keys.alignment = BoxContainer.ALIGNMENT_END
		keys.add_theme_constant_override("separation", 4)
		keys.custom_minimum_size.x = 150
		for k in r[0]:
			keys.add_child(_keycap(k, r[2]))
		grid.add_child(keys)
		var what: = UiKit.label(r[1], 16, UiKit.GOLD if r[2] else UiKit.TEXT, r[2])
		what.size_flags_vertical = Control.SIZE_SHRINK_CENTER
		grid.add_child(what)
	var auto: = UiKit.label(tr("Tus habilidades atacan solas: tú decides dónde estar."), 14, UiKit.MUTED)
	auto.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER
	col.add_child(auto)
	var ok: = UiKit.button(tr("Volver") if from_pause else tr("¡A la aventura!  (Enter)"), true)
	ok.pressed.connect( func():
		if _grace <= 0.0:
			if from_pause:
				show_pause()
			else:
				_close_onboarding())
	col.add_child(ok)
	ok.grab_focus.call_deferred()





func show_taming(id: String, ok: bool, finish: Callable) -> void :
	var spr: = RoAssets.sprite(["slotmachine"])
	if spr == null:
		world.play_sound("tame_ok" if ok else "tame_fail")
		finish.call()
		return
	_clear()
	_mode = "taming"
	world.hold_world()
	_root.mouse_filter = Control.MOUSE_FILTER_STOP
	_root.add_child(UiKit.backdrop(0.35))
	var view: = get_viewport().get_visible_rect().size
	var k: = maxf(2.0, floorf(view.y / 360.0))
	var machine: = TextureRect.new()
	machine.texture_filter = RoAssets.ui_filter()
	machine.texture = spr.get_frame(TAMING_SPIN, 0)
	machine.size = Vector2(spr.canvas_size)
	machine.scale = Vector2(k, k)
	machine.position = ((view - machine.size * k) * 0.5).floor()
	_root.add_child(machine)
	var title: = UiKit.label(tr("Domando a %s...") % tr(GameData.PETS[id].name), 20, Color.WHITE, true)
	title.add_theme_constant_override("outline_size", 6)
	title.add_theme_color_override("font_outline_color", Color(0.1, 0.08, 0.2, 0.95))
	title.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER
	title.size = Vector2(view.x, 28)
	title.position = Vector2(0, machine.position.y - 40)
	_root.add_child(title)
	var play: = func(frame: float, action: int):
		if is_instance_valid(machine):
			machine.texture = spr.get_frame(action, int(frame))
	world.play_sound("tame_roulette", 0.0, -2.0)
	var spin_frames: = spr.frame_count(TAMING_SPIN)
	var tw: = machine.create_tween().set_pause_mode(Tween.TWEEN_PAUSE_PROCESS)

	tw.tween_method(play.bind(TAMING_SPIN), 0.0, float(spin_frames * 5) - 0.01, TAMING_SPIN_TIME).set_trans(Tween.TRANS_QUAD).set_ease(Tween.EASE_OUT)
	var stop: = TAMING_OK if ok else TAMING_FAIL
	tw.tween_callback( func():
		world.play_sound("tame_ok" if ok else "tame_fail")
		title.text = (tr("¡Has domado a %s!") % tr(GameData.PETS[id].name)) if ok else tr("Falló...")
		title.add_theme_color_override("font_color", Color(1.0, 0.75, 0.9) if ok else Color(0.8, 0.82, 0.9))
		if ok:
			_taming_reveal(id, machine, k))
	tw.tween_method(play.bind(stop), 0.0, float(spr.frame_count(stop)) - 0.01, spr.frame_delay(stop) * spr.frame_count(stop))
	tw.tween_interval(2.0 if ok else 0.9)
	tw.tween_callback( func():
		_close_chest()
		finish.call())



func _taming_reveal(id: String, machine: Control, k: float) -> void :
	var view: = get_viewport().get_visible_rect().size
	var mob: = RoAssets.sprite([id])


	var right: = machine.size.x
	var tex: = (machine as TextureRect).texture if machine is TextureRect else null
	if tex != null:
		var img: = RoAssets.tex_image(tex)
		if img != null and not img.is_empty():
			right = float(img.get_used_rect().end.x)
	var w: = 220.0

	var x: = minf(machine.position.x + right * k + 48.0 * k, view.x - w - 16.0)
	var y: = machine.position.y + machine.size.y * k * 0.35
	if mob != null:


		var img: = mob.compose_image(0, 0)
		var used: = img.get_used_rect()
		if used.has_area():
			img = img.get_region(used)
		var pet: = TextureRect.new()
		pet.texture_filter = RoAssets.ui_filter()
		pet.texture = ImageTexture.create_from_image(img)
		pet.size = Vector2(img.get_size())


		pet.pivot_offset = Vector2(pet.size.x * 0.5, pet.size.y)
		pet.scale = Vector2(2, 2)
		var ground: = y + 72.0
		var top: = ground - pet.size.y
		pet.position = Vector2(roundf(x + w * 0.5 - pet.size.x * 0.5), top)
		_root.add_child(pet)
		var hop: = pet.create_tween().set_pause_mode(Tween.TWEEN_PAUSE_PROCESS).set_loops(3)
		hop.tween_property(pet, "position:y", top - 14.0, 0.18).set_trans(Tween.TRANS_QUAD).set_ease(Tween.EASE_OUT)
		hop.tween_property(pet, "position:y", top, 0.18).set_trans(Tween.TRANS_QUAD).set_ease(Tween.EASE_IN)
		y = ground + 8.0
	var bonus: = UiKit.label(tr("Mascota: %s") % tr(str(GameData.PETS[id].desc)), 15, Color(1.0, 0.92, 0.75), true)
	bonus.add_theme_constant_override("outline_size", 5)
	bonus.add_theme_color_override("font_outline_color", Color(0.1, 0.08, 0.2, 0.95))
	bonus.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER
	bonus.autowrap_mode = TextServer.AUTOWRAP_WORD_SMART
	bonus.custom_minimum_size.x = w
	bonus.size = Vector2(w, 24)
	bonus.position = Vector2(x, y)
	_root.add_child(bonus)


func _close_onboarding() -> void :
	Save.set_setting("onboarded", true)
	_close_chest()



