static var _luma_shader: Shader



static func _luma_alpha_shader() -> Shader:
	if _luma_shader == null:
		_luma_shader = Shader.new()
		_luma_shader.code = "shader_type canvas_item;\nvoid fragment() {\n\tvec4 c = texture(TEXTURE, UV);\n\tfloat a = max(c.r, max(c.g, c.b));\n\tCOLOR = vec4(c.rgb / max(a, 0.001), a);\n}"





	return _luma_shader




