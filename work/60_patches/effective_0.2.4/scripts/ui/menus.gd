	sell.disabled = locked
	var lock: = _ro_button(tr("Desbloquear") if locked else tr("Bloquear"), func(): _inv_lock(selected))
	lock.tooltip_text = tr("Bloqueado no se vende: ni con «Aplicar filtro», «Repetidos», Ctrl + clic ni con la bolsa llena. Al terminar, sale primero en el informe para llevarlo al almacén. Clic derecho en la casilla: bloquear / desbloquear.")
	acts.add_child(lock)




