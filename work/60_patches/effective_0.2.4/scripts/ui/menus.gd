func _reopen_options(tab: String) -> void :
	var at: = 0
	var old: ScrollContainer = _options.find_child("OptionsScroll", true, false) if _options != null and is_instance_valid(_options) else null
	if old != null:
		at = old.scroll_vertical
	show_options(tab)
	if at <= 0:
		return

	await get_tree().process_frame
	await get_tree().process_frame
	var now: ScrollContainer = _options.find_child("OptionsScroll", true, false) if _options != null and is_instance_valid(_options) else null
	if now != null:
		now.scroll_vertical = at


