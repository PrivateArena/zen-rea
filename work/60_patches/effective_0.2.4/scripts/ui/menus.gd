var _plag_filter: = "all"

var _plag_note: = ""






func _album_plagiarism(body: VBoxContainer, width: float) -> void :
	var pairs: = GameData.plagiarism_pairs().filter( func(pr): return GameData.SKILLS.has(pr[1]) and GameData.MONSTERS.has(pr[0]))
	var have: = Save.plagiarized()
	var on: = Save.plagiarism_active()
	var pick: = Save.plagiarism_pick()
	var got_n: = pairs.filter( func(pr): return have.has(pr[1])).size()
	_album_head(body, UiKit.skill_icon("intimidate"), tr("Plagio  %d / %d") % [got_n, pairs.size()], 
		got_n / maxf(1.0, pairs.size()), width, 
		tr("Con un Thief (o su Rogue, Stalker, Assassin o Assassin Cross), vence a un jefe o MVP para copiar su habilidad para siempre (si tiene dos, una por cada victoria). Después elige dónde puede salirte al subir de nivel."))
	var loadouts: = HBoxContainer.new()
	loadouts.add_theme_constant_override("separation", 8)
	body.add_child(loadouts)
	loadouts.add_child(_plag_loadout(tr("Partidas de Rogue y Stalker"), 
		tr("Hasta %d habilidades copiadas pueden salirte al subir de nivel.") % GameData.PLAGIARISM_ACTIVE, 
		on, GameData.PLAGIARISM_ACTIVE, false, 3.0))
	loadouts.add_child(_plag_loadout(tr("Todas las clases"), tr("Una habilidad copiada que le puede salir a cualquier clase."), 
		[pick] if pick != "" else [], GameData.PLAGIARISM_ANY, true, 2.0))
	_plag_note = ""
	var filters: = HBoxContainer.new()
	filters.add_theme_constant_override("separation", 4)
	body.add_child(filters)
	for f in [["all", tr("Todas  %d") % pairs.size()], ["got", tr("Copiadas  %d") % got_n], ["missing", tr("Faltan  %d") % (pairs.size() - got_n)]]:
		var fid: String = f[0]
		filters.add_child(_album_pill(f[1], _plag_filter == fid, func():
			_plag_filter = fid
			show_album()))
	var scroll: = _album_scroll_area(body, width, 330.0)
	var cols: = maxi(2, int((width - 30.0) / 300.0))
	var cell_w: = (width - 44.0 - (cols - 1) * 6.0) / cols


	var list: = VBoxContainer.new()
	list.add_theme_constant_override("separation", 6)
	scroll.add_child(list)
	for passive in [false, true]:
		var shown: = pairs.filter( func(pr):
			var got: bool = have.has(pr[1])
			if (_plag_filter == "got" and not got) or (_plag_filter == "missing" and got):
				return false
			return Player.is_passive(str(pr[1])) == passive)
		if shown.is_empty():
			continue
		list.add_child(_ro_text("%s  %d" % [tr("Pasivas") if passive else tr("Activas"), shown.size()], 12, Color(0.12, 0.2, 0.45), true))
		var grid: = GridContainer.new()
		grid.columns = cols
		grid.add_theme_constant_override("h_separation", 6)
		grid.add_theme_constant_override("v_separation", 6)
		list.add_child(grid)
		for pr in shown:
			grid.add_child(_plag_cell(pr[0], pr[1], have.has(pr[1]), on.has(pr[1]), pick == pr[1], cell_w))




func _album_history(body: VBoxContainer, width: float) -> void :
	var runs: = Save.history()
	var wins: = runs.filter( func(r): return bool(r.get("victory", false))).size()
	_album_head(body, UiKit.skill_icon("owls_eye"), tr("Historial  %d") % runs.size(), wins / maxf(1.0, runs.size()), width, 
		tr("Tus últimas %d partidas en este dispositivo, la más reciente arriba.") % Save.HISTORY_MAX)
	var scroll: = _album_scroll_area(body, width, 250.0)
	var list: = VBoxContainer.new()
	list.add_theme_constant_override("separation", 4)
	list.size_flags_horizontal = Control.SIZE_EXPAND_FILL
	scroll.add_child(list)
	if runs.is_empty():
		list.add_child(_ro_text(tr("Aún no hay partidas. Termina una y aparecerá aquí."), 11, Color(0.28, 0.3, 0.4)))
		return
	for r in runs:
		list.add_child(_history_row(r, width - 40.0))


func _history_row(r: Dictionary, w: float) -> Control:
	var won: = bool(r.get("victory", false))
	var panel: = _album_panel("done" if won else "off", 6)
	panel.custom_minimum_size.x = w
	var row: = HBoxContainer.new()
	row.add_theme_constant_override("separation", 10)
	panel.add_child(row)
	var cid: = str(r.get("class", ""))
	var d: Dictionary = GameData.CLASSES.get(cid, {})
	var face: = UiKit.icon_rect(UiKit.skill_icon(str(d.get("skills", [""])[0]) if not (d.get("skills", []) as Array).is_empty() else "bash"), 28)
	face.size_flags_vertical = Control.SIZE_SHRINK_CENTER
	row.add_child(face)
	var left: = VBoxContainer.new()
	left.add_theme_constant_override("separation", 0)
	left.custom_minimum_size.x = 210
	row.add_child(left)
	var who: = str(r.get("job", "")) if str(r.get("job", "")) != "" else _class_title(cid)
	left.add_child(_ro_text(who, 12, Color(0.12, 0.2, 0.45), true))
	var when : = Time.get_datetime_string_from_unix_time(int(r.get("at", 0)) + int(Time.get_time_zone_from_system().get("bias", 0)) * 60, true)
	left.add_child(_ro_text( when .substr(0, 16), 9, Color(0.28, 0.3, 0.4)))
	var mid: = VBoxContainer.new()
	mid.add_theme_constant_override("separation", 0)
	mid.size_flags_horizontal = Control.SIZE_EXPAND_FILL
	row.add_child(mid)
	var sid: = str(r.get("stage", ""))
	var place: = tr(str(GameData.STAGES[sid].name)) if GameData.STAGES.has(sid) else sid
	if int(r.get("tower", 0)) > 0:
		place = tr("Endless Tower  ·  piso %d") % int(r.tower)
	mid.add_child(_ro_text("%s  ·  %s" % [place, GameData.danger_name(int(r.get("danger", 1)))], 12, Color.BLACK, true))
	var t: = int(r.get("time", 0))
	var facts: = tr("Nv %d  ·  %d:%02d  ·  %s muertes  ·  %s z  ·  MVP %d") % [int(r.get("level", 1)), t / 60, t % 60, 
		RoBasicWindow._thousands(int(r.get("kills", 0))), RoBasicWindow._thousands(int(r.get("zeny", 0))), int(r.get("mvps", 0))]
	if int(r.get("party", 1)) > 1:
		facts += "  ·  " + tr("grupo de %d") % int(r.party)
	mid.add_child(_ro_text(facts, 10, Color(0.27, 0.29, 0.37)))
	var top: Array = r.get("top", [])
	if not top.is_empty():
		var names: = []
		for pair in top:
			var tag: = str(pair[0])
			names.append(tr(str(GameData.SKILLS[tag].name)) if GameData.SKILLS.has(tag) else (tr("Ataque básico") if tag == "basic" else tag))
		mid.add_child(_ro_text(tr("Más daño: %s") % ", ".join(names), 10, Color(0.28, 0.3, 0.4)))
	var res: = _lvl_chip(tr("VICTORIA") if won else (tr("TORRE") if int(r.get("tower", 0)) > 0 else tr("DERROTA")), 
		Color(0.36, 0.7, 0.42) if won else Color(0.6, 0.6, 0.64), won)
	res.size_flags_vertical = Control.SIZE_SHRINK_CENTER
	row.add_child(res)
	return panel




func _plag_loadout(title: String, sub: String, ids: Array, n: int, every: bool, stretch: float) -> PanelContainer:
	var panel: = _album_panel("done" if not ids.is_empty() else "off", 8)
	panel.size_flags_horizontal = Control.SIZE_EXPAND_FILL
	panel.size_flags_stretch_ratio = stretch
	var col: = VBoxContainer.new()
	col.add_theme_constant_override("separation", 4)
	panel.add_child(col)
	var head: = HBoxContainer.new()
	col.add_child(head)
	var t: = _ro_text(title, 12, Color(0.12, 0.2, 0.45), true)
	t.size_flags_horizontal = Control.SIZE_EXPAND_FILL
	head.add_child(t)
	head.add_child(_ro_text("%d / %d" % [ids.size(), n], 12, Color(0.55, 0.38, 0.05) if ids.size() >= n else Color(0.28, 0.3, 0.4), true))
	if _plag_note != "" and not every:
		col.add_child(_ro_text(_plag_note, 10, Color(0.75, 0.2, 0.15), true))
	else:
		col.add_child(_ro_text(sub, 10, Color(0.28, 0.3, 0.4)))
	var row: = HBoxContainer.new()
	row.add_theme_constant_override("separation", 6)
	col.add_child(row)
	for i in n:
		var slot: = PanelContainer.new()
		slot.size_flags_horizontal = Control.SIZE_EXPAND_FILL
		slot.custom_minimum_size.y = 38
		var sb: = StyleBoxFlat.new()
		sb.set_corner_radius_all(6)
		sb.set_content_margin_all(4)
		sb.set_border_width_all(1)
		slot.add_theme_stylebox_override("panel", sb)
		var line: = HBoxContainer.new()
		line.add_theme_constant_override("separation", 6)
		line.mouse_filter = Control.MOUSE_FILTER_IGNORE
		slot.add_child(line)
		if i < ids.size():
			var sid: String = ids[i]
			sb.bg_color = Color.WHITE
			sb.border_color = Color(0.85, 0.66, 0.25)
			var ic: = UiKit.icon_rect(UiKit.skill_icon(sid), 28)
			ic.size_flags_vertical = Control.SIZE_SHRINK_CENTER
			line.add_child(ic)
			var nm: = _ro_text(tr(str(GameData.SKILLS[sid].name)), 11, Color(0.12, 0.16, 0.32), true)
			nm.size_flags_vertical = Control.SIZE_SHRINK_CENTER
			nm.size_flags_horizontal = Control.SIZE_EXPAND_FILL
			nm.clip_text = true
			line.add_child(nm)
			var x: = _ro_text("✕", 11, Color(0.6, 0.35, 0.3), true)
			x.size_flags_vertical = Control.SIZE_SHRINK_CENTER
			line.add_child(x)
			_set_hover(slot, {"icon": UiKit.skill_icon(sid), "title": tr(str(GameData.SKILLS[sid].name)), "tag": tr("Plagiarism"), 
				"chips": _skill_chips_for(sid), "desc": tr(str(GameData.SKILLS[sid].desc)) + "\n" + tr("Clic: quitar")})
			slot.mouse_filter = Control.MOUSE_FILTER_STOP
			slot.mouse_default_cursor_shape = Control.CURSOR_POINTING_HAND
			slot.gui_input.connect( func(ev: InputEvent):
				if ev is InputEventMouseButton and ev.pressed and ev.button_index == MOUSE_BUTTON_LEFT:
					if every:
						Save.set_plagiarism_pick(sid)
					else:
						Save.toggle_plagiarism(sid)
					ui_click()
					show_album())
		else:
			sb.bg_color = Color(1, 1, 1, 0.45)
			sb.border_color = Color(0.8, 0.83, 0.9)
			var e: = _ro_text(tr("Libre: elígela abajo"), 10, Color(0.42, 0.44, 0.52))
			e.size_flags_horizontal = Control.SIZE_EXPAND_FILL
			e.size_flags_vertical = Control.SIZE_SHRINK_CENTER
			e.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER
			line.add_child(e)
		row.add_child(slot)
	return panel



func _plag_cell(boss: String, sid: String, got: bool, rogue: bool, every: bool, w: float) -> PanelContainer:
	var cell: = _album_panel("done" if rogue or every else ("off" if got else "dim"))
	cell.custom_minimum_size.x = w
	var row: = HBoxContainer.new()
	row.add_theme_constant_override("separation", 8)
	cell.add_child(row)
	var ic: = UiKit.icon_rect(UiKit.skill_icon(sid), 32)
	ic.size_flags_vertical = Control.SIZE_SHRINK_CENTER
	if not got:
		ic.modulate = Color(0.1, 0.12, 0.2, 0.6)
	row.add_child(ic)
	var info: = VBoxContainer.new()
	info.add_theme_constant_override("separation", 1)
	info.size_flags_horizontal = Control.SIZE_EXPAND_FILL
	info.size_flags_vertical = Control.SIZE_SHRINK_CENTER
	row.add_child(info)
	var nm: = _ro_text(tr(str(GameData.SKILLS[sid].name)) if got else "???", 11, Color(0.12, 0.16, 0.32) if got else Color(0.28, 0.3, 0.4), true)
	nm.clip_text = true
	nm.custom_minimum_size.x = w - 185.0 if got else w - 60.0
	info.add_child(nm)
	var from_text: = tr("De: %s") % tr(str(GameData.MONSTERS[boss].name))


	var copies = GameData.PLAGIARISM[boss]
	if not got and copies is Array and (copies as Array).size() > 1 and (copies as Array).find(sid) > 0:
		from_text = tr("De: %s, otra victoria") % tr(str(GameData.MONSTERS[boss].name))
	var from: = _ro_text(from_text, 9, Color(0.28, 0.3, 0.4))
	from.clip_text = true
	from.custom_minimum_size.x = nm.custom_minimum_size.x
	info.add_child(from)
	if not got:
		return cell
	_set_hover(cell, {"icon": UiKit.skill_icon(sid), "title": tr(str(GameData.SKILLS[sid].name)), "tag": tr("Plagiarism"), 
		"chips": _skill_chips_for(sid), "desc": tr(str(GameData.SKILLS[sid].desc))})
	cell.mouse_filter = Control.MOUSE_FILTER_PASS
	var picks: = VBoxContainer.new()
	picks.add_theme_constant_override("separation", 3)
	picks.size_flags_vertical = Control.SIZE_SHRINK_CENTER
	row.add_child(picks)
	var to_rogue: = func():
		if Save.toggle_plagiarism(sid):
			ui_click()
		else:
			_plag_note = tr("Ya tienes %d: quita una primero.") % GameData.PLAGIARISM_ACTIVE
		show_album()
	var r: = _album_pill(("✓ " if rogue else "") + tr("Rogue"), rogue, to_rogue, true, 10)
	r.tooltip_text = tr("Que pueda salir en tus partidas de Rogue y Stalker (máximo %d).") % GameData.PLAGIARISM_ACTIVE
	picks.add_child(r)
	var to_all: = func():
		Save.set_plagiarism_pick(sid)
		ui_click()
		show_album()
	var a: = _album_pill(("★ " if every else "") + tr("Todas las clases"), every, to_all, false, 10)
	a.tooltip_text = tr("La habilidad copiada que pueden sacar todas las clases (solo una).")
	picks.add_child(a)
	return cell





var _pet_tab: = "normal"


func _album_pets(body: VBoxContainer, width: float) -> void :
	var all_n: = GameData.PETS.size()
	var owned_n: = GameData.PETS.keys().filter( func(p): return Save.has_pet(p)).size()
	var bonus: = Save.active_pet()
	var skin: = Save.pet_skin()
	var face: = skin if skin != "" else (bonus if bonus != "" else "poring")
	var head: = _album_head(body, _pet_tex(face), tr("Mascotas  %d / %d") % [owned_n, all_n], owned_n / maxf(1.0, all_n), width, 
		tr("Muy raro: al vencer a un MVP puede dejar su huevo, y aun así la doma puede fallar. Además de su bonus, el MVP actúa solo cada pocos segundos.")
		if _pet_tab == "mvp" else tr("Doma monstruos con su objeto (lo sueltan a veces). Elige el bonus de una y el aspecto de la que quieras que te siga."))

	var now: = VBoxContainer.new()
	now.add_theme_constant_override("separation", 2)
	now.size_flags_vertical = Control.SIZE_SHRINK_CENTER
	head.add_child(now)
	now.add_child(_ro_text(tr("Bonus: %s") % (tr(str(GameData.PETS[bonus].name)) if bonus != "" else tr("ninguna")), 11, 
		Color(0.55, 0.38, 0.05) if bonus != "" else Color(0.28, 0.3, 0.4), true))
	now.add_child(_ro_text(tr("Aspecto: %s") % (tr(str(GameData.PETS[skin].name)) if skin != "" else tr("ninguna")), 11, 
		Color(0.2, 0.3, 0.65) if skin != "" else Color(0.28, 0.3, 0.4), true))
	_album_head_end(head)
	var sub: = HBoxContainer.new()
	sub.add_theme_constant_override("separation", 4)
	body.add_child(sub)
	for t in [["normal", tr("Mascotas  %d / %d")], ["mvp", tr("MvP  %d / %d")]]:
		var tab_id: String = t[0]
		var ids: = GameData.PETS.keys().filter( func(p): return GameData.PETS[p].get("mvp", false) == (tab_id == "mvp"))
		var owned: = ids.filter( func(p): return Save.has_pet(p)).size()
		sub.add_child(_album_pill(str(t[1]) % [owned, ids.size()], _pet_tab == tab_id, func():
			_pet_tab = tab_id
			show_album()))
	var scroll: = _album_scroll_area(body, width, 250.0)
	var cols: = maxi(2, int((width - 30.0) / 340.0))
	var cell_w: = (width - 44.0 - (cols - 1) * 6.0) / cols
	var grid: = GridContainer.new()
	grid.columns = cols
	grid.add_theme_constant_override("h_separation", 6)
	grid.add_theme_constant_override("v_separation", 6)
	scroll.add_child(grid)
	for id in GameData.PETS:
		if GameData.PETS[id].get("mvp", false) == (_pet_tab == "mvp"):
			grid.add_child(_pet_cell(id, cell_w))


func _pet_cell(id: String, w: float) -> Control:
	var d: Dictionary = GameData.PETS[id]
	var owned: = Save.has_pet(id)
	var active: = Save.active_pet() == id
	var skin: = Save.pet_skin() == id
	var cell: = _album_panel("done" if active else ("off" if owned else "dim"), 6)
	cell.custom_minimum_size.x = w
	var row: = HBoxContainer.new()
	row.add_theme_constant_override("separation", 8)
	cell.add_child(row)
	var art: = TextureRect.new()
	art.custom_minimum_size = Vector2(56, 56)
	art.size_flags_vertical = Control.SIZE_SHRINK_CENTER
	art.expand_mode = TextureRect.EXPAND_IGNORE_SIZE
	art.stretch_mode = TextureRect.STRETCH_KEEP_ASPECT_CENTERED
	art.texture_filter = RoAssets.ui_filter()
	art.texture = _pet_tex(id)
	art.modulate = Color.WHITE if owned else Color(0.08, 0.1, 0.16, 0.7)
	row.add_child(art)
	var info: = VBoxContainer.new()
	info.add_theme_constant_override("separation", 1)
	info.size_flags_horizontal = Control.SIZE_EXPAND_FILL
	info.size_flags_vertical = Control.SIZE_SHRINK_CENTER
	row.add_child(info)
	info.add_child(_ro_text(tr(d.name) if owned else "???", 11, Color(0.12, 0.16, 0.32) if owned else Color(0.28, 0.3, 0.4), true))
	var how: = (tr("Quest: %s") % tr(str(GameData.QUESTS[str(d.quest)].name))) if d.has("quest") else tr("Doma con: %s") % tr(d.item)
	if d.get("mvp", false):
		how = tr("Su huevo, muy raro, al vencer a %s") % tr(str(d.name))
	var desc: = _ro_text(tr(d.desc) if owned else how, 10, Color(0.3, 0.32, 0.38) if owned else Color(0.28, 0.3, 0.4))
	desc.autowrap_mode = TextServer.AUTOWRAP_WORD_SMART
	desc.custom_minimum_size.x = w - (150.0 if owned else 80.0)
	info.add_child(desc)
	var where: = ""
	for sid in GameData.STAGES:
		for sp in GameData.STAGES[sid].spawns:
			if sp.mob == id and where == "":
				where = tr(GameData.STAGES[sid].name)
	if where != "":
		info.add_child(_ro_text(where, 9, Color(0.3, 0.32, 0.42)))
	if owned:

		var picks: = VBoxContainer.new()
		picks.add_theme_constant_override("separation", 3)
		picks.size_flags_vertical = Control.SIZE_SHRINK_CENTER
		row.add_child(picks)
		var use: = func():
			Save.set_active_pet("" if active else id)
			ui_click()
			show_album()
		var b: = _album_pill(("✓ " if active else "") + tr("Bonus"), active, use, true, 10)
		b.tooltip_text = tr("Su bonus te acompaña en cada partida (solo una mascota a la vez).")
		picks.add_child(b)
		var look: = func():
			Save.set_pet_skin(id)
			ui_click()
			show_album()
		var a: = _album_pill(("✓ " if skin else "") + tr("Aspecto"), skin, look, false, 10)
		a.tooltip_text = tr("Esta mascota es la que te sigue, sea cual sea el bonus que uses.")
		picks.add_child(a)
	return cell





func _gear_groups() -> Array:
	return [["weapon", tr("Armas")], ["shield", tr("Escudos")], ["armor", tr("Armaduras")], ["garment", tr("Prendas")], 
		["shoes", tr("Calzado")], ["head", tr("Cabeza")], ["mid", tr("Cara superior")], ["low", tr("Cara inferior")], 
		["acc", tr("Accesorios")], ["wings", tr("Alas")]]


func _album_gear(body: VBoxContainer, width: float) -> void :
	var legends: = _gear_items(false)
	var uniques: = _gear_items(true)
	var sets: = _gear_sets()
	var whole: = sets.filter( func(sid): return GameData.set_pieces(sid).all(_gear_found)).size()
	var found_any: = (legends + uniques).filter(_gear_found)
	var icon_id: = str(found_any[0]) if not found_any.is_empty() else str(legends[0]) if not legends.is_empty() else ""
	var head: = _album_head(body, _item_icon(str(GameData.ITEMS[icon_id].get("icon", icon_id))) if icon_id != "" else null, 
		tr("Colección  %d%%") % _gear_percent(), _gear_percent() / 100.0, width, 
		tr("Los sets, las legendarias y las únicas que encontraste en cualquier partida."))
	var only: = _tool_check(tr("Solo las que faltan"), "")
	only.button_pressed = _gear_missing
	only.size_flags_vertical = Control.SIZE_SHRINK_CENTER
	only.toggled.connect( func(on: bool):
		_gear_missing = on
		_album_scroll = 0
		show_album())
	head.add_child(only)
	_album_head_end(head)
	var sub: = HBoxContainer.new()
	sub.add_theme_constant_override("separation", 4)
	body.add_child(sub)
	for t in [["sets", tr("Sets  %d / %d") % [whole, sets.size()]], 
			["legend", tr("Legendarias  %d / %d") % [legends.filter(_gear_found).size(), legends.size()]], 
			["unique", tr("Únicas  %d / %d") % [uniques.filter(_gear_found).size(), uniques.size()]], 
			["souls", tr("Almas  %d / %d") % [_soul_items().filter(_gear_found).size(), _soul_items().size()]]]:
		var tid: String = t[0]
		sub.add_child(_album_pill(t[1], _gear_tab == tid, func():
			_gear_tab = tid
			_album_scroll = 0
			show_album()))
	var scroll: = _album_scroll_area(body, width, 230.0)
	var list: = VBoxContainer.new()
	list.add_theme_constant_override("separation", 6)
	scroll.add_child(list)
	var shown: = 0
	if _gear_tab == "sets":
		var grid: = GridContainer.new()
		grid.columns = 2
		grid.add_theme_constant_override("h_separation", 8)
		grid.add_theme_constant_override("v_separation", 8)
		list.add_child(grid)
		for sid in sets:
			if not _gear_missing or not GameData.set_pieces(sid).all(_gear_found):
				grid.add_child(_gear_set_card(sid, (width - 46.0) * 0.5))
				shown += 1
	elif _gear_tab == "souls":

		var cols: = maxi(3, int((width - 30.0) / 250.0))
		var cell_w: = (width - 44.0 - (cols - 1) * 6.0) / cols
		for g in [[false, tr("Almas de únicas")], [true, tr("Almas de legendarias")]]:
			var of_kind: = _soul_items().filter( func(id): return Souls.is_legend_soul(str(id)) == bool(g[0]))
			var listed: = of_kind.filter( func(id): return not _gear_missing or not _gear_found(id))
			if listed.is_empty():
				continue
			list.add_child(_album_group("%s  %d/%d" % [g[1], of_kind.filter(_gear_found).size(), of_kind.size()]))
			var grid: = GridContainer.new()
			grid.columns = cols
			grid.add_theme_constant_override("h_separation", 6)
			grid.add_theme_constant_override("v_separation", 6)
			list.add_child(grid)
			for id in listed:
				grid.add_child(_gear_cell(id, cell_w))
				shown += 1
	else:

		var ids: Array = uniques if _gear_tab == "unique" else legends
		var cols: = maxi(3, int((width - 30.0) / 250.0))
		var cell_w: = (width - 44.0 - (cols - 1) * 6.0) / cols
		for g in _gear_groups():
			var of_slot: = ids.filter( func(id): return str(GameData.ITEMS[id].get("slot", "")) == g[0])
			var listed: = of_slot.filter( func(id): return not _gear_missing or not _gear_found(id))
			if listed.is_empty():
				continue
			list.add_child(_album_group("%s  %d/%d" % [g[1], of_slot.filter(_gear_found).size(), of_slot.size()]))
			var grid: = GridContainer.new()
			grid.columns = cols
			grid.add_theme_constant_override("h_separation", 6)
			grid.add_theme_constant_override("v_separation", 6)
			list.add_child(grid)
			for id in listed:
				grid.add_child(_gear_cell(id, cell_w))
				shown += 1
	if shown == 0:
		list.add_child(_ro_text(tr("¡Ya tienes todo esto!"), 13, Color(0.15, 0.5, 0.2), true))


func _gear_panel(done: bool) -> PanelContainer:
	return _album_panel("done" if done else "off", 7)



func _gear_icon(id: String, side: float) -> TextureRect:
