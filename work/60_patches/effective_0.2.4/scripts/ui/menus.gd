func _renderer_row(rows: VBoxContainer) -> void :
	if OS.get_name() != "Windows" or OS.has_feature("editor"):
		return
	var running: = "gl" if RenderingServer.get_current_rendering_method() == "gl_compatibility" else ("vulkan" if RenderingServer.get_current_rendering_driver_name() == "vulkan" else "d3d12")



	var path: = OS.get_executable_path().get_base_dir().path_join("override.cfg")
	var saved: = ConfigFile.new()
	var now: = running
	if saved.load(path) == OK and saved.has_section_key("rendering", "renderer/rendering_method"):
		now = "gl" if str(saved.get_value("rendering", "renderer/rendering_method")) == "gl_compatibility" else str(saved.get_value("rendering", "rendering_device/driver.windows", "d3d12"))
	var note: = tr("Se aplica al reiniciar el juego") if world.running or now != running else tr("¿Pocos FPS, tirones o congelaciones? Prueba con Vulkan u OpenGL")
	_opt_row(rows, tr("Renderizador"), _opt_segments([["DirectX 12", "d3d12"], ["Vulkan", "vulkan"], ["OpenGL", "gl"]], now, func(v):
		var cfg: = ConfigFile.new()
		cfg.load(path)
		if str(v) == "gl":
			cfg.set_value("rendering", "renderer/rendering_method", "gl_compatibility")


			var vendor: = RenderingServer.get_video_adapter_vendor()
			if vendor.contains("ATI") or vendor.contains("AMD") or vendor.contains("Advanced Micro"):
				cfg.set_value("rendering", "gl_compatibility/force_angle_on_devices", World.ANGLE_DEVICES)
		else:
			cfg.set_value("rendering", "renderer/rendering_method", "mobile")
			cfg.set_value("rendering", "rendering_device/driver.windows", str(v))
		if cfg.save(path) != OK:
			show_npc_line(tr("Opciones"), "", tr("No se pudo guardar el cambio junto al juego (¿carpeta protegida?)."))
			return
		ui_click()
		if world.running or str(v) == running:


			return
		OS.set_restart_on_exit(true, OS.get_cmdline_args())
		quit_game()), note)


