class_name Menus
extends CanvasLayer



const RO_THEME = preload("res://assets/ro/ui/ro_theme.tres")
const UiStyles = preload("res://scripts/ui/ro_ui_styles.gd")
const TownChannel = preload("res://scripts/net/town_channel.gd")
const GradeFx = preload("res://scripts/ui/grade_fx.gd")
const RunPrefs = preload("res://scripts/ui/run_prefs.gd")
const BonusSummary = preload("res://scripts/ui/bonus_summary.gd")



const INPUT_GRACE: = 0.35


const LEVEL_UP_GRACE: = 0.5

var world: World
var auto_pick: = false


var showcase: = false
var _root: Control
var _choices: Array = []

var _cards: Array = []

var _banish_armed: = false
var _tool_buttons: = {}
var _mode: = "closed"
var _class_previews: Array[Dictionary] = []
var _login_cluster: Control
var _login_scale: = 1.0
var _grace: = 0.0
var _ro_window_root: Control

var _resume_asked: = false

var _options: Control

var _options_paused: = false


func _ready() -> void :
	get_tree().node_added.connect(_on_node_added)
	layer = 10
	process_mode = Node.PROCESS_MODE_ALWAYS
	_root = Control.new()
	_root.set_anchors_and_offsets_preset(Control.PRESET_FULL_RECT)
	_root.mouse_filter = Control.MOUSE_FILTER_IGNORE
	_root.theme = RO_THEME
	add_child(_root)
	get_viewport().size_changed.connect(_on_viewport_resized)
	_trade_setup()


func _process(delta: float) -> void :
	_grace = maxf(0.0, _grace - delta)
	_rail_tick(delta)
	_equip_hud_tick()
	_touch_hold_tick(delta)

	if trade != null and trade.active() and not trade.can_trade():
		trade.cancel()
	for preview in _class_previews:
		preview.elapsed += delta
		var action: int = preview.action
		var delay: float = preview.sprite.frame_delay(action)
		while preview.elapsed >= delay:
			preview.elapsed -= delay
			preview.frame = (preview.frame + 1) % preview.sprite.frame_count(action)
			preview.texture.texture = preview.sprite.get_frame(action, preview.frame)




func _input(event: InputEvent) -> void :
	_touch_hold_input(event)


	if event is InputEventKey and HeroInput.typing(self):
		return

	if _mode == "chest" and _grace <= 0.0 and event is InputEventKey and event.pressed and not event.echo and event.keycode == KEY_F\
	and _chest_sell != null and is_instance_valid(_chest_sell) and not _chest_sell.disabled:
		_chest_sell.pressed.emit()
		get_viewport().set_input_as_handled()
		return


	if _mode == "level_up" and _grace <= 0.0 and event is InputEventKey and event.pressed and not event.echo and event.keycode == KEY_TAB and bool(Save.setting("hold_levels", false)):
		_put_levels_away()
		get_viewport().set_input_as_handled()
		return

	if event is InputEventKey and event.keycode == KEY_SHIFT and not event.echo and _hover_args.size() == 3\
	and _hover_card != null and is_instance_valid(_hover_card) and is_instance_valid(_hover_args[1]):
		_show_item_hover(_hover_args[0], _hover_args[1], _hover_args[2])
	if world != null and event is InputEventKey and event.pressed and not event.echo\
	and (event.keycode == KEY_F11 or (event.keycode == KEY_ENTER and event.alt_pressed)):
		world.toggle_fullscreen()
		if _options != null and is_instance_valid(_options) and _options.has_meta("main_options"):
			show_options()
		get_viewport().set_input_as_handled()


func _unhandled_input(event: InputEvent) -> void :
	if world == null:
		return

	if event is InputEventKey and event.pressed and not event.echo and event.keycode == KEY_F8\
	and not (_options != null and is_instance_valid(_options) and _options.has_meta("feedback")):
		show_feedback(_grab_shot())
		get_viewport().set_input_as_handled()
		return
	if _options != null and is_instance_valid(_options):
		if event.is_action_pressed("pause") or (event is InputEventKey and event.pressed and event.keycode == KEY_O):
			close_options()
			get_viewport().set_input_as_handled()
		return
	if _mode == "prep" and (event.is_action_pressed("pause") or event.is_action_pressed("ui_cancel")):
		show_server_select()
		get_viewport().set_input_as_handled()
		return
	if _mode == "sn_build" and (event.is_action_pressed("pause") or event.is_action_pressed("ui_cancel")):
		_sn_done.call()
		get_viewport().set_input_as_handled()
		return

	if _mode == "town_menu" and (event.is_action_pressed("pause") or event.is_action_pressed("ui_cancel")):
		_back_to_hub()
		get_viewport().set_input_as_handled()
		return

	if _mode == "town_leave" and (event.is_action_pressed("pause") or event.is_action_pressed("ui_cancel")):
		_back_to_hub()
		get_viewport().set_input_as_handled()
		return

	if _mode in ["trade", "trade_wait", "trade_ask", "trade_end"] and (event.is_action_pressed("pause") or event.is_action_pressed("ui_cancel")):
		if _tr_confirm != null and is_instance_valid(_tr_confirm):
			_close_trade_confirm()
		elif _mode == "trade_end":
			_back_to_hub()
		elif _mode == "trade_ask":
			_back_to_hub()
		else:
			trade.cancel()
		get_viewport().set_input_as_handled()
		return


	if _mode in ["album", "loadout", "kafra", "sage", "pacts", "refiner", "socket", "star_smith", "chef", "gacha", "npc_line", "rebirth", "rebirth_lv", "tower", "tower_confirm", "inspect", 
			"valkyrie", "valkyrie_wings", "hero_pick", "hero_sheet"] and (event.is_action_pressed("pause") or event.is_action_pressed("ui_cancel")):
		_back_to_hub()
		get_viewport().set_input_as_handled()
		return
	if _mode == "wardrobe" and (event.is_action_pressed("pause") or event.is_action_pressed("ui_cancel")):
		_wardrobe_leave()
		get_viewport().set_input_as_handled()
		return


	if _mode == "friends" and (event.is_action_pressed("pause") or event.is_action_pressed("ui_cancel")):
		_friends_leave()
		get_viewport().set_input_as_handled()
		return


	if world.town != null and is_instance_valid(world.town) and _mode in ["town", "hero_sheet"] and (event.is_action_pressed("status_window") or event.is_action_pressed("equip_window")):
		if _mode == "town":
			ui_click()
			show_hero_sheet()
		else:
			_back_to_hub()
		get_viewport().set_input_as_handled()
		return
	if event is InputEventKey and event.pressed and not event.echo and event.keycode == KEY_O\
	and _mode in ["login", "server_select", "class_select", "pause", "town", "kafra", "sage", "pacts", "album"]:
		show_options()
		get_viewport().set_input_as_handled()
		return
	if _mode == "start_skill" and _start_cancel.is_valid() and (event.is_action_pressed("pause") or event.is_action_pressed("ui_cancel")):
		_cancel_start()
		get_viewport().set_input_as_handled()
		return
	if _mode == "level_up" and _grace <= 0.0:
		if event is InputEventKey and event.pressed and not event.echo:
			var n: int = event.keycode - KEY_1

			if n >= 0 and n < _choices.size() and _choices.size() <= 4:
				_pick(n)
				get_viewport().set_input_as_handled()
				return
			if event.keycode == KEY_R:
				_reroll()
				get_viewport().set_input_as_handled()
				return
			if event.keycode == KEY_B and world.player.banishes > 0:
				_arm_banish( not _banish_armed)
				get_viewport().set_input_as_handled()
				return
			if event.keycode == KEY_ESCAPE and _banish_armed:
				_arm_banish(false)
				get_viewport().set_input_as_handled()
				return

	if world.running and world.player != null and (world.player.pending_levels <= 0 or bool(Save.setting("hold_levels", false))):


		if event.is_action_pressed("equip_window"):
			if _mode == "equipment":
				_resume()
			elif _mode == "closed":
				show_equipment()
			get_viewport().set_input_as_handled()
			return
		if event.is_action_pressed("inventory_window"):
			if _mode == "equipment":
				_resume()
			elif _mode == "closed":
				show_equipment()
			get_viewport().set_input_as_handled()
			return
	if event.is_action_pressed("pause") and world.running and _mode in ["equipment", "status", "inventory", "quest", "quest_reward"]:
		_resume()
		get_viewport().set_input_as_handled()
		return
	if event.is_action_pressed("pause") and world.running and _mode == "compendium":
		show_pause()
		get_viewport().set_input_as_handled()
		return
	if (event.is_action_pressed("pause") or event.is_action_pressed("ui_cancel")) and _mode == "guide":
		_guide_leave()
		get_viewport().set_input_as_handled()
		return
	if event.is_action_pressed("pause") and world.running and (world.player.pending_levels <= 0 or bool(Save.setting("hold_levels", false)) or world.is_coop()):
		if _mode == "pause":
			_resume()
		elif _mode == "closed" or (world.is_coop() and world.player == world.leader() and _mode != "victory"):




			show_pause()
		get_viewport().set_input_as_handled()



func _on_node_added(node: Node) -> void :
	if node is BaseButton and is_ancestor_of(node) and not node.pressed.is_connected(ui_click):
		node.pressed.connect(ui_click)


func ui_click() -> void :
	if world != null:
		world.play_sound("ui_click", 0.12, -4.0)



func ui_nav() -> void :
	if world != null:
		world.play_sound("ui_click", 0.04, -12.0)


func _clear() -> void :
	for child in _root.get_children():
		child.queue_free()
	_login_cluster = null
	_ro_window_root = null
	_card_side = null
	_class_previews.clear()



func enter_town_mode() -> void :
	close()
	_mode = "town"







const RAIL_MODES: = ["class_select", "album", "char_make", "loadout", "friends"]


const RAIL_TOP_BREAKPOINT: = 760.0
var _rail: Control
var _rail_key: = ""
var _class_win: RoCharSelect


func _rail_width(view: Vector2) -> float:
	return roundf(clampf(view.y / 720.0, 1.0, 2.0) * 86.0)


func _rail_on_top(view: Vector2) -> bool:
	return touch_ui() and view.x < RAIL_TOP_BREAKPOINT


func _rail_tick(delta: float) -> void :
	var want: = _mode in RAIL_MODES and world != null and world.town == null and not world.running
	var view: = get_viewport().get_visible_rect().size
	var fr = world.friends if world != null else null

	var key: = "%s|%s|%s|%s|%d|%d|%s" % [want, _mode, RoCharSelect.last_id, 
		GameData.CLASSES.has(RoCharSelect.last_id) and Save.class_unlocked(RoCharSelect.last_id), 
		int(fr.online) if fr != null else 0, int(fr.requests) if fr != null else 0, view]
	if key == _rail_key:
		if want and _rail != null and is_instance_valid(_rail):
			_rail_glow()
			_rail_place()
		return
	_rail_key = key
	if _rail != null and is_instance_valid(_rail):
		_rail.queue_free()
	_rail = null
	if want:
		_rail = _build_rail(view)
		add_child(_rail)
		_rail_place()




func _rail_place() -> void :
	var view: = get_viewport().get_visible_rect().size

	if _rail_on_top(view) or _rail.has_meta("top"):
		_rail.position = Vector2(4.0, 4.0)
		_rail.size = Vector2(maxf(0.0, view.x - 8.0), 58.0)
		return
	if _mode == "class_select" and _class_win != null and is_instance_valid(_class_win):
		var win_top: = _class_win.position.y
		var win_height: = RoCharSelect.SIZE.y * _class_win.scale.y
		_rail.position.y = roundf(win_top + (win_height - _rail.size.y) * 0.5)
	var left: = -1.0
	if _mode == "class_select" and _class_win != null and is_instance_valid(_class_win):
		left = _class_win.position.x
	elif _mode == "char_make":

		for c in _root.get_children():
			if c is RoCharMake:
				left = (c as Control).position.x
	elif _ro_window_root != null and is_instance_valid(_ro_window_root) and _ro_window_root.get_parent() == _root:
		left = _ro_window_root.get_global_rect().position.x
	else:
		for c in _root.get_children():
			if c is CenterContainer and c.get_child_count() > 0:
				left = (c.get_child(0) as Control).get_global_rect().position.x
				break
	var x: = 8.0 if left < 0.0 else left - _rail.size.x - 10.0



	_rail.position.x = roundf(maxf(8.0, x))



func _rail_glow() -> void :
	var tb = _rail.get_meta("town") if _rail.has_meta("town") else null
	if tb == null or not is_instance_valid(tb):
		return
	var call: bool = _class_win != null and is_instance_valid(_class_win) and _class_win.town_hint()
	var t: = 0.5 + 0.5 * sin(Time.get_ticks_msec() * 0.008)
	(tb as Control).modulate = Color.WHITE.lerp(Color(1.4, 1.25, 0.7), t) if call else Color.WHITE


func _build_rail(view: Vector2) -> Control:
	var k: = clampf(view.y / 720.0, 1.0, 2.0)
	var top: = _rail_on_top(view)
	var w: = _rail_width(view)
	var cid: = RoCharSelect.last_id
	if cid == "" or not GameData.CLASSES.has(cid):
		cid = "swordsman"
	var open: = Save.class_unlocked(cid)
	var panel: = PanelContainer.new()
	if top:
		panel.set_meta("top", true)
	var pb: = UiKit.panel_box(Color(0.97, 0.98, 1.0, 0.94), Color(0.62, 0.7, 0.9), 12, 1)
	pb.set_content_margin_all(roundf(5.0 * k))
	pb.shadow_color = Color(0.05, 0.1, 0.3, 0.25)
	pb.shadow_size = 4
	panel.add_theme_stylebox_override("panel", pb)
	var items_box: BoxContainer
	if top:
		var row: = HBoxContainer.new()
		row.add_theme_constant_override("separation", 2)
		panel.add_child(row)
		items_box = row
	else:
		var col: = VBoxContainer.new()
		col.add_theme_constant_override("separation", roundi(1.0 * k))
		panel.add_child(col)
		items_box = col
	var job: int = int(GameData.JOB_ICON_IDS.get(str(GameData.CLASSES[cid].name), 0))
	var job_path: = "res://assets/ro/ui/skin/job_icons/%d.png" % int(job)
	var fr = world.friends if world != null else null
	var online: = int(fr.online) if fr != null else 0
	var asks: = int(fr.requests) if fr != null else 0
	var items: = [
		["class_select", load(job_path) if ResourceLoader.exists(job_path) else null, tr("Personajes"), true, func(): show_class_select()], 
		["town", StagePreview._cropped("npc_kafra"), tr("Prontera"), open, func():
			show_loading( func(): world.enter_town(cid), [Town.MAP])], 
		["album", _item_icon("card_slot"), tr("Álbum"), true, show_album], 
		["char_make", _item_icon("cap"), tr("Perfil"), true, func(): show_char_make(cid)], 
		["loadout", _item_icon("chain_mail"), tr("Equipo"), open, func(): show_loadout(cid)], 
		["friends", StagePreview._cropped("npc_party"), tr("Amigos") + ("  %d" % online if online > 0 else ""), true, 
			func(): open_friends( func(): show_class_select())], 
	]
	for it in items:
		var here: bool = str(it[0]) == _mode
		var b: = Button.new()
		b.set_meta("rail", str(it[0]))
		b.focus_mode = Control.FOCUS_NONE
		b.custom_minimum_size = Vector2(maxf(64.0, (view.x - 20.0) / 6.0), 50.0) if top else Vector2(w - 10.0 * k, roundf(62.0 * k))
		b.disabled = not bool(it[3])
		for st in ["normal", "hover", "pressed", "disabled"]:
			var sb: = StyleBoxFlat.new()
			sb.bg_color = Color(1.0, 0.95, 0.78) if here else (Color(0.9, 0.93, 1.0) if st == "hover" else Color(0, 0, 0, 0))
			sb.border_color = GameData.REBIRTH_LV_GOLD if here else Color(0.62, 0.7, 0.9, 0.0 if st == "normal" else 0.8)
			sb.set_border_width_all(2 if here else 1)
			sb.set_corner_radius_all(roundi(8.0 * k))
			b.add_theme_stylebox_override(st, sb)
		var cb: Callable = it[4]
		var rail_id: = str(it[0])
		b.pressed.connect( func():
			if here:
				return
			ui_click()



			if rail_id == "town" and not b.has_meta("sure"):
				b.set_meta("sure", true)
				var lab: Label = b.get_meta("label")
				var ink: = lab.get_theme_color("font_color")
				lab.text = tr("¿Seguro?")
				lab.add_theme_color_override("font_color", Color(0.75, 0.3, 0.1))
				b.tooltip_text = tr("Haz clic otra vez para ir a Prontera.")
				get_tree().create_timer(3.0, true, false, true).timeout.connect( func():
					if is_instance_valid(b) and b.has_meta("sure"):
						b.remove_meta("sure")
						lab.text = tr("Prontera")
						lab.add_theme_color_override("font_color", ink)
						b.tooltip_text = "")
				return
			cb.call())
		var v: = VBoxContainer.new()
		v.set_anchors_and_offsets_preset(Control.PRESET_FULL_RECT)
		v.alignment = BoxContainer.ALIGNMENT_CENTER
		v.add_theme_constant_override("separation", 0)
		v.mouse_filter = Control.MOUSE_FILTER_IGNORE
		b.add_child(v)
		var icon_size: = 34.0 if str(it[0]) == "class_select" else 40.0
		var ic: = UiKit.icon_rect(it[1], roundf((25.0 if top else icon_size) * k))
		ic.stretch_mode = TextureRect.STRETCH_KEEP_ASPECT_CENTERED
		ic.size_flags_horizontal = Control.SIZE_SHRINK_CENTER
		ic.modulate = Color(1, 1, 1, 0.45) if b.disabled else Color.WHITE
		v.add_child(ic)
		var l: = UiKit.label(str(it[2]), roundi((9.0 if top else 12.0) * k), Color(0.55, 0.32, 0.0) if here else (UiKit.MUTED if b.disabled else UiKit.TEXT), true)
		l.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER
		if str(it[0]) == "friends" and asks > 0:
			l.add_theme_color_override("font_color", Color(0.75, 0.45, 0.0))
			b.tooltip_text = tr_n("%d solicitud de amistad", "%d solicitudes de amistad", asks) % asks
		v.add_child(l)
		b.set_meta("label", l)
		items_box.add_child(b)
		if str(it[0]) == "town":
			panel.set_meta("town", b)
	panel.reset_size()
	var size: = panel.get_combined_minimum_size()
	panel.position = Vector2(roundf(8.0 * k), roundf((view.y - size.y) * 0.5))


	panel.z_index = 200
	return panel



func mode() -> String:
	return _mode






func show_missing_poster(npc_id: String) -> void :
	_mode = "npc_line"
	var n: Dictionary = {}
	for d in GameData.TOWN_NPCS:
		if str(d.id) == npc_id:
			n = d
	if n.is_empty():
		return
	var stage_id: = str(GameData.QUEST_NPC_UNLOCK.get(npc_id, ""))
	var st: Dictionary = GameData.STAGES.get(stage_id, {})
	var col: = _screen(tr("Tablón de Prontera"), "")
	col.add_theme_constant_override("separation", 12)

	var holder: = Control.new()
	holder.custom_minimum_size = Vector2(340, 452)
	holder.size_flags_horizontal = Control.SIZE_SHRINK_CENTER
	col.add_child(holder)
