	var reqs: = HBoxContainer.new()
	reqs.alignment = BoxContainer.ALIGNMENT_CENTER
	reqs.add_theme_constant_override("separation", 22)
	col.add_child(reqs)
	var frags: = Save.ymir_fragments()
	var lv: = int(Save.class_progress(class_id).level)
	var frag_row: = HBoxContainer.new()
	frag_row.add_theme_constant_override("separation", 6)
	reqs.add_child(frag_row)
	frag_row.add_child(UiKit.icon_rect(_item_icon("ymir_fragment"), 28))
	frag_row.add_child(UiKit.label(tr("Fragmentos de Ymir  %d/%d") % [mini(frags, GameData.REBIRTH_FRAGMENTS), GameData.REBIRTH_FRAGMENTS], 16, 
		Color(0.2, 0.55, 0.3) if frags >= GameData.REBIRTH_FRAGMENTS else UiKit.TEXT, true))
	reqs.add_child(UiKit.label(tr("Nivel de clase  %d/%d") % [mini(lv, GameData.REBIRTH_CLASS_LEVEL), GameData.REBIRTH_CLASS_LEVEL], 16, 
		Color(0.2, 0.55, 0.3) if lv >= GameData.REBIRTH_CLASS_LEVEL else UiKit.TEXT, true))
	var how: = UiKit.label(tr("Cada MVP derrotado deja un Fragmento de Ymir (sirven para cualquier clase)."), 13, UiKit.MUTED)
