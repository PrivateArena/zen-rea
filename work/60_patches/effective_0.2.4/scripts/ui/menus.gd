	go.custom_minimum_size = Vector2(76, 34)
	go.size_flags_vertical = Control.SIZE_SHRINK_CENTER
	go.pressed.connect( func():
		ui_click()
		if pick.is_valid():
			pick.call(i)
		else:
			_tower_confirm(b, i, int(start[0])))
	row.add_child(go)
	return panel



