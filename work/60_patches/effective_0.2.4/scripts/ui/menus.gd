		show_loadout(class_id, (tr("%s en el equipo inicial. La Huuma ocupa las dos manos: lo de la mano izquierda vuelve al almacén.") if huuma
			else (tr("%s en el equipo inicial. El katar ocupa las dos manos: lo de la mano izquierda vuelve al almacén.") if katar
			else tr("%s en el equipo inicial. Es a dos manos: lo de la mano izquierda vuelve al almacén."))) % tr(str(Equipment.item_def(it).name)))
		return
	show_loadout(class_id, tr("%s en el equipo inicial.") % tr(str(Equipment.item_def(it).name)))





