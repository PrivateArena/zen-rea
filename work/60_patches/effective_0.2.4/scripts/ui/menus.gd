func _coop_join() -> void :
	_mode = "coop"
	var net: NetSync = world.net
	var my_class: String = world.town.class_id if world.town != null else _run_class
	var body: = _ro_screen(tr("Unirse a una sala"), 340)
	body.add_child(_npc_header("npc_party", tr("Lydia"), tr("¿Te pasaron un código? Escríbelo y te llevo con tu grupo."), 320))
	var row: = HBoxContainer.new()
	row.add_theme_constant_override("separation", 6)
	body.add_child(row)
	var field: = LineEdit.new()
	field.placeholder_text = tr("Código de la sala")
	field.size_flags_horizontal = Control.SIZE_EXPAND_FILL
	field.max_length = 40
	field.alignment = HORIZONTAL_ALIGNMENT_CENTER
	field.add_theme_font_size_override("font_size", 14)
	row.add_child(field)
	var do_join: = func():
		var text: = field.text.strip_edges()
		if text == "":
			return
		_coop_wait(tr("Buscando la sala..."))
		var eos = net.eos()
		if text.contains(".") or eos == null:
			var port: = NetSync.PORT
			if text.contains(":"):
				port = int(text.get_slice(":", 1))
				text = text.get_slice(":", 0)
			net.join(text, port, my_class)
		else:
			var peer = await eos.join_async(text)
			if peer == null:
				_coop_menu(str(eos.error))
				return
			net.join("", 0, my_class, peer)
		show_coop()
	row.add_child(_ro_button(tr("Unirse"), do_join))
	field.text_submitted.connect( func(_t): do_join.call())
	var footer: = HBoxContainer.new()
	footer.alignment = BoxContainer.ALIGNMENT_END
	body.add_child(footer)
	footer.add_child(_ro_button(tr("Volver"), func(): _coop_menu()))
	field.grab_focus.call_deferred()





func _coop_channels(to_town: = false) -> void :
	var ch: TownChannel = world.channel
	_coop_wait(tr("Buscando canales..."))
	var chans: Array = await ch.list_async()
	if _mode != "coop":
		return
	var back: = func():
		if to_town:
			_back_to_hub()
		elif world.net.mode == "":
			_coop_menu()
		else:
			show_coop()
	_mode = "coop"
	var body: = _ro_screen(tr("Prontera online"), 340)
	body.add_child(_npc_header("npc_party", tr("Lydia"), tr("En cada canal pasean hasta %d aventureros. ¿A cuál te llevo?") % TownChannel.MAX_PLAYERS, 320))
	var first: = _menu_option(_item_icon("sign_chat"), tr("Automático"), tr("El canal con más gente que aún tenga sitio"), func():
		_coop_wait(tr("Entrando al canal..."))
		await ch.join_async(0)
		back.call())
	body.add_child(first)
	var list: = VBoxContainer.new()
	list.add_theme_constant_override("separation", 4)
	var scroll: = ScrollContainer.new()
	scroll.horizontal_scroll_mode = ScrollContainer.SCROLL_MODE_DISABLED
	scroll.custom_minimum_size = Vector2(0, mini(chans.size(), 5) * 54)
	scroll.add_child(list)
	list.size_flags_horizontal = Control.SIZE_EXPAND_FILL
	body.add_child(scroll)
	for c in chans:
		var n: = int(c[0])
		var here: = ch.is_in() and n == ch.number
		var full: = int(c[1]) >= TownChannel.MAX_PLAYERS
		var sub: = tr("Aquí estás") if here else (tr("Lleno") if full else tr("%d / %d jugadores") % [int(c[1]), TownChannel.MAX_PLAYERS])
		var opt: = _menu_option(_item_icon("sign_shop"), tr("Canal %d") % n, sub, func():
			_coop_wait(tr("Entrando al canal..."))
			await ch.join_async(n)
			back.call())
		opt.disabled = here or full
		list.add_child(opt)
	if ch.error != "":
		body.add_child(_ro_text(ch.error, 11, Color(0.7, 0.2, 0.2)))
	var footer: = HBoxContainer.new()
	footer.alignment = BoxContainer.ALIGNMENT_END
	body.add_child(footer)
	footer.add_child(_ro_button(tr("Volver"), back))
	first.grab_focus.call_deferred()




func _coop_quick() -> void :
	_mode = "coop"
	var ch: TownChannel = world.channel
	var body: = _ro_screen(tr("Buscar party rápido"), 340)
	body.add_child(_npc_header("npc_party", tr("Lydia"), tr("Te busco compañeros. Con 4 salimos enseguida; con 2 o más, cuando todos voten empezar (o pasado un minuto). El más avanzado será el líder."), 320))
	var shown: = _ro_text("", 13, Color(0.55, 0.32, 0.0), true)
	body.add_child(shown)

	var votes: = VBoxContainer.new()
	votes.add_theme_constant_override("separation", 2)
	body.add_child(votes)
	var pick: = HBoxContainer.new()
	pick.alignment = BoxContainer.ALIGNMENT_CENTER
	pick.add_theme_constant_override("separation", 8)
	body.add_child(pick)

	var yes_b: = _ro_button(tr("Votar para empezar"), func(): ch.quick_vote("" if ch.quick_vote_mine == "yes" else "yes"))
	yes_b.custom_minimum_size = Vector2(170, 22)
	pick.add_child(yes_b)
	var vote_key: = [""]
	var tick: = func():
		if not is_instance_valid(shown) or _mode != "coop":
			return
		if world.net.mode != "" and ch.quick in ["", "done"]:
			show_coop()
			return
		if ch.quick == "":
			_coop_menu()
			return
		shown.text = tr("Buscando party...  %d / 4  ·  %s") % [maxi(1, ch.quick_count()), UiKit.time_text(ch.quick_waited())]\
		if ch.quick == "search" else tr("¡Party encontrada! Conectando...")
		var list: Array = ch.quick_votes() if ch.quick == "search" else []
		pick.visible = ch.quick == "search" and list.size() >= 2
		yes_b.text = ("✓ " + tr("Votaste empezar")) if ch.quick_vote_mine == "yes" else tr("Votar para empezar")
		var key: = var_to_str(list)
		if key == vote_key[0]:
			return
		vote_key[0] = key
		for c in votes.get_children():
			c.queue_free()

		if list.size() < 2:
			return
		var yes: = 0
		for v in list:
			if str(v[1]) == "yes":
				yes += 1
			var who: = str(v[0]) if str(v[0]) != "" else tr("Aventurero")
			if bool(v[2]):
				who += " " + tr("(tú)")
			var what: String = tr("quiere empezar") if str(v[1]) == "yes" else tr("esperando")
			var col: Color = {"yes": Color(0.15, 0.5, 0.2), "no": Color(0.6, 0.35, 0.05)}.get(str(v[1]), Color(0.28, 0.3, 0.4))
			votes.add_child(_ro_text("•  %s — %s" % [who, what], 11, col))
