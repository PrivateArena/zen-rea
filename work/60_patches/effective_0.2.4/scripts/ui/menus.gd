func _do_socket() -> void :
	var it: = Save.storage_item(_socket_uid)
	if it.is_empty() or Equipment.socket_room(it) <= 0:
		return
	var price: = Equipment.socket_price(it)
	var mat: = str(price[1])
	var need: = int(price[2])
	if (need > 0 and Save.material(mat) < need) or not Save.spend(int(price[0])):
		return
	for i in need:
		Save.use_material(mat)
	var ok: = randf() < Equipment.socket_chance(it)
	if ok:
		it["extra_slots"] = int(it.get("extra_slots", 0)) + 1

		if int(it.extra_slots) >= GameData.SOCKET_MAX_LEGENDARY and world != null:
			world.channel.feat("socket", str(it.id), int(it.extra_slots))
	Save.mark_dirty()
	Save.flush()
	world.play_sound("refine_hammer", 0.0, -4.0)
	world.net.town_event("socket", ok)
	get_tree().create_timer(0.45, true).timeout.connect( func():
		if ok:
			world.play_sound("refine_ok" if RoAssets.sound("refine_ok") != null else "levelup", 0.0, -2.0)
		else:
			world.play_sound("refine_fail", 0.0, -2.0))
	var npc: Node3D = world.town.npc_node("socket") if world.town != null else null
	if npc != null:
		world.emote(npc, "ok" if ok else "sweat", 1.6)
	if ok:
		if _eternal_fits(it).is_empty():
			show_socket(tr("«¡Hecho! %s, con un hueco más. Cuando fundas una Carta Eterna que le vaya, vuelve y te la engarzo.»") % Equipment.item_name(it))
		else:
			show_socket(tr("«¡Hecho! %s, con un hueco más. Haz clic en el hueco «+» para ponerle una Carta Eterna.»") % Equipment.item_name(it))
	else:
		show_socket(tr("«Uf... no hubo suerte. La pieza está intacta; ¿probamos otra vez?»"), false)
	_refine_anim(ok, false)



