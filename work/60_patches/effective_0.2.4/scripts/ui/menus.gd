static func _card_kind(id: String, kind: String) -> bool:
	var c: Dictionary = GameData.CARDS[id]
	for k in ALBUM_KINDS[kind].keys:
		if k in ["proc", "proc_hit"] and c.has(k):
			return true
		if c.get("mods", {}).has(k) or c.get("effects", {}).has(k):
			return true
	return false




