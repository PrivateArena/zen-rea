func _resume() -> void :
	get_tree().paused = false
	close()



func _build_summary(p: Player, gear_and_cards: = true, with_gear: = true) -> PanelContainer:
	var panel: = PanelContainer.new()
	panel.add_theme_stylebox_override("panel", UiKit.panel_box())
	panel.custom_minimum_size = Vector2(380, 0)
	var col: = VBoxContainer.new()
	col.add_theme_constant_override("separation", 6)
	panel.add_child(col)
	var head: = UiKit.label(tr("%s  ·  Base Lv. %d") % [p.job_name(), p.level], 16, UiKit.TEXT, true)
	head.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER
	col.add_child(head)
	var skills: = HFlowContainer.new()
	skills.alignment = FlowContainer.ALIGNMENT_CENTER
	skills.add_theme_constant_override("h_separation", 8)
	skills.add_theme_constant_override("v_separation", 4)
	skills.custom_minimum_size.x = 360
	col.add_child(skills)
	for id in p.skills:
		var cell: = VBoxContainer.new()
		cell.add_theme_constant_override("separation", 2)
		var icon: = UiKit.skill_icon(id)
		if icon != null:
			var r: = UiKit.icon_rect(icon, 32)
			r.size_flags_horizontal = Control.SIZE_SHRINK_CENTER
			cell.add_child(r)


		var shown_lv: = int(p.skills[id].level) + (9 if GameData.SKILLS[id].get("evolved", false) else 0)
		var l: = UiKit.label("%s %d" % [tr(GameData.SKILLS[id].name), shown_lv] if with_gear else tr("Nv %d") % shown_lv, 11, UiKit.MUTED)
		l.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER
		cell.add_child(l)

		if world != null and world.hud != null:
			_set_hover(cell, world.hud._skill_hover(id))
			cell.mouse_filter = Control.MOUSE_FILTER_STOP
			for c in cell.get_children():
				(c as Control).mouse_filter = Control.MOUSE_FILTER_IGNORE
		skills.add_child(cell)
	var stat_parts: Array[String] = []
	for id in p.stats:
		stat_parts.append("%s %d" % [tr(GameData.STATS[id].name), p.stats[id]])
	var stats: = UiKit.label("   ".join(stat_parts), 13, UiKit.GOLD, true)
	stats.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER
	col.add_child(stats)
	var gear_names: Array[String] = []
	for k in p.equipment.slots:
		if p.equipment.slots[k] != null:
			gear_names.append(Equipment.item_name(p.equipment.slots[k]))
	if not gear_names.is_empty() and gear_and_cards and with_gear:
		var gear: = UiKit.label(tr("Equipo: %s") % ", ".join(gear_names), 12, UiKit.MUTED)
		gear.autowrap_mode = TextServer.AUTOWRAP_WORD_SMART
		gear.custom_minimum_size.x = 360
		gear.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER
		col.add_child(gear)
	if not p.cards.is_empty() and gear_and_cards:
		var cards: = UiKit.label(tr("Cartas: %s") % card_list(p.cards), 12, UiKit.MUTED)
		cards.autowrap_mode = TextServer.AUTOWRAP_WORD_SMART
		if not with_gear:

			cards.max_lines_visible = 2
			UiKit.fit_dots(cards)
			cards.tooltip_text = cards.text
			cards.mouse_filter = Control.MOUSE_FILTER_PASS
		cards.custom_minimum_size.x = 360
		cards.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER
		col.add_child(cards)
	return panel


func show_end(victory: bool, result: Dictionary) -> void :
	get_tree().paused = false
	_mode = "end"

	_picked_stage = ""
	if world != null:
		world.hud.hide()
	var title: = tr("¡MVP derrotado!") if victory else tr("Has caído")

	if victory and world != null and world.endless and world.player != null and world.player.fell:
		title = tr("Modo infinito: has caído")
	if world != null and world.tower != null:
		title = tr("Endless Tower: hasta el piso %d") % (world.tower.floor - (1 if world.tower.state in ["rest", "climb"] else 0))
	var stage_name: String = tr(world.stage.name) if world != null else ""


	if world != null and world.tower == null and world.festival == null and not world.training and world.danger > 0:
		stage_name += "  ·  " + GameData.danger_name(world.danger)
		if world.hard:
			stage_name += "  ·  " + tr("Difícil")
		if world.frenzy:
			stage_name += "  ·  " + (tr("Frenesí x2") if world.game_fast else tr("Frenesí"))
	var col: = _screen(title, "%s  ·  %s" % [stage_name, result.get("class", "")], 
		UiKit.GOLD if victory else Color(1, 0.55, 0.5))
	col.add_theme_constant_override("separation", 8)
	var best: Dictionary = result.best

	var tiles: = HBoxContainer.new()
	tiles.alignment = BoxContainer.ALIGNMENT_CENTER
	tiles.add_theme_constant_override("separation", 8)
	col.add_child(tiles)
	tiles.add_child(_stat_tile(tr("Tiempo"), UiKit.time_text(result.time)))
	tiles.add_child(_stat_tile(tr("Nivel"), str(result.level)))
	tiles.add_child(_stat_tile(tr("Derrotados"), str(result.kills)))
	tiles.add_child(_stat_tile(tr("Zeny"), "+%s" % RoBasicWindow._thousands(int(result.get("zeny", 0)))))
	if best.has("class_level"):
		tiles.add_child(_stat_tile(tr("Nv. de clase"), str(best.class_level)))


	var rec: Dictionary = result.get("record", {})
	if not rec.is_empty():
		if rec.has("floor"):
			tiles.add_child(_stat_tile(tr("Piso"), str(int(rec.floor))))
		else:
			tiles.add_child(_stat_tile(tr("Puntos"), RoBasicWindow._thousands(int(rec.score))))
		if bool(rec.get("online", false)) and world != null:
			var place: = UiKit.label(tr("Enviando tu récord del mes..."), 13, UiKit.MUTED, true)
			place.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER
			col.add_child(place)
			world.board.submitted.connect( func(d: Dictionary): _record_place(place, d), CONNECT_ONE_SHOT)




	if world != null and world.player != null and not world.player.death_by.is_empty() and ( not victory or world.player.fell or world.player.hp <= 0.0 or world.player.downed):
		tiles.add_child(_death_line(world.player.death_by))


	var scroll: = ScrollContainer.new()
	scroll.horizontal_scroll_mode = ScrollContainer.SCROLL_MODE_DISABLED


	scroll.add_theme_stylebox_override("panel", StyleBoxEmpty.new())
	col.add_child(scroll)
	var pad: = MarginContainer.new()
	for side in ["margin_left", "margin_right", "margin_top", "margin_bottom"]:
		pad.add_theme_constant_override(side, 6)
	scroll.add_child(pad)
	var cols: = HBoxContainer.new()
	cols.alignment = BoxContainer.ALIGNMENT_CENTER
	cols.add_theme_constant_override("separation", 10)
	pad.add_child(cols)
	cols.add_child(_end_rewards(result, best))


	var hero_card: PanelContainer = null
	if world != null and world.player != null:
		hero_card = _build_summary(world.player, true, false)
		cols.add_child(hero_card)
		cols.add_child(_build_damage_report())


	for c in cols.get_children() + tiles.get_children():
		_soft_shadow(c as Control)
	if world != null and not world.run_cards.is_empty():
		col.add_child(_end_cards(world.run_cards, maxf(640.0, cols.get_combined_minimum_size().x)))
	var keep: Array = result.get("keep", [])
	_keep_pending = false
	if not keep.is_empty():
		col.add_child(_keep_section(keep, bool(result.get("keep_free", false))))

	var row: = HBoxContainer.new()
	row.alignment = BoxContainer.ALIGNMENT_CENTER
	row.add_theme_constant_override("separation", 8)
	col.add_child(row)
	var to_maps: Button

	var follower: = world != null and world.net.is_client()
	if victory and world != null and not follower:
		var unlocked: = world.newly_unlocked

		var opened: Dictionary = GameData.REGIONS.get(unlocked, GameData.STAGES.get(unlocked, {}))
		to_maps = UiKit.button(tr("Elegir destino  ·  ¡%s desbloqueado!") % tr(str(opened.name))
			if not opened.is_empty() else tr("Elegir destino"), true)
		to_maps.pressed.connect( func(): _end_leave( func(): show_server_select()))
		row.add_child(to_maps)
	var again: = UiKit.button(tr("Jugar de nuevo"), to_maps == null)
	var class_id: = world.player.class_id if world != null and world.player != null else ""
	again.pressed.connect( func(): _end_leave( func(): world.start_run(class_id, true)))

	if not follower and (world == null or world.tower == null):
		row.add_child(again)

	if class_id != "":
		var first_visit: = not bool(Save.setting("town_visited", false))

		var reborn: = not first_visit and (Save.can_rebirth(class_id) or Save.rebirth_lv_ready(class_id))
		var town: = UiKit.button(tr("Ir a Prontera  ·  ¡mejora a tus héroes!") if first_visit else (tr("Ir a Prontera  ·  ¡puedes renacer!") if reborn else tr("Ir a Prontera")), 
			(first_visit or reborn) and to_maps == null)
		town.pressed.connect( func(): _end_leave( func(): show_loading( func(): world.enter_town(class_id), [Town.MAP])))
		row.add_child(town)
	var change: = UiKit.button(tr("Cambiar de clase"))
	change.pressed.connect( func(): _end_leave(show_class_select))
	row.add_child(change)


	var tower_btn: Button = null




	if world != null and world.player != null and world.tower == null and not world.autopilot and not world.training\
	and world.player.level >= GameData.TOWER_BUILD_MIN_LEVEL and (Save.tower_open() or Save.tower_ready()):




		var hero: = world.player
		if not hero.has_meta("tower_snap"):
			var snap0: = RunSave.hero_snapshot(world)


			if follower:
				snap0["bag"] = (snap0.get("bag", []) as Array).filter( func(b): return Equipment.is_perm(b))
			hero.set_meta("tower_snap", snap0)
			hero.set_meta("tower_saved", [true])
			Save.add_tower_build(hero.get_meta("tower_snap"))
		var snap: Dictionary = hero.get_meta("tower_snap")
		var saved: Array = hero.get_meta("tower_saved")
		var keep_build: = UiKit.button("")
		keep_build.size_flags_horizontal = Control.SIZE_SHRINK_CENTER
		keep_build.tooltip_text = tr("Este héroe tal como está, para la Endless Tower (se gasta al entrar) y el Emperium Festival de nearQ (no se gasta).") + "\n" + tr("Se guardan las %d más recientes.") % Save.TOWER_BUILDS_MAX
		var show: = func():
			keep_build.text = tr("Build guardada  ·  clic: quitar") if saved[0] else tr("Guardar build")
		show.call()
		keep_build.pressed.connect( func():
			saved[0] = not saved[0]
			if saved[0]:
				Save.add_tower_build(snap)
			else:
				Save.drop_tower_build(snap)
			show.call()
			ui_click())
		tower_btn = keep_build
	if tower_btn != null:


		var foot: = HBoxContainer.new()
		foot.alignment = BoxContainer.ALIGNMENT_CENTER
		foot.add_theme_constant_override("separation", 6)
		foot.size_flags_vertical = Control.SIZE_SHRINK_END | Control.SIZE_EXPAND
		if hero_card != null:
			hero_card.get_child(0).add_child(foot)
		else:
			row.add_child(foot)
		tower_btn.add_theme_font_size_override("font_size", 13)
		tower_btn.custom_minimum_size.y = 30
		foot.add_child(tower_btn)

		var list_btn: = UiKit.button("")
		list_btn.add_theme_font_size_override("font_size", 13)
		list_btn.custom_minimum_size.y = 30
		var count: = func():
			list_btn.text = tr("Tus builds") + "  (%d)" % Save.tower_builds().size()
		count.call()
		list_btn.tooltip_text = tr("Ver y borrar tus builds guardadas")
		var hero: = world.player
		tower_btn.pressed.connect(count)
		list_btn.pressed.connect( func():
			ui_click()

			_builds_manager( func():
				if is_instance_valid(list_btn):
					count.call()
				if is_instance_valid(tower_btn) and is_instance_valid(hero) and hero.has_meta("tower_snap"):
					var sv: Array = hero.get_meta("tower_saved")
					var mine: Dictionary = hero.get_meta("tower_snap")
					sv[0] = Save.tower_builds().any( func(b): return is_same(b, mine))
					tower_btn.text = tr("Build guardada  ·  clic: quitar") if sv[0] else tr("Guardar build")))
		foot.add_child(list_btn)
	if to_maps != null:
		to_maps.grab_focus.call_deferred()
	elif again.is_inside_tree():
		again.grab_focus.call_deferred()
	_fit_end_scroll.call_deferred(scroll, pad, col)







func show_tower() -> void :


	if world != null and world.net.is_client():
		show_npc_line(tr("Lucile"), "npc_lucile", tr("¿Subís en grupo? El líder abre la subida: cuando lo haga, te pediré que elijas tu build."))
		return
	_mode = "tower"
	var hel: = tower_hel and Save.hel_open()
	tower_hel = hel
	var col: = _screen(tr("Lucile  ·  Torre de Hel") if hel else tr("Lucile  ·  Endless Tower"), "")
	_npc_cutin("tnm_lucile01" if not Save.tower_builds().is_empty() else "tnm_lucile02")

	if hel:
		_cutin_say(tr(str(GameData.HEL_LUCILE_LINES.pick_random())), tr("Lucile"))
	elif not Save.has_seen("talks", "lucile"):
		Save.mark_seen("talks", "lucile")
		_cutin_say(GameData.LUCILE_INTRO.map( func(l): return tr(str(l))), tr("Lucile"))
	else:
		_cutin_say(tr(str(GameData.LUCILE_LINES.pick_random())), tr("Lucile"))
	col.add_theme_constant_override("separation", 5)
	col.custom_minimum_size.x = 600
	var top: = Save.tower_top()
	if hel:
		_hel_flames()
		col.add_child(_hel_banner())
	else:
		col.add_child(_tower_banner(top))

	if Save.hel_earned():
		col.add_child(_tower_modes(hel))
	if hel:
		_show_hel_body(col)
		return

	var stats: = HBoxContainer.new()
	stats.add_theme_constant_override("separation", 8)
	col.add_child(stats)
	stats.add_child(_tower_stat(tr("Piso más alto"), str(top), Color(0.55, 0.35, 0.95)))
	stats.add_child(_tower_stat(tr("Daño y vida en la torre"), "+%d%%" % roundi(Save.tower_power() * 100.0), Color(0.9, 0.35, 0.3)))
	stats.add_child(_tower_stat(tr("Huecos de legendaria"), "+%d" % Save.tower_legend_slots(), Color(0.95, 0.6, 0.15)))

	var builds_box: = _tower_section(tr("Tus builds"))
	col.add_child(builds_box.panel)
	var start: = [1]

	var party: = _tower_party()
