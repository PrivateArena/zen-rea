func show_album() -> void :
	_mode = "album"




	if world != null and world.net.mode != "" and world.town != null:
		world.net.update_class(world.town.class_id)
	Save.see_fusible()
	var view: = get_viewport().get_visible_rect().size
	var k: = clampf(floorf(view.y / 640.0), 1.0, 2.0)
	var width: = clampf(view.x / k * 0.86, 560.0, 980.0)
	var body: = _ro_screen(tr("Álbum"), width)

	var fresh: = Achievements.check()
	var equipped: Array = Save.equipped_cards()
	var slots: = GameData.card_slots()
	var found: = GameData.CARDS.keys().filter( func(c): return Save.has_card(c)).size()
	var pets_found: = GameData.PETS.keys().filter( func(p): return Save.has_pet(p)).size()

	var tabs: = HBoxContainer.new()
	tabs.add_theme_constant_override("separation", 4)
	body.add_child(tabs)
	for t in [["cards", tr("Cartas  %d / %d") % [found, GameData.CARDS.size()]], 
			["pets", tr("Mascotas  %d / %d") % [pets_found, GameData.PETS.size()]], 
			["gear", tr("Colección  %d%%") % _gear_percent()], 
			["evo", tr("Habilidades")], 
			["ach", tr("Logros  %d%%") % roundi(Achievements.percent() * 100.0)], 
			["plagio", tr("Plagio  %d / %d") % [Save.plagiarized().size(), GameData.plagiarism_pairs().size()]], 
			["hist", tr("Historial  %d") % Save.history().size()]]:
		var tab_id: String = t[0]
		var b: = _ro_button(t[1], func():
			_album_tab = tab_id
			_album_scroll = 0
			show_album())

		b.custom_minimum_size = Vector2(minf(150.0, (width - 70.0) / 7.0), 26)
		if _album_tab == tab_id:
			_select_style(b)

		if (tab_id == "cards" and Save.fusible_count() > 0) or (tab_id == "ach" and not Save.unclaimed_achievements().is_empty()):
			_glow(b)
		if tab_id == "ach":
			_ach_tab = b
		tabs.add_child(b)
	var spacer: = Control.new()
	spacer.size_flags_horizontal = Control.SIZE_EXPAND_FILL
	tabs.add_child(spacer)
	if _album_tab == "cards":
		_album_cards(body, width, equipped, slots)
	elif _album_tab == "ach":
		_album_achievements(body, width)
	elif _album_tab == "evo":
		_album_evolutions(body, width)
	elif _album_tab == "plagio":
		_album_plagiarism(body, width)
	elif _album_tab == "gear":
		_album_gear(body, width)
	elif _album_tab == "hist":
		_album_history(body, width)
	else:
		_album_pets(body, width)
	var footer: = HBoxContainer.new()
	footer.alignment = BoxContainer.ALIGNMENT_END
	body.add_child(footer)


	var builds_b: = _ro_button(tr("Tus builds") + "  (%d)" % Save.tower_builds().size(), func(): _builds_manager(show_album))
	builds_b.tooltip_text = tr("Tus builds guardadas: verlas, renombrarlas, bloquearlas o borrarlas.")
	footer.add_child(builds_b)
	var fgap: = Control.new()
	fgap.size_flags_horizontal = Control.SIZE_EXPAND_FILL
	footer.add_child(fgap)
	footer.add_child(_zeny_chip())
	if not fresh.is_empty():
		var nl: = _ro_text(tr_n("¡%d logro nuevo!", "¡%d logros nuevos!", fresh.size()) % fresh.size(), 12, Color(0.6, 0.38, 0.0), true)
		nl.size_flags_vertical = Control.SIZE_SHRINK_CENTER
		footer.add_child(nl)
		world.play_sound("drop_purple", 0.0, -4.0)
	var close: = _ro_button(tr("Cerrar"), _back_to_hub)
	footer.add_child(close)
	close.grab_focus.call_deferred()









func _album_box(state: String, margin: = 6) -> StyleBoxFlat:
	var box: = StyleBoxFlat.new()
	match state:
		"hot":
			box.bg_color = Color(1.0, 0.94, 0.72)
			box.border_color = Color(0.95, 0.62, 0.1)
			box.set_border_width_all(2)
		"done":
			box.bg_color = Color(1.0, 0.97, 0.86)
			box.border_color = Color(0.85, 0.66, 0.25)
			box.set_border_width_all(1)
		"on":
			box.bg_color = Color(0.91, 0.94, 1.0)
			box.border_color = Color(0.3, 0.42, 0.78)
			box.set_border_width_all(2)
		"dim":
			box.bg_color = Color(0.93, 0.94, 0.97)
			box.border_color = Color(0.82, 0.84, 0.9)
			box.set_border_width_all(1)
		_:
			box.bg_color = Color(0.97, 0.98, 1.0)
			box.border_color = Color(0.74, 0.79, 0.9)
			box.set_border_width_all(1)
	box.set_corner_radius_all(6)
	box.set_content_margin_all(margin)
	return box


