			if f in MULT_FIELDS:
				return "×%s" % str(snappedf(1.0 + v, 0.01))

			if f == "cleave_dmg":
				return "%d%%" % roundi((GameData.AGI_CLEAVE_DMG + v) * 100.0)
			if f == "cleave_extra":
				return "+%d" % roundi(v)
			if f == "cleave_reach":
				return "+%s" % str(snappedf(v, 0.1))

			if f in ["sphere_power", "kick_fury", "stance"]:
				return "%s%%" % str(snappedf(v * 100.0, 0.1))
			if f in percent:
				return "%d%%" % roundi(v * 100.0)
			if f == "kaizel":
				return "%d s" % roundi(v)
			if f == "mult":
				return "x%s" % str(snappedf(v, 0.01))
			if f in ["count", "pierce", "spheres", "coins", "zeny", "zeny_cost", "hits", "summon_count"]:
				return str(int(v))
			if f in ["chain_combo", "combo_finish"]:
				return "x%s" % str(snappedf(v, 0.01))
			if f == "cicada":
				return str(snappedf(v, 0.1))
			if f == "cooldown":
				return "%.2f s" % v
			return str(snappedf(v, 0.1)) if absf(v) < 10.0 else str(roundi(v))
		if now:
			lines.append("%s  %s" % [names.get(f, f), fmt.call(b)])
			continue
		lines.append("%s  %s MAX" % [names.get(f, f), fmt.call(b)] if maxed else "%s  %s → %s" % [names.get(f, f), fmt.call(a), fmt.call(b)])
		if f == "sage_double":
			lines.append_array(_sage_double_lines(id, a, b))

	if now:
		return "\n".join(lines)
	return "\n".join(lines) if not lines.is_empty() else _skill_desc(id)



func _multi_words(c: float) -> String:
	var words: Array = [tr("doble"), tr("triple"), tr("cuádruple")]
	var sure: = mini(floori(c), GameData.MULTI_CAST_MAX)
	var rest: = c - floorf(c)
	if sure >= GameData.MULTI_CAST_MAX:
		return tr("cuádruple seguro (MAX)")
	if sure <= 0:
		return tr("%d%% de doble") % roundi(rest * 100.0)
	return tr("%s seguro + %d%% de %s") % [str(words[sure - 1]), roundi(rest * 100.0), str(words[sure])]







func _sage_double_lines(id: String, a: float, b: float) -> Array[String]:
	var out: Array[String] = []
	var pl: Player = world.player if world != null else null
	if pl == null:
		return out
	var copied: = pl.is_plagiarized(id)
	var k: = GameData.SAGE_DOUBLE_COPIED if copied else (GameData.SAGE_DOUBLE_PROF if str(pl.job2.get("id", "")) == "professor" else 1.0)
	if not is_equal_approx(k, 1.0):
		out.append((tr("×%s (copiada): %d%% → %d%%") if copied else tr("×%s (Professor): %d%% → %d%%")) % [
			str(k), roundi(a * k * 100.0), roundi(b * k * 100.0)])


	var general: = pl.double_cast_chance("") if copied else pl.double_cast_chance("fire_bolt") - float(pl.effects.get("sage_double", 0.0)) * k
	if general > 0.0:
		var total_b: = general + b * k
		out.append(tr("Con el general (+%d%%): %d%% → %d%%") % [roundi(general * 100.0), roundi((general + a * k) * 100.0), roundi(total_b * 100.0)])
		if total_b > GameData.MULTI_CAST_TRIPLE_AT:
			out.append(tr("Cada 100% es un lanzamiento extra seguro; lo que sobra, la probabilidad de uno más"))
	return out



func _evolves_note(passive: String) -> String:
	if world == null or world.player == null or not Player.is_passive(passive):
		return ""
	var names: Array[String] = []
	var pool: Array = world.player.skill_pool()
	for id in GameData.EVOLUTIONS:
		if str(GameData.EVOLUTIONS[id].passive) == passive and (pool.has(id) or world.player.skills.has(id)):
			names.append(tr(str(GameData.SKILLS[id].name)))
	return "" if names.is_empty() else "\n" + tr("Permite evolucionar: %s (Nv 5)") % ", ".join(names)



static func card_list(ids: Array) -> String:
	var counts: = {}
	for c in ids:
		counts[c] = int(counts.get(c, 0)) + 1
	var parts: Array[String] = []
	for c in counts:
		var n: = TranslationServer.translate(GameData.CARDS[c].name)
		parts.append(n if counts[c] == 1 else "%s x%d" % [n, counts[c]])
	return ", ".join(parts)







func _skill_chips_for(id: String) -> Array:
	var sk: Dictionary = GameData.SKILLS.get(id, {})
	if sk.is_empty():
		return []
	var p: Player = world.player if world != null and world.player != null and is_instance_valid(world.player) else null
	var grows: = ""
	if sk.has("damage") or GameData.SKILL_SCALE.has(id.trim_suffix("_x")):
		grows = p.scaling_text(id) if p != null else GameData.skill_scaling(id)
	elif str(sk.get("type", "")) == "buff" and sk.has("bonus"):
		grows = GameData.support_scaling(id)
	var el: = ""
	if GameData.skill_has_element(id):
		el = Skills.element_of(p, sk) if p != null else str(sk.get("element", "neutral"))
	var chips: = HoverCard.skill_chips(id, grows, el, sk.get("uses_arrows", false))
	for k in _skill_kinds(sk):
		if not chips.any( func(c): return str(c[0]) == str(k[0])):
			chips.append(k)
	return chips


func _skill_kinds(sk: Dictionary) -> Array:
	var out: = []
	if sk.get("ninjutsu", false):
		out.append([tr("Ninjutsu"), Color(0.6, 0.45, 0.95)])
	if sk.get("thrown", false):
		out.append([tr("Lanzable"), Color(0.35, 0.55, 0.9)])
	if sk.has("bleed_chance"):
		out.append([tr("Sangrado"), GameData.BLEED_COLOR])
	if sk.has("burn_chance"):
		out.append([tr("Quemadura"), GameData.BURN_COLOR])
	return out




func _skill_desc(id: String, chips: = false) -> String:
	var sk: Dictionary = GameData.SKILLS[id]
	var tags: Array[String] = []

	if sk.get("needs_shield", false):
		tags.append(tr("Requiere escudo"))
	elif sk.has("shield_scale"):
		tags.append(tr("Mejor con escudo"))
	if sk.has("needs_weapon"):
		tags.append(tr("Requiere: %s") % str(sk.needs_weapon).capitalize())
	if GameData.SKILLS.has(str(sk.get("needs", ""))):
		tags.append(tr("Requiere: %s") % tr(str(GameData.SKILLS[str(sk.needs)].name)))
	if sk.get("lance", false):
		tags.append(tr("Más fuerte montado"))
	if GameData.skill_has_element(id) and not chips:
		var el: String = Skills.element_of(world.player, sk) if world != null and world.player != null else str(sk.get("element", "neutral"))
		var el_name: = tr(str(GameData.ELEMENT_NAMES[el]))
		tags.append(tr("Elemento: %s") % (tr("%s · flecha") % el_name if sk.get("uses_arrows", false) else el_name))
	if sk.get("ninjutsu", false):
		tags.append(tr("Ninjutsu: como Kagerou u Oboro, da un sello que potencia tus ninjutsu"))
	if sk.has("burn_chance"):
		tags.append(tr("Quema: %d%% por golpe (salta al morir)") % roundi(float(sk.burn_chance) * 100.0))
	if sk.has("bleed_chance"):
		tags.append(tr("Sangrado: %d%% por golpe (acumula y revienta)") % roundi(float(sk.bleed_chance) * 100.0))
		if int(sk.get("bleed_stacks", 1)) > 1:
			tags.append(tr("%d cortes por golpe") % int(sk.bleed_stacks))
	if sk.has("status"):
		tags.append(tr("Estado: %s") % tr(str(GameData.STATUS_NAMES[sk.status])))

		var combo: = str(GameData.STATUS_COMBO.get(sk.status, ""))
		if combo != "":
			tags.append(tr("Combo: %s le hace x%s") % [tr(str(GameData.ELEMENT_NAMES[combo])), 
				str(GameData.element_mult(combo, GameData.STATUS_ELEMENT[sk.status]))])

	if GameData.skill_has_element(id):
		var mine: = str(sk.get("element", ""))
		for st in GameData.STATUS_COMBO:

			if GameData.STATUS_COMBO[st] == mine and _kit_has_status(st):
				var who: = tr("congelados") if st == "freeze" else tr("petrificados")
				tags.append(tr("Combo: x%s a %s") % [str(GameData.element_mult(mine, GameData.STATUS_ELEMENT[st])), who])
	return tr(GameData.skill_desc(id, world != null and world.player != null and world.player.def.get("custom", false))) + ("""
""" + "  ·  ".join(tags) if not tags.is_empty() else "")




func _kit_has_status(st: String) -> bool:
	if world == null or world.player == null or not is_instance_valid(world.player):
		return true
	var p: Player = world.player
	for id in p.skills:
		if str(GameData.SKILLS.get(id, {}).get("status", "")) == st:
			return true
	var stack: Array = [p.def]
	while not stack.is_empty():
		var d = stack.pop_back()
		if not d is Dictionary:
			continue
		for k in d:
			var v = d[k]
			if k == "skills" and v is Array:
				for s in v:
					if str(GameData.SKILLS.get(s, {}).get("status", "")) == st:
						return true
			elif v is Dictionary:
				stack.append(v)
	return false


func _choice_icon(choice: Dictionary) -> Texture2D:
	match choice.kind:
