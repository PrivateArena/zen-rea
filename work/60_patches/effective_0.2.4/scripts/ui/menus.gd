func show_rebirth_ceremony(class_id: String) -> void :



	if world.web != null and world.web.get("packs") != null and not world.web.packs.ready_now("map:" + Valhalla.MAP):
		show_loading( func(): Valhalla.start(world, class_id), [Valhalla.MAP])
		return
	Valhalla.start(world, class_id)





const RLV_CONFIRM: = 4.0

const RLV_CARD: = Vector2(124, 150)
const RLV_GAP: = 10
const RLV_TRACK_W: = 700








func show_rebirth_lv(class_id: String) -> void :
	_mode = "rebirth_lv"
	var rlv: = Save.rebirth_lv(class_id)
	var top: = rlv >= GameData.REBIRTH_LV_MAX
	var ready: = Save.rebirth_lv_ready(class_id)
	var quote: = tr("«Valhalla recuerda a quien vuelve a empezar sin olvidar lo que es.»")
	var col: = _screen(tr("Rebirth"), quote)
	var row: = HBoxContainer.new()
	row.add_theme_constant_override("separation", 22)
	row.alignment = BoxContainer.ALIGNMENT_CENTER
	col.add_child(row)

	var stage: = _rlv_stage(class_id)
	row.add_child(stage)
	var info: = VBoxContainer.new()
	info.add_theme_constant_override("separation", 8)
	info.alignment = BoxContainer.ALIGNMENT_CENTER
	info.custom_minimum_size.x = 360
	row.add_child(info)
	var name_row: = HBoxContainer.new()
	name_row.add_theme_constant_override("separation", 10)
	info.add_child(name_row)
	name_row.add_child(UiKit.label(_class_title(class_id), 15, UiKit.MUTED, true))
	var big: = UiKit.label(GameData.rebirth_name(rlv) if rlv > 0 else tr("Sin Rebirth"), 30, GameData.REBIRTH_LV_GOLD.darkened(0.3), true)
	info.add_child(big)
	info.add_child(RebirthMarks.stars(rlv, GameData.REBIRTH_LV_MAX))

	var feather: = HBoxContainer.new()
	feather.add_theme_constant_override("separation", 6)
	feather.add_child(UiKit.icon_rect(_item_icon("sword_wings"), 22))
	feather.add_child(UiKit.label(tr("Cada Rebirth: +1 Pluma de Valkyria (tienes %d)") % Save.wing_feathers(), 12, Color(0.3, 0.4, 0.78), true))
	info.add_child(feather)

	var prog: = Save.class_progress(class_id)
	var lv: = int(prog.level)
	var max_lv: = Save.class_max_level(class_id)
	var lb: = RebirthMarks.gauge(16.0)
	var bar: ProgressBar = lb.bar
	bar.max_value = 1.0
	bar.step = 0.0
	if lv >= max_lv:
		bar.value = 1.0
		(lb.label as Label).text = tr("Nivel de clase %d / %d  ·  MAX") % [lv, max_lv]
	else:
		var need: = Save.class_xp_need(class_id, lv)
		bar.value = float(prog.xp) / maxf(1.0, need)
		(lb.label as Label).text = tr("Nivel de clase %d / %d  ·  %.1f %%") % [lv, max_lv, 100.0 * bar.value]
	info.add_child(bar)
	var how_text: = ""
	if top:
		how_text = tr("Has alcanzado el Rebirth máximo. Valhalla canta tu nombre.")
	elif ready:
		how_text = tr("Estás en la cima. Si renaces vuelves a Nivel de clase 1, pero conservas tus atributos, tu aura y tu renacimiento.")
	else:
		how_text = tr("Llega al Nivel de clase %d para alcanzar %s.") % [max_lv, GameData.rebirth_name(rlv + 1)]
	if not top:
		how_text += "\n" + tr("Volver a subir costará ×%s la EXP de clase.") % str(GameData.REBIRTH_LV_XP[rlv])
	how_text += "\n" + tr("Pasa el cursor por una recompensa para verla en tu héroe; clic en una desbloqueada: mostrar u ocultar.")
	var how: = UiKit.label(how_text, 12, UiKit.MUTED)
	how.autowrap_mode = TextServer.AUTOWRAP_WORD_SMART
	how.custom_minimum_size.x = 360
	info.add_child(how)
	col.add_child(_rlv_track(class_id, stage))
	var buttons: = HBoxContainer.new()
	buttons.alignment = BoxContainer.ALIGNMENT_CENTER
	buttons.add_theme_constant_override("separation", 12)
	col.add_child(buttons)
	var back: = UiKit.button(tr("Volver"))
	back.custom_minimum_size.x = 140
	back.pressed.connect(_back_to_hub)
	if not top:
		var go: = UiKit.button(tr("Renacer: %s") % GameData.rebirth_name(rlv + 1) if ready else tr("Aún no estás en la cima"), true)
		go.custom_minimum_size.x = 260
		go.disabled = not ready
		var asked: = [0.0]
		go.pressed.connect( func():

			var now: = Time.get_ticks_msec() / 1000.0
			if now - float(asked[0]) > RLV_CONFIRM:
				asked[0] = now
				go.text = tr("¿Seguro? Vuelves a Nivel de clase 1 (pulsa otra vez)")
				ui_click()
				get_tree().create_timer(RLV_CONFIRM).timeout.connect( func():
					if is_instance_valid(go):
						go.text = tr("Renacer: %s") % GameData.rebirth_name(rlv + 1))
				return
			if Save.take_rebirth_lv(class_id):
				_back_to_hub()
				if world != null and world.town != null:
					world.town.rebirth_lv_ceremony())
		buttons.add_child(go)
		(go if ready else back).grab_focus.call_deferred()
	else:
		back.grab_focus.call_deferred()
	buttons.add_child(back)





func _rlv_stage(class_id: String) -> Control:
	var d: Dictionary = GameData.CLASSES[class_id]
	var views: = Equipment.loadout_views(class_id)
	var ro: = RoAssets.styled_character(d.body, d.get("weapon", ""), d.get("weapon_fx", ""), [d.get("attack", 5)], 
		views.head, Save.look(class_id), "", views.extras)
	var box: = VBoxContainer.new()
	box.add_theme_constant_override("separation", 6)
	box.mouse_filter = Control.MOUSE_FILTER_IGNORE
	var frame: = PanelContainer.new()
	var fb: = UiKit.panel_box(Color(0, 0, 0, 0), Color(0.78, 0.66, 0.36), 6, 2)
	fb.set_content_margin_all(2)
	frame.add_theme_stylebox_override("panel", fb)
	box.add_child(frame)
	var view: = LookStage.new(ro, Vector2i(150, 140), 0.85, 0.7)
	var picture: = TextureRect.new()
	picture.texture = view.get_texture()
	picture.custom_minimum_size = Vector2(300, 280)
	picture.expand_mode = TextureRect.EXPAND_IGNORE_SIZE
	picture.stretch_mode = TextureRect.STRETCH_SCALE
	picture.texture_filter = RoAssets.ui_filter()
	picture.mouse_filter = Control.MOUSE_FILTER_STOP
	picture.mouse_default_cursor_shape = Control.CURSOR_DRAG
	picture.tooltip_text = tr("Arrastra para girar a tu héroe")
	picture.add_child(view)
	frame.add_child(picture)

	var drag: = [0.0]
	picture.gui_input.connect( func(e: InputEvent):
		if e is InputEventMouseMotion and (e.button_mask & MOUSE_BUTTON_MASK_LEFT) != 0:
			drag[0] += e.relative.x
			while absf(drag[0]) >= 24.0:
				var step: = 1 if drag[0] > 0.0 else -1
				drag[0] -= 24.0 * step
				view.turn(view.dir + step))

	var row: = HBoxContainer.new()
	row.alignment = BoxContainer.ALIGNMENT_CENTER
	row.add_theme_constant_override("separation", 4)
	box.add_child(row)
	var current: = str(Save.setting("rlv_backdrop", "prontera"))
	view.backdrop(current)
	var names: = {"prontera": tr("Prontera"), "field": tr("Pradera"), "night": tr("Noche"), "valhalla": tr("Valhalla")}
	for key in LookStage.BACKDROPS:
		var b: = _ro_button(str(names.get(key, key)), func():
			view.backdrop(key)
			Save.set_setting("rlv_backdrop", key)
			ui_click())
		row.add_child(b)
	box.set_meta("look_ro", ro)
	if ro != null:
		box.set_meta("hero_tex", ro.get_frame(RoVisual.PC_IDLE * RoSprite.DIRS, 0))
	box.set_meta("try_look", func(looks: Array):
		view.wear(looks, RebirthAura.earned(class_id) or not looks.is_empty()))
	(box.get_meta("try_look") as Callable).call(Save.rebirth_looks(class_id))
	return box





func _rlv_track(class_id: String, stage: Control) -> Control:
	var rlv: = Save.rebirth_lv(class_id)
	var n: int = GameData.REBIRTH_LV_LOOKS.size()
	var step: = RLV_CARD.x + RLV_GAP
	var scroll: = ScrollContainer.new()
	scroll.custom_minimum_size = Vector2(RLV_TRACK_W, RLV_CARD.y + 50)
	scroll.size_flags_horizontal = Control.SIZE_SHRINK_CENTER
	scroll.vertical_scroll_mode = ScrollContainer.SCROLL_MODE_DISABLED
	var lane: = VBoxContainer.new()
	lane.add_theme_constant_override("separation", 4)
	scroll.add_child(lane)

	var road: = Control.new()
	road.custom_minimum_size = Vector2(n * step - RLV_GAP, 26)
	road.mouse_filter = Control.MOUSE_FILTER_IGNORE
	road.draw.connect( func():
		var y: = 13.0
		var x0: = RLV_CARD.x * 0.5
		road.draw_line(Vector2(x0, y), Vector2(x0 + (n - 1) * step, y), Color(0.7, 0.72, 0.8), 4.0)
		if rlv > 0:
			road.draw_line(Vector2(x0, y), Vector2(x0 + mini(rlv, n - 1) * step, y), GameData.REBIRTH_LV_GOLD, 4.0)
		var font: = road.get_theme_default_font()
		for i in n:
			var at: = Vector2(x0 + i * step, y)
			var on: = i < rlv
			var next: = i == rlv
			road.draw_circle(at, 12.0, GameData.REBIRTH_LV_GOLD.darkened(0.25) if on else (GameData.REBIRTH_LV_GOLD if next else Color(0.62, 0.64, 0.72)))
			road.draw_circle(at, 10.0, GameData.REBIRTH_LV_GOLD.lightened(0.15) if on else (Color(1, 0.97, 0.85) if next else Color(0.88, 0.9, 0.95)))
			var txt: = GameData.roman(i + 1)
			var w: = font.get_string_size(txt, HORIZONTAL_ALIGNMENT_LEFT, -1, 11).x
			road.draw_string(font, at + Vector2( - w * 0.5, 4), txt, HORIZONTAL_ALIGNMENT_LEFT, -1, 11, 
				Color(0.3, 0.2, 0.05) if on or next else Color(0.28, 0.3, 0.4)))
	lane.add_child(road)
	var cards: = HBoxContainer.new()
	cards.add_theme_constant_override("separation", RLV_GAP)
	lane.add_child(cards)
	for i in n:
		cards.add_child(_rlv_card(class_id, i, stage))

	scroll.gui_input.connect( func(e: InputEvent):
		if e is InputEventMouseButton and e.pressed and e.button_index in [MOUSE_BUTTON_WHEEL_UP, MOUSE_BUTTON_WHEEL_DOWN]:
			scroll.scroll_horizontal += int((-1 if e.button_index == MOUSE_BUTTON_WHEEL_UP else 1) * step)
			scroll.accept_event())

	var focus: = clampi(rlv, 0, n - 1)
	scroll.ready.connect( func():
		await get_tree().process_frame
		if is_instance_valid(scroll):
			scroll.scroll_horizontal = maxi(0, int(focus * step - RLV_TRACK_W * 0.5 + RLV_CARD.x * 0.5)))
	return scroll




func _rlv_card(class_id: String, i: int, stage: Control) -> Control:
	var look: Dictionary = GameData.REBIRTH_LV_LOOKS[i]
	var id: = str(look.id)
	var rlv: = Save.rebirth_lv(class_id)
	var unlocked: = i < rlv
	var next: = i == rlv
	var shown: = Save.rebirth_looks(class_id).has(id)
	var card: = PanelContainer.new()
	card.custom_minimum_size = RLV_CARD
	card.mouse_filter = Control.MOUSE_FILTER_STOP
	card.tooltip_text = tr(str(look.desc))
	var paint: = func():
		var on: = Save.rebirth_looks(class_id).has(id)


		var bg: = Color(1.0, 0.98, 0.91) if unlocked and on else (Color(0.99, 0.97, 0.9) if next else Color(0.97, 0.98, 1.0))
		var border: = GameData.REBIRTH_LV_GOLD if (unlocked and on) or next else Color(0.6, 0.64, 0.75, 0.6 if unlocked else 0.3)
		var box: = UiKit.panel_box(bg, border, 8, 2 if next or (unlocked and on) else 1)
		box.set_content_margin_all(5)
		card.add_theme_stylebox_override("panel", box)
	paint.call()
	var vb: = VBoxContainer.new()
	vb.add_theme_constant_override("separation", 2)
	vb.alignment = BoxContainer.ALIGNMENT_CENTER
	vb.mouse_filter = Control.MOUSE_FILTER_IGNORE
	card.add_child(vb)



	var ic: Control
	var ro: RoSprite = (stage.get_meta("look_ro") if stage.has_meta("look_ro") else null)
	if ro == null:
		ic = UiKit.icon_rect((stage.get_meta("hero_tex") if stage.has_meta("hero_tex") else null), 48)
		ic.texture_filter = CanvasItem.TEXTURE_FILTER_LINEAR
		ic.modulate = Color(0.55, 0.7, 1.0, 0.8)
	else:
		var mini: = LookStage.new(ro, Vector2i(160, 160), 1.55, 0.84, true)
		mini.backdrop("prontera")
		mini.wear([id], id == "gold")
		var tr_rect: = TextureRect.new()
		tr_rect.texture = mini.get_texture()
		tr_rect.custom_minimum_size = Vector2(84, 84)
		tr_rect.expand_mode = TextureRect.EXPAND_IGNORE_SIZE
		tr_rect.stretch_mode = TextureRect.STRETCH_SCALE
		tr_rect.texture_filter = CanvasItem.TEXTURE_FILTER_LINEAR
		tr_rect.mouse_filter = Control.MOUSE_FILTER_IGNORE
		tr_rect.add_child(mini)
		ic = tr_rect
	if not (unlocked or next):
		ic.modulate = Color(0.62, 0.64, 0.72, 0.75)
	ic.size_flags_horizontal = Control.SIZE_SHRINK_CENTER
	vb.add_child(ic)
	var nm: = UiKit.label(tr(str(look.name)), 12, UiKit.TEXT if unlocked or next else UiKit.MUTED, true)
	nm.autowrap_mode = TextServer.AUTOWRAP_WORD_SMART
	nm.custom_minimum_size.x = RLV_CARD.x - 12
	nm.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER
	vb.add_child(nm)
	var state: = UiKit.label("", 10, UiKit.MUTED)
	state.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER
	state.autowrap_mode = TextServer.AUTOWRAP_WORD_SMART
	state.custom_minimum_size.x = RLV_CARD.x - 12
	vb.add_child(state)
	var label_state: = func():
		if unlocked:
			var on: = Save.rebirth_looks(class_id).has(id)
			state.text = tr("Visible  ·  clic para ocultar") if on else tr("Oculto  ·  clic para mostrar")
			state.add_theme_color_override("font_color", GameData.REBIRTH_LV_GOLD.darkened(0.4) if on else UiKit.MUTED)
		else:
			state.text = tr("Siguiente  ·  %s") % GameData.rebirth_name(i + 1) if next else GameData.rebirth_name(i + 1)
			state.add_theme_color_override("font_color", GameData.REBIRTH_LV_GOLD.darkened(0.35) if next else UiKit.MUTED)
	label_state.call()
	var try_look: Callable = stage.get_meta("try_look")
	card.mouse_entered.connect( func(): try_look.call([id]))
	card.mouse_exited.connect( func(): try_look.call(Save.rebirth_looks(class_id)))
	card.gui_input.connect( func(e: InputEvent):
		if unlocked and e is InputEventMouseButton and e.pressed and e.button_index == MOUSE_BUTTON_LEFT:
			Save.set_rebirth_look_shown(class_id, id, not Save.rebirth_looks(class_id).has(id))
			Save.flush()
			ui_click()
			paint.call()
			label_state.call()
			if world != null and world.town != null:
				world.town.refresh_rebirth_looks())
	return card




func _rebirth_tiles(class_id: String, reveal: bool) -> Control:
	var d: Dictionary = GameData.CLASSES[class_id]
	var female: = str(Save.look(class_id).get("gender", "m")) == "f"
	var paths: Array[String] = []
	var skills: Array[String] = []
	for job: Dictionary in GameData.job_paths(class_id):
		paths.append(tr(GameData.job_title(job.trans, female)))
		skills.append(str(job.trans.start))
	var tiles: = [
		[UiKit.skill_icon("blessing"), tr("+%d atributos") % GameData.REBIRTH_STAT_BONUS, tr("todos, desde el inicio")], 
		[UiKit.skill_icon(skills[0]) if not skills.is_empty() else null, tr(" / ").join(paths), tr("nueva habilidad en Base Lv %d") % GameData.JOB_CHANGE_LEVEL], 
		[_item_icon("passive_slot"), tr("+%d pasiva") % GameData.TRANS_EXTRA_PASSIVES, tr("una ranura más")], 
		[_item_icon("valkyrie_helm"), tr("+%d legendaria") % GameData.REBIRTH_LEGEND_SLOTS, tr("y el hueco de alma")], 
		[_item_icon("battle_manual"), tr("Nivel de clase %d") % GameData.REBIRTH_CLASS_MAX_LEVEL, tr("empieza de nuevo en 1")], 
		[_item_icon("card_slot"), tr("Nueva carta"), tr(GameData.CARDS[GameData.REBIRTH_CARD].name)], 
	]
	var grid: = GridContainer.new()
	grid.columns = 3
	grid.add_theme_constant_override("h_separation", 8)
	grid.add_theme_constant_override("v_separation", 8)
	grid.size_flags_horizontal = Control.SIZE_SHRINK_CENTER
	for i in tiles.size():
		var t: Array = tiles[i]
		var tile: = PanelContainer.new()
		tile.add_theme_stylebox_override("panel", UiKit.panel_box(Color(0.97, 0.97, 1.0), Color(0.85, 0.72, 0.35), 8, 1))
		tile.custom_minimum_size = Vector2(196, 56)
		var row: = HBoxContainer.new()
		row.add_theme_constant_override("separation", 8)
		tile.add_child(row)
		var ic: = UiKit.icon_rect(t[0], 36)
		ic.size_flags_vertical = Control.SIZE_SHRINK_CENTER
		row.add_child(ic)
		var txt: = VBoxContainer.new()
		txt.add_theme_constant_override("separation", 0)
		txt.alignment = BoxContainer.ALIGNMENT_CENTER
		row.add_child(txt)
		var head: = UiKit.label(str(t[1]), 14, UiKit.TEXT, true)
		head.clip_text = true
		head.custom_minimum_size.x = 140
		txt.add_child(head)
		txt.add_child(UiKit.label(str(t[2]), 11, UiKit.MUTED))
		grid.add_child(tile)
		if reveal:
			tile.modulate.a = 0.0
			tile.pivot_offset = Vector2(98, 28)
			tile.scale = Vector2.ONE * 0.6
			var tw: = tile.create_tween().set_pause_mode(Tween.TWEEN_PAUSE_PROCESS)
			tw.tween_interval(0.9 + i * 0.18)
			tw.tween_callback( func(): world.play_sound("equip_item", 0.0, -8.0))
			tw.tween_property(tile, "modulate:a", 1.0, 0.15)
			tw.parallel().tween_property(tile, "scale", Vector2.ONE, 0.25).set_trans(Tween.TRANS_BACK).set_ease(Tween.EASE_OUT)
	return grid



func _rebirth_reveal(class_id: String, white: ColorRect) -> void :
	var d: Dictionary = GameData.CLASSES[class_id]
	var high: = tr(GameData.HIGH_NAMES.get(class_id, d.name))
	var col: = _screen(tr("¡Has renacido como %s!") % high, tr("Valhalla te devuelve a Midgard más fuerte."))
	var portrait: = _job_portrait(d.body, d.get("weapon", ""), high, Save.look(class_id))
	portrait.size_flags_horizontal = Control.SIZE_SHRINK_CENTER
	col.add_child(portrait)
	col.add_child(_rebirth_tiles(class_id, true))
	var ok: = UiKit.button(tr("Continuar"), true)
	ok.pressed.connect( func(): show_class_select(class_id))
	col.add_child(ok)
	ok.grab_focus.call_deferred()

	var fade: = ColorRect.new()
	fade.color = Color.WHITE
	fade.set_anchors_and_offsets_preset(Control.PRESET_FULL_RECT)
	fade.mouse_filter = Control.MOUSE_FILTER_IGNORE
	_root.add_child(fade)
	var tw: = fade.create_tween()
	tw.tween_property(fade, "color:a", 0.0, 1.2)
	tw.tween_callback(fade.queue_free)







func _item_hover(it: Dictionary, foot: Array = [], hints: Array = []) -> Dictionary:
	var d: = Equipment.item_def(it)
	var slot: = str(d.get("slot", ""))
	var tag: = tr(GameData.SLOT_NAMES.get("acc1" if slot == "acc" else slot, slot))

	if slot == "weapon" and GameData.ITEMS.has(str(it.get("id", ""))):
		tag = "  ·  ".join(GameData.weapon_class_words(str(it.id)).map( func(w): return tr(str(w))))
	if Equipment.is_unique(it):
		tag = tr("Única") + "  ·  " + tag
	elif Equipment.is_legendary(it):
		tag = tr("Legendaria") + "  ·  " + tag
	var feet: Array = []
	for f in foot:
		feet.append([str(f), Color(0.95, 0.8, 0.4)])
	for c in it.get("eternal", []):
		if GameData.CARDS.has(str(c)):
			feet.push_front([tr("Carta Eterna: %s") % tr(str(GameData.CARDS[str(c)].name)), GameData.ETERNAL_COLOR])


	var g: = Equipment.grade(it)


	if Equipment.grade_pity(it) > 0 and g < GameData.WEAPON_GRADES.size() - 1:
		feet.push_front([tr("Suerte de grado: +%s%% al próximo intento") % GameData.grade_pct(GameData.grade_chance(g + 1, Equipment.grade_pity(it)) - GameData.grade_chance(g + 1, 0)), 
			Color(0.55, 0.95, 0.6)])
	if g > 0:

		var gkind: = Equipment.item_type(it)
		if gkind != "weapon":
			var hh: = _harmony_for(it)
			var hlv: = int(hh.get("level", 0))
			if hlv > 0:
				feet.push_front([tr("Armonía de grado %s: este bono +%d%% (total %s)") % [str(GameData.WEAPON_GRADES[hlv].name), 
					roundi(float(GameData.HARMONY_SHARE[hlv]) * 100.0), GameData.grade_total_text(gkind, GameData.grade_value(gkind, g) * (1.0 + float(GameData.HARMONY_SHARE[hlv])))], 
					GameData.WEAPON_GRADES[hlv].color.lightened(0.2)])
			else:
				feet.push_front([tr("Armonía de grado: con %d piezas de grado, el grado más bajo suma a todas") % GameData.HARMONY_MIN_PIECES, Color(0.75, 0.8, 0.95)])
		feet.push_front([tr("Grado %s: %s") % [str(GameData.WEAPON_GRADES[g].name), GameData.grade_text(Equipment.item_type(it), g)], 
			GameData.WEAPON_GRADES[g].color])

	if Equipment.item_def(it).get("wings", false) and int(it.get("refine", 0)) > 0:
		for i in range(mini(int(it.refine), GameData.WING_LEVELS.size()) - 1, -1, -1):
			feet.push_front(["+%d: %s" % [i + 1, tr(GameData.WING_LEVELS[i])], GameData.WINGS_COLOR.lightened(0.35)])
	var mods: = Equipment.item_mods(it, false)
	var lines: = _mods_lines(mods)
	var rest: = {}
	for k in mods:
		if not _MOD_ROWS.has(k):
			rest[k] = mods[k]
	var rest_text: = _mods_text(rest)
	if rest_text != "-":
		feet.push_front([rest_text, Color(0.5, 0.95, 0.55)])
	if _is_huuma(it):
		feet.push_front([_huuma_note(), Color(0.5, 0.95, 0.55)])

	var trait_d: = Equipment.trait_of(it)
	if not trait_d.is_empty():
		feet.push_front(["◆ %s: %s" % [tr(str(trait_d.name)), tr(str(trait_d.text))], Color(0.85, 0.6, 1.0)])

	var pot: = Potential.lines(it)
	for i in range(pot.size() - 1, -1, -1):

		feet.push_front(["  " + Potential.line_text(pot[i]) + ("  ★" if Potential.is_perfect(pot[i]) else ""), Potential.tier_color(int(pot[i].t)).lightened(0.25)])
	if not pot.is_empty():
		feet.push_front(["★ " + tr("Potencial %s") % Potential.tier_name(Potential.tier(it)), Potential.tier_color(Potential.tier(it)).lightened(0.15)])
	var pnote: = GameData.proc_note(d)
	if pnote != "":
		feet.push_front([pnote, Color(0.7, 0.85, 1.0)])

	if Equipment.two_hands(it):
		feet.push_front([tr("A dos manos: sus bonos, su refinado y su Potencial estelar valen un %d%% más") % roundi(GameData.TWO_HANDED_BONUS * 100.0), Color(0.7, 0.85, 1.0)])


	var users: = []
	if slot == "weapon" and GameData.ITEMS.has(str(it.get("id", ""))):
		users = _weapon_user_list(str(it.id))

	if Equipment.is_soul(it):
		var src: = str(Equipment.item_def(it).soul_of)
		if str(GameData.ITEMS.get(src, {}).get("slot", "")) == "weapon":
			users = _weapon_user_list(src)
	if world != null and world.running and world.player != null and not world.player.equipment.can_wear(it):
		feet.push_front([_wear_block(it, tr("Tu clase no puede equiparlo")), Color(1.0, 0.55, 0.5)])
	for h in hints:
		feet.append([str(h), Color(0.95, 0.8, 0.4), true])
	var info: = {"icon": _item_icon(str(d.get("icon", ""))), "title": Equipment.item_name(it), "color": Equipment.item_color(it), 
		"tag": tag, "lines": lines, "chips": HoverCard.gear_chips(d, users), "desc": _item_desc(it), "foot": feet}
	var st: = _set_info(str(it.get("id", "")))
	if not st.is_empty():
		info["set"] = st
	return info




static var _users_cache: = {}
func _weapon_users(id: String) -> String:
	return ", ".join(_weapon_user_list(id))



func _weapon_user_list(id: String) -> Array:
	var key: = id + ":" + TranslationServer.get_locale()
	if _users_cache.has(key):
		return _users_cache[key]
	var names: = []
	for cid in GameData.CLASSES:
		var line: = [["", tr(str(GameData.CLASSES[cid].name))]]
		for path in GameData.job_paths(cid):
			for job in [path, path.get("trans", {})]:
				if not (job as Dictionary).is_empty():
					line.append([str(job.id), tr(GameData.job_title(job, false))])
		var ok: = line.filter( func(j): return GameData.weapon_allowed(cid, str(j[0]), id))
		if ok.size() == line.size():
			names.append(line[0][1])
		else:
			for j in ok:
				names.append(j[1])
	_users_cache[key] = names
	return names





static var _digit_regex: RegEx
static func _digit_re() -> RegEx:
	if _digit_regex == null:
		_digit_regex = RegEx.create_from_string("\\d")
	return _digit_regex


func _item_desc(it: Dictionary) -> String:
	var desc: = Equipment.desc_of(it)

	if Equipment.is_soul(it):
		var src: Dictionary = GameData.ITEMS.get(str(Equipment.item_def(it).soul_of), {})
		return tr("Alma de %s: solo el efecto de la única, sin los atributos de la pieza. Un solo efecto de única a la vez (pieza o alma).")\
		%tr(str(src.get("name", ""))) + "\n" + desc

	if Equipment.hel_wings(it):
		return tr("Despertadas por la Valkyria: todos sus bonos x1,5. Sus huecos solo aceptan cartas de MVP.")


	if int(it.get("refine", 0)) > 0 and not Equipment.item_def(it).get("wings", false)\
	and _digit_re().search(desc) != null:
		desc += "  " + tr("(valores sin refinar)")
	return desc






func _set_info(item_id: String) -> Dictionary:
	for sid in GameData.SETS:
		var st: Dictionary = GameData.SETS[sid]
		var items: Array = GameData.set_pieces(sid)
		if not items.has(item_id):
			continue
		var in_run: bool = world != null and world.running and world.player != null and world.player.equipment != null
		var stored: = {}


		var kept: = {}


		var hero_cid: = _store_hero()
		var starting: = not in_run and GameData.CLASSES.has(hero_cid)
		if starting:
			for s_it in Save.storage():
				kept[str(s_it.get("id", ""))] = true
			var lo: = Save.loadout(hero_cid)
			for k in lo:
				var s_it: = Save.storage_item(str(lo[k]))
				if not s_it.is_empty():
					stored[str(s_it.get("id", ""))] = true
		elif not in_run:
			for s_it in Save.storage():
				stored[str(s_it.get("id", ""))] = true
		var pieces: = []
		var all: = true
		for pid in items:
			var have: bool = world.player.equipment.has_item(pid) if in_run else stored.has(pid)
			all = all and have
			pieces.append({"icon": _item_icon(str(GameData.ITEMS[pid].get("icon", pid))), "name": tr(str(GameData.ITEMS[pid].name)), "have": have, 
				"stored": not have and kept.has(pid)})
		var have_n: = pieces.filter( func(pc): return pc.have).size()
		var four: bool = st.has("more")
		return {"name": tr(str(st.name)), "build": tr(str(st.get("build", ""))), "pieces": pieces, "desc": tr(str(st.desc)), 
			"desc4": tr(str(st.get("full_desc", ""))), "active": (in_run or starting) and (have_n >= 2 if four else all), 
			"active4": (in_run or starting) and four and all, 
			"here": tr("Piezas equipadas") if in_run else (tr("Piezas en tu equipo inicial") if starting else tr("Piezas en tu almacén Kafra"))}
	return {}




const _MOD_ROWS: = ["dmg", "max_hp_pct", "armor", "dodge", "move", "haste", "crit", "crit_dmg", "regen", "aspd", "max_hp", "area", "xp", 
	"loot", "skill_dmg", "basic_dmg"]
func _mods_lines(mods: Dictionary) -> Array:
	var names: = {"dmg": tr("Daño"), "max_hp_pct": tr("Vida máx."), "armor": tr("Defensa"), "dodge": tr("Evasión"), 
		"move": tr("Velocidad"), "haste": tr("Recarga"), "crit": tr("Crítico"), "crit_dmg": tr("Daño crítico"), "regen": tr("Vida/s"), 
		"aspd": tr("Vel. de ataque"), "max_hp": tr("Vida"), "area": tr("Área"), "xp": tr("EXP"), "loot": tr("Zeny"), 
		"skill_dmg": tr("Daño de habilidades"), "basic_dmg": tr("Daño básico")}
	var pct: = ["dmg", "max_hp_pct", "dodge", "move", "haste", "crit", "crit_dmg", "aspd", "area", "xp", "loot", 
		"skill_dmg", "basic_dmg"]
	var out: = []
	for k in mods:
		if not names.has(k):
			continue
		var v: float = mods[k] * (100.0 if k in pct else 1.0)
		if absf(v) < 0.05:
			continue
		var text: = ("-%d%%" % roundi(v)) if k == "haste" else (("%+d%%" % roundi(v)) if k in pct else
			(("%+d" % roundi(v)) if k == "max_hp" else "%+.1f" % v))
		out.append([names[k], text, Color(0.5, 0.95, 0.55) if v > 0.0 or k == "haste" else Color(1.0, 0.45, 0.4)])
	return out




