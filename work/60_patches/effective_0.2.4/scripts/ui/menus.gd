	var keep: = func():
		var n: = name_box.text.strip_edges()
		if n == "":
			n = tr("Set %d") % (sets.size() + 1)
		if Save.save_set(kind, n, current.call()):
			world.play_sound("ui_click", 0.0, -2.0)
			refresh.call(tr("Set «%s» guardado.") % n, true)
		else:
			refresh.call(tr("Máximo %d sets: borra uno primero.") % Save.SETS_MAX, false)
	var save_b: = _ro_button(tr("Guardar el actual"), keep)
	row.add_child(save_b)
	name_box.text_submitted.connect( func(_t: String): keep.call())
	return box




func _load_gear_set(class_id: String, value: Variant) -> String:
	var want: Dictionary = value if value is Dictionary else {}
	for k in Save.loadout(class_id).keys():
		Save.set_loadout_slot(class_id, str(k), "")
	var missing: = 0
	for k in want:
		var it: = Save.storage_item(str(want[k]))
		if it.is_empty() or _loadout_block(class_id, it, str(k)) != "":
			missing += 1
			continue
		Save.set_loadout_slot(class_id, str(k), str(want[k]))
	return tr("%d pieza(s) ya no están o no caben.") % missing if missing > 0 else ""




func _load_card_set(value: Variant) -> String:
	var want: Array = value if value is Array else []
	var cards: = []
	for c in want:
		if Save.has_card(str(c)) and cards.size() < GameData.card_slots() and not cards.has(c):
			cards.append(c)
	Save.set_equipped_cards(cards)
	var missing: = want.size() - cards.size()
	return tr("%d carta(s) no caben o ya no las tienes.") % missing if missing > 0 else ""


func _toggle_card(id: String) -> void :
	var equipped: Array = Save.equipped_cards()
	if equipped.has(id):
		equipped.erase(id)
	elif equipped.size() < GameData.card_slots():
		equipped.append(id)
	Save.set_equipped_cards(equipped)
	show_album()






