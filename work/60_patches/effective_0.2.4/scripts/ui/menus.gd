	art.add_child(_banner_text(tr("«¡Subamos juntos! Trae tu mejor build: yo te cuido la espalda.»"), 12, Color(0.92, 0.88, 1.0), Vector2(20, 84)))
	var lord: = _banner_text(tr("Piso 100: Naght Sieger") if top < GameData.TOWER_FLOORS else tr("Naght Sieger vencido"), 13, 
		Color(1.0, 0.6, 0.5) if top < GameData.TOWER_FLOORS else Color(1.0, 0.85, 0.4), Vector2(0, 14))
	lord.horizontal_alignment = HORIZONTAL_ALIGNMENT_RIGHT
