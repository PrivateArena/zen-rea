func _transmute(index: int, times: int) -> void :
	var r: Dictionary = GameData.TRANSMUTE[index]
	var n: = int(r.n)
	times = mini(times, Save.material(str(r.from)) / n)
	if times <= 0:
		return
	var out: = int(r.get("out", 1)) * times
	Save.add_material(str(r.from), - n * times)
	Save.add_material(str(r.to), out)
	Save.flush()
	world.play_sound("refine_hammer", 0.0, -4.0)
	show_transmute(tr("¡Listo! %d %s.") % [out, tr(str(GameData.MATERIALS[r.to].name))], index, out)





func _transmute_anim(ref: Dictionary, made: int) -> void :
	var input: Control = ref.input
	var crucible: Control = ref.crucible
	if not is_instance_valid(input) or not is_instance_valid(crucible):
		return
	var ink: Color = ref.ink
	var in_icon: TextureRect = input.get_meta("icon")
	var out_icon: TextureRect = crucible.get_meta("icon")
	var tex: = in_icon.texture
	var from_at: = in_icon.global_position + in_icon.size * 0.5
	var to_at: = crucible.global_position + crucible.size * 0.5

	var tap: = input.create_tween().set_pause_mode(Tween.TWEEN_PAUSE_PROCESS)
	for i in 2:
		tap.tween_property(input, "position:y", input.position.y + 4.0, 0.05)
		tap.tween_property(input, "position:y", input.position.y, 0.08)
		tap.tween_callback( func(): world.play_sound("forge_tink", 0.0, -8.0, randf_range(0.95, 1.15)))

	var n: = clampi(made + 2, 3, 6)
	for i in n:
		var ghost: = TextureRect.new()
		ghost.texture = tex
		ghost.expand_mode = TextureRect.EXPAND_IGNORE_SIZE
		ghost.size = Vector2(26, 26)
		ghost.pivot_offset = Vector2(13, 13)
		ghost.mouse_filter = Control.MOUSE_FILTER_IGNORE
		_root.add_child(ghost)
		ghost.global_position = from_at - Vector2(13, 13)
		ghost.modulate.a = 0.0
		var mid: = (from_at + to_at) * 0.5 + Vector2(randf_range(-6, 6), -22.0 - randf() * 14.0)
		var fly: = ghost.create_tween().set_pause_mode(Tween.TWEEN_PAUSE_PROCESS)
		fly.tween_interval(0.25 + 0.07 * i)
		fly.tween_property(ghost, "modulate:a", 1.0, 0.05)
		fly.tween_method( func(k: float):
			if is_instance_valid(ghost):
				var a: = from_at.lerp(mid, k)
				var b: = mid.lerp(to_at, k)
				ghost.global_position = a.lerp(b, k) - Vector2(13, 13)
				ghost.scale = Vector2.ONE * lerpf(1.0, 0.35, k)
				ghost.rotation = k * 4.0, 0.0, 1.0, 0.32).set_trans(Tween.TRANS_SINE)
		fly.tween_callback(ghost.queue_free)

	var burst_at: = 0.25 + 0.07 * n + 0.32
	var fx: = crucible.create_tween().set_pause_mode(Tween.TWEEN_PAUSE_PROCESS)
	fx.tween_interval(burst_at)
	fx.tween_callback( func():
		if not is_instance_valid(crucible):
			return
		world.play_sound("refine_ok", 0.0, -3.0)
		world.play_sound("coin1", 0.0, -12.0)
		var rays: TextureRect = crucible.get_meta("rays")
		rays.modulate = Color(1.0, 0.92, 0.6, 1.0)
		var flare: = rays.create_tween().set_pause_mode(Tween.TWEEN_PAUSE_PROCESS)
		rays.scale = Vector2.ONE * 0.6
		flare.tween_property(rays, "scale", Vector2.ONE * 1.6, 0.35).set_trans(Tween.TRANS_BACK).set_ease(Tween.EASE_OUT)
		flare.parallel().tween_property(rays, "modulate", Color(ink, 0.85), 0.9)
		flare.tween_property(rays, "scale", Vector2.ONE, 0.4)
		var glow: = UiKit.glow(Color(1.0, 0.9, 0.55, 0.95), 96)
		glow.size = Vector2(96, 96)
		glow.position = Vector2(-16, -16)
		glow.pivot_offset = Vector2(48, 48)
		crucible.add_child(glow)
		var gt: = glow.create_tween().set_pause_mode(Tween.TWEEN_PAUSE_PROCESS)
		glow.scale = Vector2.ONE * 0.3
		gt.tween_property(glow, "scale", Vector2.ONE * 1.3, 0.25)
		gt.parallel().tween_property(glow, "modulate:a", 0.0, 0.6)
		gt.tween_callback(glow.queue_free)
		var pop: = out_icon.create_tween().set_pause_mode(Tween.TWEEN_PAUSE_PROCESS)
		pop.tween_property(out_icon, "scale", Vector2.ONE * 1.45, 0.12).set_trans(Tween.TRANS_BACK).set_ease(Tween.EASE_OUT)
		pop.parallel().tween_property(out_icon, "modulate", Color(1.8, 1.6, 1.1), 0.12)
		pop.tween_property(out_icon, "scale", Vector2.ONE, 0.3)
		pop.parallel().tween_property(out_icon, "modulate", Color.WHITE, 0.45)
		_transmute_sparks(crucible, ink)

		var plus: = _ro_text("+%d" % made, 18, Color(1.0, 0.85, 0.35), true)
		plus.add_theme_color_override("font_outline_color", Color(0.25, 0.12, 0.02))
		plus.add_theme_constant_override("outline_size", 5)
		plus.mouse_filter = Control.MOUSE_FILTER_IGNORE
		_root.add_child(plus)
		plus.global_position = to_at + Vector2(-14, -40)
		var rise: = plus.create_tween().set_pause_mode(Tween.TWEEN_PAUSE_PROCESS)
		rise.tween_property(plus, "global_position:y", plus.global_position.y - 26.0, 0.9).set_ease(Tween.EASE_OUT)
		rise.parallel().tween_property(plus, "modulate:a", 0.0, 0.9).set_delay(0.4)
		rise.tween_callback(plus.queue_free)

		var box: StyleBoxFlat = ref.box
		var edge: = crucible.create_tween().set_pause_mode(Tween.TWEEN_PAUSE_PROCESS)
		box.border_color = Color(1.0, 0.8, 0.3)
		edge.tween_property(box, "border_color", ink, 0.8))



func _transmute_sparks(at: Control, ink: Color) -> void :
	var p: = CPUParticles2D.new()
