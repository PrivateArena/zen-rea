static func touch_ui() -> bool:

	return MouseWalk.touch()




const LINKS_BAND: = 42.0





func client_k(view: Vector2, size: = Vector2(576.0, 358.0)) -> float:
	var fit: = minf(view.x / size.x, view.y / size.y)
	if touch_ui():
		return maxf(1.0, floorf(fit * 0.92 * 20.0) / 20.0)
	return maxf(1.0, floorf(fit * 0.85))


