static func _katar_in(lo: Dictionary) -> bool:
	var w: = Save.storage_item(str(lo.get("weapon", "")))
	return not w.is_empty() and str(Equipment.item_def(w).get("weapon_type", "")) == "katar"



static func _huuma_in(lo: Dictionary) -> bool:
	var w: = Save.storage_item(str(lo.get("weapon", "")))
	return not w.is_empty() and GameData.weapon_kind(str(w.id)) == "huuma"





static func _two_hand_in(lo: Dictionary) -> bool:
	var w: = Save.storage_item(str(lo.get("weapon", "")))
	return not w.is_empty() and GameData.two_handed(str(w.id))




static func _hands_full(lo: Dictionary) -> bool:
	return _katar_in(lo) or _huuma_in(lo) or _two_hand_in(lo)



static func _loadout_slot_for(class_id: String, it: Dictionary) -> String:
	var kind: = Equipment.item_type(it)
	var lo: = Save.loadout(class_id)




	if kind == "weapon" and _loadout_left_ok(class_id, it) and (Equipment.left_only(it)\
	or (lo.has("weapon") and not lo.has("shield") and not _hands_full(lo))):
		return "shield"
	if kind != "acc":
		return kind
	return "acc1" if not lo.has("acc1") else ("acc2" if not lo.has("acc2") else "acc1")





static func _loadout_left_ok(class_id: String, it: Dictionary) -> bool:
	if Equipment.left_only(it):
		return true
	var d: = Equipment.item_def(it)
	if str(d.get("slot", "")) != "weapon" or GameData.two_handed(str(it.id)):
		return false
	if not (str(d.get("weapon_type", "")) == "dagger" or GameData.OFFHAND_KINDS.has(GameData.weapon_kind(str(it.id)))):
		return false
	for path in GameData.job_paths(class_id):
		for job in [path, path.get("trans", {})]:
			if not (job as Dictionary).is_empty() and str(job.id) in GameData.DUAL_JOBS and GameData.weapon_allowed(class_id, str(job.id), str(it.id)):
				return true
	return false




static func _loadout_block(class_id: String, it: Dictionary, slot_key: String, lo_in: Variant = null) -> String:
	if not _class_can_use(class_id, it):
		return TranslationServer.translate("Esta clase no puede usarlo.")
	var shut: = _slot_shut_why(class_id, slot_key)
	if shut != "":
		return shut

	if Equipment.item_def(it).get("fixed", false):
		return TranslationServer.translate("Tus Puños ya van siempre en el arma del Taekwon: no ocupan un hueco del equipo inicial.")
	var lo: Dictionary = lo_in if lo_in is Dictionary else Save.loadout(class_id)

	if slot_key == "shield" and _katar_in(lo):
		return TranslationServer.translate("El katar ocupa las dos manos: no queda mano izquierda.")
	if slot_key == "shield" and _huuma_in(lo):
		return TranslationServer.translate("La Huuma ocupa las dos manos: no queda mano izquierda.")
	if slot_key == "shield" and _two_hand_in(lo):
		return TranslationServer.translate("Tu arma es a dos manos: no queda mano izquierda.")
	if slot_key == "shield" and Equipment.item_type(it) == "weapon" and not _loadout_left_ok(class_id, it):
		return TranslationServer.translate("Esta arma no va en la mano izquierda.")

	for k in lo:
		var other: = Save.storage_item(str(lo[k]))
		if k != slot_key and not other.is_empty() and (str(GameData.ITEMS.get(str(it.id), {}).get("soul_of", "")) == str(other.id)
				or str(GameData.ITEMS.get(str(other.id), {}).get("soul_of", "")) == str(it.id)):
			return TranslationServer.translate("Esa pieza y su alma no van juntas: elige una.")
	var replacing: = lo.has(slot_key)
	var pieces: = lo.keys().filter( func(k): return not k in GameData.LOADOUT_FREE_SLOTS).size()
	if not replacing and not slot_key in GameData.LOADOUT_FREE_SLOTS and pieces >= Save.loadout_cap():
		return TranslationServer.translate("No quedan huecos de equipo inicial: la Kafra (Pushcart) da más.")
	if Equipment.is_legendary(it):
		var uniq: = Equipment.is_unique(it)
		var cap: = GameData.LOADOUT_MAX_UNIQUE if uniq else GameData.loadout_legend_max(class_id)
		var held: = 0
		for k in lo:
			var other: = Save.storage_item(str(lo[k]))
			if k != slot_key and Equipment.is_legendary(other) and Equipment.is_unique(other) == uniq:
				held += 1
		if held >= cap:
			if uniq:
				return TranslationServer.translate("Solo 1 único en el equipo inicial.")
			var full: = TranslationServer.translate("Solo %d legendario(s) en el equipo inicial (renacer da uno más).") % cap\
			if cap <= GameData.LOADOUT_MAX_LEGENDARY else TranslationServer.translate("Solo %d legendarios en el equipo inicial.") % cap

			var next: = _next_legend_floor()
			if next > 0:
				full += " " + TranslationServer.translate("Subiendo la Endless Tower consigues más: el próximo hueco está en el piso %d.") % next
			return full
	return ""




static func _loadout_limits_tip(class_id: String) -> String:
	var lines: Array = [TranslationServer.translate("Legendarios: %d") % GameData.loadout_legend_max(class_id), 
		"  · " + TranslationServer.translate("%d de base") % GameData.LOADOUT_MAX_LEGENDARY]
	if bool(GameData.CLASSES[class_id].get("no_rebirth", false)):
		lines.append("  · " + TranslationServer.translate("+%d de esta clase (no renace): ya lo tienes") % GameData.REBIRTH_LEGEND_SLOTS)
	else:
		lines.append("  · " + (TranslationServer.translate("+%d al renacer esta clase: ya lo tienes") if Save.is_reborn(class_id)
			else TranslationServer.translate("+%d al renacer esta clase (Valkyrie, en Prontera): todavía no")) % GameData.REBIRTH_LEGEND_SLOTS)
	var floors: Array = GameData.TOWER_REWARDS.keys().filter( func(fl): return str(GameData.TOWER_REWARDS[fl]) == "legend")
	floors.sort()
	var tower: = "  · " + TranslationServer.translate("+1 por cada piso %s de la Endless Tower: %d/%d") % [", ".join(floors.map( func(fl): return str(fl))), 
		Save.tower_legend_slots(), floors.size()]
	var next: = _next_legend_floor()
	if next > 0:
		tower += " " + TranslationServer.translate("(el próximo, piso %d)") % next
	lines.append(tower)
	lines.append(TranslationServer.translate("Únicos: %d, siempre.") % GameData.LOADOUT_MAX_UNIQUE)
	lines.append(TranslationServer.translate("Hueco de alma: abierto") if GameData.soul_slot_open(class_id) else _slot_shut_why(class_id, "soul"))
	lines.append(TranslationServer.translate("Piezas: %d. La Kafra (Pushcart) da más huecos.") % Save.loadout_cap())
	return "\n".join(lines)




static func _next_legend_floor() -> int:
	var got: Array = Save._tower_floors()
	var floors: Array = GameData.TOWER_REWARDS.keys()
	floors.sort()
	for fl in floors:
		if str(GameData.TOWER_REWARDS[fl]) == "legend" and not got.has(fl):
			return int(fl)
	return 0






