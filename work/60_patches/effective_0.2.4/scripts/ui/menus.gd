func _trade_picker() -> void :
	_trade_empty(_tr_picker)
	if trade.my_ok:
		_tr_picker.add_child(_ro_text(tr("Tu lado está cerrado (OK): ya no se puede cambiar."), 10, Color(0.28, 0.3, 0.4)))
		return
	var gear: = Save.storage().filter( func(it): return not trade.mine.items.has(str(it.get("uid", ""))) and not GameData.bound_item(str(it.get("id", ""))))
	var cards: = GameData.CARDS.keys().filter( func(c): return trade.cards_left(c) > 0)
	var mats: = GameData.MATERIALS.keys().filter( func(k): return trade.mats_left(k) > 0 and not GameData.MATERIALS[k].get("bound", false))
	var cos: = Save.owned_cosmetics().filter( func(c): return not (trade.mine.get("cos", []) as Array).has(c))

	var eter: = GameData.CARDS.keys().filter( func(c): return trade.eternal_left(c) > 0)
	var tabs: = HBoxContainer.new()
	tabs.add_theme_constant_override("separation", 2)
	_tr_picker.add_child(tabs)
	for t in [["items", tr("Equipo"), gear.size()], ["cards", tr("Cartas"), cards.size()], ["mats", tr("Minerales"), mats.size()], 
			["cos", tr("Cosméticos"), cos.size()], ["eter", tr("Cartas Eternas"), eter.size()]]:
		var key: = str(t[0])
		var b: = _ro_button("%s %d" % [t[1], t[2]], func():
			_tr_tab = key
			_trade_picker.call_deferred())
		b.toggle_mode = true
		b.button_pressed = _tr_tab == key
		b.focus_mode = Control.FOCUS_NONE
		b.add_theme_font_size_override("font_size", 10)
		tabs.add_child(b)
	var full: = trade.entries(trade.mine) >= Trade.MAX_ENTRIES
	if full:
		var l: = _ro_text(tr("Máximo %d tipos de cosas por comercio.") % Trade.MAX_ENTRIES, 10, Color(0.65, 0.3, 0.2))
		l.size_flags_horizontal = Control.SIZE_EXPAND_FILL
		l.horizontal_alignment = HORIZONTAL_ALIGNMENT_RIGHT
		tabs.add_child(l)
	var grid: = GridContainer.new()


	var find: = LineEdit.new()
	find.placeholder_text = tr("Buscar...")
	find.text = _tr_query
	find.clear_button_enabled = true
	find.custom_minimum_size = Vector2(150, 0)
	find.size_flags_horizontal = Control.SIZE_EXPAND_FILL if not full else Control.SIZE_FILL
	find.add_theme_font_size_override("font_size", 10)
	find.text_changed.connect( func(text: String):
		_tr_query = text
		_trade_filter(grid))
	tabs.add_child(find)
	grid.columns = 14
	grid.add_theme_constant_override("h_separation", 3)
	grid.add_theme_constant_override("v_separation", 3)
	var scroll: = ScrollContainer.new()
	scroll.horizontal_scroll_mode = ScrollContainer.SCROLL_MODE_DISABLED
	scroll.custom_minimum_size = Vector2(2 * TRADE_COL_W + 4, 3 * 41.0)
	scroll.add_child(grid)
	_tr_picker.add_child(scroll)

	_keep_scroll(scroll, "trade_" + _tr_tab)
	match _tr_tab:
		"items":
			for it in gear:
				var locked: = Equipment.is_locked(it)
				var cell: = _trade_cell(_item_icon(Equipment.item_def(it).icon), 1, func(_all: bool):
					if Equipment.is_locked(Save.storage_item(str(it.uid))):
						_trade_unlock(str(it.uid))
					else:
						trade.add_item(str(it.uid)), full)
				if locked:

					cell.get_child(0).add_child(_padlock(Vector2(0, 14)))
				cell.set_meta("find", _fold(_store_text(it)))
				cell.mouse_entered.connect( func(): _show_item_hover(it, cell))
				cell.mouse_exited.connect(_hide_item_hover)
				grid.add_child(cell)
		"cards":
			for c in cards:
				var left: = trade.cards_left(c)
				var cell: = _trade_cell(_item_icon("card_slot"), left, func(all: bool): trade.add_card(c, left if all else 1), 
					full and not trade.mine.cards.has(c))
				cell.set_meta("find", _fold("%s %s" % [tr(str(GameData.CARDS[c].name)), tr(str(GameData.CARDS[c].get("desc", "")))]))
				cell.mouse_entered.connect( func(): _show_card_hover(c, left, 0, cell))
				cell.mouse_exited.connect(_hide_item_hover)
				grid.add_child(cell)
		"mats":
			for k in mats:
				var left: = trade.mats_left(k)
				var cell: = _trade_cell(_item_icon(str(GameData.MATERIALS[k].icon)), left, func(all: bool): trade.add_mat(k, left if all else 1), 
					full and not trade.mine.mats.has(k))
				cell.tooltip_text = "%s  x%d" % [tr(str(GameData.MATERIALS[k].name)), left]
				cell.set_meta("find", _fold(tr(str(GameData.MATERIALS[k].name))))
				grid.add_child(cell)
		"cos":
			for c in cos:
				var d: Dictionary = GameData.COSMETICS[c]
				var cell: = _trade_cell(_trade_cos_pic(str(c)), 1, func(_all: bool): trade.add_cos(str(c)), full)
				cell.tooltip_text = "%s  ·  %s" % [tr(str(d.name)), tr(str(GameData.COSMETIC_RARITY.get(str(d.rarity), GameData.COSMETIC_RARITY.common).name))]
				cell.set_meta("find", _fold(tr(str(d.name))))
				grid.add_child(cell)
		"eter":
			if not trade.their_eter:

				var old: = _ro_text(tr("%s tiene una versión anterior del juego: para recibir Cartas Eternas tiene que actualizarlo.") % trade.partner_name, 
					10, Color(0.65, 0.3, 0.2))
				old.autowrap_mode = TextServer.AUTOWRAP_WORD_SMART
				old.custom_minimum_size.x = 2 * TRADE_COL_W - 20
				grid.add_child(old)
			else:
				for c in eter:
					var left: = trade.eternal_left(c)
					var cell: = _trade_cell(_item_icon("card_slot"), left, func(all: bool): trade.add_eternal(c, left if all else 1), 
						full and not trade.mine.eter.has(c))
					(cell.get_theme_stylebox("panel") as StyleBoxFlat).border_color = GameData.ETERNAL_COLOR
					cell.set_meta("find", _fold("%s %s" % [tr(str(GameData.CARDS[c].name)), tr(str(GameData.CARDS[c].get("desc", "")))]))
					cell.mouse_entered.connect( func(): _show_card_hover(c, left, 0, cell))
					cell.mouse_exited.connect(_hide_item_hover)
					grid.add_child(cell)
	if grid.get_child_count() == 0:
		grid.add_child(_ro_text(tr("Nada aquí."), 10, Color(0.28, 0.3, 0.4)))
	_trade_filter(grid)



var _tr_query: = ""


func _trade_filter(grid: Control) -> void :
	var needle: = _fold(_tr_query.strip_edges())
	for c in grid.get_children():
		if c.has_meta("find"):
			c.visible = needle == "" or str(c.get_meta("find")).contains(needle)



func _trade_cell(icon: Texture2D, count: int, act: Callable, off: bool) -> PanelContainer:
	var cell: = PanelContainer.new()
	cell.custom_minimum_size = Vector2(38, 38)
	var sb: = StyleBoxFlat.new()
	sb.bg_color = Color(0.96, 0.97, 0.99)
	sb.border_color = Color(0.78, 0.8, 0.88)
	sb.set_border_width_all(1)
	sb.set_corner_radius_all(3)
	cell.add_theme_stylebox_override("panel", sb)
	var tex: = UiKit.icon_rect(icon, 26)
	tex.size_flags_horizontal = Control.SIZE_SHRINK_CENTER
	tex.size_flags_vertical = Control.SIZE_SHRINK_CENTER
	tex.mouse_filter = Control.MOUSE_FILTER_IGNORE
	cell.add_child(tex)
	if count > 1:
		var n: = _ro_text(str(count), 9, Color.BLACK, true)
		n.add_theme_constant_override("outline_size", 3)
		n.add_theme_color_override("font_outline_color", Color.WHITE)
		n.size_flags_horizontal = Control.SIZE_SHRINK_BEGIN
		n.size_flags_vertical = Control.SIZE_SHRINK_END
		cell.add_child(n)
	if off:
		cell.modulate.a = 0.4
		return cell
	cell.mouse_default_cursor_shape = Control.CURSOR_POINTING_HAND
	cell.gui_input.connect( func(ev: InputEvent):
		if ev is InputEventMouseButton and ev.pressed and ev.button_index in [MOUSE_BUTTON_LEFT, MOUSE_BUTTON_RIGHT]:
			_hide_item_hover()
			ui_click()
			act.call(ev.button_index == MOUSE_BUTTON_RIGHT or ev.shift_pressed))
	return cell



func _trade_unlock(uid: String) -> void :
	var it: = Save.storage_item(uid)
	if it.is_empty():
		return
	var w: = _float_window(tr("Pieza bloqueada"))
	var row0: = HBoxContainer.new()
	row0.add_theme_constant_override("separation", 10)
	w.body.add_child(row0)
	row0.add_child(UiKit.icon_rect(_item_icon(Equipment.item_def(it).icon), 36))
	var say: = _ro_text(tr("%s está bloqueado. ¿Desbloquearlo y ponerlo en el intercambio?") % Equipment.item_name(it), 12, Color(0.15, 0.17, 0.3))
	say.autowrap_mode = TextServer.AUTOWRAP_WORD_SMART
	say.custom_minimum_size.x = 300
	say.size_flags_vertical = Control.SIZE_SHRINK_CENTER
	row0.add_child(say)
	var row: = HBoxContainer.new()
	row.alignment = BoxContainer.ALIGNMENT_END
	row.add_theme_constant_override("separation", 6)
	w.body.add_child(row)
	var keep: = _ro_button(tr("Cancelar"), w.shut)
	keep.custom_minimum_size = Vector2(130, 40) if touch_ui() else Vector2(100, 28)
	row.add_child(keep)
	var go: = _ro_button(tr("Desbloquear y añadir"), func():
		w.shut.call()
		var now: = Save.storage_item(uid)
		if now.is_empty():
			return
		now.erase("lock")
		Save.mark_dirty()
		Save.flush()
		trade.add_item(uid)
		_trade_picker.call_deferred())
	go.custom_minimum_size = Vector2(150, 40) if touch_ui() else Vector2(140, 28)
	row.add_child(go)
	for b in [keep, go]:
		b.add_theme_font_size_override("font_size", 13)
	_float_show(w, keep)



