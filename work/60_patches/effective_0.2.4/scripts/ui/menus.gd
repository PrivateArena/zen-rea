func show_sn_build(done: Callable, message: = "", ok: = true) -> void :
	_sn_done = done
	var d: Dictionary = GameData.CLASSES.super_novice
	_sn_edit = Save.sn_build().duplicate(true)
	var acts: Array = _sn_edit.skills
	var pas: Array = _sn_edit.passives
	var col: = _screen(tr("Super Novice"), tr("Elige qué habilidades y pasivas pueden salirte al subir de nivel (solo esas). Empiezas con la primera activa (★)."))
	_mode = "sn_build"
	col.add_theme_constant_override("separation", 8)
	var frame: StyleBoxFlat = (col.get_parent() as PanelContainer).get_theme_stylebox("panel")
	frame.set_content_margin_all(12)

	var set_card: = PanelContainer.new()
	var set_box: = UiKit.panel_box(Color(1, 1, 1, 0.98), Color(0.78, 0.82, 0.93), 12, 1)
	set_box.shadow_size = 0
	set_box.set_content_margin_all(10)
	set_card.add_theme_stylebox_override("panel", set_box)
	col.add_child(set_card)
	var set_row: = HBoxContainer.new()
	set_row.add_theme_constant_override("separation", 24)
	set_row.alignment = BoxContainer.ALIGNMENT_CENTER
	set_card.add_child(set_row)
	for passive in [false, true]:
		var mine: Array = pas if passive else acts
		var cap: = int(d.max_passives if passive else d.max_skills)
		var group: = VBoxContainer.new()
		group.add_theme_constant_override("separation", 4)
		set_row.add_child(group)
		group.add_child(UiKit.label((tr("Pasivas  %d / %d") if passive else tr("Activas  %d / %d")) % [mine.size(), cap], 13, 
			Color(0.22, 0.34, 0.72), true))
		var slots: = HBoxContainer.new()
		slots.add_theme_constant_override("separation", 4)
		group.add_child(slots)
		for i in cap:
			slots.add_child(_sn_slot(str(mine[i]) if i < mine.size() else "", i, passive))

	var ammo: = GameData.sn_ammo(acts + pas)
	var brings: Array[String] = []
	if ammo == "arrows":
		brings.append(tr("carcaj de flechas"))
	elif ammo == "bullets":
		brings.append(tr("balas de pistola"))
	elif ammo == "kunai":
		brings.append(tr("kunais"))
	for id in acts + pas:
		if GameData.SN_CART_SKILLS.has(id):
			brings.append(tr("carro de mercader"))
			break
	var notes: = HBoxContainer.new()
	notes.alignment = BoxContainer.ALIGNMENT_CENTER
	notes.add_theme_constant_override("separation", 16)
	col.add_child(notes)
	if not brings.is_empty():
		notes.add_child(UiKit.label(tr("Trae consigo: %s") % ", ".join(brings), 12, Color(0.15, 0.45, 0.2), true))

	var mults: = GameData.sn_mult_count(acts + pas)
	notes.add_child(UiKit.label(tr("Multiplican el daño (×): %d / %d") % [mults, GameData.SN_MULT_MAX], 12, 
		Color(0.75, 0.15, 0.1) if mults >= GameData.SN_MULT_MAX else Color(0.22, 0.34, 0.72), true))
	if message != "":
		notes.add_child(UiKit.label(message, 12, Color(0.15, 0.45, 0.2) if ok else Color(0.75, 0.15, 0.1), true))

	var tabs: = _opt_segments([[tr("Activas"), "skills"], [tr("Pasivas"), "passives"]], _sn_tab, func(t):
		_sn_tab = str(t)
		_npc_scroll.erase("sn")
		show_sn_build(done), true)
	tabs.size_flags_horizontal = Control.SIZE_SHRINK_CENTER
	col.add_child(tabs)
	var scroll: = ScrollContainer.new()
	scroll.custom_minimum_size = Vector2(860, clampf(get_viewport().get_visible_rect().size.y - 420.0, 200.0, 520.0))
	scroll.horizontal_scroll_mode = ScrollContainer.SCROLL_MODE_DISABLED
	col.add_child(scroll)
	var grid: = GridContainer.new()
	grid.columns = 3
	grid.add_theme_constant_override("h_separation", 8)
	grid.add_theme_constant_override("v_separation", 8)
	grid.size_flags_horizontal = Control.SIZE_EXPAND_FILL
	scroll.add_child(grid)
	var passive_tab: = _sn_tab == "passives"
	var mine_tab: Array = pas if passive_tab else acts
	var cap_tab: = int(d.max_passives if passive_tab else d.max_skills)
	for c in GameData.SN_CLASSES:
		var ids: Array = (GameData.CLASSES[c].passives if passive_tab else GameData.CLASSES[c].skills) as Array
		ids = ids.filter( func(id): return GameData.SKILLS.has(id) and GameData.sn_origin(str(id)) == c)
		if ids.is_empty():
			continue
		var card: = PanelContainer.new()
		var box: = UiKit.panel_box(Color(1, 1, 1, 0.98), Color(0.8, 0.84, 0.93), 10, 1)
		box.shadow_size = 0
		box.set_content_margin_all(8)
		card.add_theme_stylebox_override("panel", box)
		card.custom_minimum_size.x = 278
		grid.add_child(card)
		var cc: = VBoxContainer.new()
		cc.add_theme_constant_override("separation", 4)
		card.add_child(cc)
		cc.add_child(UiKit.label(tr(str(GameData.CLASSES[c].name)), 13, Color(0.55, 0.36, 0.08), true))
		var flow: = HFlowContainer.new()
		flow.add_theme_constant_override("h_separation", 4)
		flow.add_theme_constant_override("v_separation", 4)
		cc.add_child(flow)
		for id in ids:

			var why: = ""
			if not mine_tab.has(id):
				if mine_tab.size() >= cap_tab:
					why = tr("Ya tienes %d: quita una primero.") % cap_tab
				elif GameData.sn_ammo(acts + pas + [id]) == "conflict":
					why = tr("Solo un tipo de munición: no se mezclan los disparos con flechas, balas o kunais.")
				elif GameData.sn_mult(str(id)) and GameData.sn_mult_count(acts + pas) >= GameData.SN_MULT_MAX:
					why = tr("Ya llevas %d que multiplican el daño: quita una primero.") % GameData.SN_MULT_MAX
			flow.add_child(_sn_cell(str(id), mine_tab.find(id), passive_tab, why))

	_keep_scroll(scroll, "sn")
	col.add_child(_sets_bar("sn", tr("Sets del Super Novice"), func(): return Save.sn_build().duplicate(true), 
		func(v: Variant) -> String:
			Save.set_sn_build(v if v is Dictionary else {})
			return "", 
		func(msg: String, good: bool): show_sn_build(done, msg, good)))
	var footer: = HBoxContainer.new()
	footer.alignment = BoxContainer.ALIGNMENT_CENTER
	footer.add_theme_constant_override("separation", 10)
	col.add_child(footer)
	var dice: = UiKit.button(tr("Al azar"))
	dice.pressed.connect( func():
		Save.set_sn_build(_sn_random())
		if world != null:
			world.play_sound("equip_item", 0.0, -4.0)
		show_sn_build(done))
	footer.add_child(dice)
	var clear: = UiKit.button(tr("Vaciar"))
	clear.pressed.connect( func():
		Save.set_sn_build({"skills": [], "passives": []})
		show_sn_build(done))
	footer.add_child(clear)
	var ready: = UiKit.button(tr("Listo"), true)
	ready.custom_minimum_size.x = 180
	ready.disabled = acts.is_empty()
	ready.pressed.connect( func(): _sn_done.call())
	footer.add_child(ready)
	for b: Button in [dice, clear]:
		b.custom_minimum_size.x = 120
	if acts.is_empty():
		footer.add_child(UiKit.label(tr("Elige al menos una activa"), 12, Color(0.75, 0.15, 0.1), true))
	ready.grab_focus.call_deferred()




func _sn_slot(id: String, i: int, passive: bool) -> Control:
	var b: = Button.new()
	b.custom_minimum_size = Vector2(46, 46)
	b.focus_mode = Control.FOCUS_NONE
	var st: = StyleBoxFlat.new()
	st.set_corner_radius_all(8)
	st.anti_aliasing = true
	st.set_border_width_all(2 if id != "" else 1)
	st.border_color = OPT_ACCENT if id != "" else Color(0.8, 0.84, 0.93)
	st.bg_color = Color(0.9, 0.93, 1.0) if id != "" else Color(0.95, 0.96, 0.99)
	var hov: = st.duplicate() as StyleBoxFlat
	hov.bg_color = Color(1.0, 0.92, 0.9) if id != "" else st.bg_color
	for state in ["normal", "focus", "disabled"]:
		b.add_theme_stylebox_override(state, st)
	for state in ["hover", "pressed"]:
		b.add_theme_stylebox_override(state, hov)
	if id == "":
		return b
	b.icon = UiKit.skill_icon(id)
	b.expand_icon = true
	b.icon_alignment = HORIZONTAL_ALIGNMENT_CENTER
	var hover: = _sn_hover(id)
	hover["foot"] = (hover.get("foot", []) as Array) + [[tr("Clic: quitarla del set"), Color(1.0, 0.7, 0.6), true]]
	_set_hover(b, hover)
	b.pressed.connect( func(): _sn_toggle(id, passive))
	if i == 0 and not passive:
		var star: = UiKit.label("★", 14, Color(1.0, 0.8, 0.2), true)
		star.position = Vector2(30, -4)
		b.add_child(star)
	return b




func _sn_random() -> Dictionary:
	var d: Dictionary = GameData.CLASSES.super_novice
	var out: = {"skills": [], "passives": []}
	for passive in [false, true]:
		var key: = "passives" if passive else "skills"
		var pool: Array = []
		for c in GameData.SN_CLASSES:
			for id in (GameData.CLASSES[c].passives if passive else GameData.CLASSES[c].skills) as Array:
				if GameData.SKILLS.has(id) and GameData.sn_origin(str(id)) == c and not pool.has(id):
					pool.append(id)
		pool.shuffle()
		var cap: = int(d.max_passives if passive else d.max_skills)
		for id in pool:
			if (out[key] as Array).size() >= cap:
				break
			if GameData.sn_ammo((out.skills as Array) + (out.passives as Array) + [id]) == "conflict":
				continue
			if GameData.sn_mult(str(id)) and GameData.sn_mult_count((out.skills as Array) + (out.passives as Array)) >= GameData.SN_MULT_MAX:
				continue
			(out[key] as Array).append(id)
	return out




