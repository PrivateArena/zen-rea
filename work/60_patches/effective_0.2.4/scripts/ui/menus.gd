func _layout_login() -> void :
	if _mode == "login" and not LOGIN_CLASSIC:

		var view: = get_viewport().get_visible_rect().size
		_login_scale = client_k(view)
		RoAssets.set_ui_scale(_login_scale)
		return
	if _login_cluster == null:
		return
	var view: = get_viewport().get_visible_rect().size

	_login_scale = client_k(view)
	RoAssets.set_ui_scale(_login_scale)
	var logo: = _login_cluster.get_node_or_null("RagnarokLogo") as TextureRect
	if logo != null:
		logo.position = Vector2(24.0, 20.0) * _login_scale
		logo.size = Vector2(191.0, 122.0) * 2.0 * _login_scale
	var window: = _login_cluster.get_node_or_null("LoginWindow") as TextureRect
	if window != null:
		window.custom_minimum_size = Vector2(280.0, 120.0) * _login_scale
		window.size = window.custom_minimum_size
		var buttons: = _login_cluster.get_child(2) as HBoxContainer
		var server: = _login_cluster.get_child(3) as Label
		var n: = buttons.get_child_count()

		var row_w: = 12.0 * (n - 1)
		for b: TextureButton in buttons.get_children():
			var w: = float(b.texture_normal.get_width()) if b.texture_normal != null else 42.0
			b.custom_minimum_size = Vector2(w, 20.0) * _login_scale
			row_w += w
		var button_size: = Vector2(row_w, 20.0) * _login_scale
		buttons.add_theme_constant_override("separation", int(12.0 * _login_scale))
		var server_height: = 20.0
		var spacing: = 7.0
		var group_height: = server_height + spacing + window.size.y + spacing + button_size.y
		window.position = Vector2((view.x - window.size.x) * 0.5, 
			(view.y - group_height) * 0.5 + 36.0 * _login_scale)
		server.position = Vector2(0.0, window.position.y - spacing - server_height)
		server.size = Vector2(view.x, server_height)
		buttons.position = Vector2((view.x - button_size.x) * 0.5, 
			window.position.y + window.size.y + spacing)
		buttons.size = button_size
		for field in window.get_children():
			if field is Label and field.has_meta("base_position"):
				field.position = field.get_meta("base_position") * _login_scale
				field.size = field.get_meta("base_size") * _login_scale
				field.add_theme_font_size_override("font_size", roundi(9.0 * _login_scale))
			elif field is ColorRect and field.has_meta("base_position"):
				field.position = field.get_meta("base_position") * _login_scale
				field.size = field.get_meta("base_size") * _login_scale
				var label: = field.get_child(0) as Label
				label.add_theme_font_size_override("font_size", roundi(10.0 * _login_scale))





func _ro_screen(title: String, width: float) -> VBoxContainer:
	_clear()
	_root.mouse_filter = Control.MOUSE_FILTER_STOP
	if world != null and (world.town != null or world.running):

		_root.add_child(UiKit.backdrop(0.3))
	else:
		var backdrop: = TextureRect.new()
		backdrop.set_anchors_and_offsets_preset(Control.PRESET_FULL_RECT)
		backdrop.texture = _login_texture("login_background")
		backdrop.expand_mode = TextureRect.EXPAND_IGNORE_SIZE
		backdrop.stretch_mode = TextureRect.STRETCH_KEEP_ASPECT_COVERED
		_root.add_child(backdrop)
	var win: = UiStyles.ro_window(title, UiKit.FONT_TITLE)
	var root: Control = win.root
	root.custom_minimum_size.x = width
	_root.add_child(root)
	_ro_window_root = root


	_ro_window_title = title
	_layout_ro_window.call_deferred()
	return win.body


var _ro_window_title: = ""
var _ro_placed_root: Control
var _ro_placed_title: = ""
var _ro_placed_top: = -1.0


func _layout_ro_window() -> void :
	_place_ro_window()


	var root: = _ro_window_root
	await get_tree().process_frame
	if root == _ro_window_root:
		_place_ro_window()




const MENU_SIZES: = [1.0, 1.5, 2.0, 2.5, 3.0]
const MENU_SIZE_DEFAULT: = 1.5


func _place_ro_window() -> void :
	if _ro_window_root == null or not is_instance_valid(_ro_window_root):
		return
	var view: = get_viewport().get_visible_rect().size
	var min_size: = _ro_window_root.get_combined_minimum_size()


	var k: = clampf(floorf(view.y / 640.0), 1.0, 2.0)
	if min_size.x * k > view.x * 0.95 or min_size.y * k > view.y * 0.95:
		k = 1.0


	if MouseWalk.touch():
		var want: = clampf(float(Save.setting("menu_size", MENU_SIZE_DEFAULT)), 1.0, MENU_SIZES.max())
		var room: = minf(view.x * 0.97 / maxf(1.0, min_size.x), (view.y - 16.0) / maxf(1.0, min_size.y))
		k = maxf(k, minf(want, room))


	var top: = 30.0 if world != null and world.net != null and world.net.mode != "" and not world.running else 8.0
	if _rail != null and is_instance_valid(_rail) and not _rail.is_queued_for_deletion() and (_rail_on_top(view) or _rail.has_meta("top")):
		top = maxf(top, 66.0)


	var over: = min_size.y - (view.y - top - 8.0) / k
	if over > 0.0:
		var scroll: = _tallest_scroll(_ro_window_root)
		if scroll != null:
			scroll.custom_minimum_size.y = maxf(120.0, scroll.custom_minimum_size.y - over)
			min_size = _ro_window_root.get_combined_minimum_size()





	var rail_side: = 0.0
	if _rail != null and is_instance_valid(_rail) and not _rail.is_queued_for_deletion() and not (_rail_on_top(view) or _rail.has_meta("top")):
		rail_side = _rail.size.x + 12.0
	var fit: = minf((view.y - top - 8.0) / maxf(1.0, min_size.y), (view.x - 8.0 - rail_side) / maxf(1.0, min_size.x))
	if fit < k:
		k = maxf(0.5, fit)
	elif touch_ui() and _ro_window_root.has_meta("touch_grow"):

		k = minf(fit, 1.6)
	elif _ro_window_root.has_meta("grow"):


		k = maxf(k, minf(fit * 0.96, float(_ro_window_root.get_meta("grow"))))
	_ro_window_root.scale = Vector2(k, k)
	var rail_top: = _rail != null and is_instance_valid(_rail) and (_rail_on_top(view) or _rail.has_meta("top"))
	var left_inset: = 0.0 if rail_top or _rail == null or not is_instance_valid(_rail) else _rail.size.x + 12.0
	var available: = Vector2(maxf(1.0, view.x - left_inset), view.y)
	var pos: = Vector2(left_inset + (available.x - min_size.x * k) * 0.5, (view.y - min_size.y * k) * 0.5).floor()

	pos.x = clampf(pos.x, 4.0, maxf(4.0, view.x - min_size.x * k - 4.0))
	if rail_top:
		pos.y = maxf(pos.y, 66.0)
	pos.y = maxf(pos.y, top) if min_size.y * k <= view.y - top - 8.0 else maxf(pos.y, 4.0)




	if _ro_window_title == _ro_placed_title and _ro_placed_top >= 0.0 and _ro_window_root != _ro_placed_root\
	and _ro_placed_top + min_size.y * k <= view.y - 4.0:
		pos.y = _ro_placed_top
	_ro_window_root.position = pos
	_ro_placed_title = _ro_window_title
	_ro_placed_top = pos.y
	_ro_placed_root = _ro_window_root


	if world == null or not world.running:
		RoAssets.set_ui_scale(k)
	_fit_cutin()


func _tallest_scroll(node: Node) -> ScrollContainer:
	var best: ScrollContainer = null
	for c in node.get_children():
		var s: ScrollContainer = c as ScrollContainer if c is ScrollContainer else _tallest_scroll(c)
		if s != null and (best == null or s.custom_minimum_size.y > best.custom_minimum_size.y):
			best = s
	return best


