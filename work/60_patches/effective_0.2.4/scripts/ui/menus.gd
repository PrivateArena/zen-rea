	for key in EQUIP_ROWS:
		var right: bool = EQUIP_ROWS[key][0]
		var y: int = EQUIP_ROW_Y[EQUIP_ROWS[key][1]]
		var it = p.equipment.slots[key]
		var b: = Button.new()
		b.flat = true
		b.focus_mode = Control.FOCUS_ALL
		b.position = Vector2(176 if right else 4, y - 11)
		b.size = Vector2(100 if right else 101, 22)
		b.tooltip_text = _slot_name(key) if it == null else ""
		b.pressed.connect( func(): show_equipment(key))
