func _achievement_cell(id: String, w: float) -> PanelContainer:
	var a: Dictionary = GameData.ACHIEVEMENTS[id]
	var done: = Save.achieved(id)
	var to_claim: = done and not Save.claimed(id)
	var cell: = PanelContainer.new()
	var box: = StyleBoxFlat.new()
	box.bg_color = Color(1.0, 0.94, 0.72) if to_claim else (Color(1.0, 0.97, 0.86) if done else Color(0.95, 0.96, 1.0))
	box.border_color = Color(0.95, 0.62, 0.1) if to_claim else (Color(0.85, 0.66, 0.25) if done else Color(0.78, 0.81, 0.9))
	box.set_border_width_all(2 if to_claim else 1)
	box.set_corner_radius_all(6)
	box.set_content_margin_all(5)
	cell.add_theme_stylebox_override("panel", box)
	cell.custom_minimum_size.x = w
	var row: = HBoxContainer.new()
	row.add_theme_constant_override("separation", 6)
	cell.add_child(row)
	var ic: = UiKit.icon_rect(Achievements.icon(a), 30)
	ic.texture_filter = CanvasItem.TEXTURE_FILTER_LINEAR
	if not done:
		ic.modulate = Color(0.55, 0.58, 0.68, 0.8)
	row.add_child(ic)
	var info: = VBoxContainer.new()
	info.add_theme_constant_override("separation", 1)
	info.size_flags_horizontal = Control.SIZE_EXPAND_FILL
	row.add_child(info)
	info.add_child(_ro_text(tr(str(a.name)), 11, Color(0.45, 0.28, 0.0) if done else Color(0.12, 0.16, 0.32), true))
	var d: = _ro_text(tr(str(a.desc)), 10, Color(0.27, 0.29, 0.37))
	d.autowrap_mode = TextServer.AUTOWRAP_WORD_SMART
	d.custom_minimum_size.x = w - 110.0
	info.add_child(d)
	if not done:
		var g: = Achievements.goal(a)
		var v: = minf(Achievements.value(a), g)
		var prow: = HBoxContainer.new()
		prow.add_theme_constant_override("separation", 4)
		info.add_child(prow)
		var gauge: = UiStyles.ro_gauge("blue", int(w - 170.0))
		gauge.value = 100.0 * v / maxf(1.0, g)
		gauge.size_flags_vertical = Control.SIZE_SHRINK_CENTER
		prow.add_child(gauge)
		prow.add_child(_ro_text("%s / %s" % [RoBasicWindow._thousands(int(v)), RoBasicWindow._thousands(int(g))], 9, Color(0.28, 0.3, 0.4)))
	var reward: = VBoxContainer.new()
	reward.alignment = BoxContainer.ALIGNMENT_CENTER
	reward.add_theme_constant_override("separation", 0)

	reward.custom_minimum_size.x = 80
	row.add_child(reward)
	if to_claim:

		var claim: = _ro_button(tr("Reclamar"), func(): _claim_achievement(id))
		claim.custom_minimum_size = Vector2(76, 24)
		_glow(claim)
		reward.add_child(claim)
		var cc: = HBoxContainer.new()
		cc.alignment = BoxContainer.ALIGNMENT_CENTER
		cc.add_theme_constant_override("separation", 2)
		cc.add_child(UiKit.icon_rect(Achievements.coin_icon(), 18))
		cc.add_child(_ro_text("+%d" % int(a.coins), 11, Color(0.55, 0.32, 0.0), true))
		reward.add_child(cc)
		cell.mouse_filter = Control.MOUSE_FILTER_STOP
		cell.mouse_default_cursor_shape = Control.CURSOR_POINTING_HAND
		cell.gui_input.connect( func(ev: InputEvent):
			if ev is InputEventMouseButton and ev.pressed and ev.button_index == MOUSE_BUTTON_LEFT:
				_claim_achievement(id))
		_ach_cells[id] = {"cell": cell, "box": box, "reward": reward}
		return cell
	if done:
		var stamp_path: = "res://assets/ro/ui/skin/achievement/badge_complete.png"
		var stamp: = UiKit.icon_rect(load(stamp_path) if ResourceLoader.exists(stamp_path) else null, 34)
		stamp.texture_filter = CanvasItem.TEXTURE_FILTER_LINEAR
		reward.add_child(stamp)
	var coin: = HBoxContainer.new()
	coin.add_theme_constant_override("separation", 2)
	coin.add_child(UiKit.icon_rect(Achievements.coin_icon(), 18))
	coin.add_child(_ro_text("%d" % int(a.coins), 11, Color(0.55, 0.32, 0.0) if done else Color(0.28, 0.3, 0.4), true))
	if done:
		coin.modulate.a = 0.6
	reward.add_child(coin)
	return cell


