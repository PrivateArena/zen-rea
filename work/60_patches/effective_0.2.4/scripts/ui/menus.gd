func _storage_sort(by: = "type") -> void :
	var kinds: = ["weapon", "shield", "head", "mid", "low", "armor", "garment", "shoes", "acc", "wings", "soul"]
	var kind: = func(it: Dictionary) -> int:
		var k: = kinds.find(str(Equipment.item_def(it).get("slot", "")))
		return k if k >= 0 else kinds.size()
	var rarity: = func(it: Dictionary) -> int:
		if Equipment.is_unique(it):
			return 5
		if Equipment.is_legendary(it):
			return 4
		return clampi(int(it.get("slots", 0)), 0, 3)


	var in_set: = {}
	if by == "set":
		var sids: = GameData.SETS.keys()
		sids.sort_custom( func(x, y): return tr(str(GameData.SETS[x].name)) < tr(str(GameData.SETS[y].name)))
		for si in sids.size():
			var pieces: Array = GameData.set_pieces(sids[si])
			for pi in pieces.size():
				if not in_set.has(pieces[pi]):
					in_set[pieces[pi]] = si * 100 + pi
	var set_key: = func(it: Dictionary) -> int:
		return - int(in_set.get(str(it.get("id", "")), 1000000))
	Save.storage().sort_custom( func(a: Dictionary, b: Dictionary) -> bool:
		var first: Array = [rarity.call(a), - int(kind.call(a))] if by == "rarity" else [ - int(kind.call(a)), rarity.call(a)]
		var second: Array = [rarity.call(b), - int(kind.call(b))] if by == "rarity" else [ - int(kind.call(b)), rarity.call(b)]
		if by == "set":
			first.push_front(set_key.call(a))
			second.push_front(set_key.call(b))
		if first != second:
			return first > second

		if str(a.get("id", "")) != str(b.get("id", "")):

			if Equipment.score(a) - int(a.get("refine", 0)) * 3.0 != Equipment.score(b) - int(b.get("refine", 0)) * 3.0:
				return Equipment.score(a) - int(a.get("refine", 0)) * 3.0 > Equipment.score(b) - int(b.get("refine", 0)) * 3.0
			return str(a.get("id", "")) < str(b.get("id", ""))
		if int(a.get("refine", 0)) != int(b.get("refine", 0)):
			return int(a.get("refine", 0)) > int(b.get("refine", 0))
		return (a.get("cards", []) as Array).size() > (b.get("cards", []) as Array).size())
	Save.mark_dirty()
	Save.flush()


func _store_tabs(refresh: Callable, keep: = Callable()) -> HFlowContainer:



	var slots: = [["weapon", tr("Arma")], ["shield", tr("Escudo")], ["head", tr("Cabeza")], ["mid", tr("Cara")], 
		["low", tr("Boca")], ["armor", tr("Armadura")], ["garment", tr("Prenda")], ["shoes", tr("Calzado")], ["acc", tr("Accesorio")], 
		["wings", tr("Alas")], ["soul", tr("Alma")]]
	var row: = HFlowContainer.new()
	row.add_theme_constant_override("h_separation", 2)
	row.add_theme_constant_override("v_separation", 2)
	var hero: = _store_hero()
	var mine: = _hero_gear(hero)

	if _store_group == "mine" and hero == "":
		_store_group = ""
	var groups: = {}
	var per_slot: = {}
	var all: = 0
	for it in Save.storage():
		if (keep.is_valid() and not keep.call(it)) or _store_hidden(it):
			continue
		var sl: = str(Equipment.item_def(it).get("slot", ""))
		if _store_in_group(it, _store_group, mine):
			per_slot[sl] = int(per_slot.get(sl, 0)) + 1
			all += 1
		if _store_slot != "" and sl != _store_slot:
			continue
		groups[""] = int(groups.get("", 0)) + 1
		for g in ["used", "mine", "eternal", "fav", "locked"]:
			if _store_in_group(it, g, mine):
				groups[g] = int(groups.get(g, 0)) + 1
	var chips: = [["", tr("Todo")], ["used", tr("★ En uso")], ["eternal", tr("Cartas Eternas")], ["fav", tr("Marcadas")], ["locked", tr("Bloqueadas")]]

	if hero != "":
		chips.insert(1, ["mine", tr("Mi build")])
	for pair in chips:
		var key: = str(pair[0])
		var n: = int(groups.get(key, 0))
		if key != "" and n == 0 and _store_group != key:
			continue
		var b: = _ro_button("%s %d" % [str(pair[1]), n], func():
			_store_group = key
			ui_click()
			refresh.call())
		if key == "mine":
			b.tooltip_text = tr("El equipo inicial de tu héroe: %s") % _class_title(hero)
		elif key == "eternal":
			b.tooltip_text = tr("Las piezas con Cartas Eternas puestas.")
		elif key == "fav":
			b.tooltip_text = tr("Las piezas que marcaste (Modo marcar en el Almacén Kafra): para encontrarlas rápido o mostrarlas en una captura.")
		elif key == "locked":
			b.tooltip_text = tr("Las piezas bloqueadas: no se venden ni se intercambian.")
		b.toggle_mode = true
		b.button_pressed = _store_group == key
		b.focus_mode = Control.FOCUS_NONE
		b.add_theme_font_size_override("font_size", 10)
		row.add_child(b)

	var opts: = [["", "%s %d" % [tr("Todas las piezas"), all]]]
	for pair in slots:
		var n: = int(per_slot.get(str(pair[0]), 0))
		if n > 0 or _store_slot == str(pair[0]):
			opts.append([str(pair[0]), "%s %d" % [str(pair[1]), n]])
	var at: = 0
	for i in opts.size():
		if opts[i][0] == _store_slot:
			at = i
	var pick: = _album_select(opts.map( func(o): return o[1]), at, func(i: int):
		_store_slot = str(opts[i][0])
		ui_click()
		refresh.call())
	pick.focus_mode = Control.FOCUS_NONE
	pick.add_theme_font_size_override("font_size", 10)
	pick.get_popup().add_theme_font_size_override("font_size", 14 if touch_ui() else 11)
	pick.tooltip_text = tr("Pieza")
	row.add_child(pick)
	return row




func _store_in_group(it: Dictionary, group: String, mine: Dictionary) -> bool:
	match group:
		"used":
			return Save.loadout_owner(str(it.get("uid", ""))) != ""
		"mine":
			return mine.has(str(it.get("uid", "")))
		"eternal":
			return _has_eternal(it)
		"fav":
			return bool(it.get("fav", false))
		"locked":
			return Equipment.is_locked(it)
	return true




func _store_hero() -> String:
	if world != null and world.town != null and is_instance_valid(world.town) and str(world.town.class_id) != "":
		return str(world.town.class_id)
	return _loadout_class if _mode == "loadout" and GameData.CLASSES.has(_loadout_class) else ""





func _store_hidden(it: Dictionary) -> bool:
	if str(it.get("uid", "")) != Save.FISTS_UID:
		return false
	var hero: = _store_hero()
	return hero != "" and hero != "taekwon"



static func _has_eternal(it: Dictionary) -> bool:
