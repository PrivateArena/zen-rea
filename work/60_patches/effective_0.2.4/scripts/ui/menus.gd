func _loadout_compare(class_id: String, it: Dictionary) -> String:
	if not GameData.CLASSES.has(class_id) or not _class_can_use(class_id, it):
		return ""
	var lo: = Save.loadout(class_id)
	var uid: = str(it.get("uid", ""))
	if lo.values().any( func(u): return str(u) == uid):
		return ""
	var kind: = Equipment.item_type(it)
	var keys: Array = ["acc1", "acc2"] if kind == "acc" else [kind]
	var worn: = {}
	for k in keys:
		var w: = Save.storage_item(str(lo.get(k, "")))
		if w.is_empty():
			return tr("Hueco libre en tu equipo inicial")
		if worn.is_empty() or Equipment.score(w) < Equipment.score(worn):
			worn = w
	if worn.is_empty():
		return ""
	var d: = _mods_delta(Equipment.item_mods(it), Equipment.item_mods(worn))
	for k in d.keys():
		if absf(float(d[k])) < 0.0005:
			d.erase(k)
	var delta: = _mods_text(d)
	return tr("Frente a %s: %s") % [Equipment.item_name(worn), delta if delta != "-" else tr("igual")]




const STORE_HOLD_MS: = 350
var _store_sure: = ""


func _storage_cell(class_id: String, it: Dictionary) -> Control:
	var cell: = PanelContainer.new()
	cell.custom_minimum_size = Vector2(38, 38)
	var usable: = not it.is_empty() and _class_can_use(class_id, it)
	cell.add_theme_stylebox_override("panel", _cell_box(Equipment.item_color(it) if not it.is_empty() else Color(0.8, 0.82, 0.9), 
		not it.is_empty(), 2 if not it.is_empty() else 1))
	if it.is_empty():
		cell.mouse_filter = Control.MOUSE_FILTER_PASS
		return cell



	var layer: = Control.new()
	layer.mouse_filter = Control.MOUSE_FILTER_IGNORE
	cell.add_child(layer)
	_grade_deco(cell, it)
	var ic: = UiKit.icon_rect(_item_icon(Equipment.item_def(it).icon), 30)
	ic.position = Vector2(1, 1)
	ic.size = Vector2(30, 30)
	if not usable:
		ic.modulate = Color(1, 1, 1, 0.3)
	layer.add_child(ic)
	var uid: = str(it.get("uid", ""))
	var owner: = Save.loadout_owner(uid)
	if int(it.get("refine", 0)) > 0:

		var tag: = _ro_text("+%d" % int(it.refine), 11, Color(0.1, 0.12, 0.3), true)
		tag.add_theme_color_override("font_outline_color", Color(1, 1, 1, 0.95))
		tag.add_theme_constant_override("outline_size", 4)
		tag.position = Vector2(-1, -4)
		layer.add_child(tag)
	if owner != "":
		var star: = _ro_text("★", 12, Color(1.0, 0.82, 0.25), false)
		star.add_theme_font_override("font", ThemeDB.fallback_font)
		star.add_theme_color_override("font_outline_color", Color(0.3, 0.18, 0.0))
		star.add_theme_constant_override("outline_size", 4)
		star.position = Vector2(20, 19) if Equipment.grade(it) > 0 else Vector2(20, -5)
		layer.add_child(star)
	var locked: = Equipment.is_locked(it)
	if locked:
		layer.add_child(_padlock(Vector2(1, 19)))
	if bool(it.get("fav", false)):
		layer.add_child(_fav_mark(Vector2(26, 26)))
	cell.mouse_filter = Control.MOUSE_FILTER_STOP
	var feet: = [tr("En el equipo de: %s") % _class_title(owner)] if owner != "" else []

	var vs: = _loadout_compare(class_id, it)
	if vs != "":
		feet.append(vs)
	var unsold: bool = Equipment.item_def(it).get("fixed", false)
	if unsold:
		feet.append(tr("Tus Puños no se venden: son el arma del Taekwon."))
	elif locked:
		feet.append(tr("Bloqueado: no se vende ni se intercambia"))

	var hints: = []
	if not unsold and not locked:
		hints.append((tr("Clic: vender por %s") if _store_sell_mode else tr("Ctrl + clic: vender por %s")) % Equipment.price_text(it))
	if not unsold and not touch_ui():
		hints.append(tr("Clic derecho: desbloquear") if locked else tr("Clic derecho: bloquear"))
	if _store_sell_mode and not unsold and not locked:
		cell.self_modulate = Color(1.0, 0.85, 0.75)
	elif _store_lock_mode and not unsold:
		cell.self_modulate = Color(1.0, 0.95, 0.7)
	elif _store_fav_mode:
		cell.self_modulate = Color(1.0, 0.82, 0.9)
	_set_hover(cell, _item_hover(it, feet, hints))


	var down: = [false, 0]
	cell.gui_input.connect( func(ev: InputEvent):

		if ev is InputEventMouseButton and ev.button_index == MOUSE_BUTTON_RIGHT and ev.pressed and not unsold and not touch_ui():
			_store_lock(class_id, uid)
			return
		if ev is InputEventMouseButton and ev.button_index == MOUSE_BUTTON_LEFT:
			if ev.pressed:
				down[0] = true
				down[1] = Time.get_ticks_msec()
			elif down[0]:
				down[0] = false


				if touch_ui() and Time.get_ticks_msec() - int(down[1]) >= STORE_HOLD_MS:
					return
				if _store_lock_mode and not unsold:
					_store_lock(class_id, uid)
					return
				if _store_fav_mode:
					_store_fav(class_id, uid)
					return
				if ev.ctrl_pressed or _store_sell_mode:



					if _store_valuable(it) and not unsold:
						_confirm_store_sell(class_id, uid)
						return
					_storage_sell(class_id, uid)
				else:
					_loadout_put(class_id, uid, _loadout_slot_for(class_id, it)))
	cell.mouse_exited.connect( func(): down[0] = false)
	cell.set_drag_forwarding(
		func(_at: Vector2) -> Variant:
			down[0] = false
			var pv: = UiKit.icon_rect(_item_icon(Equipment.item_def(it).icon), 30)
			pv.size = Vector2(30, 30)
			pv.modulate.a = 0.85
			cell.set_drag_preview(pv)
			return {"type": "store", "uid": uid}, 
		func(_at: Vector2, data: Variant) -> bool: return data is Dictionary and data.get("type", "") == "slot", 
		func(_at: Vector2, data: Variant) -> void :
			Save.set_loadout_slot(class_id, str(data.key), "")
			world.play_sound("ui_click", 0.0, -4.0)
			show_loadout(class_id))
	return cell




