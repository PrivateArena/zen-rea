func _trade_changed() -> void :
	if trade.state == "asking":
		if _mode != "trade_wait":
			_mode = "trade_wait"
			var body: = _ro_screen(tr("Comercio"), 300)
			body.add_child(_ro_text(tr("Esperando la respuesta de %s...") % trade.partner_name, 12))
			var footer: = HBoxContainer.new()
			footer.alignment = BoxContainer.ALIGNMENT_END
			body.add_child(footer)
			footer.add_child(_ro_button(tr("Cancelar"), trade.cancel))
		return
	if trade.state != "open":
		return
	if _mode != "trade" or _tr_left == null or not is_instance_valid(_tr_left):
		_show_trade()


	if not _tr_refresh_queued:
		_tr_refresh_queued = true
		_trade_refresh_later.call_deferred()


func _trade_ended(why: String) -> void :
	_close_trade_confirm()
	if why == "cancel":
		_back_to_hub()
		return
	var lines: = {"done": tr("¡Comercio completado! Todo está en tu Almacén Kafra."), "refused": tr("Rechazó el comercio."), 
		"busy": tr("Está ocupado ahora mismo."), "left": tr("El comercio se canceló."), 
		"failed": tr("Algo cambió en tu almacén: el comercio se canceló y nada se movió.")}
	_mode = "trade_end"
	var body: = _ro_screen(tr("Comercio"), 300)
	var t: = _ro_text(str(lines.get(why, lines.left)), 12)
	t.autowrap_mode = TextServer.AUTOWRAP_WORD_SMART
	t.custom_minimum_size.x = 280
	body.add_child(t)
	var footer: = HBoxContainer.new()
	footer.alignment = BoxContainer.ALIGNMENT_END
	body.add_child(footer)
	var ok: = _ro_button(tr("OK"), _back_to_hub)
	footer.add_child(ok)
	ok.grab_focus.call_deferred()
	if why == "done":
		world.play_sound("job_levelup", 0.0, -6.0)





const TRADE_COL_W: = 290.0
func _show_trade() -> void :
	_mode = "trade"
	var body: = _ro_screen(tr("Comercio : %s") % trade.partner_name, 2 * TRADE_COL_W + 18)
	body.add_theme_constant_override("separation", 5)
	var cols: = HBoxContainer.new()
	cols.add_theme_constant_override("separation", 4)
	body.add_child(cols)
	var left: = _trade_column(tr("Tú das"))
	cols.add_child(left.box)
	_tr_left_box = left.box
	_tr_left = left.list
	_tr_zeny = LineEdit.new()
	_tr_zeny.text = "0"
	_tr_zeny.alignment = HORIZONTAL_ALIGNMENT_RIGHT
	_tr_zeny.custom_minimum_size = Vector2(110, 20)
	_tr_zeny.add_theme_font_size_override("font_size", 11)
	_tr_zeny.max_length = 12
	_tr_zeny.select_all_on_focus = true
	_tr_zeny.tooltip_text = tr("Tienes %s z") % RoBasicWindow._thousands(Save.zeny())
	for state in ["normal", "focus", "read_only"]:
		var zb: = StyleBoxFlat.new()
		zb.bg_color = Color(1, 1, 1) if state != "read_only" else Color(0.9, 0.9, 0.92)
		zb.border_color = Color(0.3, 0.42, 0.78) if state == "focus" else Color(0.7, 0.73, 0.82)
		zb.set_border_width_all(1)
		zb.set_corner_radius_all(2)
		zb.content_margin_left = 4
		zb.content_margin_right = 4
		_tr_zeny.add_theme_stylebox_override(state, zb)
	for c in ["font_color", "font_uneditable_color"]:
		_tr_zeny.add_theme_color_override(c, Color.BLACK)
	var apply: = func(_t = null):
		var digits: = ""
		for ch in _tr_zeny.text:
			if ch >= "0" and ch <= "9":
				digits += ch
		trade.set_zeny(int(digits) if digits != "" else 0)
		_tr_zeny.text = RoBasicWindow._thousands(int(trade.mine.zeny))
	_tr_zeny.text_submitted.connect(apply)
	_tr_zeny.focus_exited.connect(apply)
	left.foot.add_child(_tr_zeny)
	left.foot.add_child(_ro_text(tr("Zeny"), 10, Color(0.2, 0.3, 0.75), true))
	var right: = _trade_column(tr("Recibes"))
	cols.add_child(right.box)
	_tr_right_box = right.box
	_tr_right = right.list
	_tr_their_zeny = _ro_text("0", 11)
	_tr_their_zeny.custom_minimum_size.x = 110
	_tr_their_zeny.horizontal_alignment = HORIZONTAL_ALIGNMENT_RIGHT
	right.foot.add_child(_tr_their_zeny)
	right.foot.add_child(_ro_text(tr("Zeny"), 10, Color(0.2, 0.3, 0.75), true))
	_tr_status = _ro_text("", 10, Color(0.28, 0.3, 0.4))
	_tr_status.autowrap_mode = TextServer.AUTOWRAP_WORD_SMART
	_tr_status.custom_minimum_size.x = 2 * TRADE_COL_W
	body.add_child(_tr_status)
	_tr_buttons = HBoxContainer.new()
	_tr_buttons.add_theme_constant_override("separation", 6)
	body.add_child(_tr_buttons)
	var line: = ColorRect.new()
	line.color = Color(0.75, 0.78, 0.86)
	line.custom_minimum_size.y = 1
	body.add_child(line)
	_tr_picker = VBoxContainer.new()
	_tr_picker.add_theme_constant_override("separation", 4)

	_tr_query = ""
	body.add_child(_tr_picker)



