func _album_ids(equipped: Array) -> Array:
	var needle: = _fold(_album_search.strip_edges())
	var out: = []
	for id in GameData.CARDS:
		var owned: = Save.has_card(id)
		match _album_filter:
			"found":
				if not owned:
					continue
			"missing":
				if owned:
					continue
			"equipped":
				if not equipped.has(id):
					continue
			"fusible":
				if not Save.can_fuse(id):
					continue
			"eternal":
				if Save.eternal(id) <= 0:
					continue
		if _album_stage != "":
			var where: = _card_stage(id)
			if (_album_stage == "other" and where != "") or (_album_stage != "other" and where != _album_stage):
				continue
		if _album_kind != "" and not _card_kind(id, _album_kind):
			continue
		if _album_slot != "" and str(GameData.CARDS[id].get("type", "")) != _album_slot:
			continue
		if needle != "" and not _fold("%s %s" % [tr(str(GameData.CARDS[id].name)), tr(str(GameData.CARDS[id].get("desc", "")))]).contains(needle):
			continue
		out.append(id)
	if _album_sort == "rarity":

		var tiers: = ["normal", "boss", "mvp"]
		var key: = {}
		for i in out.size():
			key[out[i]] = tiers.find(GameData.card_tier(str(out[i]))) * 100000 + i
		out.sort_custom( func(a, b): return int(key[a]) < int(key[b]))
	return out




func _album_fill(grid: GridContainer, scroll: ScrollContainer, equipped: Array, slots: int) -> void :
	_album_gen += 1
	var gen: = _album_gen
	for c in grid.get_children():
		c.queue_free()
	var ids: = _album_ids(equipped)
	if ids.is_empty():
		grid.add_child(_ro_text(tr("Ninguna carta con este filtro."), 11, Color(0.28, 0.3, 0.4)))
		return
	_album_filling = true
	var want: = _album_scroll


	var at_once: = (int((want + maxf(scroll.size.y, 400.0)) / ALBUM_ROW_H) + 2) * grid.columns
	for i in ids.size():
		grid.add_child(_album_cell(ids[i], equipped, slots))
		if i >= at_once and i % ALBUM_BATCH == ALBUM_BATCH - 1:
			await get_tree().process_frame
			if gen != _album_gen or not is_instance_valid(grid):
				return
			scroll.scroll_vertical = want
		elif i == at_once:
			await get_tree().process_frame
			if gen != _album_gen or not is_instance_valid(grid):
				return
			scroll.scroll_vertical = want
	await get_tree().process_frame
	if gen != _album_gen or not is_instance_valid(scroll):
		return
	scroll.scroll_vertical = want
	await get_tree().process_frame
	if gen == _album_gen and is_instance_valid(scroll):
		scroll.scroll_vertical = want
		_album_filling = false



