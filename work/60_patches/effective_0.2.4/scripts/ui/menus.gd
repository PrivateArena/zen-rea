const CHEST_SKIP_SPEED: = 10.0




func _fit_chest_list(scroll: ScrollContainer, list: Control, has_zeny: bool) -> void :
	if not is_instance_valid(scroll):
		return
	var view: = get_viewport().get_visible_rect().size.y
	var room: = view - 300.0 - (30.0 if has_zeny else 0.0)
	var tall: = list.get_combined_minimum_size().y
	var h: = minf(tall, maxf(150.0, room))


	var bar: = 0.0
	if tall > h:
		bar = maxf(8.0, scroll.get_v_scroll_bar().get_combined_minimum_size().x)
		var pad: = list as MarginContainer
		if pad != null:
			pad.add_theme_constant_override("margin_left", 28 + int(bar))
	scroll.custom_minimum_size = Vector2(list.get_combined_minimum_size().x + bar, h)




func _reveal_row(row: Control, it: Dictionary) -> void :
	var legendary: = Equipment.is_legendary(it)
	world.play_sound(GameData.DROP_SOUND_LEGENDARY if legendary else GameData.DROP_SOUNDS[clampi(int(it.slots), 0, 3)], 0.0, -4.0)
	world.play_sound("equip_item", 0.0, -6.0)
	row.pivot_offset = row.size * Vector2(0.1, 0.5)
	row.scale = Vector2.ONE * 1.12
	var tw: = row.create_tween().set_pause_mode(Tween.TWEEN_PAUSE_PROCESS).set_parallel()
	tw.tween_property(row, "modulate:a", 1.0, 0.14)
	tw.tween_property(row, "scale", Vector2.ONE, 0.22).set_trans(Tween.TRANS_BACK).set_ease(Tween.EASE_OUT)
	if Equipment.is_unique(it):
		_unique_moment(row, it)
	elif legendary:
		_legendary_moment(row, it)


var _legend_banner: Control






func _unique_moment(row: Control, it: Dictionary) -> void :
	var col: = GameData.UNIQUE_COLOR
	world.play_sound("job_levelup", 0.0, 0.0)
	world.play_sound("levelup", 0.0, -2.0)
	world.play_sound("assumptio", 0.0, -4.0)
	world.shake(0.7)
	if world.player != null:
		world.spawn_fx("h_levelup", world.player.position, 1.4, 1.0, world.player)
	var flash: = ColorRect.new()
	flash.set_anchors_and_offsets_preset(Control.PRESET_FULL_RECT)
	flash.mouse_filter = Control.MOUSE_FILTER_IGNORE
	flash.color = Color(col.lightened(0.6), 0.9)
	_root.add_child(flash)
	var ft: = flash.create_tween().set_pause_mode(Tween.TWEEN_PAUSE_PROCESS)
	ft.tween_property(flash, "color:a", 0.0, 0.45)
	ft.tween_property(flash, "color:a", 0.55, 0.12)
	ft.tween_property(flash, "color:a", 0.0, 1.0).set_trans(Tween.TRANS_QUAD).set_ease(Tween.EASE_OUT)
	ft.tween_callback(flash.queue_free)
	var icon_box: Control = row.get_meta("icon_box") if row.has_meta("icon_box") else row.get_child(0)
	for k in 2:
		var rays: = UiKit.rays(Color(col.lightened(0.3), 0.95) if k == 0 else Color(1.0, 1.0, 1.0, 0.7), 130 if k == 0 else 96)
		rays.mouse_filter = Control.MOUSE_FILTER_IGNORE
		var half: = 65.0 if k == 0 else 48.0
		rays.position = Vector2(24, 24) - Vector2(half, half)
		rays.pivot_offset = Vector2(half, half)
		icon_box.add_child(rays)
		icon_box.move_child(rays, 0)
		rays.create_tween().set_pause_mode(Tween.TWEEN_PAUSE_PROCESS).set_loops()\
		.tween_property(rays, "rotation", TAU if k == 0 else - TAU, 5.0 if k == 0 else 3.5).as_relative()
	if _legend_banner != null and is_instance_valid(_legend_banner):
		_legend_banner.queue_free()
	var view: = get_viewport().get_visible_rect().size
	var banner: = VBoxContainer.new()
	_legend_banner = banner
	banner.mouse_filter = Control.MOUSE_FILTER_IGNORE
	banner.alignment = BoxContainer.ALIGNMENT_CENTER
	var big: = UiKit.label(tr("¡ÚNICO!"), 68, col.lightened(0.2), true)
	big.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER
	big.add_theme_constant_override("outline_size", 14)
	big.add_theme_color_override("font_outline_color", Color(0.0, 0.12, 0.2, 0.95))
	banner.add_child(big)
	var title_l: = UiKit.label(Equipment.item_name(it), 26, Color(0.95, 1.0, 1.0), true)
	title_l.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER
	title_l.add_theme_constant_override("outline_size", 8)
	title_l.add_theme_color_override("font_outline_color", Color(0.0, 0.12, 0.2, 0.95))
	banner.add_child(title_l)
	var d: = Equipment.item_def(it)
	var stage: Dictionary = GameData.STAGES.get(str(d.get("stage", "")), {})
	if not stage.is_empty():
		var mvp_name: = tr(str(GameData.MONSTERS.get(str(stage.get("mvp", "")), {}).get("name", "")))
		var origin: = UiKit.label(tr("Único de %s  ·  %s") % [tr(str(stage.name)), mvp_name], 15, Color(0.75, 0.95, 1.0), true)
		origin.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER
		origin.add_theme_constant_override("outline_size", 6)
		origin.add_theme_color_override("font_outline_color", Color(0.0, 0.12, 0.2, 0.95))
		banner.add_child(origin)
	banner.size = Vector2(view.x, 160)
	banner.position = Vector2(0, view.y * 0.12)
	banner.pivot_offset = banner.size * 0.5
	banner.scale = Vector2.ONE * 0.3
	banner.modulate.a = 0.0
	_root.add_child(banner)
	var bt: = banner.create_tween().set_pause_mode(Tween.TWEEN_PAUSE_PROCESS)
	bt.tween_property(banner, "modulate:a", 1.0, 0.12)
	bt.parallel().tween_property(banner, "scale", Vector2.ONE * 1.15, 0.35).set_trans(Tween.TRANS_BACK).set_ease(Tween.EASE_OUT)
	bt.tween_property(banner, "scale", Vector2.ONE, 0.2)
	bt.tween_interval(2.6)
	bt.tween_property(banner, "modulate:a", 0.0, 0.6)
	bt.tween_callback(banner.queue_free)




