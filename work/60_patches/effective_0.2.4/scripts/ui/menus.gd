	if world != null and not world.run_stored.is_empty():
		var srow: = HFlowContainer.new()
		srow.add_theme_constant_override("h_separation", 6)
		srow.add_theme_constant_override("v_separation", 2)
		var cap: = UiKit.label(tr("Al Almacén Kafra:"), 12, Color(0.2, 0.5, 0.25), true)
		cap.tooltip_text = tr("Los únicos y lo que encuentras en la Endless Tower van directo al Almacén Kafra: no se pierden al terminar. Póntelos en el Equipo inicial.")
		cap.mouse_filter = Control.MOUSE_FILTER_PASS
		srow.add_child(cap)
		for it in world.run_stored:
			var ic: = UiKit.icon_rect(_item_icon(str(Equipment.item_def(it).icon)), 22)
			ic.tooltip_text = Equipment.item_name(it) + "\n" + _mods_text(Equipment.item_mods(it))
			ic.mouse_filter = Control.MOUSE_FILTER_PASS
			srow.add_child(ic)
		col.add_child(srow)
	if best.has("class_level") and int(best.class_ups) > 0:
		var cid: = str(best.get("class_id", ""))
		var rlv: = Save.rebirth_lv(cid) if GameData.CLASSES.has(cid) else 0


		var to_place: = rlv <= 0 and GameData.CLASSES.has(cid) and Save.free_points(cid) > 0
		var up: = UiKit.label((tr("¡Nivel de clase %d! Reparte el punto en «Perfil».") if to_place else tr("¡Nivel de clase %d!")) % int(best.class_level), 
			12, UiKit.GOLD, true)
		up.autowrap_mode = TextServer.AUTOWRAP_WORD_SMART
		up.custom_minimum_size.x = 280
		col.add_child(up)

		if GameData.CLASSES.has(cid) and Save.rebirth_lv_ready(cid):
			var valk: = UiKit.label(tr("¡Estás en la cima! La Valkyrie te espera en Prontera para %s.") % GameData.rebirth_name(rlv + 1), 
				12, GameData.REBIRTH_LV_GOLD.darkened(0.3), true)
			valk.autowrap_mode = TextServer.AUTOWRAP_WORD_SMART
			valk.custom_minimum_size.x = 280
			col.add_child(valk)
	if int(result.get("ymir", 0)) > 0:
		var yrow: = HBoxContainer.new()
		yrow.add_theme_constant_override("separation", 6)
		yrow.add_child(UiKit.icon_rect(_item_icon("ymir_fragment"), 24))
		var frags: = Save.ymir_fragments()
		var ready: = frags >= GameData.REBIRTH_FRAGMENTS
		var yl: = UiKit.label(tr_n("¡%d Fragmento de Ymir!", "¡%d Fragmentos de Ymir!", int(result.ymir)) % int(result.ymir)
			+ "  " + tr("Tienes %d/%d") % [mini(frags, GameData.REBIRTH_FRAGMENTS), GameData.REBIRTH_FRAGMENTS]
			+ ("\n" + tr("¡Ya puedes renacer con la Valkyrie en Prontera!") if ready else ""), 12, Color(0.45, 0.65, 1.0), true)
		yl.autowrap_mode = TextServer.AUTOWRAP_WORD_SMART
		yl.custom_minimum_size.x = 250
		yrow.add_child(yl)
		col.add_child(yrow)
	var gods: Array = result.get("gods", [])
	if not gods.is_empty():
		var grow: = HBoxContainer.new()
		grow.add_theme_constant_override("separation", 4)
		grow.add_child(UiKit.label(tr("Dioses:"), 12, Color(0.35, 0.3, 0.6), true))
		var counts: = {}
		for g in gods:
			counts[g] = int(counts.get(g, 0)) + 1
		for g in counts:
			var d: Dictionary = GameData.ALTARS[g]
			var path: = "res://assets/ro/ui/skin/item_icons/%s.png" % str(d.icon)
			var ic: = UiKit.icon_rect(load(path) if ResourceLoader.exists(path) else null, 22)
			ic.mouse_filter = Control.MOUSE_FILTER_STOP
			_set_hover(ic, {"icon": ic.texture, "title": tr(str(d.name)), "color": d.color, 
				"tag": tr("Aceptado x%d") % int(counts[g]), "desc": tr(str(d.good))})
			grow.add_child(ic)
			if int(counts[g]) > 1:
				grow.add_child(UiKit.label("x%d" % int(counts[g]), 11, Color(0.35, 0.3, 0.6), true))
		col.add_child(grow)
	var done: Array = result.get("achievements", [])
	if done.size() == 1:
		var a: Dictionary = GameData.ACHIEVEMENTS[done[0]]
		var arow: = HBoxContainer.new()
		arow.add_theme_constant_override("separation", 6)
		arow.add_child(UiKit.icon_rect(Achievements.icon(a), 22))
		var al: = UiKit.label(tr("Logro: %s") % tr(str(a.name)), 12, Color(0.55, 0.32, 0.0), true)
		al.size_flags_horizontal = Control.SIZE_EXPAND_FILL
		arow.add_child(al)
		arow.add_child(UiKit.icon_rect(Achievements.coin_icon(), 18))
		arow.add_child(UiKit.label("+%d" % int(a.coins), 12, Color(0.55, 0.32, 0.0), true))
		col.add_child(arow)
		col.add_child(UiKit.label(tr("Reclama tus Poring Coins en el Álbum"), 10, UiKit.MUTED))
	elif done.size() > 1:

		var arow: = HBoxContainer.new()
		arow.add_theme_constant_override("separation", 4)
		arow.add_child(UiKit.label(tr("Logros:"), 12, Color(0.55, 0.32, 0.0), true))
		var coins: = 0
		for id in done:
			var a: Dictionary = GameData.ACHIEVEMENTS[id]
			coins += int(a.coins)
			var ic: = UiKit.icon_rect(Achievements.icon(a), 22)
			ic.mouse_filter = Control.MOUSE_FILTER_STOP
			_set_hover(ic, {"icon": Achievements.icon(a), "title": tr(str(a.name)), "desc": tr(str(a.get("desc", ""))), 
				"color": Color(0.95, 0.75, 0.3)})
			arow.add_child(ic)
		var gap: = Control.new()
		gap.size_flags_horizontal = Control.SIZE_EXPAND_FILL
		arow.add_child(gap)
		arow.add_child(UiKit.icon_rect(Achievements.coin_icon(), 18))
		arow.add_child(UiKit.label("+%d" % coins, 12, Color(0.55, 0.32, 0.0), true))
		col.add_child(arow)
		col.add_child(UiKit.label(tr("Reclama tus Poring Coins en el Álbum"), 10, UiKit.MUTED))
	_titles_won_row(col, result.get("titles", []))
	if grid.get_child_count() == 0 and col.get_child_count() == 2:
		col.add_child(UiKit.label(tr("Nada esta vez."), 12, UiKit.MUTED))
	return panel




func _titles_won_row(col: Control, won: Array) -> void :
	if won.is_empty():
		return
	for id in won:
		if not GameData.TITLES.has(str(id)):
			continue
		var r: = HBoxContainer.new()
		r.alignment = BoxContainer.ALIGNMENT_CENTER
		r.add_theme_constant_override("separation", 8)
		r.add_child(UiKit.label(tr("¡Nuevo título!"), 13, Color(0.55, 0.32, 0.0), true))
		r.add_child(world.titles.chip(str(id), 12))
		col.add_child(r)
	var hint: = UiKit.label(tr("Póntelo en Perfil (selección de personaje)."), 10, UiKit.MUTED)
	hint.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER
	col.add_child(hint)



func _build_damage_report() -> PanelContainer:
	var panel: = PanelContainer.new()
	panel.add_theme_stylebox_override("panel", UiKit.panel_box())
	var col: = VBoxContainer.new()
	col.add_theme_constant_override("separation", 6)
	panel.add_child(col)
	var st: Dictionary = world.meter_stats
	var total: = float(st.get("total", 0.0))
	var head: = UiKit.label(tr("Informe de daño  ·  %s  (%s/s)") % [DamageMeter.short(total), DamageMeter.short(total / maxf(1.0, world.time))], 
		16, UiKit.TEXT, true)
	head.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER
	col.add_child(head)
	var meter: = DamageMeter.new()
	meter.world = world
	meter.compact = false
	meter.max_rows = 6
	meter.row_height = 20.0
	meter.data = world.meter_sorted()
	meter.custom_minimum_size.x = 340
	col.add_child(meter)
	meter.custom_minimum_size.y = meter.row_height * maxi(1, mini(meter.max_rows, meter.data.size()))
	var more: = UiKit.button(tr("Ver detalles (M)"))
	more.pressed.connect( func(): world.meter_details.open("damage"))
	more.size_flags_horizontal = Control.SIZE_SHRINK_CENTER
	more.add_theme_font_size_override("font_size", 13)
	var best_tag: String = st.get("best_tag", "")
	var lines: = [
		[tr("Golpe máximo"), "%s  (%s)" % [DamageMeter.short(float(st.get("best", 0.0))), world.meter_label(best_tag) if best_tag != "" else "-"]], 
		[tr("Críticos"), tr("%d de %d golpes") % [int(st.get("crits", 0)), int(st.get("hits", 0))]], 
		[tr("Daño recibido"), DamageMeter.short(float(st.get("taken", 0.0)))], 
		[tr("Curación"), DamageMeter.short(float(st.get("healed", 0.0)))], 
	]
	var grid: = GridContainer.new()
	grid.columns = 4
	grid.add_theme_constant_override("h_separation", 8)
	grid.add_theme_constant_override("v_separation", 2)
	col.add_child(grid)
	for l in lines:
		grid.add_child(UiKit.label(l[0], 11, UiKit.MUTED))
		var v: = UiKit.label(l[1], 11, UiKit.TEXT, true)
		v.clip_text = true
		UiKit.fit_dots(v)
		v.custom_minimum_size.x = 90
		v.tooltip_text = l[1]
		v.mouse_filter = Control.MOUSE_FILTER_PASS
		grid.add_child(v)
	col.add_child(more)
	return panel









func show_corrupt_chest(on_open: Callable, on_purify: Callable, path: = "") -> void :
	_mode = "corrupt"

	if not world.net.is_client():
		get_tree().paused = true
	_grace = INPUT_GRACE
	var body: = _ro_screen(tr("Cofre Corrupto"), 560)
	body.add_theme_constant_override("separation", 6)
	var head: = CenterContainer.new()
	head.custom_minimum_size = Vector2(0, 112)
	body.add_child(head)
	var stack: = Control.new()
	stack.custom_minimum_size = Vector2(112, 112)
	head.add_child(stack)
	stack.add_child(UiKit.glow(Color(GameData.CORRUPT_COLOR, 0.35), 112))
	var spr: = RoAssets.sprite(["chest_corrupt", "chest_gold", "chest"])
	if spr != null:
		var box: = UiKit.icon_rect(spr.get_frame(0, 0), 104)
		box.position = Vector2(4, 4)
		box.pivot_offset = Vector2(52, 52)
		stack.add_child(box)
		var beat: = box.create_tween().set_pause_mode(Tween.TWEEN_PAUSE_PROCESS).set_loops()
		beat.tween_property(box, "scale", Vector2.ONE * 1.05, 0.2).set_trans(Tween.TRANS_SINE)
		beat.tween_property(box, "scale", Vector2.ONE, 0.35).set_trans(Tween.TRANS_SINE)
		beat.tween_interval(0.7)
	var ask: = _ro_text(tr("La corrupción late dentro. ¿Qué camino eliges?"), 11, Color(0.3, 0.32, 0.4))
	ask.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER
	body.add_child(ask)
	if path in ["light", "dark"]:
		var ink: Color = Color(0.62, 0.1, 0.16) if path == "dark" else Color(0.2, 0.36, 0.72)
		var note: = _ro_text((tr("Tu camino ya es Niflheim: la balanza no cambia tu portal.") if path == "dark"
			else tr("Tu camino ya es Valhalla: la balanza no cambia tu portal.")), 11, ink)
		note.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER
		note.autowrap_mode = TextServer.AUTOWRAP_WORD_SMART
		body.add_child(note)
	var row: = HBoxContainer.new()
	row.add_theme_constant_override("separation", 6)
	body.add_child(row)


	var pick: = func(cb: Callable, side: String):
		if _grace > 0.0:
			return
		if world.corrupt_auto != "random":
			world.corrupt_auto = side
		get_tree().paused = false
		close()
		cb.call()
	var pct: = func(mult: float) -> int: return roundi((mult - 1.0) * 100.0)
	var hel: int = pct.call(GameData.HEL_MARK_DMG)
	var hel_foe: int = pct.call(GameData.HEL_MARK_FOE_DMG)
	var feather: int = pct.call(GameData.FEATHER_HP)
	var feather_foe: int = pct.call(GameData.FEATHER_FOE_HP)

	var ob: = _karma_card(row, true, tr("Elegir este camino"), tr("Hacia Niflheim"), tr("La balanza baja hacia Niflheim"), 
		[[UiKit.skill_icon("over_thrust"), tr("Marca de Hel: +%d%% de daño") % hel, true, 
				tr("Marca de Hel: +%d%% de daño, se guarda en tu build") % hel], 
			[UiKit.skill_icon("blessing"), tr("+1 nivel completo"), false, ""]], 
		[[_karma_icon("status_icons", "bleed"), tr("−25% de vida"), false, ""], 
			[UiKit.skill_icon("provoke"), tr("Monstruos: +%d%% de daño") % hel_foe, false, 
				tr("Los monstruos pegan +%d%% el resto de la partida") % hel_foe]], 
		func(): pick.call(on_open, "dark"))
	_karma_card(row, false, tr("Elegir este camino"), tr("Hacia Valhalla"), tr("La balanza sube hacia Valhalla"), 
		[[UiKit.skill_icon("heal"), tr("Pluma de Valquiria: +%d%% de vida y regeneración") % feather, true, 
				tr("Pluma de Valquiria: +%d%% de vida y regeneración, se guarda en tu build") % feather], 
			[UiKit.skill_icon("blessing"), tr("+1 nivel completo"), false, ""]], 
		[[UiKit.skill_icon("endure"), tr("Monstruos: +%d%% de vida") % feather_foe, false, 
			tr("Los monstruos tienen +%d%% de vida el resto de la partida") % feather_foe]], 
		func(): pick.call(on_purify, "light"))




	var auto: = HBoxContainer.new()
	auto.alignment = BoxContainer.ALIGNMENT_END
	auto.add_theme_constant_override("separation", 5)
	body.add_child(auto)
	body.move_child(auto, 0)
	auto.add_child(_ro_text(tr("Los próximos cofres de este mapa:"), 9, Color(0.28, 0.3, 0.4)))
	var segs: = _opt_segments(corrupt_auto_opts(), "random" if world.corrupt_auto == "random" else "", func(v):
		world.corrupt_auto = str(v)
		world.play_sound("ui_click", 0.05, -6.0))
	for sb: Button in segs.find_children("*", "Button", true, false):
		sb.add_theme_font_size_override("font_size", 10)
		sb.custom_minimum_size.y = 20
	auto.add_child(segs)
	(auto.get_child(0) as Control).size_flags_vertical = Control.SIZE_SHRINK_CENTER

	head.custom_minimum_size.y = 104
	ob.grab_focus.call_deferred()




func corrupt_auto_opts() -> Array:
	return [[tr("El camino que elija"), ""], [tr("Al azar"), "random"]]



func corrupt_auto() -> int:
	match world.corrupt_auto:
		"dark":
			return 1
		"light":
			return 0
		"random":
			return randi() % 2
	return -1






func _karma_card(row: HBoxContainer, dark: bool, title: String, way: String, way_tip: String, 
		gains: Array, costs: Array, on_pick: Callable) -> Button:
	var ink: Color = Color(0.62, 0.1, 0.16) if dark else Color(0.2, 0.36, 0.72)
	var card: = PanelContainer.new()
	card.size_flags_horizontal = Control.SIZE_EXPAND_FILL
	card.mouse_filter = Control.MOUSE_FILTER_PASS
	card.mouse_default_cursor_shape = Control.CURSOR_POINTING_HAND
	var cb: = StyleBoxFlat.new()
	cb.bg_color = Color(1.0, 0.975, 0.97) if dark else Color(0.965, 0.978, 1.0)
	cb.border_color = Color(ink, 0.4)
	cb.set_border_width_all(1)
	cb.set_corner_radius_all(6)
