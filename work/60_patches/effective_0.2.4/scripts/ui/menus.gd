	var from: = str(r.from)
	var to: = str(r.to)
	var n: = int(r.n)
	var have: = Save.material(from)
	var can: = have / n
	var hd: = str(GameData.MATERIALS[to].kind) == "hd"
	var ink: = Color(0.72, 0.42, 0.95) if hd else Color(0.3, 0.58, 0.95)
	var card: = PanelContainer.new()
	var box: = StyleBoxFlat.new()
	box.bg_color = Color(0.97, 0.95, 1.0) if hd else Color(0.95, 0.97, 1.0)
	box.border_color = ink if can > 0 else Color(0.78, 0.8, 0.86)
	box.set_border_width_all(2 if can > 0 else 1)
	box.set_corner_radius_all(10)
	box.set_content_margin_all(8)
	if can > 0:
		box.shadow_color = Color(ink, 0.25)
		box.shadow_size = 4
	card.add_theme_stylebox_override("panel", box)
	card.custom_minimum_size.x = 228
	grid.add_child(card)
	var col: = VBoxContainer.new()
	col.add_theme_constant_override("separation", 5)
	card.add_child(col)

	var row: = HBoxContainer.new()
	row.alignment = BoxContainer.ALIGNMENT_CENTER
	row.add_theme_constant_override("separation", 8)
	col.add_child(row)
