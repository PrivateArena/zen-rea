func _mods_text(mods: Dictionary) -> String:
	var names: = {"dmg": tr("%+d%% daño"), "max_hp_pct": tr("%+d%% vida máx."), "armor": tr("%+.1f defensa"), 
		"dodge": tr("%+d%% evasión"), "move": tr("%+d%% velocidad"), "haste": tr("-%d%% recarga"), 
		"crit": tr("%+d%% crítico"), "regen": tr("%+.1f vida/s"), "aspd": tr("%+d%% vel. de ataque"), 
		"max_hp": tr("%+d vida"), "area": tr("%+d%% área"), "xp": tr("%+d%% EXP"), "loot": tr("%+d%% zeny"), 
		"skill_dmg": tr("%+d%% daño de habilidades"), "basic_dmg": tr("%+d%% daño básico"), 
		"magnet": tr("%+d%% imán"), "crit_dmg": tr("%+d%% daño crítico"), 

		"stance": tr("%+d%% prob. de posturas"), "sprint": tr("×%s daño de Flying Side Kick"), 
		"vs_boss": tr("%+d%% daño a jefes y élites"), "kick_fury": tr("%+.1f%% daño por patada en racha"), 

		"vs_mvp": tr("%+d%% daño a MVP"), "all_pct": tr("%+d%% a todos los atributos"), 
		"str_pct": tr("%+d%% STR"), "agi_pct": tr("%+d%% AGI"), "vit_pct": tr("%+d%% VIT"), 
		"int_pct": tr("%+d%% INT"), "dex_pct": tr("%+d%% DEX"), "luk_pct": tr("%+d%% LUK"), 
		"tower_dmg": tr("%+.1f%% daño por cada 10 pisos de tu récord en la torre"), 
		"tower_hp": tr("%+.1f%% vida máx. por cada 10 pisos de tu récord en la torre")}
	var pct: = ["dmg", "max_hp_pct", "dodge", "move", "haste", "crit", "aspd", "area", "xp", "loot", 
		"skill_dmg", "basic_dmg", "magnet", "crit_dmg", "vs_mvp", "all_pct", "str_pct", "agi_pct", "vit_pct", 
		"int_pct", "dex_pct", "luk_pct", "stance", "sprint", "vs_boss"]
	var parts: Array[String] = []
	for k in mods:
		if not names.has(k):
			continue
		var v: float = mods[k] * (100.0 if k in pct or k in ["tower_dmg", "tower_hp", "kick_fury"] else 1.0)
		if absf(v) < 0.05:
			continue
		if k == "haste" and v < 0.0:
			parts.append(tr("+%d%% recarga") % roundi( - v))
			continue

		if k == "sprint":
			parts.append(names[k] %str(snappedf(1.0 + float(mods[k]), 0.01)))
			continue

		if k in ["tower_dmg", "tower_hp"]:
			var top: = Save.tower_top()

			var counted: = mini(top, GameData.TOWER_GEAR_TOP)
			parts.append(names[k] %v + " " + tr("(ahora %+.1f%%, récord piso %d)") % [v * float(counted / GameData.TOWER_TIER_FLOORS), top]
				+ (" " + tr("(máximo al piso %d)") % GameData.TOWER_GEAR_TOP if top >= GameData.TOWER_GEAR_TOP else ""))
			continue
		parts.append(names[k] %(roundi(v) if k in pct or k == "max_hp" else v))
	return ", ".join(parts) if not parts.is_empty() else "-"





func _delta_row(new: Dictionary, old: Dictionary, font: = 10, width: = 0.0) -> Control:
	var row: = HFlowContainer.new()
	row.add_theme_constant_override("h_separation", 0)
	row.add_theme_constant_override("v_separation", 0)
	row.mouse_filter = Control.MOUSE_FILTER_IGNORE
	if width > 0.0:
		row.custom_minimum_size.x = width
	row.add_child(_ro_text((tr("Cambio: %s") % "").strip_edges() + " ", font, Color(0.3, 0.32, 0.4), true))
	var d: = _mods_delta(new, old)
	var parts: = []
	for k in d:
		var t: = _mods_text({k: d[k]})
		if t != "-":
			parts.append([t, float(d[k]) >= 0.0])
	if parts.is_empty():
		row.add_child(_ro_text("-", font, Color(0.3, 0.32, 0.4), true))
	for i in parts.size():
		row.add_child(_ro_text(str(parts[i][0]) + (", " if i < parts.size() - 1 else ""), font, 
			Color(0.15, 0.5, 0.2) if parts[i][1] else Color(0.78, 0.18, 0.15), true))
	return row



func _ro_overlay(title: String, width: float) -> VBoxContainer:
	_clear()
	if world != null:
		world.hud.clear_announce()
	_root.mouse_filter = Control.MOUSE_FILTER_STOP
	_root.add_child(UiKit.backdrop(0.35))
	var win: = UiStyles.ro_window(title, UiKit.FONT_TITLE)
	var root: Control = win.root
	root.custom_minimum_size.x = width
	_root.add_child(root)
	_ro_window_root = root
	_ro_window_title = title
	_layout_ro_window.call_deferred()
	return win.body



