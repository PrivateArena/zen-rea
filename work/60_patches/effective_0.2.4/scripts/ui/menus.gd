func _cosmetic_picture(id: String, body_key: String, look: Dictionary) -> Texture2D:
	var d: Dictionary = GameData.COSMETICS[id]
	var key: = Equipment.cosmetic_robe(id, body_key) if str(d.slot) == "back" else Equipment.cosmetic_view(id)
	if key == "":
		return null
	if str(look.get("gender", "m")) == "f" and RoAssets.has_sprite(key + "_f"):
		key += "_f"
	if _cosmetic_pics.has(key):
		return _cosmetic_pics[key]
	var spr: = RoAssets.sprite([key])
	var tex: Texture2D = null

	var img: Image = spr.compose_image(0, 0) if spr != null and spr.frame_count(0) > 0 else null
	if img != null:
		var used: = img.get_used_rect()
		if used.size.x > 0 and used.size.y > 0:
			tex = ImageTexture.create_from_image(img.get_region(used))
	_cosmetic_pics[key] = tex
	return tex
