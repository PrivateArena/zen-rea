func _reset_confirm() -> void :
	var win: = _options_window(tr("Borrar mi progreso"))
	var body: VBoxContainer = win.body
	var red: = Color(0.7, 0.12, 0.1)
	var word: = tr("BORRAR")
	body.add_child(_ro_text(tr("Última confirmación: escribe %s para borrar todo.") % word, 12, red, true))
	var edit: = LineEdit.new()
	edit.placeholder_text = word
	edit.custom_minimum_size = Vector2(200, 24)
	edit.size_flags_horizontal = Control.SIZE_SHRINK_CENTER
	edit.add_theme_font_override("font", UiKit.FONT_BODY)
	edit.add_theme_font_size_override("font_size", 13)
	body.add_child(edit)
	var footer: = HBoxContainer.new()
	footer.alignment = BoxContainer.ALIGNMENT_END
	footer.add_theme_constant_override("separation", 6)
	body.add_child(footer)
	footer.add_child(_ro_button(tr("Cancelar"), show_options))
	var go: = _ro_button(tr("Borrar para siempre"), func(): pass)
	go.disabled = true
	go.add_theme_color_override("font_color", red)
	footer.add_child(go)
	edit.text_changed.connect( func(t: String): go.disabled = t.strip_edges().to_upper() != word.to_upper())
	go.pressed.connect( func():
		if go.disabled:
			return
		RunSave.clear()
		Save.reset_progress()
		close_options()
		get_tree().paused = false

		get_tree().reload_current_scene())
	edit.text_submitted.connect( func(_t: String):
		if not go.disabled:
			go.pressed.emit())
	edit.grab_focus.call_deferred()



