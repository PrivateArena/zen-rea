	var btns: = HBoxContainer.new()
	btns.alignment = BoxContainer.ALIGNMENT_CENTER
	btns.add_theme_constant_override("separation", 4)
	col.add_child(btns)
	var one: = _ro_button("x1", func(): _transmute(index, 1), can >= 1)
	btns.add_child(one)
	btns.add_child(_ro_button("x10", func(): _transmute(index, 10), can >= 10))
	btns.add_child(_ro_button("x100", func(): _transmute(index, 100), can >= 100))
	btns.add_child(_ro_button(tr("Todo (%d)") % can, func(): _transmute(index, can), can >= 1))
	_tm_refs[index] = {"card": card, "box": box, "input": input, "crucible": crucible, "from": from, "to": to, "ink": ink}
	return one




