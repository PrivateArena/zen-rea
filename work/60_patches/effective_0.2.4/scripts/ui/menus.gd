func _trade_refresh_later() -> void :
	_tr_refresh_queued = false
	if _mode == "trade" and trade != null and trade.state == "open" and _tr_left != null and is_instance_valid(_tr_left):
		_trade_refresh()


func _trade_setup() -> void :
	if trade != null or world == null or world.net == null:
		return
	trade = Trade.new(world)
	trade.changed.connect(_trade_changed)
	trade.ended.connect(_trade_ended)




func show_trade_menu(id: int, at: Vector2) -> void :
	_trade_setup()
	if trade == null or not trade.can_trade():
		return
	var ch: TownChannel = world.channel
	var menu: = PopupMenu.new()
	menu.add_item(tr("Comerciar con %s") % trade.name_of(id), 0)
	menu.set_item_disabled(0, trade.active())
	if id < 0:
		menu.add_item(tr("Invitar a party"), 1)
		var why: = ""
		if ch.in_my_party( - id):
			why = tr("Ya está en tu party")
		elif world.net.is_client():
			why = tr("Solo el líder invita")
		elif str(ch.members.get( - id, {}).get("room", "")) != "":
			why = tr("Ya tiene party")
		elif world.net.roster.size() >= TownChannel.PARTY_MAX:
			why = tr("Tu party está llena")
		if why != "":
			menu.set_item_disabled(1, true)
			menu.set_item_tooltip(1, why)
			menu.set_item_text(1, "%s  (%s)" % [tr("Invitar a party"), why])
		menu.add_item(tr("Ver equipo"), 2)
		menu.add_item(tr("Susurrar"), 3)

		menu.add_item(tr("Agregar a amigos"), 5)
		if str(ch.members.get( - id, {}).get("ft", "")) == "":
			menu.set_item_disabled(menu.get_item_index(5), true)
			menu.set_item_tooltip(menu.get_item_index(5), tr("Su juego aún no tiene amigos (necesita actualizarse)"))

		if Save.is_dev():
			menu.add_item(tr("Expulsar del canal"), 4)
	_root.add_child(menu)
	menu.id_pressed.connect( func(i: int):
		if i == 0:
			trade.ask(id)
		elif i == 1:
			ch.invite_async( - id)
		elif i == 2:
			_ask_gear( - id)
		elif i == 4:
			ch.kick( - id)
		elif i == 5:
			_friend_from_town( - id)
		elif world.town != null:
			world.town.open_chat("/w %s " % ch.name_of( - id)))
	menu.popup_hide.connect(menu.queue_free)
	menu.popup(Rect2i(Vector2i(at), Vector2i.ZERO))



func _ask_gear(id: int) -> void :
	var ch: TownChannel = world.channel
	var got: = [null]
	var take: = func(from: int, data: Array):
		if from == id:
			got[0] = data
	ch.gear_in.connect(take)
	ch.ask_gear(id)
	for i in 40:
		if got[0] != null:
			break
		await get_tree().create_timer(0.1, true, false, true).timeout
	ch.gear_in.disconnect(take)
	if got[0] == null:
		ch.log_line("sys", tr("%s no respondió.") % ch.name_of(id))
	elif _mode == "town":
		show_player_gear(ch.name_of(id), got[0])






