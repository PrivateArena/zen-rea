func _web_fetch(keys: Array, bar: Range, tw: Tween, view: Vector2) -> void :
	var packs: Node = world.web.packs
	var need: Array = packs.missing(keys + packs.LATE_NEEDED + world.web_own_late())
	if need.is_empty():
		return
	if tw != null and tw.is_valid():
		tw.kill()
	var total: = float(packs.size_of(need))
	var note: = UiKit.label("", 13, Color(1, 1, 1, 0.9), true)
	note.add_theme_color_override("font_outline_color", Color(0, 0, 0, 0.8))
	note.add_theme_constant_override("outline_size", 4)
	note.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER
	note.size = Vector2(view.x, 20)
	note.position = Vector2(0, bar.position.y - 26)
	_root.add_child(note)
	var show_it: = func(done: int, _all: int):
		if is_instance_valid(bar):
			bar.value = 80.0 * done / maxf(1.0, total)
		if is_instance_valid(note):
			note.text = tr("Descargando: %.1f / %.1f MB") % [done / 1000000.0, total / 1000000.0]
	show_it.call(0, 0)
	packs.progress.connect(show_it)
	while not await packs.ensure(need):
		if is_instance_valid(note):
			note.text = tr("No se pudo descargar. Reintentando...")
		await get_tree().create_timer(3.0, true, false, true).timeout
	packs.progress.disconnect(show_it)
	if is_instance_valid(note):
		note.queue_free()
	if is_instance_valid(bar):
		bar.value = 85.0





