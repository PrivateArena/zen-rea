func _rarity_frame(card: Button, rarity: int, evolve: bool) -> void :
	if rarity == 0 and not evolve:

		var plain: = UiKit.panel_box(Color.WHITE, Color(0.74, 0.79, 0.9), 12, 2)
		plain.shadow_color = Color(0.1, 0.15, 0.35, 0.18)
		plain.shadow_size = 5
		plain.shadow_offset = Vector2(0, 3)
		var lit: = UiKit.panel_box(Color.WHITE, UiKit.GOLD, 12, 2)
		lit.shadow_color = Color(UiKit.GOLD, 0.45)
		lit.shadow_size = 12
		lit.shadow_offset = Vector2(0, 3)
		card.add_theme_stylebox_override("normal", plain)
		for st in ["hover", "focus", "pressed"]:
			card.add_theme_stylebox_override(st, lit)
		return
	var col: Color = GameData.LEGENDARY_COLOR if evolve else GameData.CHOICE_RARITY[rarity].color
	var bg: = Color.WHITE.lerp(col, 0.04)
	var normal: = UiKit.panel_box(bg, col, 12, 2 if rarity < 2 else 3)
	normal.shadow_color = Color(col, 0.35 if rarity >= 2 else 0.25)
	normal.shadow_size = 5 + rarity * 2
	normal.shadow_offset = Vector2(0, 3)
	var hover: = UiKit.panel_box(Color.WHITE.lerp(col, 0.08), col.lightened(0.1), 12, 3)
	hover.shadow_color = Color(col, 0.6)
	hover.shadow_size = 9 + rarity * 2
	hover.shadow_offset = Vector2(0, 3)
	card.add_theme_stylebox_override("normal", normal)
	for st in ["hover", "focus", "pressed"]:
		card.add_theme_stylebox_override(st, hover)
	if rarity >= 2 or evolve:

		var tw: = card.create_tween().set_pause_mode(Tween.TWEEN_PAUSE_PROCESS).set_loops()
		tw.tween_method( func(v: float): normal.shadow_size = int(v), 5.0 + rarity * 2.0, 9.0 + rarity * 3.0, 0.7).set_trans(Tween.TRANS_SINE)
		tw.tween_method( func(v: float): normal.shadow_size = int(v), 9.0 + rarity * 3.0, 5.0 + rarity * 2.0, 0.7).set_trans(Tween.TRANS_SINE)
	if rarity >= 3 or evolve:

		var shine: = ColorRect.new()
		shine.mouse_filter = Control.MOUSE_FILTER_IGNORE
		shine.color = Color(1, 1, 1, 0.0)
		var mat: = ShaderMaterial.new()
		var sh: = Shader.new()
		sh.code = "shader_type canvas_item;\nuniform float t = 0.0;\nuniform vec4 tint : source_color = vec4(1.0, 0.9, 0.6, 1.0);\nvoid fragment() {\n\tfloat d = abs((UV.x + UV.y * 0.6) - t);\n\tfloat a = smoothstep(0.12, 0.0, d) * 0.35;\n\tCOLOR = vec4(tint.rgb, a);\n}"







		mat.shader = sh
		mat.set_shader_parameter("tint", col.lightened(0.5))
		shine.material = mat
		shine.set_anchors_and_offsets_preset(Control.PRESET_FULL_RECT)
		card.add_child(shine)
		var sw: = shine.create_tween().set_pause_mode(Tween.TWEEN_PAUSE_PROCESS).set_loops()
		sw.tween_method( func(v: float): mat.set_shader_parameter("t", v), -0.3, 1.9, 1.6)
		sw.tween_interval(0.6)





func _level_track(choice: Dictionary, accent: Color, room: = 200.0) -> VBoxContainer:
	var stat: bool = choice.kind == "stat"
	var id: = str(choice.id)
	var cap: int = (int(world.player.stat_cap) if world.player != null else GameData.MAX_STAT) if stat else GameData.skill_cap(id)
	var to: = int(choice.level)
	var from: = int(choice.get("from", to - 1))


	var shown_from: = from
	var shown_to: = to
	if stat and world != null and world.player != null:
		var base: = int(world.player.base_stats.get(id, 0))
		from = maxi(0, from - base)
		to = maxi(0, to - base)
	var box: = VBoxContainer.new()
	box.add_theme_constant_override("separation", 3)
	box.mouse_filter = Control.MOUSE_FILTER_IGNORE
	var step: = float(GameData.SKILLS[id].get("over_step", GameData.OVERLEVEL_STEP)) * 100.0 if not stat else 0.0



	var gain: = func(a: int, b: int) -> String:
		var v: = snappedf(step * (GameData.overlevel_steps(maxi(0, b - cap)) - GameData.overlevel_steps(maxi(0, a - cap))), 0.1)
		return str(roundi(v)) if is_equal_approx(v, roundf(v)) else str(v)
	if not stat and cap <= 1:

		var only: = UiKit.label(tr("Cada mejora: +%s%% de poder") % gain.call(from, to), 12, accent.darkened(0.2), true)
		only.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER

		only.autowrap_mode = TextServer.AUTOWRAP_WORD_SMART
		only.custom_minimum_size.x = 150
		box.add_child(only)
		if true:
			var dim: = UiKit.label(_overlevel_note(cap), 11, UiKit.MUTED)
			dim.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER
			dim.autowrap_mode = TextServer.AUTOWRAP_WORD_SMART
			dim.custom_minimum_size.x = 150
			box.add_child(dim)
		return box
	var row: = HBoxContainer.new()
	row.alignment = BoxContainer.ALIGNMENT_CENTER


	var gap: = 3 if cap <= 12 else 2
	row.add_theme_constant_override("separation", gap)
	row.mouse_filter = Control.MOUSE_FILTER_IGNORE
	box.add_child(row)
	var extra_w: = 34.0 if to > cap else 0.0
	var pip_w: = minf(16.0 if cap <= 5 else 11.0, floorf((room - extra_w - gap * (cap - 1)) / maxf(1.0, cap)))
	pip_w = maxf(4.0, pip_w)
	for i in cap:
		var pip: = PanelContainer.new()
		var s: = StyleBoxFlat.new()
		s.set_corner_radius_all(3)
		if i < mini(from, cap):
			s.bg_color = accent.darkened(0.15)
		elif i < mini(to, cap):

			s.bg_color = accent.lightened(0.35)
			s.set_border_width_all(1)
			s.border_color = Color.WHITE
			s.shadow_color = Color(accent, 0.7)
			s.shadow_size = 4
			var tw: = pip.create_tween().set_pause_mode(Tween.TWEEN_PAUSE_PROCESS).set_loops()
			tw.tween_property(pip, "modulate", Color(1.35, 1.35, 1.35), 0.45).set_trans(Tween.TRANS_SINE)
			tw.tween_property(pip, "modulate", Color.WHITE, 0.45).set_trans(Tween.TRANS_SINE)
		else:
			s.bg_color = Color(0.1, 0.15, 0.35, 0.12)
			s.set_border_width_all(1)
			s.border_color = Color(0.1, 0.15, 0.35, 0.18)
		pip.add_theme_stylebox_override("panel", s)
		pip.custom_minimum_size = Vector2(pip_w, 8)
		pip.mouse_filter = Control.MOUSE_FILTER_IGNORE
		row.add_child(pip)
	if to > cap:
		var extra: = UiKit.label("★+%d" % (to - maxi(from, cap)), 12, accent.darkened(0.1), true)
		extra.size_flags_vertical = Control.SIZE_SHRINK_CENTER
		row.add_child(extra)
	var line: = ""
	var hint: = ""
	if stat:
		line = tr("%s  %d → %d") % [tr(str(GameData.STATS[id].name)), shown_from, shown_to]
	elif to <= cap:
		line = tr("Nivel %d → %d  de %d") % [from, to, cap]
	else:


		line = tr("Nivel %d → %d (máx. %d)  ·  +%s%% de poder") % [from, to, cap, gain.call(maxi(from, cap), to)]
	if stat and id == "luk" and world.player != null and world.player.crit >= 1.0:

		hint = tr("Crítico al 100%: cada punto suma daño crítico")
	elif stat:
		if to < cap:
			hint = tr("Puede volver a salir hasta %d") % cap
		elif to == cap:
			hint = tr("¡Atributo al máximo!")
	elif to < cap:
		hint = tr("Puede volver a salir: sube hasta Nv %d") % cap
	elif from < cap and GameData.EVOLUTIONS.has(id):
		var pas: = str(GameData.EVOLUTIONS[id].passive)
		hint = tr("¡Nivel máximo! Ya puedes evolucionarla") if world.player.skills.has(pas)\
		else tr("¡Nivel máximo! Evoluciona si aprendes la pasiva %s") % tr(str(GameData.SKILLS[pas].name))
	elif from < cap:
		hint = tr("¡Nivel máximo! Después solo sube su poder")
	elif to > cap:


		hint = _overlevel_note(cap)
	else:

		hint = ""
	var l: = UiKit.label(line, 12, UiKit.TEXT, true)
	l.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER
	l.autowrap_mode = TextServer.AUTOWRAP_WORD_SMART
	l.custom_minimum_size.x = 150
	box.add_child(l)
	var h: = UiKit.label(hint, 11, accent.darkened(0.25) if to >= cap else UiKit.MUTED)
	h.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER
	h.autowrap_mode = TextServer.AUTOWRAP_WORD_SMART
	h.custom_minimum_size.x = 150
	h.visible = hint != ""
	box.add_child(h)
	return box





func _overlevel_note(cap: int) -> String:


	var shown: = cap + 9 if cap <= 1 else cap
	return tr("Pasado el Nv %d cada nivel rinde la mitad, y pasado el Nv %d un cuarto") % [shown + GameData.OVERLEVEL_FULL, shown + GameData.OVERLEVEL_HALF]




var _start_done: Callable









func show_start_skill(options: Array, done: Callable, title: = "", key: = "", fallback: = "", passives: Array = [], 
		subtitle: = "", cancel: = Callable(), notes: = {}) -> void :
	_mode = "start_skill"
	_start_notes = notes
	_choices = options + passives
	_start_done = done
	_start_cancel = cancel
	world.hold_world()
	_grace = INPUT_GRACE
	var p: = world.player
	var last: = str(Save.setting(key if key != "" else "start_skill_" + p.class_id, fallback if fallback != "" else p.start_skill()))
	var total: = _choices.size()
	var col: = _screen(title if title != "" else tr("Elige tu habilidad inicial"), subtitle if subtitle != "" else
		(tr("Una habilidad o una pasiva: el resto puede salir al subir de nivel") if not passives.is_empty()
			else tr("Las demás pueden salir al subir de nivel")))
	_bounce_in(col.get_parent().get_parent())
	_cards.clear()


	var room: = _view_width() - 120.0
	var rows: = 1 if options.size() <= 7 else 2
	var per_row: = ceili(options.size() / float(rows))
	var compact: = rows > 1 or not passives.is_empty()
	var card_w: = clampf(room / float(maxi(3, per_row)) - 12.0, 116.0, 220.0)



	var crowded: = _choices.size() > 11
	var holder: VBoxContainer = col
	if crowded:
		card_w = 150.0
		var per: = maxi(1, floori(room / (card_w + 12.0)))
		var lines: = ceili(options.size() / float(per)) + (ceili(passives.size() / float(per)) if not passives.is_empty() else 0)
		var needed: = lines * 150.0 + (34.0 if not passives.is_empty() else 0.0)
		var scroll: = ScrollContainer.new()
		scroll.horizontal_scroll_mode = ScrollContainer.SCROLL_MODE_DISABLED
		scroll.custom_minimum_size = Vector2(_view_width() - 96.0, minf(needed, get_viewport().get_visible_rect().size.y - 260.0))
		col.add_child(scroll)
		holder = VBoxContainer.new()
		holder.add_theme_constant_override("separation", 10)
		holder.size_flags_horizontal = Control.SIZE_EXPAND_FILL
		scroll.add_child(holder)
	var skill_cards: = _start_row(holder, options, 0, card_w, compact, last, crowded)
	var passive_cards: Array = []
	if not passives.is_empty():

		var label: = UiKit.label(tr("Pasivas") if not _start_notes.is_empty() else tr("o empieza con una pasiva"), 14, UiKit.MUTED, true)
		label.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER
		holder.add_child(label)
		var pw: = card_w if crowded else clampf(room / float(maxi(4, passives.size())) - 12.0, 120.0, 190.0)


		passive_cards = _start_row(holder, passives, options.size(), pw, true, last, crowded or rows > 1 or options.size() > 4)
	var fit: = func(cards: Array):
		var tallest: = 0.0
		for c in cards:
			if not is_instance_valid(c):
				continue

			for k in c.get_children():
				if k is MarginContainer:
					tallest = maxf(tallest, (k as Control).get_combined_minimum_size().y)
		for c in cards:
			if is_instance_valid(c):
				c.custom_minimum_size.y = tallest
	fit.call_deferred(skill_cards)
	fit.call_deferred(passive_cards)
	if cancel.is_valid():
		var out: = _ro_button(tr("No olvidar nada  (Esc)"), _cancel_start)
		out.size_flags_horizontal = Control.SIZE_SHRINK_CENTER
		col.add_child(out)
	var focus: Button = null
	for c in _cards:
		if str(c.get_meta("skill_id", "")) == last:
			focus = c
	if focus == null and not _cards.is_empty():
		focus = _cards[0]
	if focus != null:
		focus.grab_focus.call_deferred()
	if showcase:
		var tw: = create_tween().set_pause_mode(Tween.TWEEN_PAUSE_PROCESS)
		tw.tween_interval(1.0)
		tw.tween_callback( func(): _pick_start(_choices.find(last) if _choices.has(last) else 0))




func _start_row(col: VBoxContainer, ids: Array, first: int, card_w: float, compact: bool, last: String, mini: = false) -> Array:
	var row: = HFlowContainer.new()
	row.alignment = FlowContainer.ALIGNMENT_CENTER
	row.add_theme_constant_override("h_separation", 12)
	row.add_theme_constant_override("v_separation", 12)
	row.custom_minimum_size.x = minf(_view_width() - 100.0, (card_w + 12.0) * ids.size())
	col.add_child(row)
	var cards: = []
	for j in ids.size():
		var i: = first + j
		var id: String = ids[j]
		var card: = _start_card(id, i, card_w, id == last, compact, mini)
		card.set_meta("skill_id", id)
		row.add_child(card)
		_cards.append(card)
		cards.append(card)
		card.modulate.a = 0.0
		var tw: = card.create_tween().set_pause_mode(Tween.TWEEN_PAUSE_PROCESS)
		tw.tween_interval(0.1 + 0.05 * i)
		tw.tween_callback( func():
			card.position.y += 30.0
			world.play_sound("ui_click", 0.0, -12.0))
		tw.tween_property(card, "modulate:a", 1.0, 0.16)
		tw.parallel().tween_property(card, "position:y", -30.0, 0.22).as_relative()\
		.set_trans(Tween.TRANS_BACK).set_ease(Tween.EASE_OUT)
	return cards




func _start_card(id: String, index: int, width: float, last: bool, compact: = false, mini: = false) -> Button:
	var sk: Dictionary = GameData.SKILLS[id]
	var accent: Color = sk.get("color", UiKit.GOLD)
	var card: = _card_button(width, 90.0 if mini else (150.0 if compact else 220.0), UiKit.GOLD)


	_rarity_frame(card, 0, false)
	var band_col: = GameData.LEGENDARY_COLOR if last else Color(0.45, 0.55, 0.8)
	_card_band(card, band_col, 32.0 if compact else 74.0, 2)
	card.pressed.connect( func(): _pick_start(index))
	card.focus_entered.connect( func():
		if _mode == "start_skill":
			ui_nav())
	var col: = _card_column(card)

	col.alignment = BoxContainer.ALIGNMENT_BEGIN
	var top: = _lvl_chip(tr("ÚLTIMA ELEGIDA") if last else " ", GameData.LEGENDARY_COLOR if last else Color(0, 0, 0, 0), last, 11)
	if not last:
		top.modulate.a = 0.0
	top.size_flags_horizontal = Control.SIZE_SHRINK_CENTER
	if compact:

		col.add_theme_constant_override("separation", 4)
		var margin: = col.get_parent() as MarginContainer
