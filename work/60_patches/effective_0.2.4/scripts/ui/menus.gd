func _screen(title: String, subtitle: String, _title_color: = UiKit.GOLD) -> VBoxContainer:
	_clear()
	if world != null:
		world.hud.clear_announce()
	_root.mouse_filter = Control.MOUSE_FILTER_STOP
	_root.add_child(UiKit.backdrop(0.5))
	var center: = CenterContainer.new()
	center.set_anchors_and_offsets_preset(Control.PRESET_FULL_RECT)
	_root.add_child(center)
	var window: = VBoxContainer.new()
	window.add_theme_constant_override("separation", 0)
	center.add_child(window)
	window.add_child(UiKit.soft_title(title, 17))
	var body_panel: = PanelContainer.new()
	var box: = UiKit.soft_body(18)
	body_panel.add_theme_stylebox_override("panel", box)
	window.add_child(body_panel)
	var col: = VBoxContainer.new()
	col.add_theme_constant_override("separation", 12)
	col.alignment = BoxContainer.ALIGNMENT_CENTER
	body_panel.add_child(col)
	if subtitle != "":
		var s: = UiKit.label(subtitle, 14, UiKit.MUTED)
		s.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER
		col.add_child(s)
	_pop_in(window)
	return col


func _pop_in(node: Control) -> void :
	node.modulate.a = 0.0
	var tw: = node.create_tween().set_pause_mode(Tween.TWEEN_PAUSE_PROCESS)
	tw.tween_property(node, "modulate:a", 1.0, 0.18)
	_fit_window.call_deferred(node)

	for t in [0.1, 0.3, 0.6]:
		get_tree().create_timer(t, true, false, true).timeout.connect(_fit_window.bind(node))
	node.resized.connect( func(): _fit_window.call_deferred(node))





func _fit_window(win) -> void :

	if not is_instance_valid(win) or not win is Control or not (win as Control).is_inside_tree():
		return
	var node: Control = win
	var view: = get_viewport().get_visible_rect().size
	var need: = node.get_combined_minimum_size().max(node.size)
	var k: = minf(1.0, minf((view.y - 12.0) / maxf(1.0, need.y), (view.x - 12.0) / maxf(1.0, need.x)))


	var box: Control = node.get_parent() if node.get_parent() is CenterContainer else node
	box.pivot_offset = Vector2(box.size.x * 0.5, box.size.y * 0.5 if need.y <= view.y else 6.0 / maxf(0.01, 1.0 - k))
	box.scale = Vector2(k, k)


func _view_width() -> float:
	return get_viewport().get_visible_rect().size.x







