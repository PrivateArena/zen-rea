		Save.remove_from_storage(uid)
		Save.add_zeny(z)
		if world != null:
			world.play_sound("get_coin", 0.0, -4.0)
		w.shut.call()
		done.call())
	_float_show(w, cancel)





func _link_tower_snap(it: Dictionary, uid: String) -> void :
	var slot: = str(it.get("_slot", ""))
	if slot == "" or world == null or world.player == null or not world.player.has_meta("tower_snap"):
		return
	var snap: Dictionary = world.player.get_meta("tower_snap")
	var worn = (snap.get("slots", {}) as Dictionary).get(slot)
	if not worn is Dictionary or str(worn.get("id", "")) != str(it.get("id", "")):
		return
	if uid != "":
		worn["perm"] = true
		worn["kept_uid"] = uid
	else:
		worn.erase("perm")
		worn.erase("kept_uid")
	Save.mark_dirty()




static func _keep_tier(it: Dictionary) -> String:
	if Equipment.is_legendary(it) or Equipment.is_unique(it) or Equipment.item_def(it).get("wings", false):
		return "legend"
	return "purple" if int(it.get("slots", 0)) >= 3 else "rest"



var _keep_pending: = false

var _keep_offer: Array = []




func _left_worn_value() -> int:
	var z: = 0
	for it in _keep_offer:
		if it is Dictionary and it.get("_worn", false) and not it.get("_kept", false):
			z += Equipment.sell_price(it)
	return z



func _sell_left_worn() -> void :
	var z: = _left_worn_value()


	for it in _keep_offer:
		if it is Dictionary and not it.get("_kept", false):
			Equipment.cash_in(it)
	_keep_offer = []
	if z > 0:
		Save.add_zeny(z)
		if world != null:
			world.play_sound("throw_zeny", 0.0, -8.0)



func _end_leave(go: Callable) -> void :
	var then: = go
	go = func():
		_sell_left_worn()
		then.call()
	if not _keep_pending:
		go.call()
		return
	var shade: = UiKit.backdrop(0.55)
	shade.mouse_filter = Control.MOUSE_FILTER_STOP
	_root.add_child(shade)
	var win: = UiStyles.ro_window(tr("¿Salir sin guardar?"), UiKit.FONT_TITLE)
	var root: Control = win.root
	var say: = _ro_text(tr("Aún puedes llevarte objetos al almacén Kafra. Si sales ahora, los pierdes."), 12, Color(0.15, 0.17, 0.3))
	say.autowrap_mode = TextServer.AUTOWRAP_WORD_SMART
	say.custom_minimum_size.x = 340
	win.body.add_child(say)
	var row: = HBoxContainer.new()
	row.alignment = BoxContainer.ALIGNMENT_END
	row.add_theme_constant_override("separation", 6)
	win.body.add_child(row)
	var back: = _ro_button(tr("Volver a elegir"), func():
		shade.queue_free()
		root.queue_free())
	row.add_child(back)
	row.add_child(_ro_button(tr("Salir igual"), func():
		_keep_pending = false
		go.call()))
	_root.add_child(root)
	root.reset_size()
	var view: = get_viewport().get_visible_rect().size
	root.position = ((view - root.size) * 0.5).floor()
	back.grab_focus()


func _keep_cost(it: Dictionary) -> int:
	if Equipment.is_unique(it):
		return maxi(GameData.KEEP_COST_LEGENDARY, ceili(Save.zeny() * GameData.KEEP_ZENY_SHARE_UNIQUE))
	if Equipment.is_legendary(it):
		return maxi(GameData.KEEP_COST_LEGENDARY, ceili(Save.zeny() * GameData.KEEP_ZENY_SHARE_LEGENDARY))
	var rank: = clampi(int(Equipment.item_def(it).get("rank", 1)), 0, 3)
	return maxi(int(GameData.KEEP_COST[rank]), ceili(Save.zeny() * float(GameData.KEEP_ZENY_SHARE[rank])))



static func _class_can_use(class_id: String, it: Dictionary) -> bool:
	var d: = Equipment.item_def(it)

	if d.has("soul_of"):
		return Souls.class_uses(class_id, str(it.id))
	match str(d.slot):
		"weapon":
			return GameData.weapon_for_line(class_id, str(it.id))
		"shield":
			return class_id in GameData.SHIELD_CLASSES
	return true




var _auto_undo: = {}






func _loadout_auto_plan(class_id: String, take_others: bool) -> Dictionary:
	var pool: = Save.storage().filter( func(it): return not (it as Dictionary).is_empty() and _class_can_use(class_id, it)\
	and (take_others or Save.loadout_owner(str(it.uid)) in ["", class_id]))
	pool.sort_custom( func(a, b): return Equipment.score(a) > Equipment.score(b))
	var lo: = {}
	for it in pool:
		var kind: = Equipment.item_type(it)
		for key in (["acc1", "acc2"] if kind == "acc" else [kind]):
			if not GameData.EQUIP_SLOTS.has(key) or lo.has(key):
				continue
			if _loadout_block(class_id, it, key, lo) == "":
				lo[key] = str(it.uid)
			break

	if _hands_full(lo) and lo.has("shield"):
		lo.erase("shield")
	return lo



func _loadout_auto_taken(class_id: String, plan: Dictionary) -> Array:
	var out: = []
	for k in GameData.EQUIP_SLOTS:
		if not plan.has(k):
			continue
		var owner: = Save.loadout_owner(str(plan[k]))
		if owner != "" and owner != class_id:
			out.append({"it": Save.storage_item(str(plan[k])), "class": owner})
	return out




func _loadout_auto_apply(class_id: String, plan: Dictionary) -> int:
	var others: = {}
	for t in _loadout_auto_taken(class_id, plan):
		if not others.has(t. class ):
			others[t. class ] = Save.loadout(str(t. class )).duplicate()
	_auto_undo = {"class": class_id, "gear": Save.loadout(class_id).duplicate(), "others": others}
	for k in Save.loadout(class_id).keys():
		Save.set_loadout_slot(class_id, str(k), "")
	for k in plan:
		Save.set_loadout_slot(class_id, str(k), str(plan[k]))
	return plan.size()





