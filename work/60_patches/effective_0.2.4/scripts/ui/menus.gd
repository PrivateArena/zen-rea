func _look_icon(ro: RoSprite, looks: Array, aura: bool) -> Control:
	var rect: = TextureRect.new()
	rect.custom_minimum_size = Vector2(84, 84)
	rect.mouse_filter = Control.MOUSE_FILTER_IGNORE
	if ro == null:
		return rect
	var mini: = LookStage.new(ro, Vector2i(160, 160), 1.55, 0.84, true)
	mini.backdrop("prontera")
	mini.wear(looks, aura)
	rect.texture = mini.get_texture()
	rect.expand_mode = TextureRect.EXPAND_IGNORE_SIZE
	rect.stretch_mode = TextureRect.STRETCH_SCALE
	rect.texture_filter = CanvasItem.TEXTURE_FILTER_LINEAR
	rect.add_child(mini)
	return rect





func _aura_tile(title: String, pic: Control, got: bool, on: bool, how: String, toggle: Callable, hover: Callable) -> Control:
	var b: = Button.new()
	b.focus_mode = Control.FOCUS_NONE
	b.custom_minimum_size = Vector2(98, 132)
	var box: = StyleBoxFlat.new()
	box.bg_color = Color(1.0, 0.97, 0.86) if got and on else Color(0.97, 0.98, 1.0)
	box.border_color = Color(0.95, 0.7, 0.2) if got and on else Color(0.6, 0.64, 0.75, 0.6 if got else 0.3)
	box.set_border_width_all(2 if got and on else 1)
	box.set_corner_radius_all(5)
	for st in ["normal", "hover", "pressed", "disabled"]:
		b.add_theme_stylebox_override(st, box)
	var col: = VBoxContainer.new()
	col.set_anchors_preset(Control.PRESET_FULL_RECT)

	col.offset_top = 5
	col.mouse_filter = Control.MOUSE_FILTER_IGNORE
	col.add_theme_constant_override("separation", 1)
	b.add_child(col)
	b.clip_contents = true
	pic.size_flags_horizontal = Control.SIZE_SHRINK_CENTER
	pic.mouse_filter = Control.MOUSE_FILTER_IGNORE
	if not got:
		pic.modulate = Color(1, 1, 1, 0.4)
	col.add_child(pic)
	var name_l: = _ro_text(title, 9, Color(0.15, 0.17, 0.3) if got else Color(0.28, 0.3, 0.4), true)
	name_l.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER
	name_l.custom_minimum_size.x = 94
	col.add_child(name_l)
	UiKit.fit_dots(name_l)
	var tag: = _ro_text((tr("Visible") if on else tr("Oculto")) if got else how, 8, 
		Color(0.7, 0.48, 0.1) if got and on else Color(0.28, 0.3, 0.4))
	tag.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER
	tag.custom_minimum_size.x = 94
	col.add_child(tag)
	UiKit.fit_dots(tag)
	_set_hover(b, {"title": title, "tag": (tr("Visible") if on else tr("Oculto")) if got else tr("Bloqueado"), 
		"color": Color(0.95, 0.7, 0.2) if got else Color(0.42, 0.44, 0.52), 
		"desc": (tr("Haz clic para ocultarlo.") if on else tr("Haz clic para mostrarlo.")) if got else how})
	if got:
		b.pressed.connect(toggle)
	if hover.is_valid():
		b.mouse_entered.connect(hover)
	return b




func _show_name_look(class_id: String) -> void :
	var w: = _float_window(tr("Armario"), Callable(), 0.75)
	var body: VBoxContainer = w.body
	body.add_theme_constant_override("separation", 8)
	_closet_tabs(body, "name", w)
	var t: Node = world.titles
	var refill: = func():
		w.shut.call()
		_show_name_look(class_id)
	var sups: Array = t.supports_owned() if t != null else []
	var cur: String = t.supporter() if t != null else ""

	var sample: = HBoxContainer.new()
	sample.alignment = BoxContainer.ALIGNMENT_CENTER
	sample.add_theme_constant_override("separation", 6)
	body.add_child(sample)
	var who: = Save.char_name(class_id)
	if cur != "" and t.support_icon_on():
		sample.add_child(t.support_badge(cur, 26.0))
	sample.add_child(_ro_text(who, 20, t.support_color(cur, false) if cur != "" else Color(0.15, 0.17, 0.3), true))
	body.add_child(_ro_text(tr("Color del nombre"), 12, Color(0.12, 0.25, 0.75), true))
	var crow: = HBoxContainer.new()
	crow.add_theme_constant_override("separation", 6)
	body.add_child(crow)
	for s in t.SUPPORT + [t.SUPPORT_NONE]:
		var sid: = str(s)
		var label: String = tr("Normal") if sid == t.SUPPORT_NONE else str(t.name_of(sid))
		var b: = _ro_button(label, func():
			t.set_supporter(sid)
			ui_click()
			refill.call())
		b.custom_minimum_size = Vector2(130, 40 if touch_ui() else 32)
		if sid != t.SUPPORT_NONE:
			b.add_theme_color_override("font_color", t.support_color(sid, false))

		b.disabled = sid == cur or (sid == t.SUPPORT_NONE and cur == "") or (sid != t.SUPPORT_NONE and not sups.has(sid))
		crow.add_child(b)
	if not sups.is_empty():
		body.add_child(_ro_text(tr("Monstruo junto al nombre"), 12, Color(0.12, 0.25, 0.75), true))
		var irow: = HBoxContainer.new()
		irow.add_theme_constant_override("separation", 6)
		body.add_child(irow)
		for v in [true, false]:
			var on: = bool(v)
