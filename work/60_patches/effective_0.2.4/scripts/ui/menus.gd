		b.gui_input.connect( func(ev: InputEvent):
			if ev is InputEventMouseButton and ev.pressed and ev.button_index == MOUSE_BUTTON_RIGHT and it != null:
				_unequip(key)
				b.accept_event())
		if it != null:

			b.mouse_entered.connect( func(): _show_item_hover(it, b, true))
			b.mouse_exited.connect(_hide_item_hover)
		if key == selected:
			var sel: = StyleBoxFlat.new()
			sel.bg_color = Color(0.74, 0.81, 0.95, 0.55)
			sel.border_color = Color(0.3, 0.42, 0.78)
			sel.set_border_width_all(1)
			for st in ["normal", "hover", "pressed", "focus"]:
				b.add_theme_stylebox_override(st, sel)
		panel.add_child(b)

		var last: = int(EQUIP_ROWS[key][1]) == EQUIP_ROW_Y.size() - 1
		if last:
			y -= 3
		if it != null:

			var shade: = UiKit.icon_rect(_item_icon(Equipment.item_def(it).icon), 24)
			shade.position = Vector2((252 if right else 5), y - 11)
			shade.size = Vector2(24, 24)
			shade.modulate = Color(0.1, 0.12, 0.25, 0.45)
			panel.add_child(shade)
			var icon: = UiKit.icon_rect(_item_icon(Equipment.item_def(it).icon), 24)
			icon.position = Vector2((251 if right else 4), y - 12)
			icon.size = Vector2(24, 24)
			var g: = Equipment.grade(it)
			if g > 0:


				var halo: = UiKit.glow(Color(GameData.WEAPON_GRADES[g].color, 0.9), 40.0)
				halo.position = icon.position + Vector2(12, 12) - Vector2(20, 20)
				halo.mouse_filter = Control.MOUSE_FILTER_IGNORE
				panel.add_child(halo)
				panel.move_child(halo, shade.get_index())
			panel.add_child(icon)
			if g > 0:
				var spot: = Control.new()
				spot.mouse_filter = Control.MOUSE_FILTER_IGNORE
				spot.position = icon.position + Vector2(1, 2)
				spot.size = Vector2(24, 24)
				panel.add_child(spot)
				_grade_deco(spot, it)
			if key in ready:

				var mark: = _ro_text("+", 13, Color(1.0, 0.8, 0.2), true)
				mark.add_theme_constant_override("outline_size", 3)
				mark.add_theme_color_override("font_outline_color", Color(0.35, 0.2, 0.0))
				mark.position = icon.position + Vector2(15, -6)
				mark.tooltip_text = tr("Se puede refinar")
				panel.add_child(mark)
		elif key == "shield" and p.equipment.both_hands() != null:

			var both: = UiKit.icon_rect(_item_icon(Equipment.item_def(p.equipment.both_hands()).icon), 24)
			both.position = Vector2((251 if right else 4), y - 12)
			both.size = Vector2(24, 24)
			both.modulate.a = 0.5
			panel.add_child(both)
		var l: = _ro_text(Equipment.item_name(it) if it != null else _slot_name(key), 9, 
			Equipment.item_color(it) if it != null else Color(0.46, 0.49, 0.6))


		var font: = l.get_theme_font("font")
		var fs: = 9
		while fs > 7 and font.get_string_size(l.text, HORIZONTAL_ALIGNMENT_LEFT, -1, fs).x > 72.0:
			fs -= 1

		if it != null and Equipment.sockets(it) > 0 and font.get_string_size(l.text, HORIZONTAL_ALIGNMENT_LEFT, -1, fs).x > 72.0:
			l.text = l.text.trim_suffix(" [%d]" % Equipment.sockets(it))
			while fs < 9 and font.get_string_size(l.text, HORIZONTAL_ALIGNMENT_LEFT, -1, fs + 1).x <= 72.0:
				fs += 1
		l.add_theme_font_size_override("font_size", fs)
		UiKit.fit_dots(l)
		l.position = Vector2(176 if right else 31, y - 8 + (9 - fs) * 0.5)
		l.size = Vector2(72, 14)
		l.horizontal_alignment = HORIZONTAL_ALIGNMENT_RIGHT if right else HORIZONTAL_ALIGNMENT_LEFT
		panel.add_child(l)
		if it != null and Equipment.sockets(it) > 0:
			var pips: = _card_pips(it)
			pips.position = Vector2(248 - pips.custom_minimum_size.x if right else 31, y + 5)
			panel.add_child(pips)
	return panel




func _card_pips(it: Dictionary) -> Control:
	var box: = Control.new()
	var n: = Equipment.sockets(it)
	box.custom_minimum_size = Vector2(n * 9 - 2, 9)
	box.size = box.custom_minimum_size
	box.mouse_filter = Control.MOUSE_FILTER_PASS
	for i in n:
		var r: Control
		if i < it.cards.size():
			var card: String = it.cards[i]
			var t: = TextureRect.new()
			t.texture = RoAssets.card_art(card)
			t.expand_mode = TextureRect.EXPAND_IGNORE_SIZE
			t.stretch_mode = TextureRect.STRETCH_SCALE
			t.texture_filter = CanvasItem.TEXTURE_FILTER_LINEAR
			_set_hover(t, _card_hover(card))
			r = t
		else:
			var empty: = Panel.new()
			var st: = StyleBoxFlat.new()
			st.bg_color = Color(1, 1, 1, 0.6)
			st.border_color = Color(0.55, 0.6, 0.75)
			st.set_border_width_all(1)
			empty.add_theme_stylebox_override("panel", st)
			empty.tooltip_text = tr("[ vacío ]")
			r = empty
		r.custom_minimum_size = Vector2(7, 9)
		r.size = Vector2(7, 9)
		r.position = Vector2(i * 9, 0)
		r.mouse_filter = Control.MOUSE_FILTER_PASS
		box.add_child(r)
	return box


