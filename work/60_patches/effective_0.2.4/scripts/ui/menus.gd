func _chef_take_off(id: String) -> void :
	ui_click()
	var t: = Save.dishes()
	t.erase(id)
	Save.set_dishes(t)
	_chef_sel = id
	show_chef()





func _chef_tile(id: String, table: Array) -> Control:
	var r: Dictionary = GameData.RECIPES[id]
	var known: = Save.recipe_known(id)
	var on: = table.has(id)
	var picked: = id == _chef_sel
	var p: = PanelContainer.new()
	p.custom_minimum_size = Vector2(CHEF_TILE, CHEF_TILE)
	var rim: = Color(0.3, 0.42, 0.78) if picked else (CHEF_GOLD if on else Color(0.82, 0.83, 0.88))
	var sb: = _chef_box(Color(1.0, 0.975, 0.92) if on else (Color(1, 1, 1) if known else Color(0.94, 0.945, 0.96)), 
		rim, 9, 2 if picked or on else 1)
	p.add_theme_stylebox_override("panel", sb)
	var ic: = UiKit.icon_rect(_item_icon(str(r.icon)), 36)
	ic.size_flags_horizontal = Control.SIZE_SHRINK_CENTER
	ic.size_flags_vertical = Control.SIZE_SHRINK_CENTER
	if not known:
		ic.modulate = Color(0.15, 0.15, 0.22, 0.35)
	p.add_child(ic)
	p.tooltip_text = tr(str(r.name)) if known else "???"
	p.mouse_default_cursor_shape = Control.CURSOR_POINTING_HAND
	p.mouse_entered.connect( func(): _chef_show(id))
	p.mouse_exited.connect( func(): _chef_show(_chef_sel))
	p.gui_input.connect( func(ev: InputEvent):
		if ev is InputEventMouseButton and ev.pressed and ev.button_index == MOUSE_BUTTON_LEFT:
			if ev.double_click and known and not on and Save.dishes().size() < Save.cook_level():
				_cook(id)
			elif id != _chef_sel:
				_chef_pick(id))
	return p


func _chef_pick(id: String) -> void :
	ui_click()
	_chef_sel = id
	show_chef()




func _chef_show(id: String) -> void :
	if _chef_detail == null or not is_instance_valid(_chef_detail) or not GameData.RECIPES.has(id):
		return
	for c in _chef_detail.get_children():
		c.queue_free()
	var r: Dictionary = GameData.RECIPES[id]
	var known: = Save.recipe_known(id)
	var table: = Save.dishes()
	var on: = table.has(id)
	var row: = HBoxContainer.new()
	row.add_theme_constant_override("separation", 10)
	_chef_detail.add_child(row)
	var ic: = UiKit.icon_rect(_item_icon(str(r.icon)), 40)
	ic.size_flags_vertical = Control.SIZE_SHRINK_BEGIN
	if not known:
		ic.modulate = Color(0.15, 0.15, 0.22, 0.35)
	row.add_child(ic)
	var text: = VBoxContainer.new()
	text.add_theme_constant_override("separation", 1)
	text.size_flags_horizontal = Control.SIZE_EXPAND_FILL
	row.add_child(text)
	text.add_child(UiKit.label(tr(str(r.name)) if known else "???", 14, CHEF_INK if known else UiKit.MUTED, true))
	var d: = UiKit.label(tr(str(r.desc)) if known else tr("Se aprende en la quest de %s.") % tr(str(GameData.STAGES[str(r.quest)].name)), 12, 
		UiKit.TEXT if known else UiKit.MUTED)
	d.autowrap_mode = TextServer.AUTOWRAP_WORD_SMART
	d.custom_minimum_size.x = 250
	text.add_child(d)
	if not known:
		return
	var btn: Button
	if on:
		btn = UiKit.button(tr("Quitar"))
		btn.pressed.connect(_chef_take_off.bind(id))
	else:
		var full: = table.size() >= Save.cook_level()
		btn = UiKit.button(tr("Servir"), not full)
		btn.disabled = full
		if full:
			btn.tooltip_text = tr("La mesa está llena: quita un plato o mejora la cocina.")
		btn.pressed.connect( func(): _cook(id))
	btn.custom_minimum_size = Vector2(92, 34)
	btn.size_flags_vertical = Control.SIZE_SHRINK_BEGIN
	row.add_child(btn)





func _cook(id: String) -> void :
	if _mode != "chef" or _chef_list == null or not is_instance_valid(_chef_list):
		return
	var list: = _chef_list
	_mode = "chef_cooking"
