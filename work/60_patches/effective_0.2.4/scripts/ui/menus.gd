func _festival_build_row(b: Dictionary, go_fn: Callable, button_text: = "", extra: Control = null) -> Control:
	var panel: = PanelContainer.new()
	var box: = UiKit.panel_box(Color(0.96, 0.97, 1.0), Color(0.84, 0.86, 0.93), 6, 1)
	box.shadow_size = 0
	box.content_margin_left = 8
	box.content_margin_right = 7
	box.content_margin_top = 3
	box.content_margin_bottom = 4
	panel.add_theme_stylebox_override("panel", box)
	var row: = HBoxContainer.new()
	row.add_theme_constant_override("separation", 5)
	panel.add_child(row)
	var job_tex: = _build_job_icon(b)
	if job_tex != null:
		var job_ic: = UiKit.icon_rect(job_tex, 24)
		job_ic.size_flags_vertical = Control.SIZE_SHRINK_CENTER
		row.add_child(job_ic)
	var info: = VBoxContainer.new()
