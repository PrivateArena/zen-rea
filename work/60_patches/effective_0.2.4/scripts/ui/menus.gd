func _element_table() -> GridContainer:
	var order: Array = GameData.ELEMENT_ORDER
	var grid: = GridContainer.new()
	grid.columns = order.size() + 1
	grid.add_theme_constant_override("h_separation", 2)
	grid.add_theme_constant_override("v_separation", 2)
	var cell: = func(text: String, bg: Color, fg: Color, bold: bool, w: float) -> PanelContainer:
		var pc: = PanelContainer.new()
		var sb: = StyleBoxFlat.new()
		sb.bg_color = bg
		sb.set_corner_radius_all(3)
		sb.content_margin_top = 2
		sb.content_margin_bottom = 2
		pc.add_theme_stylebox_override("panel", sb)
		pc.custom_minimum_size.x = w
		var l: = _ro_text(text, 9 if bold else 10, fg, bold)
		l.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER
		l.clip_text = true
		pc.add_child(l)
		return pc
	var dark: = Color(0.12, 0.14, 0.22)
	grid.add_child(cell.call("", Color(0, 0, 0, 0), dark, true, 62.0))
	for d in order:
		grid.add_child(cell.call(tr(str(GameData.ELEMENT_NAMES[d])), GameData.ELEMENT_COLORS[d], dark, true, 46.0))
	for a in order:
		grid.add_child(cell.call(tr(str(GameData.ELEMENT_NAMES[a])), GameData.ELEMENT_COLORS[a], dark, true, 62.0))
		for d in order:
			var m: = GameData.element_mult(str(a), str(d))
			var bg: = Color(0.88, 0.89, 0.93)
			var fg: = Color(0.28, 0.3, 0.4)
			if m > 1.001:
				bg = Color(0.62, 0.86, 0.55).lerp(Color(0.35, 0.75, 0.3), clampf((m - 1.25) / 0.5, 0.0, 1.0))
				fg = Color(0.05, 0.25, 0.05)
			elif m < 0.999:
				bg = Color(0.98, 0.72, 0.68).lerp(Color(0.9, 0.42, 0.38), clampf((0.75 - m) / 0.65, 0.0, 1.0))
				fg = Color(0.4, 0.05, 0.05)
			grid.add_child(cell.call("%d%%" % roundi(m * 100.0), bg, fg, m > 1.001 or m < 0.999, 46.0))
	return grid








const NOTES_SHOWN: = 8
var _notes_asked: = false
var _notes_button: Control
signal notes_changed


func _notes() -> Array:
	var cached = Save.setting("notes_cache", [])
	return cached if cached is Array else []



func notes_unseen() -> bool:
	var n: = _notes()
	return not n.is_empty() and str(n[0].get("version", "")) != str(Save.setting("notes_seen", ""))


func _ask_notes(url: = "") -> void :
	if _notes_asked and url == "":
		return
	_notes_asked = true
	var http: = HTTPRequest.new()
	http.timeout = 8.0
	http.accept_gzip = not OS.has_feature("web")
	add_child(http)
	var from: = url if url != "" else Updater.MANIFEST_URL
	http.request_completed.connect( func(result: int, code: int, _h: PackedStringArray, body: PackedByteArray):
		http.queue_free()
		var m = JSON.parse_string(body.get_string_from_utf8()) if result == HTTPRequest.RESULT_SUCCESS and code == 200 else null
		if not m is Dictionary or not (m as Dictionary).get("notes") is Array:

			if from != Updater.MANIFEST_FALLBACK:
				_ask_notes.call_deferred(Updater.MANIFEST_FALLBACK)
			return
		Save.set_setting("notes_cache", (m.notes as Array).slice(0, NOTES_SHOWN))


		Save.set_setting("relay_cfg", m.get("relay") if m.get("relay") is Dictionary else {})
		notes_changed.emit())
	if http.request(from) != OK:
		http.queue_free()



func _note_text(it: Dictionary) -> String:
	var lang: = TranslationServer.get_locale().left(2)
	return str(it.get(lang, it.get("en", it.get("es", ""))))




