func _close_trade_confirm() -> void :
	if _tr_confirm != null and is_instance_valid(_tr_confirm):
		_tr_confirm.queue_free()
	_tr_confirm = null



func _trade_summary(side: Dictionary, ours: bool) -> Label:
	var parts: = []
	for x in side.items:
		var it: Dictionary = Save.storage_item(str(x)) if ours else x
		if not it.is_empty():
			parts.append(Equipment.item_name(it))
	for c in side.cards:
		parts.append("%s x%d" % [tr(str(GameData.CARDS[c].name)), int(side.cards[c])])
	for k in side.mats:
		parts.append("%s x%d" % [tr(str(GameData.MATERIALS[k].name)), int(side.mats[k])])
	if int(side.zeny) > 0:
		parts.append("%s z" % RoBasicWindow._thousands(int(side.zeny)))
	var l: = _ro_text(", ".join(parts) if not parts.is_empty() else tr("Nada"), 11)
	l.autowrap_mode = TextServer.AUTOWRAP_WORD_SMART
	l.custom_minimum_size.x = 340
	return l




