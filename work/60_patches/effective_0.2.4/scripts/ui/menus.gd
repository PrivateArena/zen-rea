	body.add_child(refine)
	var graded: = Save.storage().filter(_gradable_stored).size()
	body.add_child(_menu_option(_item_icon("hd_oridecon"), tr("Grado"), 
		tr("Piezas +%d: %d en tu almacén") % [GameData.GRADE_MIN_REFINE, graded] if graded > 0 else tr("Pide una pieza +%d") % GameData.GRADE_MIN_REFINE, 
		pick.bind("grade")))
	body.add_child(_menu_option(_item_icon("enriched_oridecon"), tr("Transmutar"), tr("Comunes a Enriched, Enriched a HD"), func(): show_transmute()))
	var footer: = HBoxContainer.new()
	footer.alignment = BoxContainer.ALIGNMENT_END
	body.add_child(footer)
	footer.add_child(_ro_button(tr("Cerrar"), _back_to_hub))
	refine.grab_focus.call_deferred()




var _refiner_mode: = "refine"
func show_refiner(message: = "", ok: = true, broken_icon: = "") -> void :
	_refine_slot = null
	_grade_corner = null
	_grade_shine = null
	_mode = "refiner"
	var grading: = _refiner_mode == "grade"
	var keep: Callable = _gradable_stored if grading else _refinable_stored
	var body: = _ro_screen(tr("Grado  ·  Nakurusa") if grading else tr("Refinamiento  ·  Nakurusa"), 720)
	var store: = Save.storage()

	var said: = tr("«Sin hierro no hay forja. Tráeme algo del Almacén Kafra y lo dejo como nuevo.»") if store.is_empty()\
	else (tr("«Una pieza +%d aguanta el grado. Cada pieza gana lo suyo; si falla, solo pierdes lo pagado.»") % GameData.GRADE_MIN_REFINE if grading
		else tr("«Elige una pieza. Hasta el límite seguro no falla; pasado eso... puede romperse.»"))
	body.add_child(_npc_header("npc_refiner", "Nakurusa", said))

	var tabs: = HBoxContainer.new()
	tabs.add_theme_constant_override("separation", 6)
	body.add_child(tabs)
	for t in [["refine", tr("Refinar")], ["grade", tr("Grado")]]:
		var on: bool = _refiner_mode == t[0]
		var tb: = _ro_button(str(t[1]), func():
			_refiner_mode = str(t[0])
			_refine_confirm = ""
			show_refiner(), not on)
		if on:
			tb.modulate = Color(0.75, 0.85, 1.0)
		tabs.add_child(tb)
	var cols: = HBoxContainer.new()
	cols.add_theme_constant_override("separation", 14)
	body.add_child(cols)

	var left: = VBoxContainer.new()
	left.add_theme_constant_override("separation", 4)
	left.custom_minimum_size.x = 262
	cols.add_child(left)
	left.add_child(_ro_text(tr("Almacén Kafra  %d / %d") % [store.size(), Save.storage_cap()], 12, Color(0.12, 0.25, 0.75), true))
	left.add_child(_store_tabs( func(): show_refiner(), keep))
	var grid: = GridContainer.new()
	grid.columns = 6
	grid.add_theme_constant_override("h_separation", 3)
	grid.add_theme_constant_override("v_separation", 3)
	left.add_child(_store_scroll(grid, 6))
	var shown: = _store_shown(keep)
	if Save.storage_item(_refine_uid).is_empty() or not keep.call(Save.storage_item(_refine_uid)):
		_refine_uid = str(shown[0].uid) if not shown.is_empty() else ""
	for it in shown:
		var uid: = str(it.uid)
		var cell: = Button.new()
		cell.custom_minimum_size = Vector2(40, 40)
		cell.focus_mode = Control.FOCUS_NONE
		var sel: = uid == _refine_uid
		var box: = _cell_box(Equipment.item_color(it), sel, 3 if sel else 1)
		for sn in ["normal", "hover", "pressed"]:
			cell.add_theme_stylebox_override(sn, box)
		var center: = CenterContainer.new()
		center.set_anchors_and_offsets_preset(Control.PRESET_FULL_RECT)
		center.mouse_filter = Control.MOUSE_FILTER_IGNORE
		cell.add_child(center)
		center.add_child(UiKit.icon_rect(_item_icon(Equipment.item_def(it).icon), 30))
		if int(it.get("refine", 0)) > 0:
			var tag: = _ro_text("+%d" % int(it.refine), 9, Color.WHITE, true)
			tag.add_theme_color_override("font_outline_color", Color.BLACK)
			tag.add_theme_constant_override("outline_size", 3)
			tag.mouse_filter = Control.MOUSE_FILTER_IGNORE
			cell.add_child(tag)
		_owner_star(cell, uid)
		_grade_deco(cell, it)
		_set_hover(cell, _item_hover(it, _owner_feet(uid)))
		cell.pressed.connect( func():
			_refine_uid = uid
			_refine_mat = ""
			show_refiner())
		grid.add_child(cell)
	for i in maxi(0, 18 - shown.size()):
		var empty: = Panel.new()
		empty.custom_minimum_size = Vector2(40, 40)
		empty.add_theme_stylebox_override("panel", _cell_box(Color(0.84, 0.86, 0.92), false, 1))
		empty.modulate.a = 0.7
		grid.add_child(empty)

	var right: = VBoxContainer.new()
	right.add_theme_constant_override("separation", 6)
	right.custom_minimum_size = Vector2(400, 250)
	cols.add_child(right)
	var it: = Save.storage_item(_refine_uid)
	if it.is_empty() and broken_icon != "":

		right.add_child(_anvil_slot(_item_icon(broken_icon), Color(0.8, 0.15, 0.15)))
	elif it.is_empty() and grading:
		var none: = _ro_text(tr("No tienes piezas +%d en el Almacén Kafra. Refina una hasta +%d para darle grado.") % [GameData.GRADE_MIN_REFINE, GameData.GRADE_MIN_REFINE], 
			12, Color(0.28, 0.3, 0.4))
		none.autowrap_mode = TextServer.AUTOWRAP_WORD_SMART
		right.add_child(none)
	elif it.is_empty():
		right.add_child(_refiner_empty(store.is_empty()))
	else:
		var weapon: = Equipment.item_type(it) == "weapon"
		var lvl: = int(it.get("refine", 0))
		var maxed: = lvl >= GameData.MAX_REFINE or not Equipment.item_def(it).has("refine")

		var top: = HBoxContainer.new()
		top.add_theme_constant_override("separation", 12)
		right.add_child(top)
		top.add_child(_anvil_slot(_item_icon(Equipment.item_def(it).icon), Equipment.item_color(it)))
		_anvil_grade(it)
		var info: = VBoxContainer.new()
		info.size_flags_vertical = Control.SIZE_SHRINK_CENTER
		top.add_child(info)
		var name_l: = _ro_text(Equipment.item_name(it), 14, Equipment.item_color(it), true)
		info.add_child(name_l)

		var acc: = not Equipment.item_def(it).has("refine")
		var wl: = (tr("Arma Nv %d") % Equipment.weapon_level(it)) if weapon else tr("Armadura")
		info.add_child(_ro_text(tr("Accesorio") if acc else "%s  ·  %s" % [wl, tr("seguro hasta +%d") % Equipment.refine_safe(it)], 
			10, Color(0.28, 0.3, 0.4)))
		info.add_child(_ro_text(_mods_text(Equipment.item_mods(it)), 10, Color(0.15, 0.3, 0.6)))
		info.add_child(_owner_line(str(it.uid)))
		if grading:
			pass
		elif maxed:
			right.add_child(_ro_text(tr("Solo los accesorios únicos se pueden refinar.") if acc else tr("Este objeto ya no se puede refinar más."), 
				12, Color(0.6, 0.45, 0.1), true))
		else:

			var kind_for: = "weapon" if weapon else "armor"
			var mats: Array = GameData.MATERIALS.keys().filter( func(m): return GameData.MATERIALS[m]["for"] == kind_for)

			var rich: = lvl >= GameData.REFINE_RICH_FROM

			var auto_on: = bool(Save.setting("refine_auto", false))
			var auto_pick: Array = _auto_refine_mat(it) if auto_on else []
			if auto_on:
				_refine_mat = str(auto_pick[0])
			if rich and _refine_mat != "" and GameData.MATERIALS[_refine_mat].kind == "normal":
				_refine_mat = ""
			if not auto_on and (_refine_mat == "" or not mats.has(_refine_mat) or Save.material(_refine_mat) <= 0):
				_refine_mat = ""
				for m in mats:
					if Save.material(m) > 0 and GameData.MATERIALS[m].kind == "normal" and not rich:
						_refine_mat = m
				if _refine_mat == "":
					for m in mats:
						if Save.material(m) > 0 and not (rich and GameData.MATERIALS[m].kind == "normal"):
							_refine_mat = m
							break
			var mhead: = HBoxContainer.new()
			mhead.add_theme_constant_override("separation", 6)
			right.add_child(mhead)
			var mlabel: = _ro_text(tr("Material") + ("  ·  " + tr("desde +%d solo Enriched o HD") % GameData.REFINE_RICH_FROM if rich else ""), 
				11, Color(0.12, 0.25, 0.75), true)
			mlabel.size_flags_horizontal = Control.SIZE_EXPAND_FILL
			mlabel.size_flags_vertical = Control.SIZE_SHRINK_CENTER
			mhead.add_child(mlabel)

			var auto_box: = CheckBox.new()
			auto_box.text = tr("Automático")
			auto_box.focus_mode = Control.FOCUS_NONE
			auto_box.add_theme_font_override("font", UiKit.FONT_TITLE)
			auto_box.add_theme_font_size_override("font_size", 11)
			for st in ["font_color", "font_hover_color", "font_pressed_color", "font_hover_pressed_color"]:
				auto_box.add_theme_color_override(st, Color(0.12, 0.25, 0.55))
			auto_box.button_pressed = auto_on
			auto_box.tooltip_text = tr("Elige solo el material de cada intento: el más barato con más del %d%% de éxito (desde +%d, Enriched o HD). Si se te acaba, usa el siguiente mejor que tengas; si no hay, el de abajo.")\
			%[roundi(GameData.REFINE_AUTO_MIN * 100.0), GameData.REFINE_RICH_FROM]
			auto_box.toggled.connect( func(on: bool):
				Save.set_setting("refine_auto", on)
				_refine_mat = ""
				_refine_confirm = ""
				show_refiner())
			mhead.add_child(auto_box)
			var mrow: = HBoxContainer.new()
			mrow.add_theme_constant_override("separation", 6)
			right.add_child(mrow)
			for m in mats:
				var md: Dictionary = GameData.MATERIALS[m]
				var have: = Save.material(m)
				var mb: = Button.new()
				mb.custom_minimum_size = Vector2(118, 44)
				mb.focus_mode = Control.FOCUS_NONE
				var barred: bool = rich and md.kind == "normal"
				mb.disabled = have <= 0 or barred
				var chosen: bool = m == _refine_mat
				var mbox: = _cell_box(Color(0.3, 0.42, 0.78) if chosen else Color(0.75, 0.78, 0.86), chosen, 2 if chosen else 1)
				for sn in ["normal", "hover", "pressed", "disabled"]:
					mb.add_theme_stylebox_override(sn, mbox)
				var mr: = HBoxContainer.new()
				mr.set_anchors_and_offsets_preset(Control.PRESET_FULL_RECT)
				mr.offset_left = 4
				mr.add_theme_constant_override("separation", 4)
				mr.mouse_filter = Control.MOUSE_FILTER_IGNORE
				mb.add_child(mr)
				var mic: = UiKit.icon_rect(_item_icon(str(md.icon)), 24)
				mic.size_flags_vertical = Control.SIZE_SHRINK_CENTER
				if have <= 0 or barred:
					mic.modulate.a = 0.35
				mr.add_child(mic)
				var mt: = _ro_text("%s\nx%d" % [tr(str(md.name)), have], 9, Color.BLACK if have > 0 and not barred else Color(0.42, 0.44, 0.5), chosen)
				mt.size_flags_vertical = Control.SIZE_SHRINK_CENTER
				mr.add_child(mt)
				mb.pressed.connect( func():

					Save.set_setting("refine_auto", false)
					_refine_mat = m
					show_refiner())
				mrow.add_child(mb)
			if auto_on:

				var use: = str(auto_pick[0])
				var ideal: = str(auto_pick[1])
				var say: = ""
				if use == "":
					say = tr("Automático: no tienes material para este paso.")
				elif use != ideal:
					say = tr("Automático: no tienes %s, usa %s.") % [tr(str(GameData.MATERIALS[ideal].name)), tr(str(GameData.MATERIALS[use].name))]
				else:
					say = tr("Automático: %s para +%d → +%d.") % [tr(str(GameData.MATERIALS[use].name)), lvl, lvl + 1]
				var al: = _ro_text(say, 10, Color(0.6, 0.15, 0.15) if use == "" else Color(0.15, 0.45, 0.2), true)
				al.autowrap_mode = TextServer.AUTOWRAP_WORD_SMART
				al.custom_minimum_size.x = 370
				right.add_child(al)

			var base: = Equipment.refine_chance(it)
			var chance: = base
			var mkind: = str(GameData.MATERIALS[_refine_mat].kind) if _refine_mat != "" else "normal"
			chance = _ore_chance(base, mkind)
			var safe: = lvl < Equipment.refine_safe(it)
			var guarded: = _refine_guarded(it)
			var fee: = _refine_fee(it)
			var crow: = HBoxContainer.new()
			crow.add_theme_constant_override("separation", 14)
			right.add_child(crow)
			var col_ch: = Color(0.15, 0.55, 0.2) if chance >= 0.999 else (Color(0.75, 0.55, 0.1) if chance >= 0.4 else Color(0.75, 0.15, 0.15))
			crow.add_child(_ro_text("+%d  →  +%d" % [lvl, lvl + 1], 16, Color(0.12, 0.25, 0.75), true))
			crow.add_child(_ro_text(tr("%d%% de éxito") % roundi(chance * 100.0), 16, col_ch, true))
			crow.add_child(_ro_text(tr("Costo: %s z") % RoBasicWindow._thousands(fee), 12, Color(0.6, 0.15, 0.15) if Save.zeny() < fee else Color.BLACK, true))

			var up: = it.duplicate(true)
			up["refine"] = lvl + 1
			var gain: = _ro_text(tr("Si sale bien: %s") % _mods_text(_mods_delta(Equipment.item_mods(up), Equipment.item_mods(it))), 12, 
				Color(0.15, 0.45, 0.2), true)
			gain.autowrap_mode = TextServer.AUTOWRAP_WORD_SMART
			gain.custom_minimum_size.x = 370
			right.add_child(gain)
			var warn: = ""
			if safe:
				warn = tr("Dentro del límite seguro: no puede fallar.")
			elif guarded:
				warn = tr("Protegido: si falla, el objeto no se rompe, pero baja 1 nivel.")
			elif _never_breaks(it):
				warn = tr("Tus Puños nunca se rompen: si falla, bajan 1 nivel.")
			else:
				warn = tr("¡Si falla, el objeto SE ROMPE y se pierde para siempre!")
			var sturdy: = guarded or _never_breaks(it)
			var wl2: = _ro_text(warn, 11, Color(0.15, 0.5, 0.2) if safe or sturdy else Color(0.75, 0.15, 0.15), true)
			wl2.autowrap_mode = TextServer.AUTOWRAP_WORD_SMART
			wl2.custom_minimum_size.x = 370
			right.add_child(wl2)
			var can: = _refine_mat != "" and Save.zeny() >= fee
			var risky: = not safe and not sturdy
			if risky and _refine_confirm == "%s:%d" % [_refine_uid, lvl]:
				right.add_child(_refine_confirm_box(it, lvl))
			else:
				var go: = _ro_button(tr("Refinar"), func():
					if risky:


						_refine_confirm = "%s:%d" % [_refine_uid, lvl]
						_refine_confirm_at = Time.get_ticks_msec()
						world.play_sound("warning", 0.0, -6.0)
						show_refiner()
					else:
						_do_refine(), can)
				go.custom_minimum_size = Vector2(160, 30)
				right.add_child(go)



			if not safe and not _never_breaks(it):
				var prot: = CheckBox.new()
				prot.text = tr("Proteger el objeto (x%d zeny): si falla no se rompe, baja 1 nivel") % roundi(GameData.REFINE_PROTECT_MULT)
				prot.focus_mode = Control.FOCUS_NONE
				prot.add_theme_font_override("font", UiKit.FONT_TITLE)
				prot.add_theme_font_size_override("font_size", 11)
				for st in ["font_color", "font_hover_color", "font_pressed_color", "font_hover_pressed_color"]:
					prot.add_theme_color_override(st, Color(0.12, 0.25, 0.55))
				prot.button_pressed = bool(Save.setting("refine_protect", false))
				prot.toggled.connect( func(on: bool):
					Save.set_setting("refine_protect", on)
					_refine_confirm = ""
					show_refiner())
				right.add_child(prot)

	if not it.is_empty() and grading and Equipment.gradable_kind(Equipment.item_type(it)):
		right.add_child(_grade_block(it))

	var bar: = PanelContainer.new()
	var bar_box: = StyleBoxFlat.new()
	bar_box.bg_color = Color(0.94, 0.95, 0.99)
	bar_box.border_color = Color(0.72, 0.76, 0.88)
	bar_box.set_border_width_all(1)
	bar_box.set_corner_radius_all(5)
	bar_box.set_content_margin_all(6)
	bar.add_theme_stylebox_override("panel", bar_box)
	body.add_child(bar)
	var shop: = HBoxContainer.new()
	shop.add_theme_constant_override("separation", 6)
	bar.add_child(shop)
	shop.add_child(_ro_text(tr("Materiales"), 11, Color(0.12, 0.25, 0.75), true))
	for m in GameData.MATERIALS:

		if str(GameData.MATERIALS[m].get("kind", "")) in ["potential", "currency"]:
			continue
		var have: = Save.material(m)
		var chip: = HBoxContainer.new()
		chip.add_theme_constant_override("separation", 1)
		chip.tooltip_text = tr(str(GameData.MATERIALS[m].name))
		chip.mouse_filter = Control.MOUSE_FILTER_PASS
		var ic: = UiKit.icon_rect(_item_icon(str(GameData.MATERIALS[m].icon)), 24)
		ic.modulate.a = 1.0 if have > 0 else 0.35
		chip.add_child(ic)
		var nl: = _ro_text("%d" % have, 11, Color.BLACK if have > 0 else Color(0.42, 0.44, 0.5), have > 0)
		nl.size_flags_vertical = Control.SIZE_SHRINK_CENTER
		chip.add_child(nl)
		shop.add_child(chip)
	var gap: = Control.new()
	gap.size_flags_horizontal = Control.SIZE_EXPAND_FILL
	shop.add_child(gap)
	var zl: = _ro_text(tr("Zeny : %s") % RoBasicWindow._thousands(Save.zeny()), 11, Color.BLACK, true)
	zl.size_flags_vertical = Control.SIZE_SHRINK_CENTER
	shop.add_child(zl)

	var tm: = _ro_button(tr("Transmutar"), func(): show_transmute())
	tm.icon = _item_icon("enriched_oridecon")
	tm.tooltip_text = tr("Convierte Oridecon y Elunium en Enriched, y Enriched en HD")
	shop.add_child(tm)
	if message != "":
		body.add_child(_ro_text(message, 12, Color(0.15, 0.5, 0.2) if ok else Color(0.7, 0.15, 0.15), true))
	var footer: = HBoxContainer.new()
	footer.alignment = BoxContainer.ALIGNMENT_END
	body.add_child(footer)
	var close: = _ro_button(tr("Cerrar"), _back_to_hub)
	footer.add_child(close)
	close.grab_focus.call_deferred()






func _grade_block(it: Dictionary) -> Control:
	var panel: = PanelContainer.new()
	var g: = Equipment.grade(it)
	var now_col: Color = GameData.WEAPON_GRADES[g].color if g > 0 else Color(0.6, 0.64, 0.75)
	var pbox: = StyleBoxFlat.new()
	pbox.bg_color = Color(0.97, 0.97, 1.0)
	pbox.border_color = Color(now_col, 0.8)
	pbox.set_border_width_all(1)
	pbox.set_corner_radius_all(5)
	pbox.set_content_margin_all(6)
	panel.add_theme_stylebox_override("panel", pbox)
	var box: = VBoxContainer.new()
	box.add_theme_constant_override("separation", 3)
	panel.add_child(box)
	var head: = HBoxContainer.new()
	head.add_theme_constant_override("separation", 8)
	box.add_child(head)
	var kind: = Equipment.item_type(it)
	head.add_child(_ro_text(tr("Grado"), 12, Color(0.12, 0.25, 0.75), true))
	head.add_child(_ro_text(tr("Grado %s") % str(GameData.WEAPON_GRADES[g].name) if g > 0 else tr("sin grado"), 12, now_col, true))
	var last: = GameData.WEAPON_GRADES.size() - 1
	if g >= last:
		box.add_child(_ro_text(tr("Grado máximo: %s") % GameData.grade_text(kind, g), 11, now_col, true))
		return panel
	if int(it.get("refine", 0)) < GameData.GRADE_MIN_REFINE:
		var need: = _ro_text(tr("Se le da grado a las piezas desde +%d: cada grado mejora lo suyo, pagado en Oridecon (armas) o Elunium (lo demás).") % GameData.GRADE_MIN_REFINE, 10, Color(0.28, 0.3, 0.4))
		need.autowrap_mode = TextServer.AUTOWRAP_WORD_SMART
		need.custom_minimum_size.x = 380
		box.add_child(need)
		return panel
	var nx: Dictionary = GameData.WEAPON_GRADES[g + 1]

	var price: = GameData.grade_cost(kind, g + 1)
	var cost: = HBoxContainer.new()
	cost.add_theme_constant_override("separation", 10)
	box.add_child(cost)
	var enough: = true
	for m in [[str(price.ore), int(price.ori)], [str(price.hd_ore), int(price.hd)]]:
		if int(m[1]) <= 0:
			continue
		var have: = Save.material(str(m[0]))
		enough = enough and have >= int(m[1])
		var chip: = HBoxContainer.new()
		chip.add_theme_constant_override("separation", 2)
		chip.add_child(UiKit.icon_rect(_item_icon(str(GameData.MATERIALS[m[0]].icon)), 20))
		chip.add_child(_ro_text("%d / %d" % [have, int(m[1])], 11, Color.BLACK if have >= int(m[1]) else Color(0.7, 0.15, 0.15), true))
		chip.tooltip_text = tr(str(GameData.MATERIALS[m[0]].name))
		cost.add_child(chip)
	var zeny: = int(price.zeny)
	enough = enough and Save.zeny() >= zeny
	cost.add_child(_ro_text(tr("Costo: %s z") % RoBasicWindow._thousands(zeny), 11, Color(0.6, 0.15, 0.15) if Save.zeny() < zeny else Color.BLACK, true))

	var pity: = Equipment.grade_pity(it)
	var chance: = GameData.grade_chance(g + 1, pity)
	cost.add_child(_ro_text(tr("%d%% de éxito") % roundi(chance * 100.0), UiKit.text_size(12, 1.15), Color(0.62, 0.42, 0.0) if chance < 0.999 else Color(0.1, 0.48, 0.15), true))

	var step: = _ro_text(GameData.grade_step_text(kind, g + 1), UiKit.text_size(13, 1.15), HoverCard.ink(nx.color), true)
	box.add_child(step)
	var gain: = _ro_text(tr("Grado %s: %s. Si falla, solo pierdes lo pagado: la pieza y su grado quedan.") % [str(nx.name), GameData.grade_text(kind, g + 1)], 
		UiKit.text_size(11, 1.15), HoverCard.ink(nx.color))
	gain.autowrap_mode = TextServer.AUTOWRAP_WORD_SMART
	gain.custom_minimum_size.x = 380
	box.add_child(gain)

	var pity_l: = _ro_text(tr_n("Suerte acumulada: +%s%% por %d fallo (máximo %d%%)", "Suerte acumulada: +%s%% por %d fallos (máximo %d%%)", pity)
		%[GameData.grade_pct(chance - float(nx.chance)), pity, roundi(GameData.GRADE_CHANCE_MAX * 100.0)] if pity > 0\
		else tr("Cada fallo suma +%s%% al próximo intento de esta pieza (máximo %d%%).") % [GameData.grade_pct(GameData.GRADE_PITY), roundi(GameData.GRADE_CHANCE_MAX * 100.0)], 
		UiKit.text_size(11, 1.15), Color(0.1, 0.42, 0.2) if pity > 0 else UiKit.MUTED, pity > 0)
	pity_l.autowrap_mode = TextServer.AUTOWRAP_WORD_SMART
	pity_l.custom_minimum_size.x = 380
	box.add_child(pity_l)

	var wearer: = Save.loadout_owner(str(it.get("uid", "")))
	if kind != "weapon" and wearer != "" and GameData.CLASSES.has(wearer):
		var hl: = _harmony_lines(Equipment.loadout_harmony(wearer))
		var hlab: = _ro_text("%s: %s" % [tr(str(GameData.CLASSES[wearer].name)), hl[0] + ("  ·  " + hl[1] if hl[1] != "" else "")], 
			UiKit.text_size(11, 1.15), hl[2], true)
		hlab.autowrap_mode = TextServer.AUTOWRAP_WORD_SMART
		hlab.custom_minimum_size.x = 380
		box.add_child(hlab)
	var go: = _ro_button(tr("Subir a grado %s") % str(nx.name), _do_grade, enough)
	go.custom_minimum_size = Vector2(160, 26)
	box.add_child(go)
	return panel




func _harmony_for(it: Dictionary) -> Dictionary:
	if world != null and world.running and world.player != null and world.player.equipment != null:
		var slots: Dictionary = world.player.equipment.slots
		return Equipment.harmony_of(slots) if slots.values().any( func(s): return is_same(s, it)) else {}
	var wearer: = Save.loadout_owner(str(it.get("uid", ""))) if it.has("uid") else ""
	return Equipment.loadout_harmony(wearer) if wearer != "" else {}




func _harmony_lines(h: Dictionary) -> Array:
	var lv: = int(h.get("level", 0))
	var low: = str(h.get("low", ""))
	var low_name: = tr(str(GameData.SLOT_NAMES.get(low, low))) if low != "" else ""
	if lv > 0:
		var gd: Dictionary = GameData.WEAPON_GRADES[lv]
		var hint: = ""
		if lv < GameData.WEAPON_GRADES.size() - 1:
			hint = tr("sube con %s a grado %s") % [low_name, str(GameData.WEAPON_GRADES[lv + 1].name)]
		return [tr("Armonía de grado %s: +%d%% a los bonos de grado de tu equipo") % [str(gd.name), roundi(float(GameData.HARMONY_SHARE[lv]) * 100.0)], 
			hint, HoverCard.ink(gd.color)]
	var n: = int(h.get("pieces", 0))
	if n < GameData.HARMONY_MIN_PIECES:
		return [tr("Armonía de grado: %d / %d piezas equipadas (sin contar arma, cara ni alas)") % [n, GameData.HARMONY_MIN_PIECES], 
			tr("con %d piezas de grado, el grado más bajo suma a todas") % GameData.HARMONY_MIN_PIECES, UiKit.MUTED]
	return [tr("Armonía de grado: falta darle grado a %s") % low_name, tr("con %d piezas de grado, el grado más bajo suma a todas") % GameData.HARMONY_MIN_PIECES, 
		UiKit.MUTED]


func _do_grade() -> void :


	if _grade_fx != null and is_instance_valid(_grade_fx) and not _grade_fx.is_queued_for_deletion():
		_grade_fx.finish()
		return
	var it: = Save.storage_item(_refine_uid)
	var g: = Equipment.grade(it)
	if it.is_empty() or not Equipment.gradable_kind(Equipment.item_type(it)) or g >= GameData.WEAPON_GRADES.size() - 1\
	or int(it.get("refine", 0)) < GameData.GRADE_MIN_REFINE:
		return
	var nx: Dictionary = GameData.WEAPON_GRADES[g + 1]
	var price: = GameData.grade_cost(Equipment.item_type(it), g + 1)
	var hd: = int(price.hd)
	var ore: = str(price.ore)
	var hd_ore: = str(price.hd_ore)
	if Save.material(ore) < int(price.ori) or Save.material(hd_ore) < hd or Save.zeny() < int(price.zeny):
		return
	Save.spend(int(price.zeny))
	for i in int(price.ori):
		Save.use_material(ore)
	for i in hd:
		Save.use_material(hd_ore)

	var pity: = Equipment.grade_pity(it)
	var ok: = randf() < GameData.grade_chance(g + 1, pity)
	var msg: = ""
	if ok:
		it["grade"] = g + 1
		it.erase("grade_pity")
		Save.stat_max("weapon_grade", g + 1)

		msg = tr("¡Éxito! %s ahora es de grado %s.") % [Equipment.item_name(it), str(nx.name)] + "  " + GameData.grade_step_text(Equipment.item_type(it), g + 1)

		if g + 1 >= GameData.WEAPON_GRADES.size() - 1 and world != null:
			world.channel.feat("grade", str(it.id), g + 1)
	else:
		it["grade_pity"] = mini(pity + 1, GameData.GRADE_PITY_MAX)
		msg = tr("Falló... %s sigue como estaba.") % Equipment.item_name(it) + "  "\
		+ tr("Próximo intento: %d%% de éxito.") % roundi(GameData.grade_chance(g + 1, int(it.grade_pity)) * 100.0)
	Save.mark_dirty()
	Save.flush()
	show_refiner(msg, ok)
	_grade_anim(ok, g + 1 if ok else g, GameData.WEAPON_GRADES[g].color if g > 0 else Equipment.item_color(it))




func _anvil_grade(it: Dictionary) -> void :
	var g: = Equipment.grade(it)
	if g <= 0 or _refine_slot == null:
		return
	var col: Color = GameData.WEAPON_GRADES[g].color
	_refine_frame.border_color = col
	if g >= GameData.WEAPON_GRADES.size() - 1:
		_grade_shine = GradeFx.shine(_refine_slot)
	var tag: = _ro_text(str(GameData.WEAPON_GRADES[g].name), 22, col.lightened(0.15), true)
	tag.add_theme_color_override("font_outline_color", col.darkened(0.7))
	tag.add_theme_constant_override("outline_size", 4)
	tag.set_anchors_preset(Control.PRESET_TOP_RIGHT)
	tag.grow_horizontal = Control.GROW_DIRECTION_BEGIN
	tag.offset_right = -7
	tag.offset_top = 1
	_refine_slot.add_child(tag)
	_grade_corner = tag




func _grade_anim(ok: bool, g: int, was: Color) -> void :
	if _refine_slot == null or not is_instance_valid(_refine_slot) or _equip_portrait == null:
		return
	var fx: = GradeFx.new()
	fx.world = world
	fx.ok = ok
	fx.icon = _equip_portrait
	fx.frame_box = _refine_frame
	fx.from_col = was
	if g > 0:
		fx.col = GameData.WEAPON_GRADES[g].color
		fx.letter = str(GameData.WEAPON_GRADES[g].name)
	if ok:
		fx.corner = _grade_corner
		fx.reveal = [_grade_corner, _grade_shine].filter( func(n): return n != null)
		if g >= GameData.WEAPON_GRADES.size() - 1:
			fx.slam_sound = "levelup"
	fx.play(_refine_slot)
	_grade_fx = fx







var _tm_refs: = {}


var _tm_tab: = "up"
func show_transmute(message: = "", played: = -1, made: = 0) -> void :
	_mode = "refiner"
	var body: = _ro_screen(tr("Transmutación  ·  Nakurusa"), 480)
	body.add_child(_npc_header("npc_refiner", "Nakurusa", message if message != ""\
	else (tr("Un HD vuelve a ser cinco Enriched, un Enriched diez comunes. No se pierde nada.") if _tm_tab == "down"\
	else tr("Un Oridecon por un Elunium, o al revés. El mismo fuego, otra forma.") if _tm_tab == "swap"\
	else tr("Diez comunes hacen uno Enriched, cinco Enriched hacen uno HD. El fuego no miente."))))
	var tabs: = HBoxContainer.new()
	tabs.alignment = BoxContainer.ALIGNMENT_CENTER
	tabs.add_theme_constant_override("separation", 6)
	body.add_child(tabs)
	for tab in ["up", "swap", "down"]:
		var t: String = tab
		var tb: = _ro_button({"up": tr("Mejorar  ▲"), "swap": tr("Conversión  ⇄"), "down": tr("Deshacer  ▼")}[t], func():
			_tm_tab = t
			show_transmute())
		tb.modulate = Color.WHITE if _tm_tab == t else Color(1, 1, 1, 0.55)
		tabs.add_child(tb)
	var grid: = GridContainer.new()
	grid.columns = 2
	grid.add_theme_constant_override("h_separation", 8)
	grid.add_theme_constant_override("v_separation", 8)
	body.add_child(grid)
	_tm_refs.clear()
	var first: Button
	for i in GameData.TRANSMUTE.size():
		if str(GameData.TRANSMUTE[i].get("tab", "up")) != _tm_tab:
			continue
		var b: = _transmute_card(grid, GameData.TRANSMUTE[i], i)
		if first == null and not b.disabled:
			first = b
	var footer: = HBoxContainer.new()
	footer.alignment = BoxContainer.ALIGNMENT_END
	footer.add_theme_constant_override("separation", 6)
	body.add_child(footer)
	var back: = _ro_button(tr("Volver al refinamiento"), func(): show_refiner())
	footer.add_child(back)
	(first if first != null else back).grab_focus.call_deferred()
	if played >= 0 and _tm_refs.has(played):

		get_tree().process_frame.connect( func(): _transmute_anim(_tm_refs[played], made), CONNECT_ONE_SHOT)




