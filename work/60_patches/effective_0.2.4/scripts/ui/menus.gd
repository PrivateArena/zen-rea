func _volume_row(caption: String, key: String, ro_style: = false, default: = 0.8) -> HBoxContainer:
	var row: = HBoxContainer.new()
	row.add_theme_constant_override("separation", 6)
	var l: = _ro_text(caption, 11, Color(0.15, 0.2, 0.45), true) if ro_style else UiKit.label(caption, 14, UiKit.TEXT, true)
	l.custom_minimum_size.x = 64 if ro_style else 90
	l.size_flags_vertical = Control.SIZE_SHRINK_CENTER
	row.add_child(l)
	var gauge: = UiStyles.ro_gauge("blue", 150 if ro_style else 280)
	gauge.max_value = 1.0
	gauge.step = 0.0
	gauge.size_flags_vertical = Control.SIZE_SHRINK_CENTER
	gauge.mouse_filter = Control.MOUSE_FILTER_STOP
	var pct: = _ro_text("", 11, Color.BLACK, true) if ro_style else UiKit.label("", 14, UiKit.TEXT, true)
	pct.custom_minimum_size.x = 40
	pct.horizontal_alignment = HORIZONTAL_ALIGNMENT_RIGHT
	pct.size_flags_vertical = Control.SIZE_SHRINK_CENTER
	var set_value: = func(v: float):
		v = clampf(snappedf(v, 0.05), 0.0, 1.0)
		gauge.value = v
		pct.text = "%d%%" % roundi(v * 100.0) if v > 0.0 else tr("Mudo")
		if absf(float(Save.setting(key, default)) - v) > 0.001:
			Save.set_setting(key, v)
			world.apply_audio_settings()
			if key == "sfx" or key == "ui_volume":
				world.play_sound("ui_click", 0.05, 0.0)
	var down: = _ro_button("◀", func(): set_value.call(gauge.value - 0.1))
	var up: = _ro_button("▶", func(): set_value.call(gauge.value + 0.1))
	for b in [down, up]:
		b.custom_minimum_size = Vector2(22, 18)
		b.size_flags_vertical = Control.SIZE_SHRINK_CENTER
	gauge.gui_input.connect( func(ev: InputEvent):
		if (ev is InputEventMouseButton and ev.pressed and ev.button_index == MOUSE_BUTTON_LEFT)\
		or (ev is InputEventMouseMotion and ev.button_mask & MOUSE_BUTTON_MASK_LEFT):
			set_value.call(ev.position.x / maxf(1.0, gauge.size.x)))
	row.add_child(down)
	row.add_child(gauge)
	row.add_child(up)
	row.add_child(pct)
	set_value.call(float(Save.setting(key, default)))
	return row






const OPTION_TABS: = ["sound", "video", "game", "language", "controls"]
var _options_tab: = "sound"
const OPT_W: = 620.0
const OPT_BODY_H: = 430.0
const OPT_LABEL_W: = 210.0
const OPT_ROW_H: = 34.0
const OPT_ACCENT: = Color(0.33, 0.47, 0.86)
const OPT_ACCENT_DARK: = Color(0.22, 0.34, 0.72)


func show_options(tab: = "") -> void :
	if tab != "":
		_options_tab = tab
	if not _options_tab in OPTION_TABS:
		_options_tab = "sound"
	close_options()
	_options = Control.new()
	_options.set_anchors_and_offsets_preset(Control.PRESET_FULL_RECT)
	_options.mouse_filter = Control.MOUSE_FILTER_STOP
	_options.set_meta("main_options", true)
	_root.add_child(_options)
	_options.add_child(UiKit.backdrop(0.45))
	var win: = VBoxContainer.new()
	win.add_theme_constant_override("separation", 0)
	_options.add_child(win)
	win.add_child(UiKit.soft_title(tr("Opciones"), 17))
	var panel: = PanelContainer.new()
	panel.add_theme_stylebox_override("panel", UiKit.soft_body(16))
	win.add_child(panel)
	var body: = VBoxContainer.new()
	body.custom_minimum_size.x = OPT_W
	body.add_theme_constant_override("separation", 12)
	panel.add_child(body)
	var names: = {"sound": tr("Sonido"), "video": tr("Gráficos"), "game": tr("Juego"), "language": tr("Idioma"), "controls": tr("Controles")}
	var tab_labels: = []
	for t in OPTION_TABS:
		tab_labels.append([str(names[t]), t])
	var bar: = _opt_segments(tab_labels, _options_tab, func(t):
		world.play_sound("ui_click", 0.05, -6.0)
		show_options(str(t)), true)
	bar.size_flags_horizontal = Control.SIZE_SHRINK_CENTER
	body.add_child(bar)
	var scroll: = ScrollContainer.new()
	scroll.name = "OptionsScroll"
	scroll.horizontal_scroll_mode = ScrollContainer.SCROLL_MODE_DISABLED
	scroll.custom_minimum_size = Vector2(OPT_W, OPT_BODY_H)
	body.add_child(scroll)
	var page: = VBoxContainer.new()
	page.size_flags_horizontal = Control.SIZE_EXPAND_FILL
	page.add_theme_constant_override("separation", 6)
	scroll.add_child(page)
	match _options_tab:
		"sound":
			_options_sound(page)
		"video":
			_options_video(page)
		"game":
			_options_game(page)
		"language":
			_options_language(page)
		"controls":
			_options_controls(page)
	var footer: = HBoxContainer.new()
	footer.add_theme_constant_override("separation", 10)
	body.add_child(footer)

	var hint: = UiKit.label("" if MouseWalk.touch() else tr("O / Esc: cerrar"), 12, UiKit.MUTED)
	hint.size_flags_horizontal = Control.SIZE_EXPAND_FILL
	hint.size_flags_vertical = Control.SIZE_SHRINK_CENTER
	footer.add_child(hint)
	var close_b: = UiKit.button(tr("Cerrar"), true)
	close_b.custom_minimum_size = Vector2(140, 38)
	close_b.pressed.connect(close_options)
	footer.add_child(close_b)
	close_b.grab_focus.call_deferred()

	var place: = func():
		if not is_instance_valid(win):
			return
		var view: = get_viewport().get_visible_rect().size
		var need: = win.get_combined_minimum_size()
		var k: = clampf(minf((view.x - 24.0) / need.x, (view.y - 24.0) / need.y), 0.6, minf(view.y / 720.0, view.x / 1280.0) * 1.15)
		win.scale = Vector2(k, k)
		win.position = ((view - need * k) * 0.5).floor()
	place.call_deferred()



func _opt_card(page: VBoxContainer, title: String) -> VBoxContainer:
	if page.get_child_count() > 0:
		var gap: = Control.new()
		gap.custom_minimum_size.y = 6
		page.add_child(gap)
	var head: = UiKit.label(title, 14, OPT_ACCENT_DARK, true)
