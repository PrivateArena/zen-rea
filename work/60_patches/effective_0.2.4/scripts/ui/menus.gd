func _quest_box(d: Dictionary, q: QuestRun) -> PanelContainer:
	var panel: = PanelContainer.new()
	var box: = StyleBoxFlat.new()
	box.bg_color = Color(1.0, 0.97, 0.86)
	box.border_color = Color(0.85, 0.66, 0.25)
	box.set_border_width_all(1)
	box.set_corner_radius_all(3)
	box.set_content_margin_all(10)
	panel.add_theme_stylebox_override("panel", box)
	var col: = VBoxContainer.new()
	col.add_theme_constant_override("separation", 6)
	panel.add_child(col)
	col.add_child(_ro_text(tr("Quest: %s") % tr(str(d.name)), 15, Color(0.55, 0.32, 0.0), true))
	var what: = tr(str(d.objective))
	match str(d.type):
		"defend":
			what = tr("%s durante %d s.") % [tr(str(d.objective)), roundi(q._scaled("duration"))]
		"hunt", "ritual":
			what = tr("%s antes de %d s.") % [tr(str(d.objective)), roundi(q._scaled("duration"))]
	var goal: = _ro_text(what, 13)
	goal.autowrap_mode = TextServer.AUTOWRAP_WORD_SMART
	col.add_child(goal)
	col.add_child(_ro_text(tr("Recompensa:"), 13, Color.BLACK, true))
	for r in _quest_rewards(d):
		col.add_child(_reward_row(r))
	return panel



func _quest_rewards(d: Dictionary) -> Array:
	var out: = []
	var rw: Dictionary = d.get("reward", {})
	if rw.has("unlock"):
		var npc_id: = str(rw.unlock)
		for n in GameData.TOWN_NPCS:
			if n.id == npc_id:
				var spr: = RoAssets.sprite([str(n.sprite)])
				var tex: Texture2D = spr.get_frame(0, 0) if spr != null else null
				out.append([tex, tr("%s abre su puesto en Prontera") % tr(str(n.name)), ""])
	if rw.has("recipe"):
		var r: Dictionary = GameData.RECIPES[str(rw.recipe)]
		out.append([_item_icon(str(r.icon)), tr("Receta: %s") % tr(str(r.name)), tr(str(r.desc))])
	if rw.has("pet"):
		var pet: Dictionary = GameData.PETS[str(rw.pet)]
		var ps: = RoAssets.sprite([str(rw.pet)])
		out.append([ps.get_frame(0, 0) if ps != null else null, tr("Mascota: %s") % tr(str(pet.name)), tr(str(pet.desc))])
	if rw.has("card"):
		var card: Dictionary = GameData.CARDS[str(rw.card)]
		out.append([RoAssets.card_art(str(rw.card)), tr("%s para tu álbum y una Carta Eterna") % tr(str(card.name)), tr(str(card.desc))])
	return out



func _reward_row(r: Array) -> PanelContainer:
	var card: = PanelContainer.new()
	var box: = StyleBoxFlat.new()
	box.bg_color = Color(1.0, 1.0, 1.0, 0.85)
	box.border_color = Color(0.86, 0.76, 0.5)
	box.set_border_width_all(1)
	box.set_corner_radius_all(3)
	box.set_content_margin_all(6)
	card.add_theme_stylebox_override("panel", box)
	var row: = HBoxContainer.new()
	row.add_theme_constant_override("separation", 10)
	card.add_child(row)
	var icon: = UiKit.icon_rect(r[0], QUEST_REWARD_ICON)
	icon.size_flags_vertical = Control.SIZE_SHRINK_CENTER
	row.add_child(icon)
	var info: = VBoxContainer.new()
	info.add_theme_constant_override("separation", 2)
	info.size_flags_horizontal = Control.SIZE_EXPAND_FILL
	info.size_flags_vertical = Control.SIZE_SHRINK_CENTER
	row.add_child(info)
	var what: = _ro_text(str(r[1]), 13, Color.BLACK, true)
