func _gear_slot(gear: Dictionary, slot: String, mirror: bool, centered: = false) -> HBoxContainer:
	var it: = _clean_item(gear.get(slot))
	var row: = HBoxContainer.new()
	row.add_theme_constant_override("separation", 6)
	row.custom_minimum_size.x = 130.0 if centered else 175.0
	var cell: = PanelContainer.new()
	cell.custom_minimum_size = Vector2(32, 32)
	cell.size_flags_vertical = Control.SIZE_SHRINK_CENTER
	cell.add_theme_stylebox_override("panel", _cell_box(Equipment.item_color(it) if not it.is_empty() else Color(0.8, 0.82, 0.88), false, 1))
	if not it.is_empty():
		cell.add_child(UiKit.icon_rect(_item_icon(str(Equipment.item_def(it).get("icon", it.id))), 24))
		_grade_deco(cell, it)
		cell.mouse_filter = Control.MOUSE_FILTER_PASS
		_set_hover(cell, _item_hover(it))
	var words: = VBoxContainer.new()
	words.add_theme_constant_override("separation", 0)
	words.size_flags_horizontal = Control.SIZE_EXPAND_FILL
	words.alignment = BoxContainer.ALIGNMENT_CENTER
	var tag: = _ro_text(tr(str(GameData.SLOT_NAMES.get(slot, slot))), 10, Color(0.28, 0.3, 0.4))
	var name: = _ro_text(Equipment.item_name(it) if not it.is_empty() else "—", 12, 
		Equipment.item_color(it).darkened(0.25) if not it.is_empty() else Color(0.42, 0.44, 0.52), not it.is_empty())
	for l: Label in [tag, name]:
		l.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER if centered else (HORIZONTAL_ALIGNMENT_RIGHT if mirror else HORIZONTAL_ALIGNMENT_LEFT)
		l.clip_text = true
		UiKit.fit_dots(l)
		l.tooltip_text = l.text
		words.add_child(l)
	if centered:

		row.alignment = BoxContainer.ALIGNMENT_CENTER
		var col: = VBoxContainer.new()
		col.add_theme_constant_override("separation", 2)
		cell.size_flags_horizontal = Control.SIZE_SHRINK_CENTER
		col.add_child(cell)
		col.add_child(words)
		row.add_child(col)
		return row
	if mirror:
		row.add_child(words)
		row.add_child(cell)
	else:
		row.add_child(cell)
		row.add_child(words)
	return row




func _clean_item(it: Variant) -> Dictionary:
	if not it is Dictionary or not GameData.ITEMS.has(str(it.get("id", ""))):
		return {}
	var c: = {}
	for k in it:
		var v = it[k]
		if v is int or v is float or v is bool or v is String:
			c[str(k)] = v
	c["id"] = str(it.id)
	c["refine"] = clampi(int(c.get("refine", 0)), 0, 20)
	c["slots"] = clampi(int(c.get("slots", 0)), 0, 4)
	for k in ["cards", "eternal"]:
		var list = it.get(k, [])
		c[k] = (list as Array).filter( func(x): return GameData.CARDS.has(str(x))).slice(0, 8) if list is Array else []

	var pot: = Potential.clean(it.get("pot"))
	if not pot.is_empty():
		c["pot"] = pot
	return c



func show_trade_ask(from: int, who: String) -> void :
	_mode = "trade_ask"
