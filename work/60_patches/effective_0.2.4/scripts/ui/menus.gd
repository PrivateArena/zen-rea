func _hide_item_hover() -> void :
	_touch_pending = []

	if _hover_pinned and _hover_card != null and is_instance_valid(_hover_card):
		return
	_hover_pinned = false
	if _hover_card != null and is_instance_valid(_hover_card):
		_hover_card.queue_free()
	_hover_card = null
	_hover_args = []





const TOUCH_HOLD: = 0.4
const TOUCH_SLOP: = 14.0
var _touch_down: = false
var _touch_fired: = false
var _touch_t: = 0.0
var _touch_at: = Vector2.ZERO

var _touch_pending: Array = []
var _touch_now: = false
var _hover_pinned: = false




func _touch_defer(show: Callable, anchor: Control) -> bool:
	if not touch_ui() or _touch_now:
		return false
	if _hover_pinned and _hover_args.size() > 1 and _hover_args[1] == anchor:
		return true
	_touch_pending = [show, anchor]
	return true


func _touch_hold_input(event: InputEvent) -> void :
	if not touch_ui():
		return
	if event is InputEventMouseButton and event.button_index == MOUSE_BUTTON_LEFT:
		if event.pressed:

			if _hover_pinned:
				_hover_pinned = false
				_hide_item_hover()
			_touch_down = true
			_touch_fired = false
			_touch_t = 0.0
			_touch_at = event.position
		else:
			_touch_down = false
			if not _hover_pinned:
				_touch_pending = []
			if _touch_fired:

				_touch_fired = false
				get_viewport().set_input_as_handled()
	elif event is InputEventMouseButton and event.button_index == MOUSE_BUTTON_RIGHT and _touch_fired:


		get_viewport().set_input_as_handled()
	elif event is InputEventMouseMotion and _touch_down and event.position.distance_to(_touch_at) > TOUCH_SLOP:

		_touch_down = false
		_touch_pending = []


func _touch_hold_tick(delta: float) -> void :
	if not _touch_down or _touch_fired or _touch_pending.is_empty():
		return
	_touch_t += delta
	if _touch_t < TOUCH_HOLD:
		return
	var pend: = _touch_pending
	_touch_pending = []
	if not is_instance_valid(pend[1]) or not (pend[1] as Control).is_visible_in_tree():
		return
	_touch_fired = true
	_touch_now = true
	(pend[0] as Callable).call()
	_touch_now = false
	if _hover_card == null or not is_instance_valid(_hover_card):
		return
	_hover_pinned = true
	Input.vibrate_handheld(30)
	_place_hover_away(_hover_card, _touch_at)




func _place_hover_away(panel: Control, at: Vector2) -> void :
	if _ro_window_root != null and is_instance_valid(_ro_window_root) and _ro_window_root.scale.x > 1.0:
		panel.scale = _ro_window_root.scale

	await get_tree().process_frame
	await get_tree().process_frame
	if not is_instance_valid(panel):
		return
	var view: = get_viewport().get_visible_rect().size
	var sz: = panel.get_combined_minimum_size() * panel.scale
	var gap: = 64.0
	var x: = at.x - gap - sz.x if at.x > view.x * 0.5 else at.x + gap
	if x < 4.0 or x + sz.x > view.x - 4.0:
		x = at.x + gap if x < 4.0 else at.x - gap - sz.x
	x = clampf(x, 4.0, maxf(4.0, view.x - sz.x - 4.0))
	var y: = clampf(at.y - sz.y * 0.5, 4.0, maxf(4.0, view.y - sz.y - 4.0))
	panel.global_position = Vector2(x, y).floor()



func _mods_delta(new: Dictionary, old: Dictionary) -> Dictionary:
	var out: = {}
	for k in new:
		out[k] = float(new[k]) - float(old.get(k, 0.0))
	for k in old:
		if not new.has(k):
			out[k] = - float(old[k])
	return out



