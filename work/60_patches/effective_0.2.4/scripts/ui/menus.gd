		var text: = field.text.strip_edges()
		if text == "":
			return
		_friends_note(tr("Enviando..."), true)
		fr.ask(text, func(status: String, shown: String):
			var notes: = {"sent": [tr("Solicitud enviada a %s.") % shown, true], 
				"accepted": [tr("¡%s ya es tu amigo!") % shown, true], 
				"already": [tr("%s ya está en tu lista.") % shown, false], 
				"not_found": [tr("No encontramos a nadie con ese Nombre#TAG. Tiene que haber abierto el juego con este nombre."), false], 
				"self": [tr("Ese eres tú."), false], "full": [tr("Tu lista está llena (50)."), false], 
				"bad": [tr("Escríbelo como Nombre#TAG, por ejemplo Aventurero#3C7D."), false], 
				"offline": [tr("Sin conexión: inténtalo de nuevo."), false]}
			var n: Array = notes.get(status, notes.not_found)
			_friends_note(str(n[0]), bool(n[1]))
			if _mode == "friends":
				if status in ["sent", "accepted"]:
					_friends_tab = "friends" if status == "accepted" else "requests"
				show_friends(back))
	var add_b: = _ro_button(tr("Agregar"), send)
	add_b.custom_minimum_size = Vector2(80, 36 if touch else 26)
