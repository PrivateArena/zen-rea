	return b




func _grade_deco(cell: Control, it) -> void :
	var g: = Equipment.grade(it)
	if g <= 0 or cell == null:
		return
	var gd: Dictionary = GameData.WEAPON_GRADES[g]
	var col: Color = gd.color
	var boxes: Array[StyleBoxFlat] = []
	for st in ["panel", "normal", "hover", "pressed", "focus", "disabled"]:
		if cell.has_theme_stylebox_override(st):
			var sb: = cell.get_theme_stylebox(st) as StyleBoxFlat
			if sb != null and not boxes.has(sb):
				boxes.append(sb)
	for sb in boxes:
		sb.border_color = col
		sb.set_border_width_all(maxi(2, sb.border_width_left))
		sb.shadow_color = Color(col, 0.8)
		sb.shadow_size = 4
	if not boxes.is_empty():
		var tw: = cell.create_tween().set_loops()
		for sb in boxes:
			tw.parallel().tween_property(sb, "shadow_size", 8, 0.9).set_trans(Tween.TRANS_SINE)
		for sb in boxes:
			tw.parallel().tween_property(sb, "shadow_color:a", 0.45, 0.9).set_trans(Tween.TRANS_SINE)
		tw.chain()
		for sb in boxes:
			tw.parallel().tween_property(sb, "shadow_size", 4, 0.9).set_trans(Tween.TRANS_SINE)
		for sb in boxes:
			tw.parallel().tween_property(sb, "shadow_color:a", 0.8, 0.9).set_trans(Tween.TRANS_SINE)



	var deco: = Control.new()
	deco.mouse_filter = Control.MOUSE_FILTER_IGNORE
	deco.set_anchors_and_offsets_preset(Control.PRESET_FULL_RECT)
	cell.add_child(deco)

	if g >= GameData.WEAPON_GRADES.size() - 1:
		GradeFx.shine(deco)
	var tag: = _ro_text(str(gd.name), 11, col.lightened(0.15), true)
	tag.add_theme_color_override("font_outline_color", col.darkened(0.7))
	tag.add_theme_constant_override("outline_size", 4)
	tag.mouse_filter = Control.MOUSE_FILTER_IGNORE
	tag.set_anchors_preset(Control.PRESET_TOP_RIGHT)
	tag.grow_horizontal = Control.GROW_DIRECTION_BEGIN
	tag.grow_vertical = Control.GROW_DIRECTION_END
	tag.offset_right = -1
	tag.offset_top = -1
