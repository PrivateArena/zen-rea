	_mode = "hel_ask"
	var col: = _screen(tr("Lucile  ·  Torre de Hel"), "")
	_npc_cutin("tnm_lucile02")
	_cutin_say(GameData.HEL_LUCILE_ASK.map( func(l): return tr(str(l))), tr("Lucile"))
	_hel_flames(0.35)
	col.custom_minimum_size.x = 470
	var head: = UiKit.label(tr("¿Bajar a la Torre de Hel?"), 22, Color(0.62, 0.06, 0.12), true)
	head.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER
	col.add_child(head)
	var box: = PanelContainer.new()
	var sb: = UiKit.panel_box(Color(0.16, 0.04, 0.08), Color(0.95, 0.45, 0.2), 10, 2)
