	control.size_flags_vertical = Control.SIZE_SHRINK_CENTER
	right.add_child(control)
	row.add_child(right)




func _opt_segments(opts: Array, current: Variant, on_pick: Callable, big: = false) -> PanelContainer:
	var holder: = PanelContainer.new()
	var bg: = UiKit.panel_box(Color(0.9, 0.92, 0.97), Color(0.8, 0.84, 0.93), 10 if big else 8, 1)
	bg.shadow_size = 0
	bg.set_content_margin_all(3)
	holder.add_theme_stylebox_override("panel", bg)
	var row: = HBoxContainer.new()
	row.add_theme_constant_override("separation", 2)
	holder.add_child(row)
	var buttons: Array[Button] = []
	var paint: = func(value: Variant):
		for i in buttons.size():
			var on: bool = opts[i][1] == value
			var st: = StyleBoxFlat.new()
			st.set_corner_radius_all(8 if big else 6)
			st.content_margin_left = 16 if big else 10
			st.content_margin_right = 16 if big else 10
			st.content_margin_top = 4
			st.content_margin_bottom = 4
			st.anti_aliasing = true
			if on:
				st.bg_color = OPT_ACCENT
				st.shadow_color = Color(OPT_ACCENT_DARK, 0.35)
				st.shadow_size = 3
				st.shadow_offset = Vector2(0, 1)
			else:
				st.bg_color = Color(1, 1, 1, 0.0)
			var hov: = st.duplicate() as StyleBoxFlat
			if not on:
				hov.bg_color = Color(1, 1, 1, 0.75)
			for state in ["normal", "focus", "disabled"]:
				buttons[i].add_theme_stylebox_override(state, st)
			for state in ["hover", "pressed", "hover_pressed"]:
				buttons[i].add_theme_stylebox_override(state, hov)
			var ink: = Color.WHITE if on else Color(0.2, 0.26, 0.45)
			for c in ["font_color", "font_hover_color", "font_focus_color", "font_pressed_color", "font_hover_pressed_color"]:
				buttons[i].add_theme_color_override(c, ink)
			buttons[i].add_theme_font_override("font", UiKit.FONT_TITLE if on else UiKit.FONT_BODY)
	for o in opts:
		var b: = Button.new()
		b.text = str(o[0])
		b.focus_mode = Control.FOCUS_ALL
		b.add_theme_font_size_override("font_size", 15 if big else 13)
		b.custom_minimum_size = Vector2(104 if big else 0, 32 if big else 26)
		var value: Variant = o[1]
		b.pressed.connect( func():
			paint.call(value)
			on_pick.call(value))
		buttons.append(b)
		row.add_child(b)
	paint.call(current)
	return holder



func _opt_choice(key: String, default: Variant, opts: Array, apply: = Callable()) -> PanelContainer:
	return _opt_segments(opts, Save.setting(key, default), func(v):
		Save.set_setting(key, v)
		world.play_sound("ui_click", 0.05, -6.0)
		if apply.is_valid():
			apply.call())



func _opt_switch(key: String, default: bool, apply: = Callable()) -> Button:
	var b: = Button.new()
	b.toggle_mode = true
	b.focus_mode = Control.FOCUS_ALL
	b.custom_minimum_size = Vector2(46, 26)
	b.button_pressed = bool(Save.setting(key, default))
	var clear: = StyleBoxEmpty.new()
	for state in ["normal", "hover", "pressed", "hover_pressed", "focus", "disabled"]:
		b.add_theme_stylebox_override(state, clear)
	b.draw.connect( func():
		var on: = b.button_pressed
		var track: = StyleBoxFlat.new()
		track.set_corner_radius_all(13)
		track.anti_aliasing = true
		track.bg_color = OPT_ACCENT if on else Color(0.8, 0.83, 0.9)
		if b.is_hovered():
			track.bg_color = track.bg_color.lightened(0.08)
		b.draw_style_box(track, Rect2(Vector2.ZERO, b.size))
		var r: = b.size.y * 0.5 - 3.0
		var cx: = b.size.x - r - 3.0 if on else r + 3.0
		b.draw_circle(Vector2(cx, b.size.y * 0.5 + 1.0), r, Color(0.05, 0.08, 0.2, 0.18))
		b.draw_circle(Vector2(cx, b.size.y * 0.5), r, Color.WHITE))
	b.mouse_entered.connect(b.queue_redraw)
	b.mouse_exited.connect(b.queue_redraw)
	b.toggled.connect( func(on: bool):
		Save.set_setting(key, on)
		b.queue_redraw()
		world.play_sound("ui_click", 0.05, -6.0)
		if apply.is_valid():
			apply.call())
	return b


static var _knob_tex: Texture2D


func _opt_volume(key: String, default: = 0.8) -> HBoxContainer:
	var box: = HBoxContainer.new()
	box.add_theme_constant_override("separation", 10)
	var slider: = HSlider.new()
	slider.min_value = 0.0
	slider.max_value = 1.0
	slider.step = 0.05
	slider.custom_minimum_size = Vector2(230, 24)
	slider.focus_mode = Control.FOCUS_ALL
	var track: = StyleBoxFlat.new()
	track.bg_color = Color(0.86, 0.88, 0.94)
	track.set_corner_radius_all(4)
	track.content_margin_top = 3
	track.content_margin_bottom = 3
	var fill: = track.duplicate() as StyleBoxFlat
	fill.bg_color = OPT_ACCENT
	slider.add_theme_stylebox_override("slider", track)
	slider.add_theme_stylebox_override("grabber_area", fill)
	slider.add_theme_stylebox_override("grabber_area_highlight", fill)
	if _knob_tex == null:
		var img: = Image.create(18, 18, false, Image.FORMAT_RGBA8)
		for y in 18:
			for x in 18:
				var d: = Vector2(x + 0.5, y + 0.5).distance_to(Vector2(9, 9))
				if d <= 8.5:
					var rim: = d > 7.0
					img.set_pixel(x, y, OPT_ACCENT if rim else Color.WHITE)
				elif d <= 9.0:
					img.set_pixel(x, y, Color(OPT_ACCENT, 9.0 - d))
		_knob_tex = ImageTexture.create_from_image(img)
	for icon in ["grabber", "grabber_highlight", "grabber_disabled"]:
		slider.add_theme_icon_override(icon, _knob_tex)
	var pct: = UiKit.label("", 13, UiKit.TEXT, true)
	pct.custom_minimum_size.x = 48
	pct.horizontal_alignment = HORIZONTAL_ALIGNMENT_RIGHT
	pct.size_flags_vertical = Control.SIZE_SHRINK_CENTER
	var show: = func(v: float):
		pct.text = "%d%%" % roundi(v * 100.0) if v > 0.0 else tr("Mudo")
	slider.value = float(Save.setting(key, default))
	show.call(slider.value)
	slider.value_changed.connect( func(v: float):
		show.call(v)
		Save.set_setting(key, v)
		world.apply_audio_settings()
		if key == "sfx" or key == "ui_volume":
			world.play_sound("ui_click", 0.05, 0.0))
	box.add_child(slider)
	box.add_child(pct)
	return box



func _opt_percents(key: String, fallback: float, values: Array, set_to: = Callable()) -> PanelContainer:
	var opts: = []
	var current: = float(Save.setting(key, fallback))
	var now: Variant = values[0]
	for v in values:
		opts.append(["%d%%" % roundi(float(v) * 100.0), v])
		if absf(float(v) - current) < 0.01:
			now = v
	return _opt_segments(opts, now, func(v):
		world.play_sound("ui_click", 0.05, -6.0)
		if set_to.is_valid():
			set_to.call(v)
			return
		Save.set_setting(key, v)
		world.apply_audio_settings())




func _set_num_alpha(v: float) -> void :
	var was: = float(Save.setting("num_alpha", 0.8))
	Save.set_setting("num_alpha", v)


	var saved = Save.data.settings.get("damage_numbers", true)
	var mode: = ("all" if saved else "none") if saved is bool else str(saved)
	if v <= 0.001 and mode != "none":
		Save.set_setting("num_mode_back", mode)
		Save.set_setting("damage_numbers", "none")
	elif v > 0.001 and was <= 0.001 and mode == "none":
		Save.set_setting("damage_numbers", str(Save.setting("num_mode_back", "all")))


