func _trade_refresh() -> void :
	_trade_side_box(_tr_left_box, trade.my_ok)
	_trade_side_box(_tr_right_box, trade.their_ok)

	_trade_empty(_tr_left)
	for uid in trade.mine.items:
		var it: = Save.storage_item(str(uid))
		if not it.is_empty():
			_tr_left.add_child(_trade_row_item(it, func(_all: bool): trade.take_back("items", str(uid))))
	for cid in trade.mine.cards:
		_tr_left.add_child(_trade_row_card(cid, int(trade.mine.cards[cid]), func(all: bool): trade.take_back("cards", cid, -1 if all else 1)))
	for k in trade.mine.mats:
		_tr_left.add_child(_trade_row_mat(k, int(trade.mine.mats[k]), func(all: bool): trade.take_back("mats", k, -1 if all else 1)))
	for c in trade.mine.get("cos", []):
		_tr_left.add_child(_trade_row_cos(str(c), func(_all: bool): trade.take_back("cos", str(c))))
	for cid in trade.mine.get("eter", {}):
		_tr_left.add_child(_trade_row_eternal(cid, int(trade.mine.eter[cid]), func(all: bool): trade.take_back("eter", cid, -1 if all else 1)))
	_tr_zeny.editable = not trade.my_ok
	if not _tr_zeny.has_focus():
		_tr_zeny.text = RoBasicWindow._thousands(int(trade.mine.zeny))

	_trade_empty(_tr_right)
	for it in trade.theirs.items:
		_tr_right.add_child(_trade_row_item(it, Callable()))
	for cid in trade.theirs.cards:
		_tr_right.add_child(_trade_row_card(cid, int(trade.theirs.cards[cid]), Callable()))
	for k in trade.theirs.mats:
		_tr_right.add_child(_trade_row_mat(k, int(trade.theirs.mats[k]), Callable()))
	for c in trade.theirs.get("cos", []):
		_tr_right.add_child(_trade_row_cos(str(c), Callable()))
	for cid in trade.theirs.get("eter", {}):
		_tr_right.add_child(_trade_row_eternal(cid, int(trade.theirs.eter[cid]), Callable()))
	_tr_their_zeny.text = RoBasicWindow._thousands(int(trade.theirs.zeny))

	_trade_empty(_tr_buttons)
	var ok: = _ro_button(tr("OK"), trade.press_ok, not trade.my_ok)
	ok.custom_minimum_size.x = 64
	_tr_buttons.add_child(ok)
	var mid: = Control.new()
	mid.size_flags_horizontal = Control.SIZE_EXPAND_FILL
	_tr_buttons.add_child(mid)
	var go: = _ro_button(tr("Esperando...") if trade.my_ready else tr("Comerciar"), _show_trade_confirm, 
		trade.my_ok and trade.their_ok and not trade.my_ready and trade.blocked() == "")
	go.custom_minimum_size.x = 96
	_tr_buttons.add_child(go)
	var mid2: = Control.new()
	mid2.size_flags_horizontal = Control.SIZE_EXPAND_FILL
	_tr_buttons.add_child(mid2)
	var cancel: = _ro_button(tr("Cancelar"), trade.cancel)
	cancel.custom_minimum_size.x = 64
	_tr_buttons.add_child(cancel)
	var status: = ""
	if trade.blocked() != "":
		status = trade.blocked()
	elif trade.my_ready:
		status = tr("Confirmaste. Esperando que %s confirme...") % trade.partner_name
	elif trade.my_ok and trade.their_ok:
		status = tr("Los dos pusieron OK: revisa y pulsa Comerciar.")
	elif trade.my_ok:
		status = tr("Tu lado está listo. Esperando el OK de %s...") % trade.partner_name
	elif trade.their_ok:
		status = tr("%s ya puso OK. Pon lo tuyo y pulsa OK.") % trade.partner_name
	else:
		status = tr("Clic en tu inventario para ofrecer (clic derecho: todas las copias). Clic en lo ofrecido para quitarlo.")
	_tr_status.text = status
	_trade_picker()

	if _ro_window_root != null and is_instance_valid(_ro_window_root):
		_ro_window_root.reset_size()




func _trade_empty(box: Node) -> void :
	for c in box.get_children():
		box.remove_child(c)
		c.queue_free()



func _trade_row(icon: Texture2D, count: int, text: String, color: Color, act: Callable) -> PanelContainer:
	var row: = PanelContainer.new()
	var sb: = StyleBoxFlat.new()
	sb.bg_color = Color(0, 0, 0, 0)
	sb.set_content_margin_all(1)
	row.add_theme_stylebox_override("panel", sb)
	row.mouse_filter = Control.MOUSE_FILTER_STOP
	var h: = HBoxContainer.new()
	h.add_theme_constant_override("separation", 6)
	h.mouse_filter = Control.MOUSE_FILTER_IGNORE
	row.add_child(h)
	var ic: = Control.new()
	ic.custom_minimum_size = Vector2(24, 20)
	ic.mouse_filter = Control.MOUSE_FILTER_IGNORE
	h.add_child(ic)
	var tex: = UiKit.icon_rect(icon, 20)
	tex.mouse_filter = Control.MOUSE_FILTER_IGNORE
	ic.add_child(tex)
	if count > 1:
		var n: = _ro_text(str(count), 9, Color.BLACK, true)
		n.add_theme_constant_override("outline_size", 3)
		n.add_theme_color_override("font_outline_color", Color.WHITE)
		n.position = Vector2(-2, 9)
		ic.add_child(n)
	var l: = _ro_text(text, 11, color)
	l.size_flags_horizontal = Control.SIZE_EXPAND_FILL
	l.clip_text = true
	UiKit.fit_dots(l)
	h.add_child(l)
	if act.is_valid() and not trade.my_ok:
		row.mouse_default_cursor_shape = Control.CURSOR_POINTING_HAND
		row.mouse_entered.connect( func(): sb.bg_color = Color(0.9, 0.93, 1.0);row.queue_redraw())
		row.mouse_exited.connect( func(): sb.bg_color = Color(0, 0, 0, 0);row.queue_redraw())
		row.gui_input.connect( func(ev: InputEvent):
			if ev is InputEventMouseButton and ev.pressed and ev.button_index in [MOUSE_BUTTON_LEFT, MOUSE_BUTTON_RIGHT]:
				_hide_item_hover()
				ui_click()
				act.call(ev.button_index == MOUSE_BUTTON_RIGHT or ev.shift_pressed))
	return row


func _trade_row_item(it: Dictionary, act: Callable) -> Control:
	var row: = _trade_row(_item_icon(Equipment.item_def(it).icon), 1, Equipment.item_name(it), Equipment.item_color(it).darkened(0.2), act)
	var et: Array = it.get("eternal", [])
	if not et.is_empty():
		var l: Label = row.get_child(0).get_child(1)
		l.text += "  ·  " + tr("%d Carta(s) Eterna(s)") % et.size()
	row.mouse_entered.connect( func(): _show_item_hover(it, row))
	row.mouse_exited.connect(_hide_item_hover)
	return row


