func show_job_change() -> void :
	var p: = world.player
	if auto_pick:
		var n: = GameData.job_paths(p.class_id).size()
		var args: = OS.get_cmdline_user_args()
		var at: = args.find("--path")
		world.do_job_change(clampi(int(args[at + 1]), 0, n - 1) if at >= 0 and args.size() > at + 1 else randi() % maxi(1, n))
		return
	_mode = "job_change"
	world.hold_world()
	_grace = INPUT_GRACE
	var paths: = GameData.job_paths(p.class_id)
	var col: = _screen(tr("Cambio de oficio"), tr("Has alcanzado Base Lv %d. Elige tu camino.") % GameData.JOB_CHANGE_LEVEL
		if paths.size() > 1 else tr("Has alcanzado Base Lv %d. El gremio te reconoce como %s.") % [GameData.JOB_CHANGE_LEVEL, tr(GameData.job_title(p.next_job(), p.female()))])
	var row: = HBoxContainer.new()
	row.alignment = BoxContainer.ALIGNMENT_CENTER
	row.add_theme_constant_override("separation", 18)
	col.add_child(row)
	var first: Button = null



	var compact: = get_viewport().get_visible_rect().size.y < 660.0
	for i in paths.size():
		compact = compact or p.next_job(i).skills.size() > JOB_CARD_SKILLS
	for i in paths.size():
		var job: Dictionary = p.next_job(i)
		var b: = _job_path_card(p, job, i, paths.size() > 1, compact)
		row.add_child(b)
		if first == null:
			first = b
	if first != null:
		first.grab_focus.call_deferred()

	var even: = func():
		var tallest: = 0.0
		for c in row.get_children():
			tallest = maxf(tallest, (c as Control).get_combined_minimum_size().y)
		for c in row.get_children():
			(c as Control).custom_minimum_size.y = tallest
	even.call_deferred()
	var slots: = GameData.JOB_EXTRA_SKILLS + (GameData.TRANS_EXTRA_SKILLS if p.reborn else 0)
	var pslots: = GameData.JOB_EXTRA_PASSIVES + (GameData.TRANS_EXTRA_PASSIVES if p.reborn else 0)
	var note: = UiKit.label(tr("+%d ranura de habilidad  ·  +%d de pasiva  ·  la elección dura toda la partida") % [slots, pslots], 13, UiKit.MUTED)
	note.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER
	col.add_child(note)
	if showcase:
		get_tree().create_timer(2.2).timeout.connect( func():
			if _mode == "job_change":
				world.do_job_change())



