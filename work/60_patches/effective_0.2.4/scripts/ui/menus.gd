func _kit_now(cid: String) -> Dictionary:
	return {"gear": Save.loadout(cid).duplicate(), "cards": Save.equipped_cards().duplicate(), "dishes": Save.dishes().duplicate(), 
		"pet": Save.active_pet(), "pet_skin": Save.pet_skin(), "pacts": Save.pacts(cid).duplicate(), 
		"plag_on": Save.plagiarism_active().duplicate(), "plag_pick": Save.plagiarism_pick(), 
		"bans": _class_setting("run_bans", cid, []), "favs": _class_setting("run_favs", cid, []), 
		"pick_order": _class_setting("pick_order", cid, []), "pick_limits": _class_setting("pick_limits", cid, {}), 
		"pick_bans": _class_setting("pick_bans", cid, [])}



static func _class_setting(key: String, cid: String, fallback: Variant) -> Variant:
	var all = Save.setting(key, {})
	var v = all.get(cid, fallback) if all is Dictionary else fallback
	if typeof(v) != typeof(fallback):
		v = fallback
	return v.duplicate(true)



static func _set_class_setting(key: String, cid: String, v: Variant) -> void :
	var all = Save.setting(key, {})
	var d: Dictionary = (all as Dictionary).duplicate(true) if all is Dictionary else {}
	if v.is_empty():
		d.erase(cid)
	else:
		d[cid] = v.duplicate(true)
	Save.set_setting(key, d)




func _kit_apply(cid: String, v: Variant) -> String:
	var k: Dictionary = v if v is Dictionary else {}
	var notes: Array[String] = []
	if k.has("gear"):
		var g: = _load_gear_set(cid, k.gear)
		if g != "":
			notes.append(g)
	if k.has("cards"):
		var c: = _load_card_set(k.cards)
		if c != "":
			notes.append(c)
	if k.has("dishes"):
		_load_dish_set(k.dishes)
	var pet: = str(k.get("pet", ""))
	if pet == "" or Save.has_pet(pet):
		Save.set_active_pet(pet)
	var skin: = str(k.get("pet_skin", ""))
	if skin != "" and Save.has_pet(skin):
		Save.set_pet_skin(skin)
	if k.get("pacts") is Array:
		var want: Array = k.pacts
		for id in Save.pacts(cid):
			if not want.has(id):
				Save.toggle_pact(cid, str(id))
		for id in want:
			if GameData.PACTS.has(str(id)) and GameData.pact_unlocked(str(id)) and not Save.pacts(cid).has(id):
				Save.toggle_pact(cid, str(id))
	if k.get("plag_on") is Array:
		var on: Array = k.plag_on
		for id in Save.plagiarism_active():
			if not on.has(id):
				Save.toggle_plagiarism(str(id))
		for id in on:
			if Save.plagiarized().has(id) and not Save.plagiarism_active().has(id):
				Save.toggle_plagiarism(str(id))
	if k.has("plag_pick"):
		var pick: = str(k.plag_pick)
		if pick != Save.plagiarism_pick():
			if pick == "":
				Save.set_plagiarism_pick(Save.plagiarism_pick())
			elif Save.plagiarized().has(pick):
				Save.set_plagiarism_pick(pick)

	for key in ["bans:run_bans", "favs:run_favs", "pick_order:pick_order", "pick_limits:pick_limits", "pick_bans:pick_bans"]:
		var f: String = key.get_slice(":", 0)
		if k.get(f) is Array or k.get(f) is Dictionary:
			_set_class_setting(key.get_slice(":", 1), cid, k[f])
	Save.flush()
	return "  ".join(notes)




func _load_dish_set(value: Variant) -> String:
	var want: Array = value if value is Array else []
	var ok: = want.filter( func(d): return GameData.RECIPES.has(str(d)) and Save.recipe_known(str(d)))
	Save.set_dishes(ok)
	var missing: = want.size() - mini(ok.size(), Save.cook_level())
	return tr("%d plato(s) no caben o aún no sabes la receta.") % missing if missing > 0 else ""


