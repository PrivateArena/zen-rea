		b.mouse_entered.connect(walk_on.bind(true))
		b.mouse_exited.connect(walk_on.bind(false))
		b.focus_entered.connect(walk_on.bind(true))
		b.focus_exited.connect(walk_on.bind(false))
		b.pressed.connect( func():
			world.play_sound("ui_click", 0.0, -4.0)
			close()
			_mode = "town"
			world.town.change_hero(id))
	return b





class HeroFigure extends Control:
	var ro: RoSprite
	var walking: = false:
		set(v):
			walking = v
			_f = 0
			_t = 0.0
			queue_redraw()
	var glow: = false
	var _t: = 0.0
	var _f: = 0

	func _ready() -> void :
		mouse_filter = Control.MOUSE_FILTER_IGNORE
		texture_filter = RoAssets.ui_filter()

	func _process(delta: float) -> void :
		if ro == null or not walking:
			return
		var act: = RoVisual.PC_WALK * RoSprite.DIRS
		_t += delta
		var step: = maxf(0.05, ro.frame_delay(act))
		if _t >= step:
			_t = fmod(_t, step)
			_f = (_f + 1) % maxi(1, ro.frame_count(act))
			queue_redraw()

	func _draw() -> void :
		var feet: = Vector2(roundf(size.x * 0.5), size.y - 6.0)
		if glow:
			draw_set_transform(feet - Vector2(0, 34), 0.0, Vector2(0.8, 1.2))
			for k in 6:
				draw_circle(Vector2.ZERO, 34.0 - k * 5.0, Color(1.0, 0.82, 0.35, 0.07))
			draw_set_transform(Vector2.ZERO)
		draw_set_transform(feet, 0.0, Vector2(1.0, 0.32))
		draw_circle(Vector2.ZERO, 17.0, Color(0.1, 0.12, 0.25, 0.16))
		draw_circle(Vector2.ZERO, 11.0, Color(0.1, 0.12, 0.25, 0.12))
		draw_set_transform(Vector2.ZERO)
		if ro == null:
			return
		var act: = (RoVisual.PC_WALK if walking else RoVisual.PC_IDLE) * RoSprite.DIRS
		var tex: = ro.get_frame(act, _f if walking else 0)
		if tex != null:
			draw_texture(tex, (feet - Vector2(ro.origin)).floor())









