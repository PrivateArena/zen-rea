const INTRO_KAFRA: = "npc_kafra9"


var _intro_live: = false
var _intro_resume: = false
var _intro_phase: = "ask"
var _intro_line: = 0

const RAIL_OF_BUTTON: = {"btn_town": "town", "btn_style": "char_make", "btn_gear": "loadout", "btn_album": "album"}


func _intro_wanted() -> bool:
	if _intro_resume:
		return true
	_intro_live = false
	if bool(Save.setting("intro_kafra_seen", false)) or not _has_cutin(INTRO_KAFRA):
		return false

	var args: = OS.get_cmdline_user_args()
	if "--intro-tour" in args:
		return true
	return not Array(args).any( func(a): return str(a).begins_with("--") and a != "--lang" and a != "--update-url")


func _class_intro(win: Control) -> void :
	Save.set_setting("intro_kafra_seen", true)
	var resumed: = _intro_resume
	if not resumed:
		_intro_phase = "ask"
		_intro_line = 0
	_intro_live = true
	var view: = get_viewport().get_visible_rect().size



	var art: = TextureRect.new()
	art.texture = load("res://assets/ro/ui/skin/illust/%s.png" % INTRO_KAFRA)
	art.expand_mode = TextureRect.EXPAND_IGNORE_SIZE
	art.stretch_mode = TextureRect.STRETCH_KEEP_ASPECT
	art.flip_h = true
	art.mouse_filter = Control.MOUSE_FILTER_IGNORE
	var aspect: = art.texture.get_width() / float(art.texture.get_height())

	var paint: = _cutin_paint(art.texture)
	var from: = 1.0 - paint.x - paint.y




	const OUT: = 0.15
	var win_right: = win.position.x + RoCharSelect.SIZE.x * win.scale.x
	var room: = view.x - 8.0 - (win_right + 4.0)
	var h: = minf(view.y * 0.74, float(art.texture.get_height()) * 1.25)
	if room > 0.0:
		h = clampf(room / (1.0 - OUT) / (aspect * paint.y), minf(h, view.y * 0.45), h)
	var w: = h * aspect


	var x: = minf(view.x - 8.0 - w * (from + paint.y * (1.0 - OUT)), maxf(win_right + 4.0 - w * from, 
		minf(view.x - 8.0, view.x * 0.96) - w * (from + paint.y)))
	art.position = Vector2(floorf(x), view.y - h)
	art.size = Vector2(w, h)
	var head: = _cutin_head(art.texture)
	var tip: = Vector2(art.position.x + (1.0 - head.x) * w, art.position.y + head.y * h + 6.0)
	_root.add_child(art)
	art.modulate.a = 0.0
	art.position.x += 30.0
	var tw: = art.create_tween().set_pause_mode(Tween.TWEEN_PAUSE_PROCESS)
	tw.tween_property(art, "modulate:a", 1.0, 0.3)
	tw.parallel().tween_property(art, "position:x", -30.0, 0.35).as_relative().set_trans(Tween.TRANS_QUAD).set_ease(Tween.EASE_OUT)

	var ask: = [tr("¡Hola! Tú debes ser nuevo por aquí, ¿no? Soy empleada de la Corporación Kafra. Si quieres, te muestro rápidamente cómo funciona todo antes de que salgas.")]
	var guide: = [
		tr("Aquí eliges a tu personaje. Cada clase tiene sus propias habilidades y su forma de pelear; ninguna es mejor que otra, así que elige la que más te guste. Siempre puedes cambiar después."), 
		tr("Si en algún mapa te cuesta avanzar, pásate por Prontera. Ahí te atiendo yo: con el zeny que juntes puedes comprar mejoras que se quedan para siempre. También vas a encontrar a otros aventureros para conversar o armar grupo."), 
		tr("En el Álbum se va guardando todo lo que encuentras: cartas, mascotas, logros y mucho más. Vale la pena revisarlo de vez en cuando."), 
		tr("En Perfil puedes cambiar el nombre, el peinado y la ropa de tu personaje. Además, a medida que tu clase sube de nivel ganas puntos de atributo, y ahí es donde los repartes."), 
		tr("En Equipo decides con qué equipo empiezas cada partida. Puedes usar cualquier objeto que tengas guardado en el almacén Kafra."), 
		tr("Eso es todo por ahora. Cuando estés listo, presiona OK, elige un mapa y comienza tu aventura. ¡Mucha suerte!"), 
	]
	var bye: = [tr("¡Perfecto! Si en algún momento necesitas ayuda, me encontrarás en Prontera. ¡Buena suerte!")]


	var targets: = ["slots", "btn_town", "btn_album", "btn_style", "btn_gear", "btn_ok"]
	var phase: = ["ask"]
	var bubble: = SayBubble.new()
	bubble.lines = ask
	var col: = VBoxContainer.new()
	col.add_theme_constant_override("separation", 2)
	col.mouse_filter = Control.MOUSE_FILTER_IGNORE
	bubble.add_child(col)
	bubble.who = _ro_text(tr("Empleada Kafra"), 11, Color(0.58, 0.36, 0.08), true)
	col.add_child(bubble.who)
	bubble.text = _ro_text("", 13, Color(0.22, 0.16, 0.32))
	bubble.text.autowrap_mode = TextServer.AUTOWRAP_WORD_SMART
	col.add_child(bubble.text)

	var answers: = HBoxContainer.new()
	answers.add_theme_constant_override("separation", 6)
	answers.alignment = BoxContainer.ALIGNMENT_END
	col.add_child(answers)
	var foot: = HBoxContainer.new()
	foot.mouse_filter = Control.MOUSE_FILTER_IGNORE
	foot.visible = false
	col.add_child(foot)
	var step: = _ro_text("", 9, Color(0.6, 0.5, 0.35))
	step.size_flags_horizontal = Control.SIZE_EXPAND_FILL
	foot.add_child(step)
	bubble.more = _ro_text("▼", 9, Color(0.6, 0.44, 0.2))
	foot.add_child(bubble.more)
	var blink: = bubble.more.create_tween().set_pause_mode(Tween.TWEEN_PAUSE_PROCESS).set_loops()
	blink.tween_property(bubble.more, "modulate:a", 0.2, 0.45)
	blink.tween_property(bubble.more, "modulate:a", 1.0, 0.45)
	var bw: = clampf(view.x * 0.24, 260.0, 340.0)
	bubble.custom_minimum_size.x = bw
	bubble.text.custom_minimum_size.x = bw - 32.0
	_root.add_child(bubble)

	var place: = func():
		if not is_instance_valid(bubble):
			return


		var f: Font = bubble.text.get_theme_font("font")
		var need: = f.get_multiline_string_size(bubble.text.text, HORIZONTAL_ALIGNMENT_LEFT, bw - 32.0, 13).y
		bubble.text.custom_minimum_size.y = ceilf(need) + 2.0
		bubble.reset_size()
		var bh: = bubble.get_combined_minimum_size().y
		var bx: = clampf(tip.x - bw * 0.5, 8.0, view.x - bw - 8.0)

		var by: = maxf(LINKS_BAND + 2.0, tip.y - RO_SAY_TAIL - bh)
		bubble.position = Vector2(floorf(bx), floorf(by))
		bubble.tip = tip - bubble.position
		bubble.queue_redraw()
	bubble.minimum_size_changed.connect(place)


	for t in [0.1, 0.3, 0.6, 1.0, 1.6, 2.4]:
		get_tree().create_timer(t, true).timeout.connect(place)

	var ring: = Panel.new()
	var rs: = StyleBoxFlat.new()
	rs.draw_center = false
	rs.border_color = Color(1.0, 0.72, 0.2)
	rs.set_border_width_all(3)
	rs.set_corner_radius_all(9)
	rs.shadow_color = Color(1.0, 0.75, 0.25, 0.55)
	rs.shadow_size = 8
	rs.anti_aliasing = true
	ring.add_theme_stylebox_override("panel", rs)
	ring.mouse_filter = Control.MOUSE_FILTER_IGNORE
	ring.visible = false

	ring.z_index = 201
	_root.add_child(ring)
	var pulse: = ring.create_tween().set_pause_mode(Tween.TWEEN_PAUSE_PROCESS).set_loops()
	pulse.tween_property(ring, "modulate:a", 0.45, 0.55).set_trans(Tween.TRANS_SINE)
	pulse.tween_property(ring, "modulate:a", 1.0, 0.55).set_trans(Tween.TRANS_SINE)


	var aim: = func():
		if not is_instance_valid(ring) or not is_instance_valid(bubble) or not is_instance_valid(win) or phase[0] != "guide":
			return
		var key: String = targets[clampi(bubble.at, 0, targets.size() - 1)]
		var rect: = Rect2()
		if key == "slots":
			var k: float = win.scale.x
			rect = Rect2(win.position + Vector2(RoCharSelect.SLOT_X[0] - 4, RoCharSelect.SLOT_Y - 4) * k, 
				Vector2(RoCharSelect.SLOT_X[2] - RoCharSelect.SLOT_X[0] + RoCharSelect.SLOT_SIZE.x + 8, RoCharSelect.SLOT_SIZE.y + 26) * k)
		else:
			for c in win.get_children():
				if c is Button and str(c.get_meta("key", "")) == key and c.visible:
					rect = (c as Control).get_global_rect().grow(4.0)
			var on_rail: = str(RAIL_OF_BUTTON.get(key, ""))
			if not rect.has_area() and on_rail != "" and _rail != null and is_instance_valid(_rail) and not _rail.is_queued_for_deletion():
				for c in _rail.find_children("*", "Button", true, false):
					if str(c.get_meta("rail", "")) == on_rail:
						rect = (c as Control).get_global_rect().grow(3.0)
		ring.visible = rect.has_area()
		if ring.visible:
			ring.position = rect.position
			ring.size = rect.size
	var leave: = func():
		_intro_live = false
		for n in [bubble, ring, art]:
			if is_instance_valid(n):
				var out: = (n as CanvasItem).create_tween().set_pause_mode(Tween.TWEEN_PAUSE_PROCESS)
				out.tween_property(n, "modulate:a", 0.0, 0.3)
				out.tween_callback(n.queue_free)
	bubble.line_shown.connect( func(i: int):
		_intro_line = i
		if world != null:
			world.play_sound("ui_click", 0.0, -12.0)

		place.call_deferred()
		get_tree().create_timer(0.05, true).timeout.connect(place)
		get_tree().create_timer(0.2, true).timeout.connect(place)
		if phase[0] != "guide":
			ring.visible = false
			return
		step.text = "%d / %d" % [i + 1, guide.size()]
		aim.call()


		for t in [0.05, 0.3]:
			get_tree().create_timer(t, true).timeout.connect(aim)

		if i == guide.size() - 1:
			get_tree().create_timer(9.0, true).timeout.connect( func():
				if is_instance_valid(bubble) and bubble.at == i:
					leave.call()))
	bubble.finished.connect( func():

		if phase[0] != "ask":
			leave.call())
	var answer: = func(yes: bool):
		answers.visible = false
		phase[0] = "guide" if yes else "bye"
		_intro_phase = phase[0]
		bubble.lines = guide if yes else bye
		foot.visible = yes
		bubble.show_line(0)
		if not yes:
			get_tree().create_timer(2.6, true).timeout.connect(leave)
	var yes_b: = _album_pill(tr("Sí, porfa"), true, func(): answer.call(true), false, 11)
	var no_b: = _album_pill(tr("No, gracias"), false, func(): answer.call(false), false, 11)
	answers.add_child(no_b)
	answers.add_child(yes_b)
	if resumed and _intro_phase == "guide":

		answers.visible = false
		phase[0] = "guide"
		bubble.lines = guide
		foot.visible = true
		bubble.show_line(clampi(_intro_line, 0, guide.size() - 1))
	elif resumed and _intro_phase == "bye":
		leave.call()
		return
	else:
		bubble.show_line(0)
	place.call_deferred()
	bubble.modulate.a = 0.0
	var fade_in: = bubble.create_tween().set_pause_mode(Tween.TWEEN_PAUSE_PROCESS)
	fade_in.tween_interval(0.35)
	fade_in.tween_property(bubble, "modulate:a", 1.0, 0.25)






func show_loading(then: Callable, maps: Array = []) -> void :
	_clear()
	_mode = "loading"
	_root.mouse_filter = Control.MOUSE_FILTER_STOP
	var black: = ColorRect.new()
	black.color = Color.BLACK
	black.set_anchors_and_offsets_preset(Control.PRESET_FULL_RECT)
	_root.add_child(black)
	var pics: Array[String] = []
	for i in 13:
		var path: = "res://assets/ro/ui/loading/loading%02d.png" % i
		if ResourceLoader.exists(path):
			pics.append(path)
	var view: = get_viewport().get_visible_rect().size
	if not pics.is_empty():
		var art: = TextureRect.new()

		var full: = load(pics.pick_random()) as Texture2D
		var cut: = AtlasTexture.new()
		cut.atlas = full
		cut.region = Rect2(0, 0, full.get_width(), full.get_height() * 438.0 / 480.0)
		art.texture = cut
		art.set_anchors_and_offsets_preset(Control.PRESET_FULL_RECT)
		art.expand_mode = TextureRect.EXPAND_IGNORE_SIZE
		art.stretch_mode = TextureRect.STRETCH_KEEP_ASPECT_CENTERED
		_root.add_child(art)

	var bar: = UiStyles.round_gauge("blue", minf(420.0, view.x * 0.5), 14)
	bar.size = bar.custom_minimum_size
	bar.position = Vector2((view.x - bar.size.x) * 0.5, view.y - 84)
	bar.value = 0
	_root.add_child(bar)
	var tw: = bar.create_tween()
	tw.tween_property(bar, "value", 85.0, 0.35)
	_loading_tip(view, bar.position.y + bar.size.y + 10.0)
	if world != null and world.web != null and world.web.get("packs") != null:
		await _web_fetch(World.web_keys(maps) if not maps.is_empty() else world.web_ahead(), bar, tw, view)

	await get_tree().process_frame
	await get_tree().process_frame
	then.call()
	if is_instance_valid(bar):
		bar.value = 100



var _last_tip: = -1




func _loading_tip(view: Vector2, top: float) -> void :
	var touch: = touch_ui()
	var pool: Array[int] = []
	for i in GameData.LOADING_TIPS.size():
		var where: = str(GameData.LOADING_TIPS[i][1])
		if (where == "pc" and touch) or (where == "touch" and not touch) or i == _last_tip:
			continue
		pool.append(i)
	if pool.is_empty():
		return
	_last_tip = pool.pick_random()
	if has_meta("force_tip"):
		_last_tip = int(get_meta("force_tip"))
	var width: = minf(view.x - 32.0, 960.0)
	var strip: = PanelContainer.new()
	var box: = StyleBoxFlat.new()
	box.bg_color = Color(0.04, 0.05, 0.1, 0.78)
	box.border_color = Color(1.0, 0.84, 0.42, 0.5)
	box.set_border_width_all(1)
	box.set_corner_radius_all(10)
	box.content_margin_left = 14
	box.content_margin_right = 16
	box.content_margin_top = 7
	box.content_margin_bottom = 7
	strip.add_theme_stylebox_override("panel", box)
	strip.custom_minimum_size.x = width
	strip.mouse_filter = Control.MOUSE_FILTER_IGNORE
	var row: = HBoxContainer.new()
	row.add_theme_constant_override("separation", 10)
	strip.add_child(row)
	var gold: = Color(1.0, 0.84, 0.42)
	var tag: = UiKit.label(tr("Consejo"), 15, gold, true)
	tag.vertical_alignment = VERTICAL_ALIGNMENT_CENTER
	row.add_child(tag)
	var bar: = ColorRect.new()
	bar.color = Color(gold, 0.45)
	bar.custom_minimum_size = Vector2(1, 0)
	row.add_child(bar)
	var text: = UiKit.label(tr(str(GameData.LOADING_TIPS[_last_tip][0])), 15, Color(0.95, 0.95, 1.0), true)
	text.autowrap_mode = TextServer.AUTOWRAP_WORD_SMART
	text.size_flags_horizontal = Control.SIZE_EXPAND_FILL
	text.vertical_alignment = VERTICAL_ALIGNMENT_CENTER
	text.add_theme_constant_override("outline_size", 3)
	text.add_theme_color_override("font_outline_color", Color(0, 0, 0, 0.8))
	row.add_child(text)
	_root.add_child(strip)
	strip.reset_size()
	strip.position = Vector2((view.x - width) * 0.5, minf(top, view.y - strip.size.y - 8.0))

	( func():
		if is_instance_valid(strip):
			strip.reset_size()
			strip.position.y = minf(top, view.y - strip.size.y - 8.0)).call_deferred()




func show_char_make(class_id: String) -> void :
	_clear()
	_mode = "char_make"
	_root.mouse_filter = Control.MOUSE_FILTER_STOP
	var backdrop: = TextureRect.new()
	backdrop.set_anchors_and_offsets_preset(Control.PRESET_FULL_RECT)
	backdrop.texture = _login_texture("login_background")
	backdrop.expand_mode = TextureRect.EXPAND_IGNORE_SIZE
	backdrop.stretch_mode = TextureRect.STRETCH_KEEP_ASPECT_COVERED
	_root.add_child(backdrop)
	var view: = get_viewport().get_visible_rect().size


	var room: = view
	if world == null or world.town == null:
		room.x -= (_rail_width(view) + 10.0) * 2.0


	var fit: = minf(room.x / RoCharMake.SIZE.x, room.y / RoCharMake.SIZE.y)
	var k: = maxf(1.0, floorf(fit * (0.92 if touch_ui() else 0.84) * 4.0) / 4.0)
	RoAssets.set_ui_scale(k)
	var win: = RoCharMake.new()
	win.class_id = class_id
	win.scale = Vector2(k, k)
	win.position = ((view - RoCharMake.SIZE * k) * 0.5).floor()


	var in_town: bool = world != null and world.town != null and is_instance_valid(world.town) and world.town.class_id == class_id
	win.done.connect( func(id: String, look: Dictionary):
		Save.set_look(id, look)
		if win.name_changed:
			world.board.rename(id, Save.char_name(id))
		if in_town and world.town != null and is_instance_valid(world.town):
			world.town.refresh_hero()
			show_hero_sheet()
		else:
			show_class_select(id))
	win.cancelled.connect( func():
		if in_town and world.town != null and is_instance_valid(world.town):
			show_hero_sheet()
		else:
			show_class_select(class_id))
	win.titles_pressed.connect( func(): show_closet(class_id, "titles"))
	win.cosmetics_pressed.connect( func(): show_closet(class_id))
	_root.add_child(win)
	win.grab_focus.call_deferred()







