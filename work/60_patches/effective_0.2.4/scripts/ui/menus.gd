func _banish(choice: Dictionary) -> void :
	if _mode != "level_up" or world.player.banishes <= 0:
		return
	world.play_sound("teleport", 0.0, -4.0)
	if world.net.is_client():

		world.player.banishes -= 1
		world.net.send_banish(world.net.offered.find(choice))
		return
	world.player.banish(choice)

	var index: = _choices.find(choice)
	var others: = _choices.filter( func(o): return o != choice)
	var next: = world.player.replacement_choice(others)
	var cards: = _choices.duplicate()
	if next.is_empty():
		cards.remove_at(index)
	else:
		cards[index] = next



	world.player.offer = cards
	show_level_up(cards, true)


func _choice_color(choice: Dictionary) -> Color:
	match choice.kind:
		"evolve":
			return GameData.LEGENDARY_COLOR
		"skill":
			return Color(0.36, 0.7, 0.42) if choice.level == 1 else UiKit.GOLD
		"stat":
			return Color(0.45, 0.6, 0.9)
	return Color(0.85, 0.3, 0.35)


func _choice_name(choice: Dictionary) -> String:
	match choice.kind:
		"evolve":
			return tr(GameData.SKILLS[choice.to].name)
		"skill":
			return tr(GameData.SKILLS[choice.id].name)
		"stat":
			return tr(GameData.STATS[choice.id].full)
	return tr("Red Potion")


func _choice_badge(choice: Dictionary) -> String:
	match choice.kind:
		"evolve":
			return tr("EVOLUCIÓN")
		"skill":
			var from: = int(choice.get("from", int(choice.level) - 1))
			var to: = int(choice.level)
			if GameData.SKILLS[choice.id].get("evolved", false):
				return tr("NIV %d → %d") % [from + 9, to + 9]

			if Player.is_passive(str(choice.id)):
				return tr("NUEVA PASIVA") if from == 0 else tr("MEJORA DE PASIVA")

			if Player.is_support(str(choice.id)):
				return tr("NUEVO APOYO") if from == 0 else tr("MEJORA DE APOYO")
			return tr("NUEVA HABILIDAD") if from == 0 else tr("MEJORA")
		"stat":
			return tr("ATRIBUTO  +%d") % (int(choice.level) - int(choice.get("from", int(choice.level) - 1)))
	return tr("CURACIÓN")


func _choice_desc(choice: Dictionary) -> String:
	match choice.kind:
		"evolve":

			return _skill_numbers(str(choice.to), world.player.evolved_level(str(choice.id)) if world.player != null else 1, true) + tr(GameData.SKILLS[choice.to].desc)
		"skill":
			var from: = int(choice.get("from", int(choice.level) - 1))
			if from > 0:
				return _skill_diff(str(choice.id), int(choice.level), from)
			return _skill_numbers(str(choice.id), int(choice.level), true) + _skill_desc(str(choice.id), true) + _evolves_note(str(choice.id))
		"stat":
			var text: = tr(GameData.STATS[choice.id].desc)

			var run_from: = int(choice.get("from", 0)) - (int(world.player.base_stats.get(choice.id, 0)) if world.player != null else 0)
			if run_from >= (int(world.player.stat_cap) if world.player != null else GameData.MAX_STAT):
				text = _halved_numbers(text)
			var maxed: = _maxed_effects(str(choice.id))
			if not maxed.is_empty():
				text += """
""" + "  ·  ".join(maxed)
			return text
	return tr("Recupera el 40% de la vida.")






func _skill_numbers(id: String, level: int, chips: = false) -> String:
	var p: = world.player if world != null else null
	var sk: Dictionary = GameData.SKILLS[id]
	var v: = func(f: String) -> float: return GameData.skill_value(id, f, level)
	var parts: Array[String] = []
	if sk.has("damage"):
		var dmg: float = v.call("damage") * (p.dmg_mult * p.skill_mult_for(id) if p != null else 1.0)
		parts.append(tr("Daño %d") % roundi(dmg) if chips else "%s (%s)" % [tr("Daño %d") % roundi(dmg), p.scaling_text(id) if p != null else GameData.skill_scaling(id)])


	if sk.has("stance_chance"):
		parts.append(tr("Postura %d%%") % roundi(minf(1.0, v.call("stance_chance") + (float(p.effects.get("stance", 0.0)) if p != null else 0.0)) * 100.0))
	if sk.has("count") and v.call("count") + (p.extra_count if p != null else 0) > 1.0:
		parts.append("×%d" % int(v.call("count") + (p.extra_count if p != null else 0)))
	if sk.has("heal_amount"):
		parts.append("%s (%s)" % [tr("Curación %d") % roundi(v.call("heal_amount")), GameData.support_scaling(id)])
	if sk.has("amount"):
		parts.append("%s (%s)" % [(tr("Curación %d") if sk.type == "heal" else tr("Barrera %d")) % roundi(v.call("amount")), GameData.support_scaling(id)])

	var bonus_names: = {"dmg": tr("%+d%% daño"), "aspd": tr("%+d%% vel. de ataque"), "move": tr("%+d%% velocidad"), 
		"crit": tr("%+d%% crítico"), "dodge": tr("%+d%% evasión")}
	if sk.type == "buff":

		for f in sk.get("bonus", []):

			var bm: = p.buff_mult_for(str(f), id) if p != null else 1.0
			if bonus_names.has(f):
				parts.append(bonus_names[f] %roundi(v.call(f) * bm * 100.0))
			elif f == "armor":
				parts.append(tr("%+.1f defensa") % (v.call(f) * bm))
		if not chips:
			parts.append("(%s)" % tr("DES"))
	if sk.has("cooldown") and sk.type != "passive" and sk.type != "buff":
		var cd: float = v.call("cooldown") * (p.cd_for(id) if p != null else 1.0)
		parts.append(tr("Recarga %s s") % str(snappedf(cd, 0.01 if cd < 1.0 else 0.1)))

	if GameData.PUNISH_SKILLS.has(id):
		parts.append(tr("Castigo +%d%%") % roundi(GameData.PUNISH_DMG * 100.0))
	return "  ·  ".join(parts) + """
""" if not parts.is_empty() else ""




func _maxed_effects(stat: String) -> Array:
	var p: = world.player if world != null else null
	var out: = []
	if p == null:
		return out
	match stat:
		"agi":
			if p.dodge >= GameData.FLEE_CAP - 0.0001:
				out.append(tr("Evasión MAX"))
			if p.move_speed >= p.max_move_speed() - 0.0001:
				out.append(tr("Vel. de movimiento MAX"))
		"vit":
			if p.vit_cut >= GameData.VIT_DMG_CUT_MAX - 0.0001:
				out.append(tr("Reducción de daño MAX"))
			if p.hit_resist() >= GameData.HIT_RESIST_MAX - 0.0001:
				out.append(tr("Resistencia a golpes normales MAX"))
		"luk":
			if p.perfect_dodge >= GameData.PERFECT_DODGE_CAP - 0.0001:
				out.append(tr("Esquiva perfecta MAX"))
	return out



static func _halved_numbers(text: String) -> String:
	var re: = RegEx.new()
	re.compile("\\d+(\\.\\d+)?")
	var out: = ""
	var last: = 0
	for m in re.search_all(text):
		out += text.substr(last, m.get_start() - last)
		var v: = float(m.get_string()) * 0.5
		out += str(int(v)) if is_equal_approx(v, roundf(v)) else str(snappedf(v, 0.01))
		last = m.get_end()
	return out + text.substr(last)






