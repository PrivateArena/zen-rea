	return plain


func _inv_equip(index: int, slot_key: String) -> void :
	if not world.player.equipment.can_wear(world.player.equipment.bag[index]):
		show_inventory(index, _wear_block(world.player.equipment.bag[index], tr("Esta clase no puede usarlo.")))
		return
	var moved: = world.player.equipment.equip_from_bag(index, slot_key)
	if moved < 0:
		show_inventory(index, tr("Solo puedes llevar una única a la vez: quítate la que tienes puesta."))
		return
	world.player.recompute()
	world.play_sound("equip_item", 0.0, -2.0)
	show_equipment("weapon", tr("Equipado. Cartas pasadas a la nueva pieza: %d.") % moved if moved > 0 else tr("Equipado."))


func _inv_sell(index: int) -> void :
	var it: Dictionary = world.player.equipment.bag[index]
	if not Equipment.can_sell(it):
		show_inventory(index, tr("Equipo permanente: no se vende."))
		return
	if Equipment.is_locked(it):
		show_inventory(index, tr("Está bloqueado: desbloquéalo para venderlo."))
		return
	var stored: = Equipment.found_face(it)
	var price: = Equipment.price_text(it)
	var z: = world.player.equipment.sell_from_bag(index)
	world.add_zeny(z, "sold")
	world.play_sound("get_coin", 0.0, -4.0)
	show_inventory(-1, tr("Vendido por %s. También salió del Almacén Kafra.") % price if stored else tr("Vendido por %s.") % price)



func _inv_lock(index: int) -> void :
	var it: Dictionary = world.player.equipment.bag[index]
	var on: = not Equipment.is_locked(it)
	if on:
		it["lock"] = true
	else:
		it.erase("lock")

	if not on and Equipment.is_locked(it):
		show_inventory(index, tr("Está bloqueado en el Almacén Kafra: desbloquéalo allí."))
		return
	world.play_sound("equip_item" if on else "ui_click", 0.0, -4.0)
	show_inventory(index, tr("Bloqueado: no se venderá con los filtros.") if on else tr("Desbloqueado."))


