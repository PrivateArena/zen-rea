func _float_window(title: String, then: = Callable(), dim: = 0.45) -> Dictionary:
	var shade: = UiKit.backdrop(dim)
	shade.mouse_filter = Control.MOUSE_FILTER_STOP
	_root.add_child(shade)
	_root.mouse_filter = Control.MOUSE_FILTER_STOP
	var win: = UiStyles.ro_window(title, UiKit.FONT_TITLE)
	var root: Control = win.root
	var shut: = func():
		if is_instance_valid(shade):
			shade.queue_free()
		if is_instance_valid(root):
			root.queue_free()

		if _mode in ["closed", "town"] and _root.get_child_count() <= 2:
			_root.mouse_filter = Control.MOUSE_FILTER_IGNORE
		if then.is_valid():
			then.call()
	return {"root": root, "body": win.body, "shut": shut}


func _float_show(w: Dictionary, focus: Control) -> void :
	var root: Control = w.root
	_root.add_child(root)
	var fit_window: = func():
		if not is_instance_valid(root):
			return
		root.reset_size()
		var view: = get_viewport().get_visible_rect().size
		var scale: = 1.0
		if touch_ui():
			scale = minf(1.0, minf((view.x - 16.0) / maxf(1.0, root.size.x), (view.y - 16.0) / maxf(1.0, root.size.y)))
		root.scale = Vector2.ONE * maxf(0.1, scale)
		root.position = ((view - root.size * root.scale) * 0.5).floor().max(Vector2(8.0, 8.0))
	fit_window.call()
	var viewport: = get_viewport()
	viewport.size_changed.connect(fit_window)
	root.tree_exiting.connect( func():
		if is_instance_valid(viewport) and viewport.size_changed.is_connected(fit_window):
			viewport.size_changed.disconnect(fit_window))
	if focus != null:
		focus.grab_focus()


	root.minimum_size_changed.connect(fit_window)






