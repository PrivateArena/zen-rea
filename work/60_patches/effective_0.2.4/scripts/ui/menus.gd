func _opt_row(rows: VBoxContainer, caption: String, control: Control, note: = "") -> void :
	if rows.get_child_count() > 0:
		var line: = ColorRect.new()
		line.color = Color(0.88, 0.9, 0.96)
		line.custom_minimum_size.y = 1
		rows.add_child(line)
	var row: = HBoxContainer.new()
	row.custom_minimum_size.y = OPT_ROW_H + (10.0 if note != "" else 0.0)
	row.add_theme_constant_override("separation", 12)
