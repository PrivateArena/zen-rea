func _card_button(width: float, height: float, accent: Color) -> Button:
	var b: = Button.new()
	b.custom_minimum_size = Vector2(width, height)
	b.focus_mode = Control.FOCUS_ALL
	var normal: = UiKit.panel_box(UiKit.PANEL_SOFT, UiKit.GOLD_DIM, 6)
	var hover: = UiKit.panel_box(Color.WHITE, UiKit.GOLD, 6, 2)
	hover.shadow_color = Color(UiKit.GOLD, 0.35)
	hover.shadow_size = 12
	b.add_theme_stylebox_override("normal", normal)
	b.add_theme_stylebox_override("hover", hover)
	b.add_theme_stylebox_override("focus", hover)
	b.add_theme_stylebox_override("pressed", hover)
	b.mouse_entered.connect( func(): b.grab_focus())
	b.focus_entered.connect( func(): _lift(b, true))
	b.focus_exited.connect( func(): _lift(b, false))
	return b


func _card_column(card: Button) -> VBoxContainer:
	var margin: = MarginContainer.new()
	margin.set_anchors_and_offsets_preset(Control.PRESET_FULL_RECT)
	margin.mouse_filter = Control.MOUSE_FILTER_IGNORE
	for side in ["left", "right", "top", "bottom"]:
		margin.add_theme_constant_override("margin_" + side, 14)
	card.add_child(margin)
	var col: = VBoxContainer.new()
	col.add_theme_constant_override("separation", 8)
	col.mouse_filter = Control.MOUSE_FILTER_IGNORE
	margin.add_child(col)
	return col


func _lift(card: Control, up: bool) -> void :
	card.pivot_offset = card.size * 0.5
	var tw: = card.create_tween().set_pause_mode(Tween.TWEEN_PAUSE_PROCESS)
	tw.tween_property(card, "scale", Vector2.ONE * (1.015 if up else 1.0), 0.12)






func show_level_up(choices: Array, chained: = false) -> void :
	_choices = choices
	if auto_pick:
		world.choose(Bot.pick_choice(world.player, choices))
		return
	_mode = "level_up"
	world.hold_world()
	_grace = 0.36 + 0.09 * (choices.size() - 1) + LEVEL_UP_GRACE
	_banish_armed = false


	var title: = tr("¡Nivel %d!") % (world.player.level - maxi(0, world.player.pending_levels - 1))
	if world.player.pending_levels > 1:
		title += "   " + tr("(%d más)") % (world.player.pending_levels - 1)
	var col: = _screen(title, "")
	if not chained:
		_bounce_in(col.get_parent().get_parent())
		world.play_sound("job_levelup", 0.3, -6.0)
	var row: = HBoxContainer.new()
	row.alignment = BoxContainer.ALIGNMENT_CENTER
	row.add_theme_constant_override("separation", 16)
	col.add_child(row)
	var card_w: = clampf((_view_width() - 100.0) / float(maxi(3, choices.size())) - 16.0, 170.0, 250.0)
	_cards.clear()


	var fit: = func():
		var tallest: = 300.0
		for c in _cards:
			if not is_instance_valid(c):
				continue



			for k in c.get_children():
				if k is MarginContainer:
					tallest = maxf(tallest, (k as Control).get_combined_minimum_size().y + 6.0)
		for c in _cards:
			if is_instance_valid(c):
				c.custom_minimum_size.y = tallest
	fit.call_deferred()

	get_tree().create_timer(0.08, true, false, true).timeout.connect(fit)
	get_tree().create_timer(0.25, true, false, true).timeout.connect(fit)
	for i in choices.size():
		var choice: Dictionary = choices[i]
		var card: = _choice_card(choice, i, card_w)
		row.add_child(card)
		_cards.append(card)


		card.modulate.a = 0.0
		var tw: = card.create_tween().set_pause_mode(Tween.TWEEN_PAUSE_PROCESS)
		tw.tween_interval(0.12 + 0.09 * i)
		var rarity: = int(choice.get("rarity", 0))
		tw.tween_callback( func():
			card.position.y += 36.0
			var snd: String = ["ui_click", "drop_blue", "drop_purple", GameData.DROP_SOUND_LEGENDARY][rarity]
			if choice.kind == "evolve":
				snd = GameData.DROP_SOUND_LEGENDARY
			world.play_sound(snd, 0.0, -10.0 if snd == "ui_click" else -5.0)
			if rarity >= 2:
				world.hud.flash(GameData.CHOICE_RARITY[rarity].color, 0.25))
		tw.tween_property(card, "modulate:a", 0.6, 0.16)
		tw.parallel().tween_property(card, "position:y", -36.0, 0.24).as_relative()\
		.set_trans(Tween.TRANS_BACK).set_ease(Tween.EASE_OUT)

	var ready_tw: = create_tween().set_pause_mode(Tween.TWEEN_PAUSE_PROCESS)
	ready_tw.tween_interval(_grace - 0.12)
	ready_tw.tween_callback( func():
		for c in _cards:
			if is_instance_valid(c):
				c.create_tween().set_pause_mode(Tween.TWEEN_PAUSE_PROCESS).tween_property(c, "modulate:a", 1.0, 0.12))
	if not _cards.is_empty():
		_cards[0].grab_focus.call_deferred()

	var p: = world.player

	var tools: = HBoxContainer.new()
	tools.custom_minimum_size.y = 46
	tools.alignment = BoxContainer.ALIGNMENT_CENTER
	tools.add_theme_constant_override("separation", 16)
	col.add_child(tools)
	_tool_buttons.clear()
	if p.rerolls > 0:
		tools.add_child(_sage_tool("magnifier", tr("Magnifier"), tr("Nuevas opciones"), "R", p.rerolls, _reroll))
	if p.banishes > 0:
		tools.add_child(_sage_tool("fly_wing", tr("Holy Water"), tr("Desterrar una opción"), "B", p.banishes, 
			func(): _arm_banish( not _banish_armed)))


	if bool(Save.setting("hold_levels", false)):
		var later: = _ro_button(tr("Seguir jugando  (Tab)"), _put_levels_away)
		later.focus_mode = Control.FOCUS_NONE
		later.add_theme_font_size_override("font_size", 11)
		later.size_flags_horizontal = Control.SIZE_SHRINK_END
		later.size_flags_vertical = Control.SIZE_SHRINK_CENTER
		col.get_parent().get_parent().get_child(0).add_child(later)


	var auto: = _tool_check(tr("Elegir al azar"), "endless_auto_pick")
	auto.toggled.connect( func(on: bool):
		Save.set_setting("endless_auto_pick", on)
		if on and _mode == "level_up":

			hide_level_up()
			get_tree().paused = false)

	var random_row: = HBoxContainer.new()
	random_row.add_theme_constant_override("separation", 2)
	random_row.add_child(auto)
	tools.add_child(random_row)
	var gear: = TextureButton.new()
	gear.texture_normal = load("res://assets/brand/gear.png")
	gear.ignore_texture_size = true
	gear.stretch_mode = TextureButton.STRETCH_KEEP_ASPECT_CENTERED
	gear.custom_minimum_size = Vector2(17, 17)
	gear.size_flags_vertical = Control.SIZE_SHRINK_CENTER
	gear.focus_mode = Control.FOCUS_NONE
	gear.tooltip_text = tr("Prioridad de mejoras")
	gear.pressed.connect(show_pick_order)
	gear.mouse_entered.connect( func(): gear.modulate = Color(0.7, 0.8, 1.0))
	gear.mouse_exited.connect( func(): gear.modulate = Color.WHITE)
	random_row.add_child(gear)

	var hold: = _tool_check(tr("Acumular mejoras"), "hold_levels")
	hold.toggled.connect( func(on: bool):
		Save.set_setting("hold_levels", on)
		if on:
			_put_levels_away())
	tools.add_child(hold)
	if showcase:

		var pick: = 0
		for i in choices.size():
			if not (choices[i].kind == "stat" and choices[i].id == "int"):
				pick = i
				break
		for i in choices.size():
			if choices[i].kind == "evolve" or (choices[i].kind == "skill" and world.player.job2.get("skills", []).has(choices[i].id)):
				pick = i
				break
		var tw: = create_tween().set_pause_mode(Tween.TWEEN_PAUSE_PROCESS)
		for i in pick + 1:
			tw.tween_interval(0.45)
			tw.tween_callback( func():
				if i < _cards.size() and is_instance_valid(_cards[i]):
					_cards[i].grab_focus())
		tw.tween_interval(0.4)
		tw.tween_callback( func(): _showcase_pick(pick))




func _showcase_pick(index: int) -> void :
	if _mode != "level_up":
		return
	if _grace > 0.0:
		get_tree().create_timer(0.2).timeout.connect( func(): _showcase_pick(index))
		return
	_pick(index)



func _bounce_in(window: Control) -> void :
	window.scale = Vector2.ONE * 0.86
	var tw: = window.create_tween().set_pause_mode(Tween.TWEEN_PAUSE_PROCESS)
	tw.tween_callback( func(): window.pivot_offset = window.size * 0.5)
	tw.tween_property(window, "scale", Vector2.ONE, 0.26).set_trans(Tween.TRANS_BACK).set_ease(Tween.EASE_OUT)




func _pick(index: int) -> void :
	if _mode != "level_up" or _grace > 0.0 or index >= _choices.size():
		return
	if _banish_armed:
		if _choices[index].kind != "potion" and world.player.can_banish(_choices[index]):
			_banish(_choices[index])
		elif _choices[index].kind != "potion":
			world.play_sound("ui_click", 0.0, -2.0)
			world.number(world.player.position + Vector3(0, 2.4, 0), tr("Es la última que te queda"), Color(1.0, 0.6, 0.5))
		return
	_mode = "level_up_pick"
	var choice: Dictionary = _choices[index]
	match choice.kind:
		"skill":

			if not GameData.SKILLS[choice.id].get("song", false):
				world.play_sound(str(GameData.SKILLS[choice.id].get("sound", "")), 0.0, -2.0)
			else:
				world.play_sound("equip_item", 0.0, -2.0)
		"stat":
			world.play_sound("equip_item", 0.0, -2.0)
		"potion":
			world.play_sound("heal", 0.0, -2.0)
	world.play_sound("drop_green" if choice.kind != "evolve" else "levelup", 0.0, -8.0)
	for i in _cards.size():
		var c: Control = _cards[i]
		if not is_instance_valid(c):
			continue
		var tw: = c.create_tween().set_pause_mode(Tween.TWEEN_PAUSE_PROCESS).set_parallel()
		if i == index:


			tw.tween_property(c, "modulate", Color(1.8, 1.65, 1.25), 0.07)
			tw.tween_property(c, "position:y", c.position.y - 10.0, 0.08).set_ease(Tween.EASE_OUT)
			tw.chain().tween_property(c, "modulate", Color.WHITE, 0.14)
			tw.parallel().tween_property(c, "position:y", c.position.y, 0.14).set_trans(Tween.TRANS_BOUNCE).set_ease(Tween.EASE_OUT)
		else:
			tw.tween_property(c, "modulate:a", 0.15, 0.15)
			tw.tween_property(c, "scale", Vector2.ONE * 0.94, 0.15)
	var done: = create_tween().set_pause_mode(Tween.TWEEN_PAUSE_PROCESS)
	done.tween_interval(0.24)
	done.tween_callback( func():
		if _mode == "level_up_pick":
			world.choose(choice))




static func _fit_title(l: Label, max_w: float, size: int, min_size: int) -> void :
	var font: Font = l.get_theme_font("font")
	var fs: = size
	while fs > min_size and font.get_string_size(l.text, HORIZONTAL_ALIGNMENT_LEFT, -1, fs).x > max_w:
		fs -= 1
	l.add_theme_font_size_override("font_size", fs)
	if font.get_string_size(l.text, HORIZONTAL_ALIGNMENT_LEFT, -1, fs).x > max_w:
		l.autowrap_mode = TextServer.AUTOWRAP_WORD_SMART
		l.custom_minimum_size.x = max_w


func _choice_card(choice: Dictionary, index: int, width: float) -> Button:
	var accent: = _choice_color(choice)
	var rarity: = int(choice.get("rarity", 0))
	var tier: Dictionary = GameData.CHOICE_RARITY[rarity]
	var rcol: Color = tier.color
	var card: = _card_button(width, 300.0, accent)
	_rarity_frame(card, rarity, choice.kind == "evolve")
	var band_col: Color = GameData.LEGENDARY_COLOR if choice.kind == "evolve" else (rcol if rarity > 0 else (accent if choice.kind == "potion" else Color(0.45, 0.55, 0.8)))
	_card_band(card, band_col, 80.0 if choice.kind in ["skill", "stat"] else 52.0, 3 if rarity >= 2 or choice.kind == "evolve" else 2)
	card.pressed.connect( func(): _pick(index))
	card.focus_entered.connect( func():
		if _mode == "level_up":
			ui_nav())
	var col: = _card_column(card)


	col.alignment = BoxContainer.ALIGNMENT_BEGIN

	if choice.kind in ["skill", "stat"]:
		var steps: = int(choice.level) - int(choice.get("from", int(choice.level) - 1))
		var ribbon: = _lvl_chip(tr(str(tier.name)).to_upper() + (("  ·  +%d") % steps if steps > 1 else ""), 
			rcol if rarity > 0 else Color(0.5, 0.56, 0.72), true, 12)
		ribbon.size_flags_horizontal = Control.SIZE_SHRINK_CENTER
		col.add_child(ribbon)
		if rarity > 0:
			accent = rcol

	var icon_box: = CenterContainer.new()
	icon_box.custom_minimum_size = Vector2(0, 76)
	icon_box.mouse_filter = Control.MOUSE_FILTER_IGNORE
	col.add_child(icon_box)
	var stack: = Control.new()
	stack.custom_minimum_size = Vector2(76, 76)
	stack.mouse_filter = Control.MOUSE_FILTER_IGNORE
	icon_box.add_child(stack)
	if choice.kind == "evolve" or rarity >= 1 or (choice.kind == "skill" and int(choice.get("from", 0)) == 0):

		var rays: = UiKit.rays(Color(accent, 0.75), 120)
		rays.position = Vector2(-22, -22)
		stack.add_child(rays)
		var spin: = rays.create_tween().set_pause_mode(Tween.TWEEN_PAUSE_PROCESS).set_loops()
		spin.tween_property(rays, "rotation", TAU, 9.0).as_relative()
	stack.add_child(UiKit.glow(Color(accent, 0.45), 76))
	var tex: = _choice_icon(choice)


	var medal: = Panel.new()
	var mb: = StyleBoxFlat.new()
	mb.bg_color = Color.WHITE
	mb.border_color = accent
	mb.set_border_width_all(3)
	mb.set_corner_radius_all(32)
	mb.shadow_color = Color(accent.darkened(0.3), 0.3)
	mb.shadow_size = 4
	mb.shadow_offset = Vector2(0, 2)
	mb.anti_aliasing = true
	medal.add_theme_stylebox_override("panel", mb)
	medal.position = Vector2(6, 6)
	medal.size = Vector2(64, 64)
	medal.mouse_filter = Control.MOUSE_FILTER_IGNORE
	if tex == null:
		stack.add_child(medal)
	else:
		medal.free()
	if tex != null:
		var r: = UiKit.icon_rect(tex, 48)
		r.position = Vector2(14, 14)
		stack.add_child(r)

		var sid: = str(choice.get("to", choice.id)) if choice.kind == "evolve" else str(choice.id)
		if choice.kind in ["skill", "evolve"] and GameData.SKILLS.has(sid):
			r.mouse_filter = Control.MOUSE_FILTER_PASS
			_set_hover(r, world.hud._skill_hover(sid))
	else:
		var glyph: String = tr(GameData.STATS[choice.id].name) if choice.kind == "stat" else "?"
		var big: = UiKit.label(glyph, 22, accent.darkened(0.15), true)
		big.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER
		big.vertical_alignment = VERTICAL_ALIGNMENT_CENTER
		big.set_anchors_and_offsets_preset(Control.PRESET_FULL_RECT)
		stack.add_child(big)

	var title: = UiKit.label(_choice_name(choice), 21, UiKit.TEXT, true)
	title.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER
	_fit_title(title, width - 30.0, 21, 14)
	col.add_child(title)
	var badge: = _lvl_chip(_choice_badge(choice), accent)



	if choice.kind in ["skill", "evolve"]:
		badge.size_flags_horizontal = Control.SIZE_SHRINK_CENTER
		col.add_child(badge)

		var badges: = HFlowContainer.new()
		badges.alignment = FlowContainer.ALIGNMENT_CENTER
		badges.add_theme_constant_override("h_separation", 4)
		badges.add_theme_constant_override("v_separation", 4)
		badges.mouse_filter = Control.MOUSE_FILTER_IGNORE
		col.add_child(badges)

		var sid: = str(choice.to) if choice.kind == "evolve" and choice.has("to") else str(choice.id)
		for c in _skill_chips_for(sid):
			badges.add_child(HoverCard.chip(str(c[0]), c[1]))
	else:
		badge.size_flags_horizontal = Control.SIZE_SHRINK_CENTER
		col.add_child(badge)

	if choice.kind in ["skill", "evolve"] and world.player.is_plagiarized(str(choice.id)):
		var plag: = _lvl_chip(tr("PLAGIARISM"), Color(0.55, 0.3, 0.75))
		plag.size_flags_horizontal = Control.SIZE_SHRINK_CENTER
		col.add_child(plag)
	if choice.kind in ["skill", "stat"]:
		col.add_child(_level_track(choice, accent, width - 42.0))

	var inset: = PanelContainer.new()
	var ib: = StyleBoxFlat.new()
	ib.bg_color = Color(0.945, 0.955, 0.985).lerp(band_col, 0.05)
	ib.border_color = Color(band_col, 0.18)
	ib.set_border_width_all(1)
	ib.set_corner_radius_all(8)
	ib.content_margin_left = 6
	ib.content_margin_right = 6
	ib.content_margin_top = 6
	ib.content_margin_bottom = 7
	inset.add_theme_stylebox_override("panel", ib)
	inset.mouse_filter = Control.MOUSE_FILTER_IGNORE
	col.add_child(inset)
	var texts: = VBoxContainer.new()
	texts.add_theme_constant_override("separation", 6)
	texts.mouse_filter = Control.MOUSE_FILTER_IGNORE
	inset.add_child(texts)
	if tier.has("all_stats"):
		var extra: = UiKit.label(tr("+%d a todos los atributos") % int(tier.all_stats), 13, rcol.darkened(0.25), true)
		extra.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER

		extra.autowrap_mode = TextServer.AUTOWRAP_WORD_SMART
		extra.custom_minimum_size = Vector2(width - 42.0, 0)
		texts.add_child(extra)


	var paras: = Array(_choice_desc(choice).split("\n", false)).map( func(t): return str(t).strip_edges())\
	.filter( func(t): return t != "")

	var diff: bool = choice.kind == "skill" and int(choice.get("from", int(choice.level) - 1)) > 0
	if diff:
		paras = ["\n".join(paras)]
	var numbers: bool = diff or (choice.kind in ["skill", "evolve"] and paras.size() > 1)
	for i in paras.size():


		var desc: = UiKit.label(paras[i], 13 if i < 2 else 12, UiKit.TEXT if i == 0 and numbers else UiKit.MUTED)
		desc.autowrap_mode = TextServer.AUTOWRAP_WORD_SMART
		desc.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER
		desc.custom_minimum_size = Vector2(width - 42.0, 0)
		texts.add_child(desc)

	var push: = Control.new()
	push.size_flags_vertical = Control.SIZE_EXPAND_FILL
	push.mouse_filter = Control.MOUSE_FILTER_IGNORE
	col.add_child(push)


	var keyed: = _choices.size() <= 4 and not MouseWalk.touch()
	var key: = UiKit.tag("%d" % (index + 1) if keyed else tr("Desterrar"), UiKit.GOLD if keyed else Color(0.85, 0.12, 0.15), 13)
	var kb: = (key.get_theme_stylebox("panel") as StyleBoxFlat).duplicate() as StyleBoxFlat
	kb.bg_color = Color.WHITE
	kb.set_corner_radius_all(6)
	kb.border_width_bottom = 3
	kb.content_margin_left = 10
	kb.content_margin_right = 10
	kb.content_margin_top = 2
	kb.content_margin_bottom = 2
	kb.anti_aliasing = true
	key.add_theme_stylebox_override("panel", kb)
	key.custom_minimum_size.x = 30
	key.size_flags_horizontal = Control.SIZE_SHRINK_CENTER
	if not keyed:
		key.modulate.a = 0.0
	col.add_child(key)

	if choice.kind != "potion":
		var veil: = Panel.new()
		var vb: = StyleBoxFlat.new()
		vb.bg_color = Color(0.85, 0.12, 0.15, 0.16)
		vb.border_color = Color(0.85, 0.12, 0.15)
		vb.set_border_width_all(3)
		vb.set_corner_radius_all(12)
		veil.add_theme_stylebox_override("panel", vb)
		veil.set_anchors_and_offsets_preset(Control.PRESET_FULL_RECT)
		veil.mouse_filter = Control.MOUSE_FILTER_IGNORE
		veil.visible = false
		card.add_child(veil)
		card.set_meta("banish_veil", veil)


		card.set_meta("banish_key", key)
		card.set_meta("key_text", "%d" % (index + 1) if keyed else "")

		card.set_meta("banish_ok", world.player.can_banish(choice))
	return card




