		row.alignment = BoxContainer.ALIGNMENT_CENTER
		row.add_theme_constant_override("separation", 4)
		builds_box.body.add_child(row)
		row.add_child(UiKit.label(tr("Empezar en el piso:"), 13, UiKit.MUTED))
		var picks: Array[Button] = []
		for f in points:
			var b: = _ro_button(str(f), func(): pass)
			b.toggle_mode = true
			b.button_pressed = f == 1
			picks.append(b)
			row.add_child(b)
		for i in picks.size():
			var me: = picks[i]
			var floor_n: int = points[i]
			me.pressed.connect( func():
				start[0] = floor_n
				for o in picks:
					o.button_pressed = o == me
				ui_click())
		var list: = VBoxContainer.new()
		list.add_theme_constant_override("separation", 4)
		list.size_flags_horizontal = Control.SIZE_EXPAND_FILL



		var many: = builds.size() > 2
		var scroll: = ScrollContainer.new()
		scroll.horizontal_scroll_mode = ScrollContainer.SCROLL_MODE_DISABLED
		scroll.vertical_scroll_mode = ScrollContainer.SCROLL_MODE_AUTO if many else ScrollContainer.SCROLL_MODE_DISABLED
		scroll.custom_minimum_size = Vector2(560, minf(builds.size(), 2) * 54.0 - 4.0)
		var pad: = MarginContainer.new()
		pad.size_flags_horizontal = Control.SIZE_EXPAND_FILL
		pad.add_theme_constant_override("margin_right", 12 if many else 0)
		pad.add_child(list)
		scroll.add_child(pad)
		builds_box.body.add_child(scroll)
		for i in builds.size():
			list.add_child(_tower_build_row(builds[i], i, start))
		var warn: = UiKit.label(tr("⚠ La build se gasta al entrar y no vuelve: ni si caes ni si terminas la subida. Los pisos superados quedan guardados."), 12, 
			Color(0.75, 0.35, 0.1), true)
		warn.autowrap_mode = TextServer.AUTOWRAP_WORD_SMART
		warn.custom_minimum_size.x = 540
		warn.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER
		builds_box.body.add_child(warn)
		if party:
			var group: = UiKit.label(tr("En grupo: cada uno elige y gasta su propia build. Los pisos de inicio son los puntos de control que tenéis todos."), 12, 
				Color(0.35, 0.3, 0.75))
			group.autowrap_mode = TextServer.AUTOWRAP_WORD_SMART
			group.custom_minimum_size.x = 540
			group.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER
			builds_box.body.add_child(group)

	var gifts_box: = _tower_section(tr("Regalos de Lucile (la primera vez que superas cada tramo)"))
	col.add_child(gifts_box.panel)
	var grid: = GridContainer.new()
	grid.columns = 5
	grid.add_theme_constant_override("h_separation", 6)
	grid.add_theme_constant_override("v_separation", 6)
	gifts_box.body.add_child(grid)
	for f in GameData.TOWER_REWARDS:
		grid.add_child(_tower_gift(int(f), str(GameData.TOWER_REWARDS[f]), top >= int(f)))
	var back: = UiKit.button(tr("Volver"))
	back.pressed.connect(_back_to_hub)
	col.add_child(back)
	back.grab_focus.call_deferred()



var tower_hel: = false





func _hel_wait_text(left: int) -> String:
	var hms: = "%02d:%02d:%02d" % [(left / 3600) % 24, (left / 60) % 60, left % 60]
	return (tr("%d d") % (left / 86400) + " " + hms) if left >= 86400 else hms


func _tower_modes(hel: bool) -> Control:
	var row: = HBoxContainer.new()
	row.add_theme_constant_override("separation", 6)
	for down in [false, true]:
		var on: bool = down == hel
		var b: = Button.new()
		b.focus_mode = Control.FOCUS_NONE
		b.size_flags_horizontal = Control.SIZE_EXPAND_FILL
		b.custom_minimum_size = Vector2(0, 38)
		b.mouse_default_cursor_shape = Control.CURSOR_POINTING_HAND
		var ink: = Color(0.62, 0.08, 0.14) if down else Color(0.4, 0.25, 0.75)
		for st in ["normal", "hover", "pressed"]:
			var sb: = StyleBoxFlat.new()
			sb.set_corner_radius_all(9)
			sb.set_border_width_all(2 if on else 1)
			sb.anti_aliasing = true
			if on:
				sb.bg_color = ink if not down else Color(0.3, 0.03, 0.08)
				sb.border_color = Color(1.0, 0.6, 0.3) if down else ink.lightened(0.3)
				sb.shadow_color = Color(1.0, 0.35, 0.1, 0.5) if down else Color(ink, 0.35)
				sb.shadow_size = 6
			else:
				sb.bg_color = Color(1, 1, 1) if st != "hover" else ink.lerp(Color.WHITE, 0.88)
				sb.border_color = ink.lerp(Color.WHITE, 0.5)
			b.add_theme_stylebox_override(st, sb)
		var h: = HBoxContainer.new()
		h.alignment = BoxContainer.ALIGNMENT_CENTER
		h.add_theme_constant_override("separation", 6)
		h.mouse_filter = Control.MOUSE_FILTER_IGNORE
		h.set_anchors_and_offsets_preset(Control.PRESET_FULL_RECT)
		b.add_child(h)
		var ic: = UiKit.icon_rect(UiKit.skill_icon("meteor_storm" if down else "angelus"), 22)
		ic.mouse_filter = Control.MOUSE_FILTER_IGNORE
		ic.size_flags_vertical = Control.SIZE_SHRINK_CENTER
		h.add_child(ic)
		var t: = UiKit.label(("▼  " + tr("Torre de Hel")) if down else ("▲  " + tr("Endless Tower")), 15, 
			Color(1.0, 0.92, 0.85) if on else ink, true)
		t.mouse_filter = Control.MOUSE_FILTER_IGNORE
		t.size_flags_vertical = Control.SIZE_SHRINK_CENTER
		h.add_child(t)


		if down and not Save.hel_released():
			var wait: = UiKit.label("", 12, Color(1.0, 0.5, 0.2), true)
			wait.mouse_filter = Control.MOUSE_FILTER_IGNORE
			wait.size_flags_vertical = Control.SIZE_SHRINK_CENTER
			h.add_child(wait)
			var tick: = func():
				if not is_instance_valid(wait):
					return
				var left: = Save.hel_wait()
				if left <= 0:
					if _mode == "tower" and not tower_hel:
						show_tower()
					return
				wait.text = tr("abre en %s") % _hel_wait_text(left)
			tick.call()
			var timer: = Timer.new()
			timer.wait_time = 1.0
			timer.process_mode = Node.PROCESS_MODE_ALWAYS
			timer.timeout.connect(tick)
			b.add_child(timer)
			timer.autostart = true
		elif down and not on and not Save.has_seen("talks", "hel_tower"):
			var nw: = UiKit.label(tr("¡Nuevo!"), 11, Color(1.0, 0.5, 0.2), true)
			nw.mouse_filter = Control.MOUSE_FILTER_IGNORE
			nw.size_flags_vertical = Control.SIZE_SHRINK_CENTER
			h.add_child(nw)
			var tw: = b.create_tween().set_loops()
			tw.tween_property(nw, "modulate:a", 0.35, 0.5).set_trans(Tween.TRANS_SINE)
			tw.tween_property(nw, "modulate:a", 1.0, 0.5).set_trans(Tween.TRANS_SINE)
		var want: bool = down
		b.pressed.connect( func():
			if want == tower_hel:
				return
			ui_click()
			if want and not Save.hel_released():

				if _cutin_bubble != null and is_instance_valid(_cutin_bubble):
					_cutin_bubble.queue_free()
				_cutin_say(tr("La Torre de Hel abre en %s") % _hel_wait_text(Save.hel_wait()), tr("Lucile"))
				return
			if want:
				_hel_ask()
			else:
				tower_hel = false
				show_tower())
		row.add_child(b)
	return row



