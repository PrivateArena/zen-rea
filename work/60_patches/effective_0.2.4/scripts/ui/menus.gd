	footer.add_theme_constant_override("separation", 6)
	body.add_child(footer)
	footer.add_child(_ro_button(tr("Rechazar"), func():
		trade.answer(from, false)
		_back_to_hub()))
	var yes: = _ro_button(tr("Aceptar"), func(): trade.answer(from, true))
