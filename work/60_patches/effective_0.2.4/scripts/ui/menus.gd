func _festival_daily_row(col: Control, checks: int) -> void :
	if checks <= 0:
		return



	var box: = VBoxContainer.new()
	box.add_theme_constant_override("separation", 4)
	col.add_child(box)
	var note: = UiKit.label(tr("Premio del día: ya lo recibiste hoy, vuelve mañana.") if not Save.festival_daily_ready() else tr("Premio del día: consultando..."), 11, UiKit.MUTED)
	note.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER
	box.add_child(note)
	if not Save.festival_daily_ready():
		return
	world.board.claim_festival_daily( func(ok: bool, day: String):
		if day != "":
			Save.take_festival_daily(day)


		var got: = _festival_daily_pay(checks) if ok else {}
		if not is_instance_valid(box):
			return
		if not ok:
			note.text = tr("Premio del día: ya lo recibiste hoy, vuelve mañana.") if day != "" else tr("Premio del día: hace falta conexión para recibirlo.")
			return
		note.queue_free()
		_festival_daily_show(box, got))



func _festival_daily_pay(checks: int) -> Dictionary:
	var e: = mini(checks, GameData.FESTIVAL_DAILY_MAX_E)
	var zeny: = e * GameData.FESTIVAL_DAILY_ZENY
	var got: = {"oridecon": e * GameData.FESTIVAL_DAILY_ORE, "elunium": e * GameData.FESTIVAL_DAILY_ORE}
	for i in e / GameData.FESTIVAL_DAILY_ENRICHED_PER:
		var k: String = ["enriched_oridecon", "enriched_elunium"].pick_random()
		got[k] = int(got.get(k, 0)) + 1
	var hd: = e / GameData.FESTIVAL_DAILY_HD_PER + (1 if randf() < float(e % GameData.FESTIVAL_DAILY_HD_PER) / GameData.FESTIVAL_DAILY_HD_PER else 0)
	for i in hd:
		var k: String = ["hd_oridecon", "hd_elunium"].pick_random()
		got[k] = int(got.get(k, 0)) + 1


	for i in e:
		if randf() < GameData.STAR_CRUMB_FESTIVAL:
			got["star_crumb"] = int(got.get("star_crumb", 0)) + 1
		if randf() < GameData.FESTIVAL_DAILY_COIN:
			got["poring_coin"] = int(got.get("poring_coin", 0)) + 1
	Save.add_zeny(zeny)
	for id in got:
		if id == "poring_coin":
			Save.add_coins(int(got[id]))
		else:
			Save.add_material(id, int(got[id]))
	Save.flush()
	got["zeny"] = zeny
	return got



