func _tower_speed_row() -> Control:
	var box: = VBoxContainer.new()
	box.add_theme_constant_override("separation", 2)
	var row: = HBoxContainer.new()
	row.alignment = BoxContainer.ALIGNMENT_CENTER
	box.add_child(row)
	var client: = world != null and world.net.is_client()
	var make: = [Callable()]
	make[0] = func(focus: bool):
		for c in row.get_children():
			row.remove_child(c)
			c.queue_free()


		if client and not world.running:
			var wait: = UiKit.button(tr("Frenesí: lo elige el líder"))
			wait.disabled = true
			row.add_child(wait)
			return
		var s: = (3 if world.game_fast else (2 if world.frenzy else 1)) if client else World.tower_speed()
		var b: = UiKit.button(tr("Frenesí") + "        ", s > 1)
		b.custom_minimum_size.x = 160
		RoServerSelect.frenzy_pips(b, s)
		b.disabled = client
		b.tooltip_text = tr("Frenesí en la torre: la subida va x%s (púlsalo otra vez: x2). Se detiene en los pisos de evento, los MVP y la pelea final. Solo ahorra tiempo.") % str(GameData.FRENZY_SPEED)
		b.pressed.connect( func():
			ui_click()
			world.set_tower_speed(RoServerSelect.next_speed(World.tower_speed()))
			make[0].call_deferred(true))
		row.add_child(b)

		if focus:
			b.grab_focus.call_deferred()
	make[0].call(false)
	var note: = UiKit.label(tr("En grupo decide el líder.") if client else tr("Se elige antes de entrar: no se cambia en plena subida."), 11, UiKit.MUTED)
	note.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER
	box.add_child(note)
	return box



func _tower_party() -> bool:
	return world != null and world.net.is_host() and not world.net.ready_peers().is_empty()




func show_tower_wait(i: int, f: int) -> void :
	_mode = "tower_wait"
	var col: = _screen(tr("Lucile  ·  Endless Tower"), "")
	_npc_cutin("tnm_lucile01")
	_cutin_say(tr("¡Os llamo a todos! Que cada uno elija su build."), tr("Lucile"))
	col.custom_minimum_size.x = 440
	col.add_theme_constant_override("separation", 8)
	var where: = UiKit.label(tr("Empezáis en el piso %d") % f, 15, Color(0.4, 0.25, 0.75), true)
	where.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER
	col.add_child(where)
	var list: = VBoxContainer.new()
	list.add_theme_constant_override("separation", 4)
	col.add_child(list)
	var builds: = Save.tower_builds()
	var mine: Dictionary = builds[i] if i < builds.size() else {}
	var row: = HBoxContainer.new()
	row.alignment = BoxContainer.ALIGNMENT_CENTER
	row.add_theme_constant_override("separation", 10)
	col.add_child(row)
	var back: = UiKit.button(tr("Cancelar"))
	back.custom_minimum_size.x = 140
	back.pressed.connect( func():
		ui_click()
		world.net.cancel_tower()
		show_tower())
	row.add_child(back)
	var go: = UiKit.button(tr("Subir  ▶"), true)
	go.custom_minimum_size.x = 180
	go.pressed.connect( func():
		if world.net.tower_ready():
			var hel: = tower_hel
			show_loading( func(): world.start_tower(i, f, hel), [TowerRun.map_of(f), str(GameData.TOWER_STAGE.map)]))
	row.add_child(go)
	var fill: = func():
		if _mode != "tower_wait" or not is_instance_valid(list):
			return
		for c in list.get_children():
			c.queue_free()
		list.add_child(_tower_member(tr("Tú"), _tower_build_name(mine), "ready"))
		for id in world.net.ready_peers():
			var a: Dictionary = world.net.tower_party.get(id, {})
			list.add_child(_tower_member(str(world.net.peers[id].get("name", "?")), _tower_build_name(a.get("build", {}), false), str(a.get("state", "asking"))))
		go.disabled = not world.net.tower_ready()
	fill.call()
	if not world.net.tower_changed.is_connected(_on_tower_changed):
		world.net.tower_changed.connect(_on_tower_changed)
	_tower_fill = fill
	back.grab_focus.call_deferred()


var _tower_fill: = Callable()


func _on_tower_changed() -> void :
	if _mode == "tower_wait" and _tower_fill.is_valid():
		_tower_fill.call()




func _tower_build_name(b: Dictionary, own: = true) -> String:
	if b.is_empty():
		return ""
	var cid: = str(b.get("class", ""))
	var line: = "%s  ·  Nv %d" % [tr(str(b.get("name", GameData.CLASSES.get(cid, {}).get("name", cid)))), int(b.get("level", 1))]
	var label: = Save.build_label(b) if own else ""
	return line if label == "" else "%s  ·  %s" % [label, line]



