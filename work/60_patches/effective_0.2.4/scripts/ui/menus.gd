func _inv_cell(i: int, selected: int) -> Control:
	var eq: = world.player.equipment
	var cell: = Button.new()
	cell.custom_minimum_size = Vector2(32, 32)
	cell.focus_mode = Control.FOCUS_ALL
	if i >= eq.bag.size():
		cell.disabled = true
		cell.add_theme_stylebox_override("disabled", _cell_box(Color(0.82, 0.84, 0.9), false, 1))

		_unequip_drop_target(cell)
		return cell
	var it: Dictionary = eq.bag[i]
	var rar: = _rarity(it)
	var col: Color = rar[0] if int(it.slots) > 0 or Equipment.is_legendary(it) else Color(0.62, 0.64, 0.7)
	var box: = _cell_box(col, i == selected, 3 if i == selected else 2)
	if Equipment.is_legendary(it):
		box.shadow_color = Color(Equipment.item_color(it), 0.7)
		box.shadow_size = 4
	for st in ["normal", "hover", "pressed", "focus"]:
		cell.add_theme_stylebox_override(st, box if st != "hover" else _cell_box(col.lightened(0.2), true, 3))
	cell.icon = _item_icon(Equipment.item_def(it).icon)
	cell.expand_icon = true
	cell.icon_alignment = HORIZONTAL_ALIGNMENT_CENTER
	if Equipment.sockets(it) > 0:
		var n: = _ro_text("%d" % Equipment.sockets(it), 9, Color.WHITE, true)
		n.add_theme_color_override("font_outline_color", Color(0, 0, 0, 0.9))
		n.add_theme_constant_override("outline_size", 3)
		n.position = Vector2(23, 18)
		cell.add_child(n)
	if Equipment.is_locked(it):
		cell.add_child(_padlock(Vector2(1, 1)))
	_grade_deco(cell, it)
	cell.gui_input.connect( func(ev: InputEvent):
		if ev is InputEventMouseButton and ev.button_index == MOUSE_BUTTON_LEFT:
			if ev.pressed and ev.ctrl_pressed:

				_hide_item_hover()
				_inv_sell(i)
			elif ev.pressed and ev.double_click:
				_inv_equip(i, "")
			elif not ev.pressed and _pad_click():

				_hide_item_hover()
				_inv_equip(i, "")
			elif not ev.pressed and not ev.ctrl_pressed:




				if touch_ui():
					_hide_item_hover()
				show_inventory(i)
			else:
				return
			cell.accept_event()
		elif ev is InputEventMouseButton and ev.button_index == MOUSE_BUTTON_RIGHT and ev.pressed and _pad_click():


			_hide_item_hover()
			show_inventory(i)
			cell.accept_event()
		elif ev is InputEventMouseButton and ev.button_index == MOUSE_BUTTON_RIGHT and ev.pressed and not touch_ui():


			_hide_item_hover()
			_inv_lock(i)
			cell.accept_event()
		elif ev is InputEventMouseButton and ev.button_index == MOUSE_BUTTON_RIGHT and ev.pressed and touch_ui() and not _pad_click():



			_show_item_hover(it, cell)
			cell.accept_event())
	cell.mouse_entered.connect( func(): _show_item_hover(it, cell))

	cell.mouse_exited.connect( func():
		if _hover_args.size() > 1 and _hover_args[1] == cell:
			_hide_item_hover())

	cell.set_drag_forwarding(
		func(_at: Vector2) -> Variant:
			_hide_item_hover()
			var pv: = UiKit.icon_rect(_item_icon(Equipment.item_def(it).icon), 32)
			pv.size = Vector2(32, 32)
			pv.modulate.a = 0.85
			cell.set_drag_preview(pv)
			return {"type": "item", "index": i}, 
		func(_at: Vector2, data: Variant) -> bool:
			return data is Dictionary and data.get("type", "") == "equipped", 
		func(_at: Vector2, data: Variant) -> void :
			_unequip(str(data.slot)))
	return cell



