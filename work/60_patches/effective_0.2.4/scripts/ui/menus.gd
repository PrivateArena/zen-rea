			_friends_failed = not ok
			if _mode == "friends":
				show_friends(back))
	_friends_poll(back)


var _friends_poll_on: = false


func _friends_poll(back: Callable) -> void :
	if _friends_poll_on:
		return
	_friends_poll_on = true
	while _mode == "friends" and is_inside_tree():
		await get_tree().create_timer(20.0, true).timeout
		if _mode != "friends":
			break
		world.friends.refresh( func(_ok):

			var typing: = get_viewport().gui_get_focus_owner() is LineEdit
			if _mode == "friends" and not typing:
				show_friends(back))
	_friends_poll_on = false


func _friends_note(text: String, ok: bool) -> void :
	_friends_msg = [text, ok]







func _friends_leave(back: = Callable()) -> void :
	_friends_msg = ["", true]
	_friends_failed = false
	if world != null and world.town != null and not world.running:



		enter_town_mode()
	elif back.is_valid():
		back.call()
	elif world != null and world.running:
		close()
	else:
		show_class_select()


