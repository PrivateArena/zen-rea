func _load_pact_set(class_id: String, value: Variant) -> String:
	var want: Array = value if value is Array else []
	for id in Save.pacts(class_id):
		if not want.has(id):
			Save.toggle_pact(class_id, str(id))
	var missing: = 0
	for id in want:
		if not GameData.PACTS.has(str(id)) or not GameData.pact_unlocked(str(id)):
			missing += 1
		elif not Save.pacts(class_id).has(id):
			Save.toggle_pact(class_id, str(id))
	return tr("Pactos aún no abiertos (no se pusieron): %d.") % missing if missing > 0 else ""





