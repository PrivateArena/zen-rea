func _cloud_card(page: VBoxContainer) -> void :
	var cloud: Node = world.get("cloud")
	if cloud == null:
		return
	var rows: = _opt_card(page, tr("Guardado en la nube"))
	var small: = func(b: Button) -> Button:
		b.custom_minimum_size = Vector2(0, 32)
		b.add_theme_font_size_override("font_size", 13)
		return b

	var who: String = cloud.user()
	var acc: = small.call(UiKit.button(tr("Mi cuenta") if who != "" else tr("Iniciar sesión o crear cuenta"), who == "")) as Button
	acc.pressed.connect( func(): show_account())
	_opt_row(rows, tr("Cuenta"), acc, tr("Sesión: %s") % who if who != "" else tr("Juegas como invitado"))

	if not cloud.changed.is_connected(_cloud_refresh):
		cloud.changed.connect(_cloud_refresh)
	if not cloud.linked():
		var on: = small.call(UiKit.button(tr("Activar"), true)) as Button
		on.disabled = cloud.status == "syncing"
		on.pressed.connect( func(): cloud.enable())
		_opt_row(rows, tr("Tu progreso en la nube"), on, tr("Juega en PC y celular con la misma partida"))
		var line: = HBoxContainer.new()
		line.add_theme_constant_override("separation", 6)
		var code: = LineEdit.new()
		code.placeholder_text = "XXXX-XXXX"
		code.max_length = 9
		code.custom_minimum_size = Vector2(130, 32)
		line.add_child(code)
		var use: = small.call(UiKit.button(tr("Usar"))) as Button
		line.add_child(use)
		var said: = UiKit.label("", 11, Color(0.7, 0.15, 0.1))
		use.pressed.connect( func():
			use.disabled = true
			cloud.use_code(code.text, func(err: String):
				if is_instance_valid(use):
					use.disabled = false
				if err != "" and is_instance_valid(said):
					said.text = err))
		_opt_row(rows, tr("Tengo un código"), line, tr("Hecho en tu otro dispositivo"))
		rows.add_child(said)
		if cloud.status == "offline":
			rows.add_child(UiKit.label(Leaderboard.offline_text(), 11, Color(0.7, 0.15, 0.1)))
		return
	var state: String = {"syncing": tr("Sincronizando..."), "ok": tr("Sincronizado"), "offline": Leaderboard.offline_text(tr("Sin conexión (se reintenta solo)")), 
		"conflict": tr("Elige qué partida conservar"), "error": tr("La nube no reconoce este dispositivo"), 
		"too_big": tr("Tu partida es demasiado grande para la nube: escríbenos en Discord")}.get(cloud.status, tr("Activado"))
	var now: = small.call(UiKit.button(tr("Sincronizar"))) as Button
	now.disabled = cloud.status == "syncing"
	now.pressed.connect( func(): cloud.sync_now(false))
	_opt_row(rows, tr("Estado"), now, state)
	var link: Dictionary = cloud.link
	if link.has("code") and Time.get_ticks_msec() < int(link.until):
		var c: = str(link.code)
		var shown: = c.left(4) + "-" + c.substr(4)
		var code_row: = HBoxContainer.new()
		code_row.add_theme_constant_override("separation", 10)
		code_row.add_child(UiKit.label(shown, 22, Color(0.14, 0.2, 0.45), true))
		var copy: = small.call(UiKit.button(tr("Copiar"))) as Button
		copy.pressed.connect( func():
			UiKit.copy(shown)
			copy.text = tr("¡Copiado!"))
		code_row.add_child(copy)
		_opt_row(rows, tr("Código para tu otro dispositivo"), code_row, tr("Escríbelo allí en «Tengo un código». Vale 10 minutos."))
	else:
		var mk: = small.call(UiKit.button(tr("Vincular otro dispositivo"))) as Button
		mk.pressed.connect( func(): cloud.make_link())
		_opt_row(rows, tr("Otro dispositivo"), mk, tr("Te da un código para usar allí"))
	var off: = small.call(UiKit.button(tr("Desvincular"))) as Button
	off.add_theme_color_override("font_color", Color(0.7, 0.12, 0.1))
	off.pressed.connect( func(): cloud.forget())
	_opt_row(rows, tr("Este dispositivo"), off, tr("Tu progreso se queda aquí y en la nube"))




