		var lb_text: = tr("Sin candado (%d)") % int(loose[0])
		var lb: = _ro_button(lb_text, func():
			var b: Button = lb_ref[0]
			if armed[0]:
				_inv_sell_unlocked()
				return
			armed[0] = true
			b.text = (tr("¿%d por %s z y Moneda legendaria x%d? Otra vez") % [int(loose[0]), RoBasicWindow._thousands(int(loose[1])), int(loose[2])]
				if int(loose[2]) > 0 else tr("¿%d por %s z? Otra vez") % [int(loose[0]), RoBasicWindow._thousands(int(loose[1]))])
			ui_click()
			get_tree().create_timer(3.0).timeout.connect( func():
				if is_instance_valid(b) and armed[0]:
					armed[0] = false
					b.text = lb_text))
		lb_ref.append(lb)
		lb.size_flags_horizontal = Control.SIZE_SHRINK_BEGIN
		lb.add_theme_font_size_override("font_size", 10)
		lb.tooltip_text = tr("Vende todo lo de la bolsa que no tenga candado (Bloquear), legendarias incluidas (por Monedas legendarias); nunca las únicas, las almas ni el equipo inicial. Sus cartas vuelven a la bolsa. Pulsa dos veces.")
		sell_btns.add_child(lb)

	var ups: = eq.bag.filter( func(b): return eq.upgrade_slot(b) != "").size()
	if ups > 0:
		var ub: = _ro_button(tr("Equipar lo mejor (%d)") % ups, _inv_equip_upgrades)
		ub.size_flags_horizontal = Control.SIZE_SHRINK_BEGIN
		ub.add_theme_font_size_override("font_size", 10)
		ub.tooltip_text = tr("Equipa lo que llevas en la bolsa que sea mejor que lo puesto (rareza, rango, ranuras, refino y cartas). Nunca quita el equipo inicial ni un legendario.")
		sell_btns.add_child(ub)

	if eq.bag.size() > 1:
		var ob: = _ro_button(tr("Ordenar"), func():
			eq.sort_bag()
			ui_click()
			show_inventory(-1))
		ob.size_flags_horizontal = Control.SIZE_SHRINK_BEGIN
		ob.add_theme_font_size_override("font_size", 10)
		ob.tooltip_text = tr("Por tipo de pieza: armas primero, lo más raro y mejor de cada tipo delante; las copias de un objeto juntas.")
		sell_btns.add_child(ob)
	var sell_row: = _autosell_row(gb)

	var fetch: = CheckBox.new()
	fetch.text = tr("Mascota trae cofres (G)")
	fetch.focus_mode = Control.FOCUS_NONE
	fetch.add_theme_font_size_override("font_size", 10)
	for st in ["font_color", "font_hover_color", "font_pressed_color", "font_hover_pressed_color"]:
		fetch.add_theme_color_override(st, Color(0.2, 0.26, 0.43))
	fetch.button_pressed = bool(Save.setting("pet_fetch", true))
	fetch.toggled.connect( func(on: bool):
		if on != bool(Save.setting("pet_fetch", true)):
			world.toggle_pet_fetch())
	box.add_child(fetch)

	var up: = CheckBox.new()
	up.text = tr("Equipar lo mejor al recogerlo")
	up.focus_mode = Control.FOCUS_NONE
	up.add_theme_font_size_override("font_size", 10)
	for st in ["font_color", "font_hover_color", "font_pressed_color", "font_hover_pressed_color"]:
		up.add_theme_color_override(st, Color(0.2, 0.26, 0.43))
	up.button_pressed = bool(Save.setting("auto_upgrade", true))
	var up_tip: = tr("Si lo que encuentras es mejor que lo que llevas puesto, te lo pones y lo viejo va a la bolsa. Nunca quita el equipo inicial ni un legendario.")
	if world.is_coop():
		up_tip += "\n" + tr("En co-op el cambio cuenta desde la próxima partida.")
	up.tooltip_text = up_tip
	up.toggled.connect( func(on: bool):
		Save.set_setting("auto_upgrade", on)
		if not world.is_coop():
			eq.auto_upgrade = on)
	box.add_child(up)

	if world.player.equipment.bag.size() >= world.player.equipment.bag_max and not bool(Save.setting("autosell_hint_seen", false)):
		Save.set_setting("autosell_hint_seen", true)
		box.add_child(_autosell_hint(sell_row))
	else:
		box.add_child(sell_row)



func _padlock(at: Vector2) -> Control:
	var c: = Control.new()
	c.mouse_filter = Control.MOUSE_FILTER_IGNORE
	c.position = at
	c.size = Vector2(11, 12)
	c.draw.connect( func():
		var ink: = Color(0.25, 0.17, 0.02)
		c.draw_arc(Vector2(5.5, 5.0), 3.0, PI, TAU, 10, ink, 3.0, true)
		c.draw_arc(Vector2(5.5, 5.0), 3.0, PI, TAU, 10, Color(1.0, 0.85, 0.35), 1.4, true)
		c.draw_rect(Rect2(1, 5, 9, 7), ink)
		c.draw_rect(Rect2(2, 6, 7, 5), Color(1.0, 0.8, 0.25))
		c.draw_rect(Rect2(5, 7, 1, 2), ink))
