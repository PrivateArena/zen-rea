	b.icon = _item_icon("fly_wing")
	b.expand_icon = true
	b.icon_alignment = HORIZONTAL_ALIGNMENT_CENTER
	b.add_theme_constant_override("icon_max_width", 20)
	var off: = UiKit.panel_box(Color.WHITE, Color(0.66, 0.72, 0.88), 10)
	off.shadow_size = 0
	off.set_content_margin_all(2)
	var lit: = off.duplicate() as StyleBoxFlat
	lit.bg_color = Color(0.92, 0.95, 1.0)
	var on: = UiKit.panel_box(Color(0.84, 0.91, 1.0), Color(0.3, 0.42, 0.78), 10, 2)
	on.shadow_size = 0
	on.set_content_margin_all(2)
	var dead: = off.duplicate() as StyleBoxFlat
	dead.bg_color = Color(0.96, 0.965, 0.98)
	dead.border_color = Color(0.85, 0.87, 0.92)
	for st in ["normal", "focus"]:
		b.add_theme_stylebox_override(st, off)
	b.add_theme_stylebox_override("hover", lit)
	b.add_theme_stylebox_override("pressed", on)
	b.add_theme_stylebox_override("hover_pressed", on)
	b.add_theme_stylebox_override("disabled", dead)

	b.add_theme_color_override("icon_normal_color", Color(1, 1, 1, 0.35))
	b.add_theme_color_override("icon_hover_color", Color(1, 1, 1, 0.7))
	b.add_theme_color_override("icon_disabled_color", Color(1, 1, 1, 0.15))
	b.button_pressed = (_class_setting("pick_bans", cid, []) as Array).has(id)
	var paint: = func():
		var lim: = int((_class_setting("pick_limits", cid, {}) as Dictionary).get(id, 0))
		b.disabled = lim <= 0
		b.tooltip_text = tr("Ponle un tope de nivel para poder desterrarla al llegar.") if lim <= 0\
		else tr("Al llegar a Nv %d, «Elegir al azar» la destierra de la partida con un Holy Water (si te queda): ya no sale y las demás salen más.") % lim
	paint.call()
	b.toggled.connect( func(now: bool):
		var bans: Array = _class_setting("pick_bans", cid, [])
		bans.erase(id)
		if now:
			bans.append(id)
		_set_class_setting("pick_bans", cid, bans)
		world.play_sound("ui_click", 0.0, -8.0))

	limit_pick.connect("level_set", paint)
	return b




func _pick_skill_card(id: String) -> Dictionary:
	if world.player != null and is_instance_valid(world.player) and world.hud != null:
		return world.hud._skill_hover(id)
	var d: Dictionary = GameData.SKILLS[id]
	return {"icon": UiKit.skill_icon(id), "title": tr(str(d.name)), "chips": _skill_chips_for(id), "desc": _skill_desc(id, true)}


func _pick_row(id: String, i: int, list: VBoxContainer, dropped: Callable, cid: String) -> Control:
	var top: = i == 0
	var row: = PanelContainer.new()
	row.set_meta("pick_id", id)
	row.mouse_filter = Control.MOUSE_FILTER_STOP


	row.set_meta("no_touch_scroll", true)
	row.mouse_default_cursor_shape = Control.CURSOR_DRAG
	var st: = StyleBoxFlat.new()
	st.bg_color = Color(1.0, 0.96, 0.82) if top else (Color(0.93, 0.945, 0.975) if i % 2 == 1 else Color(1, 1, 1, 0))
	st.set_corner_radius_all(8)
	st.content_margin_left = 6
	st.content_margin_right = 10
	st.content_margin_top = 1
	st.content_margin_bottom = 2
	st.anti_aliasing = true

	var held: = UiKit.panel_box(Color.WHITE, UiKit.GOLD, 8, 2)
	held.shadow_color = Color(0.03, 0.06, 0.18, 0.3)
	held.shadow_size = 8
	held.shadow_offset = Vector2(0, 3)
	held.content_margin_left = 6
	held.content_margin_right = 10
	held.content_margin_top = 1
	held.content_margin_bottom = 2
	var lit: = st.duplicate() as StyleBoxFlat
	lit.bg_color = Color(0.88, 0.92, 1.0) if not top else Color(1.0, 0.93, 0.74)
	row.add_theme_stylebox_override("panel", st)
	var line: = HBoxContainer.new()
	line.add_theme_constant_override("separation", 8)
	line.mouse_filter = Control.MOUSE_FILTER_IGNORE
	row.add_child(line)
	var grip: = UiKit.label("⋮⋮", 15, Color(0.62, 0.67, 0.8), true)
	grip.size_flags_vertical = Control.SIZE_SHRINK_CENTER
	line.add_child(grip)
	var num: = UiKit.label(str(i + 1), 15, UiKit.GOLD if top else UiKit.MUTED, true)
	num.custom_minimum_size.x = 20
	num.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER
	num.size_flags_vertical = Control.SIZE_SHRINK_CENTER
	line.add_child(num)
	row.set_meta("num", num)
	var stat: bool = GameData.STATS.has(id)
	if stat:
		var tag: = UiKit.label(tr(str(GameData.STATS[id].name)), 13, Color(0.25, 0.4, 0.8), true)
		tag.custom_minimum_size = Vector2(32, 32)
		tag.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER
		tag.vertical_alignment = VERTICAL_ALIGNMENT_CENTER
		line.add_child(tag)
	else:
		var ic: = UiKit.icon_rect(UiKit.skill_icon(id), 32)
		ic.mouse_filter = Control.MOUSE_FILTER_IGNORE
		line.add_child(ic)
	var name_l: = UiKit.label(tr(str(GameData.STATS[id].full if stat else GameData.SKILLS[id].name)), 15, UiKit.TEXT, top)
	name_l.size_flags_horizontal = Control.SIZE_EXPAND_FILL
	name_l.size_flags_vertical = Control.SIZE_SHRINK_CENTER
	line.add_child(name_l)



	var lim_pick: = _pick_limit_button(id, cid)
	line.add_child(lim_pick)
	line.add_child(_pick_ban_toggle(id, cid, lim_pick))

	var card: Dictionary = {} if stat or not GameData.SKILLS.has(id) else _pick_skill_card(id)
	if not card.is_empty():
		_set_hover(row, card)
	var dragging: = [false]
	row.mouse_entered.connect( func():
		if not dragging[0]:
			row.add_theme_stylebox_override("panel", lit))
	row.mouse_exited.connect( func():
		if not dragging[0]:
			row.add_theme_stylebox_override("panel", st))
	row.gui_input.connect( func(ev: InputEvent):
		if ev is InputEventMouseButton and ev.button_index == MOUSE_BUTTON_LEFT:
			if ev.pressed:
				dragging[0] = true
				if row.has_meta("hover"):
					row.remove_meta("hover")
				row.add_theme_stylebox_override("panel", held)
				row.z_index = 1
				world.play_sound("ui_click", 0.0, -8.0)
			elif dragging[0]:
				dragging[0] = false
				if not card.is_empty():
					_set_hover(row, card)
				row.z_index = 0
				row.add_theme_stylebox_override("panel", st)
				world.play_sound("equip_item", 0.0, -8.0)
				dropped.call()
			row.accept_event()
		elif ev is InputEventMouseMotion and dragging[0]:

			var y: float = row.get_global_mouse_position().y
			var to: = 0
			for c in list.get_children():
				if c != row and c is Control and (c as Control).get_global_rect().get_center().y < y:
					to += 1


			var sc: = list.get_parent() as ScrollContainer
			if sc != null:
				var r: = sc.get_global_rect()
				var edge: = 28.0
				if y < r.position.y + edge:
					sc.scroll_vertical -= 12
				elif y > r.end.y - edge:
					sc.scroll_vertical += 12
			if to != row.get_index():
				list.move_child(row, to)
				world.play_sound("ui_click", 0.0, -14.0)

				for c in list.get_children():
					if c.has_meta("num"):
						(c.get_meta("num") as Label).text = str(c.get_index() + 1)
			row.accept_event())
	return row


