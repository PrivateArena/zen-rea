func show_kafra() -> void :
	_mode = "kafra"
	var body: = _ro_screen(tr("Kafra Corporation"), 530)
	var talk: = _npc_header(Save.kafra(), tr("Empleada Kafra"), tr("Bienvenido a la Corporación Kafra. Invierte tu zeny en mejoras que acompañarán a todos tus aventureros en cada partida."), 430)
	body.add_child(talk)


	var scroll: = ScrollContainer.new()
	scroll.horizontal_scroll_mode = ScrollContainer.SCROLL_MODE_DISABLED
	var view: = get_viewport().get_visible_rect().size
	scroll.custom_minimum_size = Vector2(510, clampf(view.y / client_k(view) - 190.0, 160.0, 420.0))
	body.add_child(scroll)
	var list: = VBoxContainer.new()
	list.add_theme_constant_override("separation", 2)
	list.size_flags_horizontal = Control.SIZE_EXPAND_FILL
	scroll.add_child(list)
	var first: Button
	var listed: = []
	for sec in GameData.UPGRADE_SECTIONS:
		listed.append_array(sec.ids)
	var sections: Array = GameData.UPGRADE_SECTIONS.duplicate()

	var rest: = GameData.UPGRADES.keys().filter( func(i): return not listed.has(i))
	if not rest.is_empty():
		sections.append({"name": "Otras", "ids": rest})

	if _kafra_tab < 0 or _kafra_tab >= sections.size():
		_kafra_tab = 0
	var tabs: = HFlowContainer.new()
	tabs.add_theme_constant_override("h_separation", 4)
	tabs.add_theme_constant_override("v_separation", 4)
	body.add_child(tabs)
	body.move_child(tabs, scroll.get_index())
	for i in sections.size():
		var ti: = i
		var affordable: = (sections[i].ids as Array).any( func(u):
			return GameData.UPGRADES.has(u) and Save.upgrade_level(u) < int(GameData.UPGRADES[u].max)\
			and GameData.upgrade_cost(u, Save.upgrade_level(u)) <= Save.zeny())
		var tb: = _ro_button(tr(str(sections[i].name)) + ("  •" if affordable else ""), func():
			_kafra_tab = ti
			_npc_scroll.erase("kafra")
			show_kafra())
		if i == _kafra_tab:
			_select_style(tb)
		tabs.add_child(tb)
	for id in sections[_kafra_tab].ids:
		var b: = _kafra_row(list, id)
		if first == null and b != null and not b.disabled:
			first = b
	_keep_scroll(scroll, "kafra")
	var footer: = HBoxContainer.new()
	footer.alignment = BoxContainer.ALIGNMENT_END
	footer.add_theme_constant_override("separation", 6)
	body.add_child(footer)
	footer.add_child(_zeny_chip())
	var close: = _ro_button(tr("Cerrar"), _back_to_hub)
	footer.add_child(close)
	(first if first != null else close).grab_focus.call_deferred()


