func _fav_mark(at: Vector2) -> Control:
	var c: = Control.new()
	c.mouse_filter = Control.MOUSE_FILTER_IGNORE
	c.position = at
	c.size = Vector2(11, 10)
	c.draw.connect( func():
		var ink: = Color(0.45, 0.05, 0.2)
		var pink: = Color(1.0, 0.4, 0.6)
		for pass_i in 2:
			var grow: = 1.0 if pass_i == 0 else 0.0
			var col: = ink if pass_i == 0 else pink
			c.draw_circle(Vector2(3.0, 3.2), 2.6 + grow, col)
			c.draw_circle(Vector2(8.0, 3.2), 2.6 + grow, col)
			c.draw_colored_polygon(PackedVector2Array([Vector2(0.3 - grow, 4.2), Vector2(10.7 + grow, 4.2), Vector2(5.5, 9.6 + grow)]), col))
	return c



var _inv_group: = ""
const ITEM_GROUPS: = [["", "Todo"], ["weapon", "Armas"], ["head", "Cabeza"], ["body", "Cuerpo"], ["acc", "Accesorios"]]




static func item_group(it: Dictionary) -> String:
	match Equipment.item_type(it):
		"weapon":
			return "weapon"
		"head", "mid", "low":
			return "head"
		"acc":
			return "acc"
	return "body"




func _group_filter(items: Array) -> Array:
	var out: = range(items.size()).filter( func(k): return _inv_group == "" or item_group(items[k]) == _inv_group)
	if out.is_empty() and _inv_group != "":
		_inv_group = ""
		return range(items.size())
	return out




func _filter_chip(text: String, on: bool, enabled: bool, pick: Callable, font: = 10) -> Button:
	var b: = Button.new()
	b.text = text
	b.focus_mode = Control.FOCUS_NONE
	b.disabled = not enabled
	b.add_theme_font_override("font", UiKit.FONT_BODY)
	b.add_theme_font_size_override("font_size", font)
	for st in ["normal", "hover", "pressed", "disabled"]:
		var sb: = StyleBoxFlat.new()
		sb.bg_color = Color(0.3, 0.45, 0.85) if on else (Color(1, 1, 1) if st == "hover" else Color(0.96, 0.97, 1.0))
		sb.border_color = Color(0.25, 0.38, 0.75) if on else (Color(0.45, 0.58, 0.9) if st == "hover" else Color(0.8, 0.83, 0.92))
		sb.set_border_width_all(1)
		sb.set_corner_radius_all(9)
		sb.content_margin_left = 7
		sb.content_margin_right = 7
		sb.content_margin_top = 1
		sb.content_margin_bottom = 1
		if st == "disabled":
			sb.bg_color = Color(0.97, 0.97, 0.99)
			sb.border_color = Color(0.88, 0.89, 0.93)
		b.add_theme_stylebox_override(st, sb)
	var ink: = Color.WHITE if on else Color(0.22, 0.3, 0.52)
	for c in ["font_color", "font_hover_color", "font_pressed_color", "font_focus_color"]:
		b.add_theme_color_override(c, ink)
	b.add_theme_color_override("font_disabled_color", Color(0.7, 0.72, 0.78))
	b.pressed.connect(pick)
	return b




func _group_chips(groups: Array, cur: String, pick: Callable, font: = 10) -> HBoxContainer:
	var row: = HBoxContainer.new()
	row.add_theme_constant_override("separation", 3)
	var names: = {"": tr("Todo"), "weapon": tr("Armas"), "head": tr("Cabeza"), "body": tr("Cuerpo"), "acc": tr("Accesorios")}
	for pair in ITEM_GROUPS:
		var g: String = pair[0]
		var n: = groups.size() if g == "" else groups.count(g)
		var b: = Button.new()
		b.text = str(names[g]) if g == "" else "%s %d" % [names[g], n]
		b.focus_mode = Control.FOCUS_NONE
		b.disabled = n == 0 and g != ""
		b.add_theme_font_override("font", UiKit.FONT_BODY)
		b.add_theme_font_size_override("font_size", font)
		var on: = g == cur
		for st in ["normal", "hover", "pressed", "disabled"]:
			var sb: = StyleBoxFlat.new()
			sb.bg_color = Color(0.3, 0.45, 0.85) if on else (Color(1, 1, 1) if st == "hover" else Color(0.96, 0.97, 1.0))
			sb.border_color = Color(0.25, 0.38, 0.75) if on else (Color(0.45, 0.58, 0.9) if st == "hover" else Color(0.8, 0.83, 0.92))
			sb.set_border_width_all(1)
			sb.set_corner_radius_all(9)
			sb.content_margin_left = 7
			sb.content_margin_right = 7
			sb.content_margin_top = 1
			sb.content_margin_bottom = 1
			if st == "disabled":
				sb.bg_color = Color(0.97, 0.97, 0.99)
				sb.border_color = Color(0.88, 0.89, 0.93)
			b.add_theme_stylebox_override(st, sb)
		var ink: = Color.WHITE if on else Color(0.22, 0.3, 0.52)
		for c in ["font_color", "font_hover_color", "font_pressed_color", "font_focus_color"]:
			b.add_theme_color_override(c, ink)
		b.add_theme_color_override("font_disabled_color", Color(0.7, 0.72, 0.78))
		b.pressed.connect( func(): pick.call(g))
		row.add_child(b)
	return row




