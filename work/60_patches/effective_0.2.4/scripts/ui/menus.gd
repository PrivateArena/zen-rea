func _choice_row(caption: String, opts: Array, key: String, default: Variant, apply: Callable, note: = "") -> HBoxContainer:
	var row: = HBoxContainer.new()
	row.add_theme_constant_override("separation", 4)
	var l: = _ro_text(caption, 11, Color(0.15, 0.2, 0.45), true)
	l.custom_minimum_size.x = 64
	l.size_flags_vertical = Control.SIZE_SHRINK_CENTER
	row.add_child(l)
	var buttons: Array[Button] = []
	var mark: = func():
		var now = Save.setting(key, default)
		for i in buttons.size():
			buttons[i].text = ("» " if opts[i][1] == now else "") + str(opts[i][0])
	for o in opts:
		var b: = _ro_button(str(o[0]), func():
			Save.set_setting(key, o[1])
			mark.call()
			world.play_sound("ui_click", 0.05, -6.0)
			if apply.is_valid():
				apply.call(o[1]))
		b.custom_minimum_size = Vector2(maxf(44.0, 8.0 * str(o[0]).length() + 24.0), 18)
		b.size_flags_vertical = Control.SIZE_SHRINK_CENTER
		buttons.append(b)
		row.add_child(b)
	mark.call()
	if note != "":
		var n: = _ro_text(note, 9, Color(0.28, 0.3, 0.4))
		n.size_flags_vertical = Control.SIZE_SHRINK_CENTER
		row.add_child(n)
	return row





func _check_row(items: Array, apply: Callable, indent: = true) -> HBoxContainer:
	var row: = HBoxContainer.new()
	row.add_theme_constant_override("separation", 12)
	if indent:
		var pad: = Control.new()
		pad.custom_minimum_size.x = 64
		row.add_child(pad)
	for it in items:
		var cb: = CheckBox.new()
		cb.text = str(it[0])
		cb.focus_mode = Control.FOCUS_NONE
		cb.add_theme_font_size_override("font_size", 11)
		for st in ["font_color", "font_hover_color", "font_pressed_color", "font_hover_pressed_color"]:
			cb.add_theme_color_override(st, Color(0.15, 0.2, 0.45))
		var key: String = it[1]
		cb.button_pressed = bool(Save.setting(key, it[2]))
		cb.toggled.connect( func(on: bool):
			Save.set_setting(key, on)
			if apply.is_valid():
				apply.call())
		row.add_child(cb)
	return row



