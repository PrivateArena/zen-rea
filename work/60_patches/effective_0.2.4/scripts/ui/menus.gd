	info.size_flags_horizontal = Control.SIZE_EXPAND_FILL
	row.add_child(info)
	var l: = UiKit.label(_tower_build_name(b), 13, UiKit.TEXT, true)
	l.clip_text = true
	info.add_child(l)
	info.add_child(UiKit.label("%s  ·  %s" % [GameData.danger_name(int(b.get("danger", 1))), str(b.get("saved", "")).left(10)]
		+ ("  ·  " + tr("Bloqueada") if Save.build_locked(b) else ""), 10, UiKit.MUTED))
	var skills: Array = (b.get("skills", []) as Array).duplicate()
	skills.sort_custom( func(a, c): return int(a[1]) > int(c[1]))
	for pair in skills.slice(0, 4):
		var tex: = UiKit.skill_icon(str(pair[0]))
		if tex != null:
			var ic: = UiKit.icon_rect(tex, 22)
			ic.tooltip_text = "%s Nv %d" % [tr(str(GameData.SKILLS.get(str(pair[0]), {}).get("name", pair[0]))), int(pair[1])]
			ic.mouse_filter = Control.MOUSE_FILTER_PASS
			ic.size_flags_vertical = Control.SIZE_SHRINK_CENTER
			row.add_child(ic)
	if extra != null:
		row.add_child(extra)
	var go: = UiKit.button(button_text if button_text != "" else tr("Elegir"), true)
	go.custom_minimum_size = Vector2(72, 30)
	go.size_flags_vertical = Control.SIZE_SHRINK_CENTER

	go.disabled = extra != null and Save.build_locked(b)
	go.pressed.connect( func():
		ui_click()
		go_fn.call())
	row.add_child(go)
	return panel





