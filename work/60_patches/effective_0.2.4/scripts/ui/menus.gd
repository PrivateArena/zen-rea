func _hero_gear(class_id: String) -> Dictionary:
	var out: = {}
	if class_id != "":
		var lo: = Save.loadout(class_id)
		for k in lo:
			out[str(lo[k])] = true
	return out



func _store_shown(keep: = Callable()) -> Array:
	var list: = Save.storage().filter( func(it): return not _store_hidden(it) and ( not keep.is_valid() or keep.call(it)))
	if _store_group != "":
		var mine: = _hero_gear(_store_hero())
		list = list.filter( func(it): return _store_in_group(it, _store_group, mine))
	if _store_slot != "":
		list = list.filter( func(it): return str(Equipment.item_def(it).get("slot", "")) == _store_slot)
	return list






