		inner.alignment = BoxContainer.ALIGNMENT_CENTER
		inner.add_theme_constant_override("separation", 5)
		inner.mouse_filter = Control.MOUSE_FILTER_IGNORE
		inner.set_anchors_and_offsets_preset(Control.PRESET_FULL_RECT)
		b.add_child(inner)
		var icon: = UiKit.skill_icon(str(d.icon))
		if icon != null:
			var center: = CenterContainer.new()
			center.mouse_filter = Control.MOUSE_FILTER_IGNORE
			center.add_child(UiKit.icon_rect(icon, 40))
			inner.add_child(center)
		var n: = UiKit.label(tr(str(d.name)), 15, Color(0.42, 0.18, 0.62), true)
		n.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER
		inner.add_child(n)
		var have: = int(p.toys.get(id, 0)) if p != null else 0
		if have > 0:
			var hl: = UiKit.label(tr("Tienes %d / %d") % [have, int(d.get("max", 3))], 11, Color(0.55, 0.35, 0.75), true)
			hl.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER
			inner.add_child(hl)
		var t: = UiKit.label(tr(str(d.desc)), 12, UiKit.TEXT)
		t.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER
		t.autowrap_mode = TextServer.AUTOWRAP_WORD_SMART
		t.custom_minimum_size.x = 160
		inner.add_child(t)
		var key: = str(id)
		b.pressed.connect( func():
			if _grace > 0.0:
				return
			ui_click()
			_resume()
			done.call(key))
		row.add_child(b)
		if first == null:
			first = b
	if first != null:
		first.grab_focus.call_deferred()






var _wheel_remote: = Callable()

func tower_wheel_remote(idx: int, id: String) -> void :
	if _mode == "tower_wheel" and _wheel_remote.is_valid():
		_wheel_remote.call(idx, id)






func show_tower_wheel(pick: Callable, taken: Callable, done: Callable, turns: Array = [], first: = 0) -> void :
	var total: int = turns.size() if not turns.is_empty() else GameData.TOWER_WHEEL_SPINS
	first = clampi(first, 0, total)
	var mine: = func(i: int) -> bool: return turns.is_empty() or (i < turns.size() and bool(turns[i][2]))
	if auto_pick:
		for i in range(first, total):
			if mine.call(i):
				taken.call(pick.call())
		done.call()
		return
	_clear()
	_mode = "tower_wheel"
	world.hold_world()
	_grace = INPUT_GRACE
	_root.mouse_filter = Control.MOUSE_FILTER_STOP
	var view: = get_viewport().get_visible_rect().size
	var shade: = UiKit.backdrop(0.95)
	_root.add_child(shade)


	var center: = CenterContainer.new()
	center.set_anchors_and_offsets_preset(Control.PRESET_FULL_RECT)
	center.mouse_filter = Control.MOUSE_FILTER_IGNORE
	_root.add_child(center)
	var stage: = VBoxContainer.new()
	stage.alignment = BoxContainer.ALIGNMENT_CENTER
	stage.add_theme_constant_override("separation", 2)
	center.add_child(stage)
	_npc_cutin("tnm_lucile03")

	if _cutin_art != null:
		_root.move_child(_cutin_art, shade.get_index() + 1)
	var say: = func(line: String):
		if _cutin_bubble != null and is_instance_valid(_cutin_bubble):
			_cutin_bubble.queue_free()
		_cutin_say(line, tr("Lucile"))
	say.call(tr("¡Gírala! Algunas casillas no son amables..."))
	var head: = _wheel_text(tr("LA RULETA DE LUCILE"), 26, Color(1.0, 0.85, 0.45), 6)
	stage.add_child(head)
	var pips: = HBoxContainer.new()
	pips.alignment = BoxContainer.ALIGNMENT_CENTER
	pips.add_theme_constant_override("separation", 8)
	stage.add_child(pips)
	var gems: Array[ColorRect] = []
	for i in total:
		var gem: = ColorRect.new()
		gem.custom_minimum_size = Vector2(34, 6)
		gem.color = Color(1.0, 0.85, 0.45) if i >= first else Color(0.3, 0.26, 0.34)
		pips.add_child(gem)
		gems.append(gem)
	var wheel: = preload("res://scripts/ui/lucile_wheel.gd").new()
	wheel.setup(GameData.TOWER_WHEEL)
	var holder: = CenterContainer.new()
	holder.add_child(wheel)
	stage.add_child(holder)
	var title: = _wheel_text(" ", 24, UiKit.GOLD, 6)
	stage.add_child(title)
	var what: = _wheel_text(" ", 13, Color(0.92, 0.92, 1.0), 4)

	what.autowrap_mode = TextServer.AUTOWRAP_WORD_SMART
	what.custom_minimum_size = Vector2(480, 40)
	what.vertical_alignment = VERTICAL_ALIGNMENT_TOP
	stage.add_child(what)
	var left: = [total - first]
	var go: = Button.new()
	go.text = tr("¡GIRAR!")
	go.add_theme_font_override("font", UiKit.FONT_TITLE)
	go.add_theme_font_size_override("font_size", 18)
	for c in ["font_color", "font_hover_color", "font_pressed_color", "font_focus_color"]:
		go.add_theme_color_override(c, Color(0.3, 0.14, 0.05))
	go.add_theme_color_override("font_disabled_color", Color(0.6, 0.5, 0.4))
	go.add_theme_stylebox_override("normal", UiKit.panel_box(Color(1.0, 0.82, 0.4), Color(0.55, 0.32, 0.1), 10, 3))
	go.add_theme_stylebox_override("hover", UiKit.panel_box(Color(1.0, 0.9, 0.55), Color(0.7, 0.42, 0.12), 10, 3))
	go.add_theme_stylebox_override("focus", UiKit.panel_box(Color(1.0, 0.9, 0.55), Color(0.7, 0.42, 0.12), 10, 3))
	go.add_theme_stylebox_override("pressed", UiKit.panel_box(Color(0.9, 0.68, 0.3), Color(0.55, 0.32, 0.1), 10, 3))
	go.add_theme_stylebox_override("disabled", UiKit.panel_box(Color(0.3, 0.24, 0.3), Color(0.2, 0.16, 0.2), 10, 3))
	go.size_flags_horizontal = Control.SIZE_SHRINK_CENTER
	go.custom_minimum_size = Vector2(230, 44)
	stage.add_child(go)

	var won_list: = VBoxContainer.new()
	won_list.add_theme_constant_override("separation", 6)
	won_list.position = Vector2(26.0, view.y * 0.5 - 90.0)
	won_list.custom_minimum_size.x = 210
	_root.add_child(won_list)
	wheel.ticked.connect( func(): world.play_sound("ui_click", 0.0, -8.0, randf_range(1.2, 1.35)))
	var won: = [""]


	var own: = [true]
	var pending: = []
	var whose: = _wheel_text(" ", 15, Color(0.75, 0.9, 1.0), 4)
	if not turns.is_empty():
		stage.add_child(whose)
		stage.move_child(whose, pips.get_index() + 1)
	var spin_to: = func(id: String, is_mine: bool):
		go.disabled = true
		title.text = " "
		what.text = " "
		gems[total - left[0]].color = Color(0.3, 0.26, 0.34)
		won[0] = id
		own[0] = is_mine
		var index: = 0
		for i in GameData.TOWER_WHEEL.size():
			if str(GameData.TOWER_WHEEL[i].id) == id:
				index = i
		world.play_sound("portal", 0.1, -8.0, 1.4)
		wheel.spin(index)

	var turn_now: = func():
		var at: int = total - left[0]
		if left[0] <= 0:
			go.disabled = false
			go.text = tr("Seguir subiendo") if turns.is_empty() or world.net.is_host() else tr("Cerrar")
			whose.text = " "
			go.grab_focus()
		elif mine.call(at):
			go.disabled = false
			go.text = tr("¡GIRAR!")
			if not turns.is_empty():
				whose.text = tr("¡Te toca girar!")
				whose.add_theme_color_override("font_color", Color(1.0, 0.85, 0.45))
			go.grab_focus()
		else:
			go.disabled = true
			go.text = tr("Turno de %s...") % str(turns[at][1])
			whose.text = tr("Gira %s...") % str(turns[at][1])
			whose.add_theme_color_override("font_color", Color(0.75, 0.9, 1.0))
	_wheel_remote = func(idx: int, id: String):
		var at: int = total - left[0]
		if idx < at:
			return
		if mine.call(idx):


			if idx == at and not wheel.spinning:
				spin_to.call(id, false)
			return
		if wheel.spinning or idx > at:
			pending.append([idx, id])
			return
		spin_to.call(id, false)
	wheel.stopped.connect( func():
		var e: Dictionary = TowerRun.wheel_entry(won[0])
		var kind: = str(e.kind)
		var tint: Color = Color(1.0, 0.45, 0.5) if kind == "curse" else Color(e.color).lightened(0.3)
		title.text = tr(str(e.name))
		title.add_theme_color_override("font_color", tint)
		what.text = tr(str(e.desc))
		title.pivot_offset = title.size * 0.5
		title.scale = Vector2.ONE * (2.4 if kind == "super" else 1.6)
		var pop: = title.create_tween().set_pause_mode(Tween.TWEEN_PAUSE_PROCESS)
		pop.tween_property(title, "scale", Vector2.ONE, 0.45).set_trans(Tween.TRANS_BACK).set_ease(Tween.EASE_OUT)
		won_list.add_child(_wheel_card(e))
		say.call(tr("¡¡NO PUEDE SER!! ¿¡Eso existía de verdad!?") if kind == "super" else (tr("Uy... eso va a doler un rato.") if kind == "curse" else tr("¡Eso! Te queda bien.")))
		match kind:
			"super":
				world.play_sound("drop_yellow", 0.0, 2.0)
				world.play_sound("levelup", 0.0, 0.0)
				world.play_sound("job_levelup", 0.0, -2.0)
				_wheel_rain(view, Color(1.0, 0.85, 0.3), 46)
			"curse":
				world.play_sound("curse", 0.0, -2.0)
			_:
				world.play_sound("drop_purple", 0.0, -2.0)
				_wheel_rain(view, Color(e.color).lightened(0.3), 16)
		if own[0]:
			taken.call(won[0])
		left[0] -= 1
		turn_now.call()

		pending.sort_custom( func(a, b): return int(a[0]) < int(b[0]))
		while not pending.is_empty() and int(pending[0][0]) < total - left[0]:
			pending.pop_front()
		if not pending.is_empty() and int(pending[0][0]) == total - left[0]:
			var nxt: Array = pending.pop_front()
			get_tree().create_timer(0.6, true, false, true).timeout.connect( func():
				if _mode == "tower_wheel" and not wheel.spinning and int(nxt[0]) == total - left[0]:
					spin_to.call(str(nxt[1]), false)))
	var act: = func():
		if _grace > 0.0 or wheel.spinning:
			return
		if left[0] <= 0:
			_wheel_remote = Callable()
			_resume()
			done.call()
			return
		if not mine.call(total - left[0]):
			return
		ui_click()
		spin_to.call(str(pick.call()), true)
	go.pressed.connect(act)


	wheel.mouse_filter = Control.MOUSE_FILTER_STOP
	wheel.gui_input.connect( func(ev: InputEvent):
		var tap: bool = (ev is InputEventMouseButton and (ev as InputEventMouseButton).button_index == MOUSE_BUTTON_LEFT and not ev.pressed) or (ev is InputEventScreenTouch and not ev.pressed)
		if tap and not go.disabled:
			act.call())
	if touch_ui():


		go.reparent(_root)
		go.custom_minimum_size = Vector2(200, 52)
		go.set_anchors_and_offsets_preset(Control.PRESET_BOTTOM_LEFT)
		go.position = Vector2(26.0, view.y - 52.0 - 24.0)
	turn_now.call()
	go.grab_focus.call_deferred()


