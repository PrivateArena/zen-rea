	col.add_child(row)
	var no: = UiKit.button(tr("Mejor no"))
	no.custom_minimum_size.x = 150
	no.pressed.connect( func():
		ui_click()
		tower_hel = false
		show_tower())
	row.add_child(no)
	var yes: = UiKit.button(tr("Bajemos  ▼"), true)
	yes.custom_minimum_size.x = 180
	yes.pressed.connect( func():
		Save.mark_seen("talks", "hel_tower")
		tower_hel = true
		if world != null:
			world.play_sound("warning", 0.0, -6.0)
			world.play_sound("fire_wall", 0.0, -4.0)
		show_tower()
		_hel_burst())
	row.add_child(yes)
	no.grab_focus.call_deferred()




func _hel_flames(k: = 1.0) -> void :
	var view: = get_viewport().get_visible_rect().size
	var layer: = Control.new()
	layer.set_anchors_and_offsets_preset(Control.PRESET_FULL_RECT)
	layer.mouse_filter = Control.MOUSE_FILTER_IGNORE
	_root.add_child(layer)

	_root.move_child(layer, mini(1, _root.get_child_count() - 1))

	var glow: = TextureRect.new()
	var grad: = Gradient.new()
	grad.set_color(0, Color(1.0, 0.35, 0.05, 0.0))
	grad.set_color(1, Color(0.9, 0.15, 0.05, 0.55 * k))
	var gt: = GradientTexture2D.new()
	gt.gradient = grad
	gt.fill_from = Vector2(0, 0)
	gt.fill_to = Vector2(0, 1)
	gt.width = 4
	gt.height = 64
	glow.texture = gt
	glow.stretch_mode = TextureRect.STRETCH_SCALE
	glow.expand_mode = TextureRect.EXPAND_IGNORE_SIZE
	glow.anchor_top = 0.55
	glow.anchor_bottom = 1.0
	glow.anchor_right = 1.0
	glow.mouse_filter = Control.MOUSE_FILTER_IGNORE
	layer.add_child(glow)
	var breathe: = glow.create_tween().set_loops()
	breathe.tween_property(glow, "modulate:a", 0.7, 1.1).set_trans(Tween.TRANS_SINE)
	breathe.tween_property(glow, "modulate:a", 1.0, 1.1).set_trans(Tween.TRANS_SINE)

	var add: = CanvasItemMaterial.new()
	add.blend_mode = CanvasItemMaterial.BLEND_MODE_ADD
	var fire: = CPUParticles2D.new()
	fire.material = add
	fire.texture = RoAssets.radial(Color.WHITE, 64)
	fire.amount = roundi(90 * k) + 10
	fire.lifetime = 1.6
	fire.preprocess = 1.6
	fire.position = Vector2(view.x * 0.5, view.y + 20)
	fire.emission_shape = CPUParticles2D.EMISSION_SHAPE_RECTANGLE
	fire.emission_rect_extents = Vector2(view.x * 0.55, 10)
	fire.direction = Vector2(0, -1)
	fire.spread = 12.0
	fire.gravity = Vector2(0, -40)
	fire.initial_velocity_min = 90.0 * k + 40.0
	fire.initial_velocity_max = 190.0 * k + 60.0
	fire.scale_amount_min = 0.9
	fire.scale_amount_max = 2.2
	var curve: = Curve.new()
	curve.add_point(Vector2(0, 0.6))
	curve.add_point(Vector2(0.3, 1.0))
	curve.add_point(Vector2(1, 0.1))
	fire.scale_amount_curve = curve
	var ramp: = Gradient.new()
	ramp.set_color(0, Color(1.0, 0.85, 0.4, 0.9))
	ramp.add_point(0.4, Color(1.0, 0.4, 0.08, 0.7))
	ramp.set_color(1, Color(0.5, 0.02, 0.05, 0.0))
	fire.color_ramp = ramp
	layer.add_child(fire)

	var embers: = CPUParticles2D.new()
	embers.material = add
	embers.amount = roundi(30 * k) + 6
	embers.lifetime = 3.5
	embers.preprocess = 3.5
	embers.position = fire.position
	embers.emission_shape = CPUParticles2D.EMISSION_SHAPE_RECTANGLE
	embers.emission_rect_extents = Vector2(view.x * 0.55, 10)
	embers.direction = Vector2(0, -1)
	embers.spread = 25.0
	embers.gravity = Vector2(0, -15)
	embers.initial_velocity_min = 60.0
	embers.initial_velocity_max = 160.0
	embers.scale_amount_min = 2.0
	embers.scale_amount_max = 3.5
	var ramp2: = Gradient.new()
	ramp2.set_color(0, Color(1.0, 0.8, 0.4, 1.0))
	ramp2.set_color(1, Color(1.0, 0.3, 0.1, 0.0))
	embers.color_ramp = ramp2
	layer.add_child(embers)



func _hel_burst() -> void :
	var view: = get_viewport().get_visible_rect().size
	var flash: = ColorRect.new()
	flash.color = Color(0.85, 0.2, 0.05, 0.32)
	flash.set_anchors_and_offsets_preset(Control.PRESET_FULL_RECT)
	flash.mouse_filter = Control.MOUSE_FILTER_IGNORE
	_root.add_child(flash)
	var ft: = flash.create_tween()
	ft.tween_property(flash, "color", Color(0.4, 0.0, 0.05, 0.0), 0.8).set_trans(Tween.TRANS_QUAD).set_ease(Tween.EASE_OUT)
	ft.tween_callback(flash.queue_free)
	var add: = CanvasItemMaterial.new()
	add.blend_mode = CanvasItemMaterial.BLEND_MODE_ADD
	var boom: = CPUParticles2D.new()
	boom.material = add
	boom.texture = RoAssets.radial(Color.WHITE, 64)
	boom.one_shot = true
	boom.explosiveness = 0.85
	boom.amount = 70
	boom.lifetime = 1.3
	boom.position = Vector2(view.x * 0.5, view.y + 10)
	boom.emission_shape = CPUParticles2D.EMISSION_SHAPE_RECTANGLE
	boom.emission_rect_extents = Vector2(view.x * 0.5, 10)
	boom.direction = Vector2(0, -1)
	boom.spread = 20.0
	boom.initial_velocity_min = 300.0
	boom.initial_velocity_max = 650.0
	boom.gravity = Vector2(0, 300)
	boom.scale_amount_min = 0.8
	boom.scale_amount_max = 1.8
	var ramp: = Gradient.new()
	ramp.set_color(0, Color(1.0, 0.55, 0.15, 0.55))
	ramp.add_point(0.35, Color(0.9, 0.2, 0.04, 0.4))
	ramp.set_color(1, Color(0.4, 0.0, 0.05, 0.0))
	boom.color_ramp = ramp
	_root.add_child(boom)
	boom.emitting = true
	get_tree().create_timer(1.6, true, false, true).timeout.connect(boom.queue_free)

	var win: Control = null
	for c in _root.get_children():
		if c is CenterContainer and c.get_child_count() > 0:
			win = c.get_child(0) as Control


	if win != null:
		var tw: = win.create_tween()
		tw.tween_callback( func(): win.pivot_offset = win.size * 0.5)
		for i in 6:
			tw.tween_property(win, "rotation_degrees", (1.2 if i % 2 == 0 else -1.2) * (1.0 - i / 6.0), 0.04)
		tw.tween_property(win, "rotation_degrees", 0.0, 0.04)




