		func(_at: Vector2, data: Variant) -> bool: return data is Dictionary and data.get("type", "") == "slot", 
		func(_at: Vector2, data: Variant) -> void :
			Save.set_loadout_slot(class_id, str(data.key), "")
			world.play_sound("ui_click", 0.0, -4.0)
			show_loadout(class_id))


