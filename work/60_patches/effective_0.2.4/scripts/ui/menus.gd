func _wheel_card(e: Dictionary) -> Control:
	var curse: = str(e.kind) == "curse"
	var card: = PanelContainer.new()
	card.add_theme_stylebox_override("panel", UiKit.panel_box(Color(Color(e.color).darkened(0.35), 0.95), Color(1.0, 0.4, 0.45) if curse else Color(1.0, 0.82, 0.45), 8, 2))
