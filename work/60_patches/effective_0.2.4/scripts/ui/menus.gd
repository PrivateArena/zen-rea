	UiKit.fit_dots(job)
	var rlv: = Save.rebirth_lv(id)
	var lv: = _ro_text(tr("Nv %d") % int(Save.class_progress(id).level) + ("  ·  " + GameData.rebirth_name(rlv) if rlv > 0 else ""), 9, 
		GameData.REBIRTH_LV_GOLD.darkened(0.35) if rlv > 0 else Color(0.3, 0.32, 0.45), rlv > 0)
	lv.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER
	col.add_child(lv)
	if here:
		var tag: = UiKit.tag(tr("AQUÍ"), Color(0.85, 0.6, 0.15), 9)
		tag.position = Vector2(5, 5)
		tag.mouse_filter = Control.MOUSE_FILTER_IGNORE
		b.add_child(tag)

	var free: = Save.free_points(id)
	if free > 0:
		var pts: = _ro_text("+%d" % free, 9, Color(0.85, 0.42, 0.05), true)
		pts.tooltip_text = tr("Puntos libres: %d") % free
		pts.position = Vector2(HERO_CARD.x - 26.0, 5)
		b.add_child(pts)
