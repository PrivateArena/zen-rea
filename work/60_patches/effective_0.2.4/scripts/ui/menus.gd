func _eternal_out_cost(items: Array) -> Array:
	var pieces: = 0
	var cards: = 0
	var zeny: = 0
	for it in items:
		var set_cards: Array = it.get("eternal", [])
		if set_cards.is_empty():
			continue
		pieces += 1
		for cid in set_cards:
			cards += 1
			zeny += Save.unset_eternal_price(str(cid))
	return [pieces, cards, zeny]



func _eternal_out_all(items: Array) -> void :
	var cost: = _eternal_out_cost(items)
	if int(cost[1]) == 0:
		return
	if not Save.spend(int(cost[2])):
		show_socket(tr("No tienes zeny suficiente."), false)
		return
	for it in items:
		if not (it.get("eternal", []) as Array).is_empty():
			var live: = Save.storage_item(str(it.get("uid", "")))
			if not live.is_empty():
				live.erase("eternal")
	Save.mark_dirty()
	Save.flush()
	_eternal_sel = -1
	world.play_sound("refine_hammer", 0.0, -2.0)
	show_socket(tr("«Listo: %d cartas vuelven a tu colección, intactas.»") % int(cost[1]), true)




