	hb.border_color = Color(ink, 0.3)
	hb.border_width_bottom = 1
	hb.corner_radius_top_left = 5
	hb.corner_radius_top_right = 5
	hb.content_margin_left = 8
	hb.content_margin_right = 8
	hb.content_margin_top = 5
	hb.content_margin_bottom = 5
	band.add_theme_stylebox_override("panel", hb)
	band.mouse_filter = Control.MOUSE_FILTER_PASS
	band.tooltip_text = way_tip
	col.add_child(band)
	var top: = HBoxContainer.new()
	top.add_theme_constant_override("separation", 8)
