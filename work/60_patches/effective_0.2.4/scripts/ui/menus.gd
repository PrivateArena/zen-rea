func _hit_resist_note(p: Player) -> String:
	var text: = tr("Un golpe normal (de un monstruo, o el golpe o disparo de un jefe o MVP; nunca sus habilidades ni mecánicas) te quita como máximo una parte de tu vida que sube con la dificultad, antes de tu defensa. Tu resistencia baja esa parte: %d%% por punto de VIT.") % roundi(GameData.HIT_RESIST_VIT * 100.0)
	if world != null and world.running:
		var keep: = 1.0 - p.hit_resist()
		text += "\n" + tr("Aquí: como máximo %d%% de tu vida por golpe (élites, jefes y MVP %d%%).") % [
			roundi(world.mob_hit_cap(1) * keep * 100.0), roundi(world.mob_hit_cap(2) * keep * 100.0)]
	return text


func _cap_row(label: String, value: String, cap: String, capped: bool, note: = "") -> Array:
	return [label, value, cap, capped, note]



func show_status() -> void :
	if world == null or world.player == null or not world.running:
		return
	_mode = "status"
	world.hold_world()
	_clear()
	_root.mouse_filter = Control.MOUSE_FILTER_STOP
	_root.add_child(UiKit.backdrop(0.25))
	var view: = get_viewport().get_visible_rect().size
	var k: = maxf(1.0, floorf(view.y / 360.0))
	var win: = RoStatusWindow.new()
	win.player = world.player
	win.scale = Vector2(k, k)
	win.position = ((view - RoStatusWindow.SIZE * k) * 0.5).floor()
	_root.add_child(win)
	var below: = win.position.y + RoStatusWindow.SIZE.y * k + 8

	var procs: = _proc_panel(world.player)
	if procs != null:
		_root.add_child(procs)
		procs.reset_size()
		procs.position = Vector2(floorf((view.x - procs.size.x) * 0.5), below)
		below += procs.size.y + 8
	var hint: = UiKit.label(tr("C o Esc: cerrar"), 13, Color.WHITE)
	hint.visible = not MouseWalk.touch()
	hint.add_theme_constant_override("outline_size", 4)
	hint.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER
	hint.position = Vector2(0, below)
	hint.size = Vector2(view.x, 20)
	_root.add_child(hint)







var _procs_open: = false
func _proc_panel(p: Player, plain: = false) -> PanelContainer:
	var rows: Array = []
	for pr in p.proc_summary():
		var sk: Dictionary = GameData.SKILLS.get(pr.skill, {})
		var what: = "%s Nv%d" % [tr(str(sk.get("name", pr.skill))), int(pr.level)]
		var when : = tr("al atacar") if pr. when == "basic" else tr("al recibir un golpe")
		var dmg: = (tr("daño x%s") % str(snappedf(float(pr.mult), 0.01))) if float(sk.get("damage", 0.0)) > 0.0 else ""
		rows.append([tr(str(pr.source)), what, "%s%% %s" % [str(snappedf(float(pr.chance) * 100.0, 0.1)), when ], dmg])
	var preserve: = float(p.effects.get("plag_proc", 0.0))
	if preserve > 0.0:
		rows.append(["Preserve", tr("una habilidad copiada"), "%s%% %s" % [str(snappedf(minf(1.0, preserve * (1.0 + float(p.effects.get("proc_chance", 0.0)))) * 100.0, 0.1)), tr("al atacar")], ""])
	var poison: = float(p.effects.get("poison_hit", 0.0))
	if poison > 0.0:
		var per_s: = p.basic_atk() * poison * GameData.POISON_FLAT * p.dmg_mult * p.basic_mult
		var cap: = roundi(GameData.POISON_MAX_STACKS * (1.0 + float(p.effects.get("poison_cap", 0.0))))
		var top: = minf(GameData.poison_grow_top(float(p.effects.get("poison_cap", 0.0))), pow(GameData.POISON_GROWTH, cap - 1)) * (1.0 + float(p.effects.get("poison_dmg", 0.0)))
		var corrode: = roundi((GameData.poison_corrode(cap, p) - 1.0) * 100.0)
		rows.append([tr("Veneno"), tr("cada ataque básico"), tr("%d por s · corroe hasta +%d%%") % [roundi(per_s), corrode], 
			tr("hasta x%s con %d cargas") % [str(snappedf(top, 0.1)), cap]])
	for e in [["stun_hit", tr("Aturdir")], ["burn_hit", tr("Quemadura")], ["bleed_hit", tr("Sangrado")], ["double", tr("Doble ataque")], ["triple", tr("Triple golpe")]]:
		var v: = float(p.effects.get(e[0], 0.0))
		if v > 0.0:
			var row: = [e[1], "", tr("%s%% al atacar") % str(snappedf(v * 100.0, 0.1)), ""]

			if e[0] == "double":
				var sure: = int(v)
				if sure >= Player.DOUBLE_MAX_HITS:
					row[3] = tr("%d golpes extra (MAX)") % Player.DOUBLE_MAX_HITS
				elif sure > 0:
					row[3] = tr("%d extra seguro(s) + %d%% de otro") % [sure, roundi((v - sure) * 100.0)]
				else:
					row[3] = tr("pasado del 100%: golpes seguros")
				row.append(tr("Cada 100%% es un golpe extra seguro y lo que sobra es la probabilidad de uno más: 150%% = doble seguro y 50%% de triple; 250%% = triple seguro y 50%% de cuádruple. Hasta %d golpes extra.") % Player.DOUBLE_MAX_HITS)
			rows.append(row)

	var dc: = p.double_cast_chance()
	var multi: = tr("La habilidad se lanza otra vez un momento después. La FUE o la INT (según con qué crezca cada habilidad) dan hasta un %d%%; las cartas, el equipo y los platos suman por encima de ese tope. Como los golpes extra del ataque básico: cada 100%% es un lanzamiento extra seguro y lo que sobra, la probabilidad de uno más (150%% = doble seguro y 50%% de triple; 240%% = triple seguro y 40%% de cuádruple). Hasta cuádruple.") % roundi(GameData.INT_DOUBLE_MAX * 100.0)



	var sage: = float(p.effects.get("sage_double", 0.0)) > 0.0
	if dc > 0.0 or sage:

		var attr: = minf(GameData.INT_DOUBLE_MAX, GameData.INT_DOUBLE * maxf(p.eff_stat("str"), p.eff_stat("int")))
		var copied: = sage and p.is_plagiarized("double_casting")
		var spells: = (dc + float(p.effects.sage_double) * GameData.SAGE_DOUBLE_COPIED) if copied else (p.double_cast_chance("fire_bolt") if sage else dc)
		var shown: = spells if copied else dc
		var detail: = tr("FUE/INT %d%% de %d%% máx.") % [roundi(attr * 100.0), roundi(GameData.INT_DOUBLE_MAX * 100.0)]
		if sage and not copied:
			detail = tr("hechizos de Sage (Double Casting): %s%%  ·  %s") % [str(snappedf(spells * 100.0, 0.1)), _multi_words(spells)]
		elif dc > 0.0:
			detail += "  ·  " + _multi_words(shown)
		rows.append([tr("Doble lanzamiento"), tr("habilidades de ataque (con Double Casting copiada)") if copied else tr("habilidades de ataque"), 
			tr("%s%% al lanzar") % str(snappedf(shown * 100.0, 0.1)), detail, multi])
	var steal: = float(p.effects.get("lifesteal", 0.0))
