func _rarity(it: Dictionary) -> Array:
	if Equipment.item_def(it).get("wings", false):
		return [GameData.WINGS_COLOR, tr("Mítico")]
	if Equipment.is_unique(it):
		return [GameData.UNIQUE_COLOR, tr("Único")]
	if Equipment.is_legendary(it):
		return [GameData.LEGENDARY_COLOR, tr("Legendario")]
	var names: = [tr("Común"), tr("Poco común"), tr("Raro"), tr("Épico")]
	return [Equipment.item_color(it), names[clampi(int(it.slots), 0, 3)]]





func _bag_detail(box: VBoxContainer, selected: int) -> void :
	var eq: = world.player.equipment
	var it: Dictionary = eq.bag[selected]
	var key: = eq._slot_for(it, false)
	var cur = eq.slots[key]
	var rar: = _rarity(it)
	var d: = box
	d.add_child(_ro_text(Equipment.item_name(it), 12, rar[0], true))
