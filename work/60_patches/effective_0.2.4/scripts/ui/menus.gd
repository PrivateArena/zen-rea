static func _job_skill_ids(j: Dictionary) -> Array:
	var out: Array = []
	for part in [j, j.get("trans", {})]:
		for key in ["skills", "skills_dance", "skills_f", "passives"]:
			out += (part.get(key, []) as Array)
	return out





static func _evo_reachable() -> Array:
	var out: = {}
	for cid in GameData.CLASSES:
		var d: Dictionary = GameData.CLASSES[cid]
		if d.get("custom", false):
			continue
		var ids: Array = (d.get("skills", []) as Array) + (d.get("passives", []) as Array)
		for key in ["job2", "job2_alt"]:
			if d.has(key):
				ids += _job_skill_ids(d[key])
		for id in ids:
			if GameData.EVOLUTIONS.has(id):
				out[id] = true
	return out.keys()


func _evo_list(class_id: String, width: float, ro: bool, p: Player) -> VBoxContainer:
	var d: Dictionary = GameData.CLASSES[class_id]
	var list: = VBoxContainer.new()
	list.add_theme_constant_override("separation", 6)

	var groups: = [[tr(str(d.name)), (d.skills as Array) + (d.get("passives", []) as Array)]]
	for key in ["job2", "job2_alt"]:
		if not d.has(key):
			continue
		var j: Dictionary = d[key]
		if p != null and not p.job2.is_empty() and p.job_path != (0 if key == "job2" else 1):
			continue
		var title: = tr(str(j.name)) + ((" / " + tr(str(j.trans.name))) if j.has("trans") else "")
		groups.append([title, _job_skill_ids(j)])
	var shown: = {}
	for g in groups:
		var ids: Array = (g[1] as Array).filter( func(id): return GameData.EVOLUTIONS.has(id) and not shown.has(id))


		var once: Array = []
		for id in ids:
			if not once.has(id):
				once.append(id)
		ids = once
		if ids.is_empty():
			continue
		var head: Label
		if ro:
			var found: = ids.filter( func(id): return Save.has_seen("evos", str(GameData.EVOLUTIONS[id].to))).size()
			head = _album_group("%s  %d/%d" % [g[0], found, ids.size()])
		else:
			head = UiKit.label(g[0], 15, UiKit.GOLD, true)
		list.add_child(head)

		var into: Container = list
		var row_w: = width
		if ro:
			var grid: = GridContainer.new()
			grid.columns = 2
			grid.add_theme_constant_override("h_separation", 6)
			grid.add_theme_constant_override("v_separation", 6)
			list.add_child(grid)
			into = grid
			row_w = (width - 6.0) * 0.5
		for id in ids:
			shown[id] = true
			into.add_child(_evo_row(id, row_w, ro, p))
	return list


func _evo_row(id: String, width: float, ro: bool, p: Player) -> PanelContainer:
	var ev: Dictionary = GameData.EVOLUTIONS[id]
	var to: = str(ev.to)
	var pas: = str(ev.passive)
	var txt: = func(s: String, size: int, col: Color, bold: = false) -> Label:
		var l: Label = _ro_text(s, size, col, bold) if ro else UiKit.label(s, size + 3, col, bold)
		return l
	var ok_col: = Color(0.15, 0.55, 0.25)
	var panel: = PanelContainer.new()

	var discovered: = ro and p == null and Save.has_seen("evos", to)
	var box: = _album_box("done" if discovered else "off", 7) if ro else StyleBoxFlat.new()
	if not ro:
		box.bg_color = Color(1, 1, 1, 0.65)
		box.border_color = Color(0.72, 0.76, 0.88)
		box.set_border_width_all(1)
		box.set_corner_radius_all(4)
		box.set_content_margin_all(6)
	var evolved: = p != null and p.skills.has(to)
	var ready: = p != null and not evolved and p.can_evolve(id)
	if evolved or ready:
		box.border_color = GameData.LEGENDARY_COLOR
		box.set_border_width_all(2)
	panel.add_theme_stylebox_override("panel", box)
	panel.custom_minimum_size.x = width
	var row: = HBoxContainer.new()
	row.add_theme_constant_override("separation", 8)
	panel.add_child(row)

	var req: = VBoxContainer.new()
	req.add_theme_constant_override("separation", 3)
	req.custom_minimum_size.x = width * 0.4
	row.add_child(req)
	var lv: = int(p.skills[id].level) if p != null and p.skills.has(id) else 0
	var skill_line: = tr("%s  Nv 5") % tr(str(GameData.SKILLS[id].name))
	if p != null and not evolved:
		skill_line += "   (%d/5)" % mini(lv, 5)
	req.add_child(_evo_chip(id, skill_line, txt, ok_col if evolved or lv >= 5 else Color(0.1, 0.1, 0.15)))
	var has_pas: = p != null and p.skills.has(pas)
	req.add_child(_evo_chip(pas, tr("+ pasiva %s") % tr(str(GameData.SKILLS[pas].name)) + ("  ✓" if has_pas else ""), txt, 
		ok_col if has_pas or evolved else Color(0.1, 0.1, 0.15)))
	var arrow: Label = txt.call("→", 16, GameData.LEGENDARY_COLOR.darkened(0.2), true)
	arrow.size_flags_vertical = Control.SIZE_SHRINK_CENTER
	row.add_child(arrow)

	var icon: = UiKit.icon_rect(UiKit.skill_icon(to), 28)
	icon.size_flags_vertical = Control.SIZE_SHRINK_CENTER
	icon.modulate = Color(1.15, 1.05, 0.8)
	icon.mouse_filter = Control.MOUSE_FILTER_STOP
	_set_hover(icon, {"icon": UiKit.skill_icon(to), "title": tr(str(GameData.SKILLS[to].name)), "tag": tr("Evolución"), 
		"chips": _skill_chips_for(to), "desc": tr(str(GameData.SKILLS[to].desc))})
	row.add_child(icon)
	var res: = VBoxContainer.new()
	res.add_theme_constant_override("separation", 1)
	res.size_flags_horizontal = Control.SIZE_EXPAND_FILL
	row.add_child(res)
	var name_line: = tr(str(GameData.SKILLS[to].name))
	if evolved:
		name_line += "   " + tr("¡Evolucionada!")
	elif discovered:
		name_line += "   ✓"
	elif ready:
		name_line += "   " + tr("¡Lista! Saldrá al subir de nivel")
	res.add_child(txt.call(name_line, 11, GameData.LEGENDARY_COLOR.darkened(0.35), true))
	var desc: Label = txt.call(tr(str(GameData.SKILLS[to].desc)), 10, Color(0.27, 0.29, 0.37))
	desc.autowrap_mode = TextServer.AUTOWRAP_WORD_SMART
	desc.custom_minimum_size.x = width * 0.4
	res.add_child(desc)
	return panel


