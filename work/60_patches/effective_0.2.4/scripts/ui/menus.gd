func _abstract_tabs(on: String) -> HBoxContainer:
	var tabs: = HBoxContainer.new()
	tabs.add_theme_constant_override("separation", 6)
	for t in [["socket", tr("Engarces")], ["trait", tr("Rasgos")]]:
		var lit: bool = on == t[0]
		var tb: = _ro_button(str(t[1]), func():
			if str(t[0]) == "socket":
				show_socket()
			else:
				show_traits(), not lit)
		if lit:
			tb.modulate = Color(0.75, 0.85, 1.0)
		tabs.add_child(tb)
	return tabs


func show_socket(message: = "", ok: = true) -> void :
	_mode = "socket"
	_refine_slot = null
	var body: = _ro_screen(tr("Engarces  ·  Abstract"), 720)
	var store: = Save.storage()
	if Save.storage_item(_socket_uid).is_empty():
		_socket_uid = str(store[0].uid) if not store.is_empty() else ""
	var it: = Save.storage_item(_socket_uid)

	var said: = message
	if said == "":
		if store.is_empty():
			said = tr("«Sin equipo no hay huecos. Tráeme algo del Almacén Kafra y le abro sitio para una carta.»")
		elif it.is_empty():
			said = tr("«Elige una pieza del almacén.»")
		elif Equipment.socket_room(it) <= 0:
			said = tr("«Esa ya no admite más huecos. Ni yo hago milagros.»")
		elif Equipment.sockets(it) > 0 and Save.eternal_room(it) > 0\
		and GameData.CARDS.keys().any( func(c): return Save.can_set_eternal(_socket_uid, c)):
			said = tr("«Tiene un hueco libre y tú una Carta Eterna que le va. ¿La engarzo?»")
		elif Equipment.is_legendary(it):
			said = tr("«¿Una legendaria? Le caben hasta dos cartas... si me traes Enriched.»")
		else:
			said = tr("«Un hueco más y le cabe otra carta. No siempre sale... pero tu pieza no corre peligro.»")
	body.add_child(_npc_header("npc_socket", "Abstract", said))
	body.add_child(_abstract_tabs("socket"))
	var cols: = HBoxContainer.new()
	cols.add_theme_constant_override("separation", 14)
	body.add_child(cols)

	var left: = VBoxContainer.new()
