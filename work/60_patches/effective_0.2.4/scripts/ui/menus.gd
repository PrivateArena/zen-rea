func _book_switch(p: Player) -> HBoxContainer:
	var row: = HBoxContainer.new()
	row.alignment = BoxContainer.ALIGNMENT_CENTER
	row.add_theme_constant_override("separation", 6)
	row.mouse_filter = Control.MOUSE_FILTER_IGNORE
	var books: = [[0, tr("Canciones"), ["poem_of_bragi", "assassin_cross_sunset"], Color(0.35, 0.5, 0.95)], 
		[1, tr("Danzas"), ["service_for_you", "scream"], Color(0.9, 0.35, 0.65)]]
	var now: = p.book_for_job()
	for bk in books:
		var on: bool = int(bk[0]) == now
		var b: = Button.new()
		b.focus_mode = Control.FOCUS_ALL
		b.text = str(bk[1])
		b.custom_minimum_size = Vector2(118, 28)
		b.add_theme_font_size_override("font_size", 13)
		var ink: Color = bk[3]
		for state in ["normal", "hover", "pressed", "focus"]:
			var sb: = StyleBoxFlat.new()
			sb.set_corner_radius_all(14)
			sb.anti_aliasing = true
			sb.set_border_width_all(2 if on or state != "normal" else 1)
			sb.border_color = ink if on or state != "normal" else ink.lerp(Color.WHITE, 0.55)
			sb.bg_color = ink if on else (Color(1, 1, 1, 0.95) if state == "normal" else ink.lerp(Color.WHITE, 0.82))
			b.add_theme_stylebox_override(state, sb)
		for c in ["font_color", "font_hover_color", "font_pressed_color", "font_focus_color"]:
			b.add_theme_color_override(c, Color.WHITE if on else ink.darkened(0.25))
		var names: Array = (bk[2] as Array).map( func(id): return tr(str(GameData.SKILLS[id].name)))
		b.tooltip_text = " · ".join(names)
		var pick: int = bk[0]
		b.pressed.connect( func():
			if _mode != "job_change" or p.book_for_job() == pick:
				return
			p.song_book = pick
			show_job_change())
		row.add_child(b)
	return row



