func _coop_online_option() -> Button:
	var ch: TownChannel = world.channel
	var sub: = tr("Pasea, chatea y comercia con otros jugadores")
	if ch.is_in():
		sub = tr("Estás en el Canal %d  ·  %d / %d") % [ch.number, ch.members.size(), TownChannel.MAX_PLAYERS]
	return _menu_option(_item_icon("sign_shop"), tr("Cambiar de canal") if ch.is_in() else tr("Ver canales"), sub, _coop_channels)



func _coop_create() -> void :
	var net: NetSync = world.net
	_coop_wait(tr("Creando la sala..."))
	var eos = net.eos()
	if eos != null:
		var peer = await eos.host_async()
		if peer == null:
			_coop_menu(str(eos.error))
			return
		net.host(0, peer)
	elif not net.host():
		_coop_menu(tr("No se pudo abrir la sala"))
		return
	show_coop()



