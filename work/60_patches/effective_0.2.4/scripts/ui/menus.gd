func _sn_toggle(id: String, passive: bool) -> void :
	var b: = Save.sn_build().duplicate(true)
	var key: = "passives" if passive else "skills"
	var mine: Array = b[key]
	var cap: = int(GameData.CLASSES.super_novice["max_passives" if passive else "max_skills"])
	if mine.has(id):
		mine.erase(id)
	elif mine.size() >= cap:
		show_sn_build(_sn_done, tr("Ya tienes %d: quita una primero.") % cap, false)
		return
	else:
		mine.append(id)
		if GameData.sn_ammo((b.skills as Array) + (b.passives as Array)) == "conflict":
			show_sn_build(_sn_done, tr("Solo un tipo de munición: no se mezclan los disparos con flechas, balas o kunais."), false)
			return
		if GameData.sn_mult(id) and GameData.sn_mult_count((b.skills as Array) + (b.passives as Array)) > GameData.SN_MULT_MAX:
			show_sn_build(_sn_done, tr("Ya llevas %d que multiplican el daño: quita una primero.") % GameData.SN_MULT_MAX, false)
			return
	b[key] = mine
	Save.set_sn_build(b)
	if world != null:
		world.play_sound("ui_click" if not mine.has(id) else "equip_item", 0.0, -4.0)
	show_sn_build(_sn_done)


func _sn_hover(id: String) -> Dictionary:
	var sk: Dictionary = GameData.SKILLS[id]
	var passive: = Player.is_passive(id)
	var origin: = GameData.sn_origin(id)
	return {"icon": UiKit.skill_icon(id), "icon_size": 28, "title": tr(str(sk.name)), 
		"color": Color(0.55, 0.75, 1.0) if passive else sk.get("color", Color(0.95, 0.8, 0.4)), 
		"tag": (tr("Pasiva") if passive else (tr("Apoyo") if Player.is_support(id) else tr("Habilidad")))\
		+ ("  ·  " + tr(str(GameData.CLASSES[origin].name)) if origin != "" else ""), 

		"chips": HoverCard.skill_chips(id, "", str(sk.get("element", "neutral")) if GameData.skill_has_element(id) else "", sk.get("uses_arrows", false)), 
		"desc": tr(GameData.skill_desc(id, true)), "foot": _sn_evo_foot(id)}




func _sn_evo_foot(id: String) -> Array:
	var b: = Save.sn_build()
	if GameData.EVOLUTIONS.has(id):
		var e: Dictionary = GameData.EVOLUTIONS[id]
		var has: = (b.passives as Array).has(e.passive)
		return [[tr("Evoluciona a %s con %s en el set") % [tr(str(GameData.SKILLS[e.to].name)), tr(str(GameData.SKILLS[e.passive].name))], 
			Color(0.5, 0.95, 0.55) if has else GameData.LEGENDARY_COLOR]]
	var out: = []
	for base in GameData.EVOLUTIONS:
		if str(GameData.EVOLUTIONS[base].passive) == id and GameData.sn_pool(false).has(base):
			out.append(tr(str(GameData.SKILLS[base].name)))
	if not out.is_empty():
		return [[tr("Hace evolucionar: %s") % ", ".join(out), GameData.LEGENDARY_COLOR]]
	return []

var _npc_scroll: = {}



func _keep_scroll(scroll: ScrollContainer, key: String) -> void :
	var at: = int(_npc_scroll.get(key, 0))
	var bar: = scroll.get_v_scroll_bar()



	var state: = {"ready": at == 0}
	var restore: = func():
		if not is_instance_valid(scroll):
			return
		scroll.scroll_vertical = at
		if absi(scroll.scroll_vertical - at) <= 1:
			state.ready = true
	restore.call_deferred()
	bar.changed.connect(restore)
	get_tree().process_frame.connect(restore, CONNECT_ONE_SHOT)
	for t in [0.03, 0.08]:
		get_tree().create_timer(t, true, false, true).timeout.connect(restore)
	get_tree().create_timer(0.2, true, false, true).timeout.connect( func():
		state.ready = true
		if is_instance_valid(bar) and bar.changed.is_connected(restore):
			bar.changed.disconnect(restore))
	bar.value_changed.connect( func(v: float):
		if state.ready:
			_npc_scroll[key] = int(v))



