	var navy: = Color(0.15, 0.2, 0.45)
	var intro: = _ro_text(tr("¿Encontraste un bug o tienes una idea? Cuéntanos qué pasó: llega directo al equipo."), 11, navy)
	intro.autowrap_mode = TextServer.AUTOWRAP_WORD_SMART
	intro.custom_minimum_size.x = 380
	win.body.add_child(intro)

	var kinds: = [["bug", tr("Bug")], ["idea", tr("Sugerencia")], ["other", tr("Otro")]]
	var picked: = ["bug"]
	var krow: = HBoxContainer.new()
	krow.add_theme_constant_override("separation", 6)
	win.body.add_child(krow)
	var kbuttons: Array[Button] = []
	for k in kinds:
		var kid: String = k[0]
		var b: = _ro_button(k[1], func(): pass)
		b.toggle_mode = true
		b.button_pressed = kid == "bug"
		b.custom_minimum_size.x = 90
		kbuttons.append(b)
		krow.add_child(b)
	for i in kbuttons.size():
		var kid: String = kinds[i][0]
		kbuttons[i].pressed.connect( func():
			picked[0] = kid
			for j in kbuttons.size():
				kbuttons[j].set_pressed_no_signal(j == i))
	var text: = TextEdit.new()
	text.custom_minimum_size = Vector2(380, 110)
	text.wrap_mode = TextEdit.LINE_WRAPPING_BOUNDARY
	text.placeholder_text = tr("Qué pasó, qué esperabas y cómo repetirlo si puedes...")
	text.add_theme_font_override("font", UiKit.FONT_BODY)
	text.add_theme_font_size_override("font_size", 12)

	for st in ["normal", "focus", "read_only"]:
		var tb: = StyleBoxFlat.new()
		tb.bg_color = Color.WHITE
		tb.border_color = Color(0.45, 0.55, 0.8) if st == "focus" else Color(0.7, 0.74, 0.85)
		tb.set_border_width_all(1)
		tb.set_corner_radius_all(3)
		tb.set_content_margin_all(5)
		text.add_theme_stylebox_override(st, tb)
	for c in ["font_color", "caret_color"]:
		text.add_theme_color_override(c, Color.BLACK)
	text.add_theme_color_override("font_placeholder_color", Color(0.42, 0.44, 0.5))
	win.body.add_child(text)
	text.grab_focus.call_deferred()
	var attach: = CheckBox.new()
	attach.text = tr("Adjuntar una captura de la pantalla")
	attach.focus_mode = Control.FOCUS_NONE
	attach.add_theme_font_size_override("font_size", 11)
	for st in ["font_color", "font_hover_color", "font_pressed_color", "font_hover_pressed_color"]:
		attach.add_theme_color_override(st, navy)
	attach.button_pressed = shot != null
	attach.visible = shot != null
	win.body.add_child(attach)
	var note: = _ro_text(tr("Se envía con tu versión, la pantalla y, en partida, tu personaje y el mapa. Nada más."), 9, Color(0.28, 0.3, 0.4))
	note.autowrap_mode = TextServer.AUTOWRAP_WORD_SMART
	note.custom_minimum_size.x = 380
	win.body.add_child(note)
	var status: = _ro_text("", 11, navy, true)
	win.body.add_child(status)
	var footer: = HBoxContainer.new()
	footer.alignment = BoxContainer.ALIGNMENT_END
	footer.add_theme_constant_override("separation", 6)
	win.body.add_child(footer)
	footer.add_child(_ro_button(tr("Cancelar"), close_options))
	var send: = _ro_button(tr("Enviar"), func(): pass)
	send.custom_minimum_size.x = 90
	footer.add_child(send)
	var ctx: = world.feedback_context() if world != null else {}
	send.pressed.connect( func():
		var msg: = text.text.strip_edges()
		if msg.length() < 3:
			status.text = tr("Escribe un poco más, por favor.")
			status.add_theme_color_override("font_color", Color(0.75, 0.2, 0.15))
			return
		send.disabled = true
		status.text = tr("Enviando...")
		var b64: = ""
		if shot != null and attach.button_pressed:
			b64 = _shot_b64(shot)
		world.board.send_feedback(str(picked[0]), msg, ctx, b64, func(d: Dictionary):
			if not is_instance_valid(status):
				return
			if bool(d.get("ok", false)):
				status.text = tr("¡Gracias! Lo leeremos pronto.")
				status.add_theme_color_override("font_color", Color(0.15, 0.55, 0.2))
				world.play_sound("get_coin", 0.0, -6.0)
				get_tree().create_timer(1.2, true, false, true).timeout.connect(close_options)
			elif bool(d.get("limit", false)):
				status.text = tr("Ya enviaste varios en la última hora: prueba más tarde.")
				send.disabled = false
			else:
				status.text = tr("Sin conexión: lo guardamos y se enviará la próxima vez.")
				get_tree().create_timer(1.6, true, false, true).timeout.connect(close_options)))



static func _shot_b64(img: Image) -> String:
	var im: = img.duplicate() as Image
	if im.get_width() > 960:
		im.resize(960, roundi(im.get_height() * 960.0 / im.get_width()), Image.INTERPOLATE_BILINEAR)
	var jpg: = im.save_jpg_to_buffer(0.6)
	return Marshalls.raw_to_base64(jpg) if jpg.size() <= 290000 else ""


func close_options() -> void :
	if _options != null and is_instance_valid(_options):
		_options.queue_free()
	_options = null
	if _options_paused:
		_options_paused = false
		get_tree().paused = false




