func _gear_found(id: String) -> bool:
	return Save.has_seen("items", id) or Save.has_seen("uniques", id) or Save.storage().any( func(s): return str(s.id) == id)



func _gear_sets() -> Array:
	return GameData.SETS.keys().filter( func(sid): return not GameData.set_pieces(sid).is_empty() and GameData.set_pieces(sid).all( func(p): return GameData.ITEMS.has(p)))



func _soul_items() -> Array:
	var out: Array = GameData.ITEMS.keys().filter( func(id): return GameData.ITEMS[id].has("soul_of"))
	out.sort_custom( func(a, b): return [Souls.is_legend_soul(str(a)), tr(str(GameData.ITEMS[a].name))] < [Souls.is_legend_soul(str(b)), tr(str(GameData.ITEMS[b].name))])
	return out


func _gear_items(unique: bool) -> Array:
	return GameData.ITEMS.keys().filter( func(id):
		var d: Dictionary = GameData.ITEMS[id]
		return d.get("legendary", false) and d.get("unique", false) == unique and not d.get("face", false) and not d.get("fixed", false)\
		and not d.has("soul_of"))


func _gear_percent() -> int:
	var all: = _gear_items(false) + _gear_items(true)
	if all.is_empty():
		return 0
	return roundi(100.0 * all.filter(_gear_found).size() / float(all.size()))



