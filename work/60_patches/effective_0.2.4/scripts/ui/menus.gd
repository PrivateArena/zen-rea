func _book_copied(class_id: String, p: Player) -> Array:
	if p != null:
		return p._copied()
	var out: Array = []
	var d: Dictionary = GameData.CLASSES[class_id]
	var rogue: = false
	for key in ["job2", "job2_alt"]:
		if d.has(key) and str(d[key].id) in GameData.ROGUE_JOBS:
			rogue = true


	out = [Save.plagiarism_pick()] if Save.plagiarism_pick() != "" else []
	if rogue:
		for id in Save.plagiarism_active():
			if not out.has(id):
				out.append(id)
	return out.filter( func(id): return GameData.SKILLS.has(str(id)))






func _skill_book(class_id: String, width: float, p: Player) -> VBoxContainer:
	var d: Dictionary = p.def if p != null else GameData.CLASSES[class_id]
	if p == null and d.get("custom", false):
		d = GameData.sn_def(Save.sn_build())
	var list: = VBoxContainer.new()
	list.add_theme_constant_override("separation", 10)

	var top: = Control.new()
	top.custom_minimum_size.y = 2
	list.add_child(top)
	var shown: = {}
	var sections: = [[tr(str(d.name)), tr("Clase base"), d.get("skills", []), d.get("passives", []), {}, false]]
	for key in ["job2", "job2_alt"]:
		if not d.has(key):
			continue
		var j: Dictionary = d[key]
		var t: Dictionary = j.get("trans", {})
		var title: = _job_title(j)
		if not t.is_empty():
			title += "  →  " + _job_title(t)
		var skills: Array = (j.get("skills", []) as Array).duplicate()
		var passives: Array = (j.get("passives", []) as Array).duplicate()

		var trans_only: = {}
		for id in t.get("skills", []) + t.get("passives", []):
			if not skills.has(id) and not passives.has(id):
				trans_only[id] = _job_title(t)
				(passives if Player.is_passive(id) else skills).append(id)
		var mine: = p != null and not p.job2.is_empty() and p.job_path == (0 if key == "job2" else 1)
		var other: = p != null and not p.job2.is_empty() and not mine
		sections.append([title, tr("Tu camino") if mine else (tr("Otro camino") if other else tr("Segundo oficio")), 
			skills, passives, trans_only, other])
	var copied: = _book_copied(class_id, p)
	if not copied.is_empty():
		sections.append([tr("Copiadas con Plagiarism"), tr("De los jefes que derrotaste"), 
			copied.filter( func(id): return not Player.is_passive(id)), copied.filter( func(id): return Player.is_passive(id)), {}, false])
	for s in sections:
		var acts: Array = (s[2] as Array).filter( func(id): return GameData.SKILLS.has(id) and not shown.has(id))
		var pas: Array = (s[3] as Array).filter( func(id): return GameData.SKILLS.has(id) and not shown.has(id))
		for id in acts + pas:
			shown[id] = true
		if acts.is_empty() and pas.is_empty():
			continue
		list.add_child(_book_section(s[0], s[1], acts, pas, s[4], s[5], width, p))

	if p != null:
		var extra_a: Array = []
		var extra_p: Array = []
		for id in p.skills:
			var b: = Player.base_skill(str(id))
			if shown.has(b) or shown.has(id) or not GameData.SKILLS.has(b):
				continue
			shown[b] = true
			(extra_p if Player.is_passive(b) else extra_a).append(b)
		if not extra_a.is_empty() or not extra_p.is_empty():
			list.add_child(_book_section(tr("Otras"), tr("Las que llevas de otra parte"), extra_a, extra_p, {}, false, width, p))
	return list


func _job_title(j: Dictionary) -> String:
	var name: = tr(str(j.name))
	if j.has("name_f"):
		name += " / " + tr(str(j.name_f))
