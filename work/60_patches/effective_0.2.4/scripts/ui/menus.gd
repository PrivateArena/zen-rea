func _glow(c: CanvasItem) -> void :
	var tw: = c.create_tween().set_loops().set_pause_mode(Tween.TWEEN_PAUSE_PROCESS)
	c.set_meta("glow", tw)
	tw.tween_property(c, "modulate", Color(1.25, 1.15, 0.75), 0.55).set_trans(Tween.TRANS_SINE)
	tw.tween_property(c, "modulate", Color(1.0, 0.92, 0.6), 0.55).set_trans(Tween.TRANS_SINE)




func _claim_achievement(id: String, quiet: = false) -> void :
	var c: = Save.claim_achievement(id)
	if c <= 0:
		return
	if not quiet:
		world.play_sound("get_coin", 0.0, -2.0)
		world.play_sound("drop_yellow", 0.0, -8.0)
	var info: Dictionary = _ach_cells.get(id, {})
	_ach_cells.erase(id)
	if not info.is_empty() and is_instance_valid(info.cell):
		var cell: PanelContainer = info.cell
		var box: StyleBoxFlat = info.box
		box.bg_color = Color(1.0, 0.97, 0.86)
		box.border_color = Color(0.85, 0.66, 0.25)
		box.set_border_width_all(1)
		cell.mouse_filter = Control.MOUSE_FILTER_IGNORE
		cell.mouse_default_cursor_shape = Control.CURSOR_ARROW
		var reward: VBoxContainer = info.reward
		for ch in reward.get_children():
			reward.remove_child(ch)
			ch.queue_free()
		var stamp_path: = "res://assets/ro/ui/skin/achievement/badge_complete.png"
		var stamp: = UiKit.icon_rect(load(stamp_path) if ResourceLoader.exists(stamp_path) else null, 34)
		stamp.texture_filter = CanvasItem.TEXTURE_FILTER_LINEAR
		reward.add_child(stamp)

		stamp.pivot_offset = Vector2(17, 17)
		stamp.scale = Vector2.ONE * 1.8
		var st: = stamp.create_tween().set_pause_mode(Tween.TWEEN_PAUSE_PROCESS)
		st.tween_property(stamp, "scale", Vector2.ONE, 0.22).set_trans(Tween.TRANS_BACK).set_ease(Tween.EASE_OUT)
		cell.modulate = Color(1.6, 1.45, 1.0)
		var fl: = cell.create_tween().set_pause_mode(Tween.TWEEN_PAUSE_PROCESS)
		fl.tween_property(cell, "modulate", Color.WHITE, 0.35)

		var pop: = HBoxContainer.new()
		pop.mouse_filter = Control.MOUSE_FILTER_IGNORE
		pop.add_child(UiKit.icon_rect(Achievements.coin_icon(), 22))
		pop.add_child(UiKit.label("+%d" % c, 15, Color(1.0, 0.85, 0.3), true))
		_root.add_child(pop)
		var gscale: = cell.get_global_transform().get_scale().x
		pop.global_position = cell.global_position + Vector2(cell.size.x * gscale - 70.0, 0)
		var pt: = pop.create_tween().set_parallel().set_pause_mode(Tween.TWEEN_PAUSE_PROCESS)
		pt.tween_property(pop, "global_position:y", pop.global_position.y - 34.0, 0.7).set_ease(Tween.EASE_OUT)
		pt.tween_property(pop, "modulate:a", 0.0, 0.3).set_delay(0.45)
		pt.chain().tween_callback(pop.queue_free)
	if _ach_coin_label != null and is_instance_valid(_ach_coin_label):
		_ach_coin_label.text = tr("%d Poring Coins") % Save.coins()
		_ach_coin_label.pivot_offset = _ach_coin_label.size * 0.5
		_ach_coin_label.scale = Vector2.ONE * 1.2
		var ct: = _ach_coin_label.create_tween().set_pause_mode(Tween.TWEEN_PAUSE_PROCESS)
		ct.tween_property(_ach_coin_label, "scale", Vector2.ONE, 0.2)
	if Save.unclaimed_achievements().is_empty():
		if _ach_claim_all != null and is_instance_valid(_ach_claim_all):
			_ach_claim_all.queue_free()
			_ach_claim_all = null

		if _ach_tab != null and is_instance_valid(_ach_tab) and _ach_tab.has_meta("glow"):
			(_ach_tab.get_meta("glow") as Tween).kill()
			_ach_tab.remove_meta("glow")
			_ach_tab.modulate = Color.WHITE
	Save.flush()




func _claim_all_achievements() -> void :
	var ids: = Save.unclaimed_achievements()
	if ids.is_empty():
		return
	world.play_sound("get_coin", 0.0, -2.0)
	world.play_sound("drop_yellow", 0.0, -6.0)
	if _ach_claim_all != null and is_instance_valid(_ach_claim_all):
		_ach_claim_all.disabled = true
	var tw: = create_tween().set_pause_mode(Tween.TWEEN_PAUSE_PROCESS)
	for i in ids.size():
		var id: String = ids[i]
		tw.tween_callback( func():
			_claim_achievement(id, true)
			if i % 3 == 0:
				world.play_sound("coin%d" % (1 + i % 3), 0.0, -8.0))
		tw.tween_interval(0.06)



