	var job: = _ro_text(_class_title(id), 9, Color(0.28, 0.3, 0.4))
	job.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER
	job.custom_minimum_size.x = HERO_CARD.x - 10.0
