var _book_open: = {}


func _book_section(title: String, tag: String, acts: Array, pas: Array, trans_only: Dictionary, dim: bool, width: float, p: Player) -> VBoxContainer:
	var sec: = VBoxContainer.new()
	sec.add_theme_constant_override("separation", 6)
	if dim:
		sec.modulate = Color(1, 1, 1, 0.55)
	var mine: = tag == tr("Tu camino")
	var fill: = Color(1.0, 0.93, 0.74) if mine else Color(0.86, 0.9, 1.0)
	var edge: = Color(0.85, 0.6, 0.15) if mine else Color(0.3, 0.42, 0.78)

	var band: = Button.new()
	band.focus_mode = Control.FOCUS_NONE
	band.mouse_default_cursor_shape = Control.CURSOR_POINTING_HAND
	band.custom_minimum_size = Vector2(width, 34)
	for st in ["normal", "hover", "pressed"]:
		var bb: = StyleBoxFlat.new()
		bb.bg_color = fill.lightened(0.35) if st == "hover" else fill
		bb.border_color = edge
		bb.border_width_left = 4
		bb.set_border_width_all(1)
		bb.border_width_left = 4
		bb.set_corner_radius_all(6)
		band.add_theme_stylebox_override(st, bb)
	sec.add_child(band)
	var head: = HBoxContainer.new()
	head.add_theme_constant_override("separation", 8)
	head.set_anchors_and_offsets_preset(Control.PRESET_FULL_RECT)
	head.offset_left = 12
	head.offset_right = -12
	head.mouse_filter = Control.MOUSE_FILTER_IGNORE
	band.add_child(head)
	var arrow: = _ro_text("", 12, edge.darkened(0.2), true)
	arrow.add_theme_font_override("font", ThemeDB.fallback_font)
	arrow.custom_minimum_size.x = 14
	arrow.size_flags_vertical = Control.SIZE_SHRINK_CENTER
	head.add_child(arrow)
	var t: = _ro_text(title, 13, Color(0.12, 0.2, 0.55), true)
	t.size_flags_horizontal = Control.SIZE_EXPAND_FILL
	t.size_flags_vertical = Control.SIZE_SHRINK_CENTER
	head.add_child(t)

	var learned: = 0
	if p != null:
		for id in acts + pas:
			if p.skills.has(id) or (GameData.EVOLUTIONS.has(id) and p.skills.has(str(GameData.EVOLUTIONS[id].to))):
				learned += 1
	var count: = tr("%d habilidades · %d pasivas") % [acts.size(), pas.size()]
	if learned > 0:
		count += "  ·  " + tr("%d aprendidas") % learned
	var c: = _ro_text(count, 10, Color(0.4, 0.44, 0.58))
	c.size_flags_vertical = Control.SIZE_SHRINK_CENTER
	head.add_child(c)
	var tg: = _ro_text(tag, 10, Color(0.6, 0.4, 0.05) if mine else Color(0.35, 0.4, 0.6), true)
	tg.size_flags_vertical = Control.SIZE_SHRINK_CENTER
	head.add_child(tg)
	var cols: = HBoxContainer.new()
	cols.add_theme_constant_override("separation", 10)
	sec.add_child(cols)
	var set_open: = func(open: bool):
		cols.visible = open
		arrow.text = "▼" if open else "▶"


	var key: = ("run:" if p != null else "album:") + title
	set_open.call(bool(_book_open.get(key, true)))
	band.pressed.connect( func():
		var open: = not bool(_book_open.get(key, true))
		_book_open[key] = open
		set_open.call(open)
		ui_click())
	var col_w: = (width - 10.0) * 0.5
	for pair in [[tr("Habilidades"), acts], [tr("Pasivas"), pas]]:
		var col: = VBoxContainer.new()
		col.add_theme_constant_override("separation", 5)
		col.custom_minimum_size.x = col_w
		col.size_flags_horizontal = Control.SIZE_EXPAND_FILL
		cols.add_child(col)
		var h: = _ro_text("%s  %d" % [pair[0], (pair[1] as Array).size()], 10, Color(0.4, 0.44, 0.58), true)
		h.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER
		col.add_child(h)
		for id in pair[1]:
			col.add_child(_book_card(str(id), col_w, str(trans_only.get(id, "")), p))
		if (pair[1] as Array).is_empty():
			var none: = _ro_text("—", 11, Color(0.42, 0.44, 0.52))
			none.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER
			col.add_child(none)
	return sec




func _book_card(id: String, width: float, trans_job: String, p: Player) -> PanelContainer:
	var ev: Dictionary = GameData.EVOLUTIONS.get(id, {})
	var to: = str(ev.get("to", ""))
	var evolved: = p != null and to != "" and p.skills.has(to)
	var lv: = int(p.skills[id].level) if p != null and p.skills.has(id) else 0
	var shown_id: = to if evolved else id
	var s: Dictionary = GameData.SKILLS[shown_id]
	var card: = PanelContainer.new()
	card.custom_minimum_size = Vector2(width, 58)
	card.add_theme_stylebox_override("panel", _album_box("hot" if evolved else ("on" if lv > 0 else "off"), 6))
	card.mouse_filter = Control.MOUSE_FILTER_STOP
	var row: = HBoxContainer.new()
	row.add_theme_constant_override("separation", 8)
	row.mouse_filter = Control.MOUSE_FILTER_IGNORE
	card.add_child(row)
	var icon: = UiKit.icon_rect(UiKit.skill_icon(shown_id), 34)
	icon.size_flags_vertical = Control.SIZE_SHRINK_CENTER
	if evolved:
		icon.modulate = Color(1.15, 1.05, 0.8)
	row.add_child(icon)
	var text: = VBoxContainer.new()
	text.add_theme_constant_override("separation", 1)
	text.size_flags_horizontal = Control.SIZE_EXPAND_FILL
	text.mouse_filter = Control.MOUSE_FILTER_IGNORE
	row.add_child(text)
	var top: = HBoxContainer.new()
	top.add_theme_constant_override("separation", 6)
	text.add_child(top)
	var name_l: = _ro_text(tr(str(s.name)), 11, GameData.LEGENDARY_COLOR.darkened(0.35) if evolved else Color(0.12, 0.16, 0.35), true)
	name_l.clip_text = true
	name_l.size_flags_horizontal = Control.SIZE_EXPAND_FILL
	top.add_child(name_l)
	var badge: = ""
	if evolved:
		badge = "EX"
	elif lv > 0:
		badge = tr("Nv %d/%d") % [mini(lv, GameData.MAX_SKILL_LEVEL), GameData.MAX_SKILL_LEVEL]
	elif trans_job != "":
		badge = trans_job
	if badge != "":
		top.add_child(_ro_text(badge, 9, GameData.LEGENDARY_COLOR.darkened(0.3) if evolved else (Color(0.2, 0.32, 0.7) if lv > 0 else Color(0.55, 0.45, 0.7)), true))

	var grows: = ""
	if s.has("damage") or GameData.SKILL_SCALE.has(shown_id.trim_suffix("_x")):
		grows = p.scaling_text(shown_id) if p != null else GameData.skill_scaling(shown_id)
	if grows != "":
		top.add_child(_ro_text(grows, 9, Color(0.55, 0.3, 0.1), true))
	var desc: = _ro_text(tr(str(s.get("desc", ""))), 10, Color(0.2, 0.22, 0.3))
	desc.autowrap_mode = TextServer.AUTOWRAP_WORD_SMART
	desc.max_lines_visible = 2
	desc.text_overrun_behavior = TextServer.OVERRUN_TRIM_ELLIPSIS
	desc.custom_minimum_size.x = width - 60.0
	text.add_child(desc)

	var feet: Array = []
	if to != "" and not evolved:
		feet.append([tr("EX: %s  (Nv 5 + pasiva %s)") % [tr(str(GameData.SKILLS[to].name)), tr(str(GameData.SKILLS[str(ev.passive)].name))], 
			GameData.LEGENDARY_COLOR])
	if trans_job != "":
		feet.append([tr("Solo %s") % trans_job, Color(0.75, 0.65, 0.95)])

	var el_id: = ""
	if GameData.skill_has_element(shown_id):
		el_id = Skills.element_of(p, s) if p != null else str(s.get("element", "neutral"))
	_set_hover(card, {"icon": UiKit.skill_icon(shown_id), "title": tr(str(s.name)), 
		"tag": tr("Pasiva") if Player.is_passive(id) else tr("Habilidad"), "desc": tr(str(s.get("desc", ""))), "foot": feet, 
		"chips": HoverCard.skill_chips(shown_id, grows, el_id, s.get("uses_arrows", false))})
	return card


