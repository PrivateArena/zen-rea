	info.add_child(what)
	if str(r[2]) != "":
		var desc: = _ro_text(str(r[2]), 12, Color(0.3, 0.32, 0.38))
		desc.autowrap_mode = TextServer.AUTOWRAP_WORD_SMART
		desc.custom_minimum_size.x = 300
		info.add_child(desc)
	return card



