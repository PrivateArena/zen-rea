func _eternal_flash() -> void :
	var f: = ColorRect.new()
	f.color = Color(GameData.ETERNAL_COLOR, 0.45)
	f.set_anchors_and_offsets_preset(Control.PRESET_FULL_RECT)
	f.mouse_filter = Control.MOUSE_FILTER_IGNORE
	_root.add_child(f)
	var tw: = f.create_tween()
	tw.tween_property(f, "color:a", 0.0, 0.45)
	tw.tween_callback(f.queue_free)




func show_abstract() -> void :
	_mode = "socket"
	var body: = _ro_screen(tr("Abstract"), 340)
	body.add_child(_npc_header("npc_socket", "Abstract", tr("«¿Huecos, Cartas Eternas... o una pieza con un rasgo que no te gusta?»"), 320))
