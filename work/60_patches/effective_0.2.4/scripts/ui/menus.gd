		sb.border_color = Color(0.45, 0.55, 0.85) if st == "focus" else Color(0.65, 0.7, 0.85)
		sb.set_border_width_all(1)
		sb.set_corner_radius_all(3)
		sb.content_margin_left = 5
		name_box.add_theme_stylebox_override(st, sb)
