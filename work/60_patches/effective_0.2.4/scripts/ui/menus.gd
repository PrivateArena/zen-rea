func _end_cards(got: Array, width: float) -> Control:
	var counts: = {}
	var fresh: = {}
	var order: Array = []
	for g in got:
		var id: = str(g.id)
		if not GameData.CARDS.has(id):
			continue
		if not counts.has(id):
			order.append(id)
		counts[id] = int(counts.get(id, 0)) + 1
		if bool(g.get("new", false)):
			fresh[id] = true
	var tier: = func(id: String) -> int:
		var mob: Dictionary = GameData.MONSTERS.get(id.trim_suffix("_card"), {})
		return 2 if mob.get("mvp", false) else (1 if mob.has("boss") else 0)
	order.sort_custom( func(a, b):
		if fresh.has(a) != fresh.has(b):
			return fresh.has(a)
		if tier.call(a) != tier.call(b):
			return tier.call(a) > tier.call(b)
		return int(counts[a]) > int(counts[b]))
	var panel: = PanelContainer.new()
	var box: = UiKit.panel_box()
	box.shadow_color = Color(0.05, 0.08, 0.2, 0.14)
	box.shadow_size = 4
	box.shadow_offset = Vector2(0, 2)
	box.set_content_margin_all(10)
	panel.add_theme_stylebox_override("panel", box)
	panel.custom_minimum_size.x = width
	panel.size_flags_horizontal = Control.SIZE_SHRINK_CENTER
	var v: = VBoxContainer.new()
	v.add_theme_constant_override("separation", 6)
	panel.add_child(v)
	var head: = HBoxContainer.new()
	head.alignment = BoxContainer.ALIGNMENT_CENTER
	head.add_theme_constant_override("separation", 10)
	v.add_child(head)
	head.add_child(UiKit.label(tr("Cartas de la partida"), 15, UiKit.TEXT, true))
	head.add_child(UiKit.label("%d" % got.size(), 15, UiKit.GOLD, true))
	if not fresh.is_empty():
		head.add_child(_new_badge(tr("%d nuevas") % fresh.size()))


	var line: = HBoxContainer.new()
	line.add_theme_constant_override("separation", 4)
	v.add_child(line)
	var scroll: = ScrollContainer.new()
	scroll.vertical_scroll_mode = ScrollContainer.SCROLL_MODE_DISABLED
	scroll.horizontal_scroll_mode = ScrollContainer.SCROLL_MODE_SHOW_NEVER
	scroll.add_theme_stylebox_override("panel", StyleBoxEmpty.new())
	scroll.size_flags_horizontal = Control.SIZE_EXPAND_FILL
	scroll.custom_minimum_size = Vector2(width - 90.0, 40)
	var row: = HBoxContainer.new()
	row.add_theme_constant_override("separation", 6)
	scroll.add_child(row)
	for id in order:
		row.add_child(_end_card_chip(id, int(counts[id]), fresh.has(id), int(tier.call(id))))
	var step: = func(dir: float):
		var tw: = scroll.create_tween()
		tw.tween_property(scroll, "scroll_horizontal", int(scroll.scroll_horizontal + dir * (scroll.size.x * 0.7)), 0.22).set_trans(Tween.TRANS_SINE).set_ease(Tween.EASE_OUT)
	var left: = _ro_button("<", func(): step.call(-1.0))
	var right: = _ro_button(">", func(): step.call(1.0))
	for b in [left, right]:
		b.custom_minimum_size = Vector2(26, 36)
		b.focus_mode = Control.FOCUS_NONE
		b.size_flags_vertical = Control.SIZE_SHRINK_CENTER
	line.add_child(left)
	line.add_child(scroll)
	line.add_child(right)

	scroll.gui_input.connect( func(ev: InputEvent):
		if ev is InputEventMouseButton and ev.pressed and ev.button_index in [MOUSE_BUTTON_WHEEL_UP, MOUSE_BUTTON_WHEEL_DOWN]:
			scroll.scroll_horizontal += (-60 if ev.button_index == MOUSE_BUTTON_WHEEL_UP else 60)
			scroll.accept_event())

	var fit: = func():
		if not is_instance_valid(scroll):
			return
		var all_in: = row.get_combined_minimum_size().x <= scroll.size.x + 1.0
		left.visible = not all_in
		right.visible = not all_in
		row.alignment = BoxContainer.ALIGNMENT_CENTER if all_in else BoxContainer.ALIGNMENT_BEGIN
		if all_in:
			row.custom_minimum_size.x = scroll.size.x
	fit.call_deferred()
	return panel


