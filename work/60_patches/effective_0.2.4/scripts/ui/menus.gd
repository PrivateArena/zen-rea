		dl.add_child(msg)
		dl.move_child(msg, 0)

	if touch_ui():
		_equip_touch_pages(body, cols, [bag_col, left, right], [sep, det, more, fx_box], [how, refine], selected, bag_sel)
	var footer: = HBoxContainer.new()
	footer.alignment = BoxContainer.ALIGNMENT_END
