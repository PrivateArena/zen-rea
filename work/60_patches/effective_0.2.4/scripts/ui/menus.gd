func _chef_place(id: String, open: bool, n: int) -> Control:
	var p: = PanelContainer.new()
	p.size_flags_horizontal = Control.SIZE_EXPAND_FILL
	p.custom_minimum_size = Vector2(132, 50)
	var sb: = _chef_box(Color(1.0, 0.975, 0.92) if id != "" else Color(0.95, 0.955, 0.97, 1.0 if open else 0.5), 
		CHEF_GOLD if id != "" else Color(0.8, 0.81, 0.86, 1.0 if open else 0.5), 8, 1)
