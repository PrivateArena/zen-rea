func _armory_tabs(opts: Array, key: String, reopen: = false) -> HBoxContainer:
	var row: = HBoxContainer.new()
	row.add_theme_constant_override("separation", 3)
	var group: = ButtonGroup.new()
	for o in opts:
		var b: Button = _ro_button(str(o[1]), func():
			if reopen:
				if str(_arm[key]) != str(o[0]):
					_arm[key] = str(o[0])
					show_armory()
				return
			_arm[key] = str(o[0])
			_armory_fill())
		b.toggle_mode = true
		b.button_group = group
		b.button_pressed = str(_arm[key]) == str(o[0])
		b.focus_mode = Control.FOCUS_NONE
		row.add_child(b)
	return row



func _armory_items() -> Array:
	var stored: = {}
	for it in Save.storage():
		stored[str(it.id)] = true
	var out: = []
	for id in GameData.ITEMS:
		if Save.has_seen("items", id) or Save.has_seen("uniques", id) or stored.has(id):
			out.append(id)
	return out


func _armory_fill() -> void :
	if _arm_list == null or not is_instance_valid(_arm_list):
		return
	for c in _arm_list.get_children():
		c.queue_free()
	var p: Player = world.player
	var needle: = _fold(str(_arm.text).strip_edges())
	if str(_arm.src) == "own":
		_armory_fill_own(p, needle)
		return
	var ids: = _armory_items()
	var shown: = 0
	for id in ids:
		var d: Dictionary = GameData.ITEMS[id]
		var it: = Equipment.make(id, 0 if d.get("legendary", false) or d.get("unique", false) else 3)
		var kind: = "unique" if Equipment.is_unique(it) else ("legendary" if Equipment.is_legendary(it) else "epic")
		if str(_arm.rarity) != "" and str(_arm.rarity) != kind:
			continue
		if str(_arm.slot) != "" and str(d.slot) != str(_arm.slot):
			continue
		if not bool(_arm.all) and not p.equipment.can_wear(it):
			continue
		var name: = Equipment.item_name(it)
		var fx: = _mods_text(Equipment.item_mods(it))
		var desc: = tr(str(d.get("desc", "")))
		if needle != "" and not _fold("%s %s %s" % [name, fx, desc]).contains(needle):
			continue
		shown += 1
		_arm_list.add_child(_armory_row(it, name, fx, desc))
	_arm_count.text = tr("%d de %d objetos") % [shown, ids.size()]
	if ids.is_empty():
		_arm_count.text = tr("Aún no has visto objetos: los que encuentres en tus partidas aparecerán aquí.")




func _armory_fill_own(p: Player, needle: String) -> void :
	var items: = World.training_own_items(p, bool(_arm.all))
	var shown: = 0
	for it in items:
		var d: = Equipment.item_def(it)
		if str(_arm.slot) != "" and str(d.slot) != str(_arm.slot):
			continue
		var name: = Equipment.item_name(it)
		var fx: = _mods_text(Equipment.item_mods(it))
		var desc: = tr(str(d.get("desc", "")))
		if needle != "" and not _fold("%s %s %s" % [name, fx, desc]).contains(needle):
			continue
		shown += 1
		_arm_list.add_child(_armory_row(it, name, fx, desc, func(): _armory_take_own(it)))
	_arm_count.text = tr("%d de %d objetos") % [shown, items.size()]
	if items.is_empty():
		_arm_count.text = tr("No queda nada de tu almacén que puedas tomar.")



static func _fold(t: String) -> String:
	var out: = t.to_lower()
	for pair in [["á", "a"], ["é", "e"], ["í", "i"], ["ó", "o"], ["ú", "u"], ["ü", "u"], ["ñ", "n"]]:
		out = out.replace(pair[0], pair[1])
	return out


