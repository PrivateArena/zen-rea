	for line in [tr("Sin puntos de control: cada bajada empieza en el piso 1."), 
			tr("Cada 10 pisos se suma una regla de Infierno al azar."), 
			tr("Tus Juramentos bajan contigo: más Star Crumbs, zeny y materiales de refinado, y mejor puesto."), 
			tr("Premios únicos cada 10 pisos: Lágrimas de Hel, cosméticos y un título en el 100.")]:
		var l: = UiKit.label("•  " + line, 13, Color(1.0, 0.9, 0.82))
