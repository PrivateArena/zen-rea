	var fig: = HeroFigure.new()
	fig.ro = RoAssets.styled_character(shown.body, shown.weapon, shown.weapon_fx, [shown.attack], gear.head, Save.look(id), "", gear.extras)
	fig.glow = RebirthAura.earned(id)
	fig.custom_minimum_size = Vector2(0, 104)
	fig.walking = here
	col.add_child(fig)
	var gold: = Save.rebirth_looks(id).has("valhalla")
	var name_l: = _ro_text(Save.char_name(id), 11, GameData.REBIRTH_LV_GOLD.darkened(0.3) if gold else Color(0.15, 0.17, 0.3), true)
	name_l.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER
	name_l.custom_minimum_size.x = HERO_CARD.x - 10.0
	col.add_child(name_l)
